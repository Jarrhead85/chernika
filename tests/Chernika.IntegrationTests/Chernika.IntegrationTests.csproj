<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Версия совпадает с Microsoft.AspNetCore.OpenApi в Chernika.Api (9.0.6),
         иначе WebApplicationFactory поднимет другой рантайм-конвейер, чем
         проверяемое приложение. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chernika.Domain\Chernika.Domain.csproj" />
    <ProjectReference Include="..\..\src\Chernika.Infrastructure\Chernika.Infrastructure.csproj" />
    <!-- Ссылка на API нужна для проверки карточного контракта: GsmMaterialRefDto
         и мапперы ХК — действующий публичный контракт, который после PR-5
         переведён с Type/Gost на Nd и классификацию. -->
    <ProjectReference Include="..\..\src\Chernika.Api\Chernika.Api.csproj" />
    <!-- Ссылка на Web нужна для проверки штатного запуска: worker обработки
         сроков ХК живёт в нём, и «владелец ровно один» доказывается подъёмом
         настоящего хоста, а не подстановкой удобной конфигурации. -->
    <ProjectReference Include="..\..\src\Chernika.Web\Chernika.Web.csproj" />
  </ItemGroup>

</Project>
