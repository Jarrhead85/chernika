@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using System.Globalization
@inject NavigationManager Nav

@* Read-only snapshot sections of an individual card, shared by Draft,
   Formed and Archived states. No input/select/textarea controls. *@

<h3 class="hkc-subtitle">Реквизиты ИК</h3>
<div class="hkv-row"><span class="hkv-label">@Detail.ObjectLevelDisplay:</span> @Detail.ObjectCode — @Detail.ObjectName</div>
@if (!string.IsNullOrEmpty(Detail.ContextText))
{
    <div class="hkv-row hkv-muted">@Detail.ContextText</div>
}
<div class="hkv-row"><span class="hkv-label">Филиал:</span> @(Detail.BranchName ?? "—")</div>
<div class="hkv-row"><span class="hkv-label">Автор:</span> @(Detail.AuthorName ?? "—")</div>
<div class="hkv-row"><span class="hkv-label">Создана:</span> @Detail.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
@if (Detail.FormedAt is { } formedAt)
{
    <div class="hkv-row"><span class="hkv-label">Сформирована:</span> @formedAt.ToString("dd.MM.yyyy HH:mm")</div>
}
@if (Detail.ArchivedAt is { } archivedAt)
{
    <div class="hkv-row"><span class="hkv-label">Архивирована:</span> @archivedAt.ToString("dd.MM.yyyy HH:mm")</div>
}

<h3 class="hkc-subtitle">Нормативная готовность</h3>
@if (Detail.NormativeGaps.Count == 0 && Detail.Problems.Count == 0)
{
    <div class="note">Готова: нормативные пробелы и проблемы расчёта отсутствуют.</div>
}
else
{
    @foreach (var gap in Detail.NormativeGaps)
    {
        <div class="note">⚠ @gap.Message</div>
    }
    @foreach (var problem in Detail.Problems)
    {
        <div class="note">⚠ @problem.Message</div>
    }
}

<h3 class="hkc-subtitle">Версия состава</h3>
@if (Detail.Compositions.Count == 0)
{
    <div class="note">Состав отсутствует.</div>
}
else
{
    @foreach (var composition in Detail.Compositions)
    {
        <div class="hkv-row">@composition.TargetObjectCode — @composition.TargetObjectName: состав @composition.SourceCompositionVersion ×@composition.Quantity</div>
        @foreach (var aggregate in composition.Aggregates)
        {
            <div class="hkv-muted">
                Агрегат @aggregate.AggregateCode — @aggregate.AggregateName ×@aggregate.Quantity
                (узлов: @aggregate.Nodes.Count)
            </div>
        }
    }
}

<h3 class="hkc-subtitle">Источники ХК</h3>
<div class="tableWrap" data-scroll="contained">
    <table class="hk-items-table">
        <thead>
            <tr>
                <th>Уровень</th>
                <th>Объект</th>
                <th>ХК</th>
                <th>Готовность</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var source in Detail.HKSources)
            {
                <tr>
                    <td>@IndividualCardDisplay.ObjectLevel(source.ObjectLevel)</td>
                    <td>@source.SourceObjectCode — @source.SourceObjectName</td>
                    <td class="mono">@source.HKCardCode @source.HKCardVersion</td>
                    <td>@(source.IsComplete ? "Полная" : "Частичная")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Detail.Coefficients.Count > 0)
{
    <h3 class="hkc-subtitle">Применённые коэффициенты</h3>
    <div class="hkv-muted">
        @foreach (var coefficient in Detail.Coefficients)
        {
            <div>@coefficient.CoefficientTypeName / @coefficient.CoefficientName — <span class="mono">@FormatCoefficient(coefficient.Value)</span></div>
        }
        <div>Общий коэффициент: <span class="mono">@FormatCoefficient(Detail.TotalCoefficient)</span></div>
    </div>
}

@if (Detail.Status != IndividualCardStatus.Draft)
{
    <h3 class="hkc-subtitle">Расчётные строки</h3>
    @if (Detail.Rows.Count == 0)
    {
        <div class="note">Расчётные строки отсутствуют.</div>
    }
    else
    {
        <div class="tableWrap" data-scroll="contained">
        <table class="hk-items-table">
            <thead>
                <tr>
                    <th>ХК узла</th>
                    <th>Сборочная единица</th>
                    <th>Кол-во СЕ</th>
                    <th>Кол-во узлов</th>
                    <th>Кол-во агрегатов</th>
                    <th>Кол-во изделий</th>
                    <th>Норма ХК</th>
                    <th>Базовая норма</th>
                    <th>Расчётная норма, г</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Detail.Rows)
                {
                    <tr>
                        <td class="mono">@row.HKCardCode @row.HKCardVersion</td>
                        <td>@row.AssemblyUnitName</td>
                        <td>@row.AssemblyUnitQuantity</td>
                        <td>@row.NodeQuantity</td>
                        <td>@row.AggregateQuantity</td>
                        <td>@row.ProductQuantity</td>
                        <td class="mono">@FormatGram(row.SourceVolume)</td>
                        <td class="mono">@FormatGram(row.BaseVolume)</td>
                        <td class="mono">@FormatGram(row.CalculatedVolume)</td>
                    </tr>
                    @foreach (var material in row.Materials)
                    {
                        <tr class="hkc-material-row">
                            <td></td>
                            <td colspan="8">
                                <span class="tag @(material.Category == GsmCategory.Primary ? "ok" : "")">@CategoryName(material.Category)</span>
                                @material.MaterialName
                                @if (!string.IsNullOrWhiteSpace(material.Gost))
                                {
                                    <span class="hkc-gost">ГОСТ/ТУ: @material.Gost</span>
                                }
                                — <span class="mono">@FormatGram(material.CalculatedVolume) @material.UnitOfMeasure</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>

        @if (Detail.PrimaryTotals.Count > 0)
        {
            <h3 class="hkc-subtitle">Основные марки ГСМ (альтернативы, не суммируются)</h3>
            <table class="hk-items-table">
                <thead>
                    <tr>
                        <th>Марка ГСМ</th>
                        <th>ГОСТ/ТУ</th>
                        <th>Ед. изм.</th>
                        <th>Количество строк</th>
                        <th>Значение по марке</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var total in Detail.PrimaryTotals)
                    {
                        <tr>
                            <td>@total.MaterialName</td>
                            <td>@total.Gost</td>
                            <td>@total.UnitOfMeasure</td>
                            <td>@total.ItemCount</td>
                            <td class="mono">@FormatGram(total.TotalVolume) @total.UnitOfMeasure</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

<h3 class="hkc-subtitle">История версий</h3>
<div class="tableWrap" data-scroll="contained">
    <table class="hk-items-table">
        <thead>
            <tr>
                <th>Версия</th>
                <th>Статус</th>
                <th>Создана</th>
                <th>Сформирована</th>
                <th>Архив</th>
                <th>Автор</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var version in Detail.History)
            {
                <tr>
                    <td class="mono">@version.Version</td>
                    <td>@IndividualCardDisplay.Status(version.Status)</td>
                    <td>@version.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>@(version.FormedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@(version.ArchivedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td class="mono">@version.CreatedByUserId[..Math.Min(8, version.CreatedByUserId.Length)]…</td>
                    <td>
                        @if (version.Id != Detail.Id)
                        {
                            <button type="button" class="linkBtn" @onclick="() => OpenVersionCard(version.Id)">Открыть</button>
                        }
                        else
                        {
                            <span class="tag ok">текущая</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h3 class="hkc-subtitle">Журнал событий</h3>
<div class="tableWrap" data-scroll="contained">
    <table class="hk-items-table">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Действие</th>
                <th>Пользователь</th>
                <th>Детали</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Detail.Audit)
            {
                <tr>
                    <td>@entry.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@AuditDisplayCatalog.GetAction(entry.Action).Title</td>
                    <td>@(entry.UserDisplayName ?? "—")</td>
                    <td class="hkr-context">@(entry.Details ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h3 class="hkc-subtitle">Экспорт</h3>
<div class="formActions">
    <a class="btn" href="@PdfUrl" target="_blank" rel="noopener">PDF</a>
    <button type="button" class="btn" disabled>XLSX</button>
</div>

@code {
    [Parameter] public IndividualCardDetailDto Detail { get; set; } = null!;

    private string PdfUrl => $"/api/individualcards/{Detail.Id}/pdf";

    private void OpenVersionCard(Guid id) => Nav.NavigateTo($"/инд-карты/{id}");

    private static string FormatGram(decimal value) => value.ToString("F0", CultureInfo.InvariantCulture);

    private static string FormatCoefficient(decimal value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private static string CategoryName(GsmCategory category) => category switch
    {
        GsmCategory.Primary => "Основное",
        GsmCategory.Duplicate => "Дублирующее",
        GsmCategory.Reserve => "Резервное",
        GsmCategory.Foreign => "Зарубежное",
        _ => category.ToString(),
    };
}
