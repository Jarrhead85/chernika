@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using Chernika.Web.Services
@inject CoefficientService CoeffService
@inject CircuitDbLock DbLock
@implements IDisposable

@if (_show)
{
    <div class="modalOverlay" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="coeff-types-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="coeff-types-title">Типы коэффициентов</h3>
                <button type="button" class="modalCloseButton" @onclick="Close">×</button>
            </div>
            <div class="modalBody">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="note warn">@_error</div>
                }

                <div class="mbFilters">
                    <input class="fieldInput mbSearch" @bind="_search" @bind:event="oninput" @bind:after="LoadAsync" placeholder="Поиск по наименованию..." />
                    <select class="field-select" @bind="_statusFilter" @bind:after="LoadAsync">
                        <option value="@ReferenceStatusFilter.Active">Рабочие</option>
                        <option value="@ReferenceStatusFilter.Archived">Архивные</option>
                        <option value="@ReferenceStatusFilter.All">Все</option>
                    </select>
                </div>

                @if (_canCreate)
                {
                    <div class="mbAddRow">
                        <input class="fieldInput" @bind="_newName" placeholder="Наименование нового типа..." />
                        <input class="fieldInput" type="number" @bind="_newSortOrder" placeholder="Порядковый номер" />
                        <button class="btn primary" @onclick="CreateAsync">+ Добавить тип</button>
                    </div>
                }

                @if (_loading)
                {
                    <div class="loading-state">Загрузка...</div>
                }
                else if (!_types.Any())
                {
                    <div class="empty-state">Типы коэффициентов не найдены</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Наименование</th>
                                <th>Порядок</th>
                                <th>Коэффициентов</th>
                                <th>Статус</th>
                                @if (_canEdit)
                                {
                                    <th>Действия</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in _types)
                            {
                                <tr>
                                    <td>
                                        @if (_editingId == type.Id)
                                        {
                                            <input class="fieldInput" @bind="_editName" />
                                        }
                                        else
                                        {
                                            @type.Name
                                        }
                                    </td>
                                    <td>
                                        @if (_editingId == type.Id)
                                        {
                                            <input class="fieldInput" type="number" @bind="_editSortOrder" />
                                        }
                                        else
                                        {
                                            @type.SortOrder
                                        }
                                    </td>
                                    <td>@type.CoefficientCount</td>
                                    <td>
                                        <span class="tag @(type.IsDeleted ? "" : "ok")">@(type.IsDeleted ? "Архивный" : "Рабочий")</span>
                                    </td>
                                    @if (_canEdit)
                                    {
                                        <td>
                                            <div class="rowActions">
                                                @if (_editingId == type.Id)
                                                {
                                                    <button class="linkBtn" @onclick="SaveEditAsync">Сохранить</button>
                                                    <button class="linkBtn" @onclick="CancelEdit">Отмена</button>
                                                }
                                                else if (type.IsDeleted)
                                                {
                                                    <button class="linkBtn" @onclick="() => RestoreAsync(type.Id)">Восстановить</button>
                                                }
                                                else
                                                {
                                                    <button class="linkBtn" @onclick="() => StartEdit(type)">Изменить</button>
                                                    <button class="linkBtn" @onclick="() => ConfirmArchive(type)">Архивировать</button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modalFooter">
                <button class="btn ghost" @onclick="Close">Закрыть</button>
            </div>
        </div>
    </div>
}

@if (_showArchiveConfirm && _typePendingArchive is not null)
{
    <div class="modalOverlay" @onclick="CancelArchiveConfirm">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="archive-confirm-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="archive-confirm-title">Архивирование типа</h3>
                <button type="button" class="modalCloseButton" @onclick="CancelArchiveConfirm">×</button>
            </div>
            <div class="modalBody">
                <p>Архивировать тип «@_typePendingArchive.Name»?</p>
                <p class="hint">Тип перестанет быть доступен для выбора новых коэффициентов и будущих ИК.</p>
                @if (_typePendingArchive.CoefficientCount > 0)
                {
                    <p class="note warn">В типе есть @_typePendingArchive.CoefficientCount рабочих коэффициентов. Архивирование будет отклонено, пока они не будут архивированы или перенесены.</p>
                }
            </div>
            <div class="modalFooter">
                <button class="btn ghost" @onclick="CancelArchiveConfirm">Отмена</button>
                <button class="btn bad" @onclick="ExecuteArchiveAsync">Архивировать</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _show;
    private bool _loading;
    private ReferenceStatusFilter _statusFilter = ReferenceStatusFilter.Active;
    private bool _canCreate;
    private bool _canEdit;
    private string? _error;
    private string _search = "";
    private string _newName = "";
    private string _newSortOrder = "";
    private string _editName = "";
    private string _editSortOrder = "";
    private Guid? _editingId;
    private bool _showArchiveConfirm;
    private CoefficientTypeListItemDto? _typePendingArchive;
    private List<CoefficientTypeListItemDto> _types = new();

    [Parameter] public EventCallback<CoefficientTypeListItemDto> OnTypeCreated { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    [Inject] private AuthenticationStateProvider AuthState { get; set; } = null!;
    [Inject] private IPermissionService Perms { get; set; } = null!;

    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _canCreate = await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        _canEdit = _canCreate;
    }

    public async Task ShowAsync()
    {
        _show = true;
        await LoadAsync();
    }

    private void Close()
    {
        _show = false;
        _error = null;
        _editingId = null;
        _showArchiveConfirm = false;
        _typePendingArchive = null;
    }

    private async Task LoadAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        _loading = true;
        _error = null;
        try
        {
            await using (await DbLock.WaitAsync(ct))
            {
                if (ct.IsCancellationRequested) return;
                var query = new CoefficientTypeListQuery(
                    SearchText: string.IsNullOrWhiteSpace(_search) ? null : _search,
                    StatusFilter: _statusFilter);
                var result = await CoeffService.GetCoefficientTypesAsync(query, ct);
                if (ct.IsCancellationRequested) return;
                _types = result.Items.ToList();
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = GetSafeErrorMessage(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        _error = null;
        try
        {
            int? sortOrder = null;
            if (!string.IsNullOrWhiteSpace(_newSortOrder) && int.TryParse(_newSortOrder, out var so))
                sortOrder = so;

            var created = await CoeffService.CreateCoefficientTypeAsync(
                new CreateCoefficientTypeRequest(_newName, sortOrder));
            _newName = "";
            _newSortOrder = "";
            await LoadAsync();
            await OnTypeCreated.InvokeAsync(created);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = GetSafeErrorMessage(ex);
        }
    }

    private void StartEdit(CoefficientTypeListItemDto type)
    {
        _editingId = type.Id;
        _editName = type.Name;
        _editSortOrder = type.SortOrder.ToString();
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editName = "";
        _editSortOrder = "";
    }

    private async Task SaveEditAsync()
    {
        if (!_editingId.HasValue) return;
        _error = null;
        try
        {
            if (!int.TryParse(_editSortOrder, out var so))
            {
                _error = "Укажите корректный порядковый номер.";
                return;
            }
            await CoeffService.UpdateCoefficientTypeAsync(
                new UpdateCoefficientTypeRequest(_editingId.Value, _editName, so));
            _editingId = null;
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = GetSafeErrorMessage(ex);
        }
    }

    private void ConfirmArchive(CoefficientTypeListItemDto type)
    {
        _typePendingArchive = type;
        _showArchiveConfirm = true;
    }

    private void CancelArchiveConfirm()
    {
        _showArchiveConfirm = false;
        _typePendingArchive = null;
    }

    private async Task ExecuteArchiveAsync()
    {
        if (_typePendingArchive is null) return;
        var id = _typePendingArchive.Id;
        CancelArchiveConfirm();
        _error = null;
        try
        {
            await CoeffService.ArchiveCoefficientTypeAsync(id);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = GetSafeErrorMessage(ex);
        }
    }

    private async Task RestoreAsync(Guid id)
    {
        _error = null;
        try
        {
            await CoeffService.RestoreCoefficientTypeAsync(id);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = GetSafeErrorMessage(ex);
        }
    }

    private static string GetSafeErrorMessage(Exception ex) => ex switch
    {
        InvalidOperationException biz => biz.Message,
        UnauthorizedAccessException auth => "Недостаточно прав для выполнения действия.",
        _ => "Не удалось выполнить действие. Повторите попытку."
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
