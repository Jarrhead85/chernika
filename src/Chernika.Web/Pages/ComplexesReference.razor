@page "/справочник-комплексов"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Техника" Current="Комплексы" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование комплекса" : "Новый комплекс")</h2>
                <div class="hint">Общесистемный справочник</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Код комплекса</label><input @ref="_firstField" @bind="newEntity.Code" /></div>
                    <div class="field"><label>Наименование</label><input @bind="newEntity.Name" /></div>
                    <div class="field full-width"><label>Описание</label><input @bind="newEntity.Description" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveEntity">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список комплексов</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по коду, наименованию, описанию..." />
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="Code">Сортировка: код</option>
                    <option value="Name">Сортировка: наименование</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!entities.Any())
            {
                <div class="empty-state">Нет комплексов</div>
            }
            else
            {
                <div class="referenceTableWrap">
                    <table>
                        <thead>
                            <tr><th>Код</th><th>Наименование</th><th>Описание</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in entities)
                            {
                                var rowClickable = canEdit && !e.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(e)" @onkeydown="(ev) => OnRowKeyDown(ev, e)">
                                    <td class="mono">@e.Code</td>
                                    <td>@e.Name</td>
                                    <td>@e.Description</td>
                                    <td><span class="tag @(e.IsDeleted ? "bad" : "ok")">@(e.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (e.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreEntity(e.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditEntity(e)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteEntity(e.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @entities.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<Complex> entities = new();
    private Complex newEntity = new();
    private bool editing;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private int statusFilter = 0;
    private string sortBy = "Code";
    private bool sortDesc = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search) || statusFilter != 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    private async Task OnFiltersChanged()
    {
        currentPage = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        bool? showDeleted = statusFilter switch
        {
            1 => true,
            2 => null,
            _ => false
        };

        loading = true;
        try
        {
            var result = await EquipService.GetComplexesPagedAsync(new ComplexQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);

            if (ct.IsCancellationRequested)
                return;

            entities = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await ReloadAsync();
                return;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                loading = false;
        }
    }

    async Task SaveEntity()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newEntity.Name))
        {
            errorMessage = "Укажите наименование.";
            return;
        }

        try
        {
            if (editing)
            {
                var ok = await EquipService.UpdateComplexAsync(new UpdateComplexRequest(newEntity.Id, newEntity.Code, newEntity.Name, newEntity.Description));
                if (!ok) throw new InvalidOperationException("Не удалось изменить запись справочника. Обновите список и повторите попытку.");
            }
            else
            {
                await EquipService.CreateComplexAsync(new CreateComplexRequest(newEntity.Code, newEntity.Name, newEntity.Description));
            }
            ResetForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить запись справочника. Обновите список и повторите попытку."
                : "Не удалось создать запись справочника. Обновите список и повторите попытку.";
        }
    }

    Task EditEntity(Complex c)
    {
        newEntity = new Complex { Id = c.Id, Code = c.Code, Name = c.Name, Description = c.Description };
        editing = true;
        _focusForm = true;
        return Task.CompletedTask;
    }

    async Task OnRowDblClick(Complex c)
    {
        if (!canEdit || c.IsDeleted) return;
        await EditEntity(c);
    }

    async Task OnRowKeyDown(KeyboardEventArgs ev, Complex c)
    {
        if (!canEdit || c.IsDeleted || ev.Key != "Enter") return;
        await EditEntity(c);
    }

    async Task DeleteEntity(Guid id)
    {
        errorMessage = null;
        try
        {
            var (deleted, error) = await EquipService.DeleteComplexAsync(id);
            if (!deleted)
            {
                if (error != null)
                    errorMessage = error.Replace("\n", " ");
            }
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task RestoreEntity(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await EquipService.RestoreComplexAsync(id);
            if (!ok) errorMessage = "Не удалось восстановить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    void ResetForm()
    {
        newEntity = new Complex();
        editing = false;
        errorMessage = null;
    }

    async Task ToggleSortDir()
    {
        sortDesc = !sortDesc;
        await ReloadAsync();
    }

    async Task ResetFilters()
    {
        search = "";
        statusFilter = 0;
        sortBy = "Code";
        sortDesc = false;
        currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await ReloadAsync();
    }

    async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await ReloadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
