@page "/инд-карты"
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using System.Globalization
@using Chernika.Web.Services
@inject IndividualCardService IndCardService
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@inject NavigationManager Nav

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Индивидуальные карты</h2>
            <div class="hint">Формирование и история расчётных норм ГСМ</div>
            @if (_canCreateDraft)
            {
                <button type="button" class="btn primary" @onclick="GoToCreate">+ Создать черновик ИК</button>
            }
        </div>
        <div class="panelBody">
            <div class="hkr-filters">
                <input class="fieldInput hkr-search" placeholder="Поиск: код, версия, объект"
                       value="@_search" @oninput="OnSearchChanged" />

                <select class="fieldInput hkr-select" value="@_levelFilter" @onchange="OnLevelChanged">
                    <option value="">Все уровни</option>
                    @foreach (var (value, label) in LevelOptions)
                    {
                        <option value="@value">@label</option>
                    }
                </select>

                <select class="fieldInput hkr-select" value="@_statusFilter" @onchange="OnStatusChanged">
                    <option value="">Все статусы</option>
                    @foreach (var (value, label) in StatusOptions)
                    {
                        <option value="@value">@label</option>
                    }
                </select>

                @if (_isSystemAdmin)
                {
                    <select class="fieldInput hkr-select" value="@_branchFilter" @onchange="OnBranchChanged">
                        <option value="">Все филиалы</option>
                        @foreach (var branch in _branches)
                        {
                            <option value="@branch.Id">@branch.Name</option>
                        }
                    </select>
                }

                <input type="date" class="fieldInput hkr-date" value="@_createdFrom" @onchange="OnPeriodChanged" />
                <input type="date" class="fieldInput hkr-date" value="@_createdTo" @onchange="OnPeriodChanged" />

                <label class="hkr-check">
                    <input type="checkbox" checked="@_onlyMine" @onchange="OnOnlyMineChanged" /> Только мои
                </label>
                <label class="hkr-check">
                    <input type="checkbox" checked="@_onlyGaps" @onchange="OnOnlyGapsChanged" /> Только с нормативными пробелами
                </label>

                <select class="fieldInput hkr-select" value="@_sortBy" @onchange="OnSortChanged">
                    <option value="CreatedAt">По дате создания</option>
                    <option value="FormedAt">По дате формирования</option>
                    <option value="Code">По коду</option>
                    <option value="Object">По объекту</option>
                    <option value="Status">По статусу</option>
                </select>

                <label class="hkr-check">
                    <input type="checkbox" checked="@_sortDescending" @onchange="OnSortDirectionChanged" /> По убыванию
                </label>

                <button type="button" class="btn ghost" @onclick="ResetFilters">Сбросить</button>
            </div>

            @if (_loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (_page is null || _page.Items.Count == 0)
            {
                <div class="note">Индивидуальные карты не найдены.</div>
            }
            else
            {
                <div class="tableWrap" data-scroll="contained">
                    <table class="hk-items-table">
                        <thead>
                            <tr>
                                <th>Код / Версия</th>
                                <th>Цель ИК</th>
                                <th>Объект</th>
                                <th>Статус</th>
                                <th>Филиал</th>
                                <th>Создана</th>
                                <th>Сформирована</th>
                                <th>Источники ХК</th>
                                <th>Нормативная готовность</th>
                                <th>Автор</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var card in _page.Items)
                            {
                                <tr>
                                    <td class="mono">@card.Code<br /><span class="hkr-version">@card.Version</span></td>
                                    <td>@card.ObjectLevelDisplay</td>
                                    <td>
                                        <div>@(string.IsNullOrEmpty(card.ObjectCode) ? "—" : $"{card.ObjectCode} — {card.ObjectName}")</div>
                                        @if (!string.IsNullOrEmpty(card.ContextText))
                                        {
                                            <div class="hkr-context">@card.ContextText</div>
                                        }
                                    </td>
                                    <td><span class="tag @StatusTagClass(card.Status)">@StatusName(card.Status)</span></td>
                                    <td>@card.BranchName</td>
                                    <td>@card.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td>@(card.FormedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td>@card.HKSourceCount</td>
                                    <td>
                                        @if (card.HasNormativeGaps || card.CalculationProblemCount > 0)
                                        {
                                            var count = (card.HasNormativeGaps ? 1 : 0) + card.CalculationProblemCount;
                                            <span class="tag warn">Есть пробелы: @count</span>
                                        }
                                        else
                                        {
                                            <span class="tag ok">Готова</span>
                                        }
                                    </td>
                                    <td>@(card.AuthorName ?? "—")</td>
                                    <td class="hkr-actions">
                                        <button type="button" class="linkBtn" @onclick="() => OpenCard(card.Id)">Открыть</button>
                                        @if (card.Status == IndividualCardStatus.Draft && (card.CreatedByUserId == _currentUserId || _canEditDraft))
                                        {
                                            <button type="button" class="linkBtn" @onclick="() => BeginDeleteDraft(card)">Удалить</button>
                                        }
                                        @if (card.Status == IndividualCardStatus.Formed && _canCreateVersion)
                                        {
                                            <button type="button" class="linkBtn" @onclick="() => OpenCard(card.Id, openVersion: true)">Новая версия</button>
                                        }
                                        @if (card.Status == IndividualCardStatus.Formed && _canArchive)
                                        {
                                            <button type="button" class="linkBtn" @onclick="() => OpenCard(card.Id, openArchive: true)">В архив</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="hkr-pager">
                    <button type="button" class="btn ghost" disabled="@(_page!.Page <= 1)" @onclick="() => ChangePage(_page.Page - 1)">← Назад</button>
                    <span>Стр. @_page.Page из @Math.Max(1, _page.TotalPages) (@_page.TotalCount)</span>
                    <button type="button" class="btn ghost" disabled="@(_page.Page >= _page.TotalPages)" @onclick="() => ChangePage(_page.Page + 1)">Вперёд →</button>
                </div>
            }
        </div>
    </section>
</div>

@if (_deleteCandidate is not null)
{
    <div class="modalOverlay" @onclick="() => _deleteCandidate = null">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Удалить черновик ИК</h3>
                <button type="button" class="linkBtn" @onclick="() => _deleteCandidate = null">✕</button>
            </div>
            <div class="modalBody">
                <div>Удалить черновик «@_deleteCandidate.Code @_deleteCandidate.Version»?</div>
                <div class="hkv-muted">Черновик и все его снимки будут удалены безвозвратно.</div>
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="() => _deleteCandidate = null">Отмена</button>
                <button type="button" class="btn primary" disabled="@_deleting" @onclick="DeleteDraft">
                    @(_deleting ? "Удаление…" : "Удалить")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private PagedResult<IndividualCardRegistryItemDto>? _page;

    private string _search = string.Empty;
    private string _levelFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _branchFilter = string.Empty;
    private string _createdFrom = string.Empty;
    private string _createdTo = string.Empty;
    private bool _onlyMine;
    private bool _onlyGaps;
    private string _sortBy = "CreatedAt";
    private bool _sortDescending = true;
    private int _page_ = 1;

    private bool _isSystemAdmin;
    private bool _canCreateDraft;
    private bool _canCreateVersion;
    private bool _canArchive;
    private bool _canEditDraft;
    private string _currentUserId = string.Empty;
    private List<Branch> _branches = new();

    private IndividualCardRegistryItemDto? _deleteCandidate;
    private bool _deleting;

    private static readonly List<(string Value, string Label)> LevelOptions = new()
    {
        (((int)IndividualCardObjectLevel.Complex).ToString(), "Комплекс"),
        (((int)IndividualCardObjectLevel.EquipmentModel).ToString(), "Изделие"),
        (((int)IndividualCardObjectLevel.Aggregate).ToString(), "Агрегат"),
        (((int)IndividualCardObjectLevel.Node).ToString(), "Узел"),
        (((int)IndividualCardObjectLevel.EquipmentInstance).ToString(), "Экземпляр техники"),
    };

    private static readonly List<(string Value, string Label)> StatusOptions = new()
    {
        (((int)IndividualCardStatus.Draft).ToString(), "Черновик"),
        (((int)IndividualCardStatus.Formed).ToString(), "Сформирована"),
        (((int)IndividualCardStatus.Archived).ToString(), "Архив"),
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _currentUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _isSystemAdmin = auth.User.IsInRole("SystemAdmin");

        _canCreateDraft = await Perms.HasPermissionAsync(_currentUserId, PermissionCodes.IndividualCardCreateDraft);
        _canCreateVersion = await Perms.HasPermissionAsync(_currentUserId, PermissionCodes.IndividualCardCreateVersion);
        _canArchive = await Perms.HasPermissionAsync(_currentUserId, PermissionCodes.IndividualCardArchive);
        _canEditDraft = await Perms.HasPermissionAsync(_currentUserId, PermissionCodes.IndividualCardEditDraft);

        await using (await DbLock.WaitAsync())
        {
            if (_isSystemAdmin)
            {
                var branches = await EquipService.GetBranchesPagedAsync(new BranchQuery { Page = 1, PageSize = 200 });
                _branches = branches.Items.ToList();
            }
            await LoadPageAsync();
        }
        _loading = false;
    }

    private async Task LoadPageAsync()
    {
        _error = null;
        try
        {
            _page = await IndCardService.GetRegistryAsync(new IndividualCardRegistryQuery(
                string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                int.TryParse(_levelFilter, out var level) ? (IndividualCardObjectLevel)level : null,
                int.TryParse(_statusFilter, out var status) ? (IndividualCardStatus)status : null,
                Guid.TryParse(_branchFilter, out var branchId) ? branchId : null,
                DateTime.TryParse(_createdFrom, out var from) ? from.ToUniversalTime() : null,
                DateTime.TryParse(_createdTo, out var to) ? to.ToUniversalTime().AddDays(1) : null,
                _onlyMine,
                _onlyGaps,
                _sortBy,
                _sortDescending,
                _page_,
                50));
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
            _page = null;
        }
    }

    private async Task ReloadFromFirstPage()
    {
        _page_ = 1;
        await using (await DbLock.WaitAsync())
        {
            await LoadPageAsync();
        }
        StateHasChanged();
    }

    private async Task OnSearchChanged(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        await ReloadFromFirstPage();
    }

    private Task OnLevelChanged(ChangeEventArgs args) { _levelFilter = args.Value?.ToString() ?? string.Empty; return ReloadFromFirstPage(); }
    private Task OnStatusChanged(ChangeEventArgs args) { _statusFilter = args.Value?.ToString() ?? string.Empty; return ReloadFromFirstPage(); }
    private Task OnBranchChanged(ChangeEventArgs args) { _branchFilter = args.Value?.ToString() ?? string.Empty; return ReloadFromFirstPage(); }
    private Task OnPeriodChanged(ChangeEventArgs args) => ReloadFromFirstPage();
    private Task OnOnlyMineChanged(ChangeEventArgs args) { _onlyMine = args.Value is true; return ReloadFromFirstPage(); }
    private Task OnOnlyGapsChanged(ChangeEventArgs args) { _onlyGaps = args.Value is true; return ReloadFromFirstPage(); }
    private Task OnSortChanged(ChangeEventArgs args) { _sortBy = args.Value?.ToString() ?? "CreatedAt"; return ReloadFromFirstPage(); }
    private Task OnSortDirectionChanged(ChangeEventArgs args) { _sortDescending = args.Value is true; return ReloadFromFirstPage(); }

    private async Task ResetFilters()
    {
        _search = string.Empty;
        _levelFilter = _statusFilter = _branchFilter = string.Empty;
        _createdFrom = _createdTo = string.Empty;
        _onlyMine = _onlyGaps = false;
        _sortBy = "CreatedAt";
        _sortDescending = true;
        await ReloadFromFirstPage();
    }

    private async Task ChangePage(int page)
    {
        _page_ = page;
        await using (await DbLock.WaitAsync())
        {
            await LoadPageAsync();
        }
        StateHasChanged();
    }

    private void GoToCreate() => Nav.NavigateTo("/инд-карты/создать");

    private void OpenCard(Guid id, bool openVersion = false, bool openArchive = false)
    {
        var query = openVersion ? "?action=version" : openArchive ? "?action=archive" : string.Empty;
        Nav.NavigateTo($"/инд-карты/{id}{query}");
    }

    private void BeginDeleteDraft(IndividualCardRegistryItemDto card) => _deleteCandidate = card;

    private async Task DeleteDraft()
    {
        if (_deleteCandidate is null) return;
        _deleting = true;
        _error = null;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                await IndCardService.DeleteDraftAsync(_deleteCandidate.Id);
            }
            _deleteCandidate = null;
            await using (await DbLock.WaitAsync())
            {
                await LoadPageAsync();
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string StatusName(IndividualCardStatus status) => status switch
    {
        IndividualCardStatus.Draft => "Черновик",
        IndividualCardStatus.Formed => "Сформирована",
        IndividualCardStatus.Archived => "Архив",
        _ => status.ToString(),
    };

    private static string StatusTagClass(IndividualCardStatus status) => status switch
    {
        IndividualCardStatus.Draft => "",
        IndividualCardStatus.Formed => "ok",
        IndividualCardStatus.Archived => "",
        _ => "",
    };
}
