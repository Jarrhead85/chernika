@page "/состав-изделия"
@attribute [Authorize(Policy = "ViewHK")]
@inject EquipmentService EquipService
@inject HKCardService HKCardService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Состав изделия</h2>
            <div class="hint">Изделие → состав → количество</div>
        </div>
        <div class="panelBody">
            <div class="form">
                <div class="field"><label>Модель техники</label>
                    <select @bind="selectedModelId" class="field-select">
                        <option value="">— Выберите модель —</option>
                        @foreach (var m in models)
                        {
                            <option value="@m.Id">@m.Index — @m.Name</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Модификация</label><input @bind="modification" /></div>
                <div class="field"><label>Экземпляр (зав. №)</label><input @bind="serialNumber" /></div>
                <div class="field"><label>Комментарий</label><input @bind="comment" /></div>
                <div class="formActions">
                    <button class="btn" @onclick="LoadCompositions">Обновить список</button>
                    @if (canEdit) { <button class="btn primary" @onclick="CreateComposition">Создать состав</button> }
                </div>
            </div>
        </div>
    </section>

    <div class="grid">
        <div class="stack">
            <section class="panel">
                <div class="panelHeader">
                    <h2>Список составов</h2>
                    <div class="hint">@compositions.Count записей</div>
                </div>
                <div class="panelBody">
                    @if (loading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (!compositions.Any())
                    {
                        <div class="empty-state">Нет составов изделий</div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Модель</th>
                                    <th>Изделий</th>
                                    <th>Покрыто ХК</th>
                                    <th>Дата</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in compositions)
                                {
                                    var allNodes = comp.Parts.SelectMany(p => p.Nodes).ToList();
                                    var covered = allNodes.Count(n => n.Node?.HKCards?.Any(h => h.Status == HKCardStatus.Approved) == true);
                                    <tr @onclick="() => SelectComposition(comp.Id)" style="cursor:pointer">
                                        <td>@comp.EquipmentModel?.Name<br /><span class="mono">@comp.EquipmentModel?.Index</span></td>
                                        <td>@allNodes.Count</td>
                                        <td><span class="tag @(covered == allNodes.Count ? "ok" : "warn")">@covered / @allNodes.Count</span></td>
                                        <td class="mono">@comp.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <div class="rowActions">
                                                <button class="linkBtn" @onclick="() => SelectComposition(comp.Id)">Открыть</button>
                                                @if (canEdit) { <button class="linkBtn" @onclick="() => DeleteComposition(comp.Id)">Удалить</button> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            @if (selectedComposition != null)
            {
                <section class="panel">
                    <div class="panelHeader">
                        <h2>Состав изделия</h2>
                        <div class="hint">@selectedComposition.Parts.SelectMany(p => p.Nodes).Count() изделий</div>
                    </div>
                    <div class="panelBody">
                        <div class="form" style="margin-bottom:12px">
                            <div class="field"><label>Составная часть</label>
                                <select @bind="selectedPartId" class="field-select">
                                    <option value="">— Выберите часть —</option>
                                    @foreach (var p in selectedComposition.Parts.OrderBy(p => p.SortOrder))
                                    {
                                        <option value="@p.Id">@p.SortOrder. @p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Новая часть</label><input @bind="newPartName" placeholder="Напр. Силовая установка" /></div>
                            <div class="field"><label>Порядок</label><input type="number" @bind="newPartSortOrder" class="field-input" /></div>
                            <div class="field" style="display:flex;align-items:flex-end">
                                @if (canEdit) { <button class="btn" @onclick="AddPart">+ Добавить часть</button> }
                            </div>
                        </div>

                        <div class="form" style="margin-bottom:12px">
                            <div class="field"><label>Изделие</label>
                                <select @bind="newNodeNodeId" class="field-select">
                                    <option value="">— Выберите изделие —</option>
                                    @foreach (var n in nodes)
                                    {
                                        <option value="@n.Id">@n.Code — @n.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Количество</label><input type="number" @bind="newNodeQty" min="1" class="field-input" /></div>
                            <div class="field" style="display:flex;align-items:flex-end">
                                @if (canEdit) { <button class="btn primary" @onclick="AddNode" disabled="@(selectedPartId == Guid.Empty)">+ Добавить изделие</button> }
                            </div>
                        </div>
                        <div class="listRows">
                            @foreach (var part in selectedComposition.Parts.OrderBy(p => p.SortOrder))
                            {
                                <div style="margin-bottom:10px">
                                    <div class="hint" style="margin:6px 0;font-weight:700">@part.Name</div>
                                    @foreach (var node in part.Nodes.OrderBy(n => n.Node.Code))
                                    {
                                        var hk = node.Node?.HKCards?
                                            .Where(h => h.Status == HKCardStatus.Approved)
                                            .OrderByDescending(h => h.ApprovedDate ?? h.CreatedAt)
                                            .FirstOrDefault();
                                        <div class="rowCard" @onclick="() => SelectNode(node)" style="cursor:pointer">
                                            <div class="top">
                                                <div>
                                                    <div class="name">@node.Node?.Name</div>
                                                    <div class="sub">@node.Node?.Code • ХК: @(hk?.Code ?? "не привязана")</div>
                                                </div>
                                                <div class="qty">@node.Quantity</div>
                                            </div>
                                            <div class="chips">
                                                <span class="tag @(hk != null ? "ok" : "bad")">@(hk != null ? "Покрыто" : "Нет покрытия")</span>
                                                @if (hk != null)
                                                {
                                                    <span class="pill">@hk.Version</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>

        <aside class="stack">
            <section class="panel">
                <div class="panelHeader"><h2>Привязка изделия</h2><div class="hint">Правый редактор</div></div>
                <div class="panelBody">
                    @if (selectedNode == null)
                    {
                        <div class="empty-state">Выберите изделие из списка</div>
                    }
                    else
                    {
                        <div class="form" style="grid-template-columns:1fr">
                            <div class="field"><label>Изделие</label><input value="@selectedNode.Node?.Name" readonly style="opacity:.7" /></div>
                            <div class="field"><label>Количество</label><input type="number" @bind="selectedNode.Quantity" min="1" class="field-input" /></div>
                            @{
                                var hk = selectedNode.Node?.HKCards?
                                    .Where(h => h.Status == HKCardStatus.Approved)
                                    .OrderByDescending(h => h.ApprovedDate ?? h.CreatedAt)
                                    .FirstOrDefault();
                            }
                            <div class="field"><label>Актуальная ХК по изделию</label>
                                <input value="@(hk != null ? $"{hk.Code} • {hk.Version}" : "— Нет утвержденной ХК —")" readonly style="opacity:.8" />
                            </div>
                            <div class="field"><label>Статус покрытия</label>
                                <span class="tag @(hk != null ? "ok" : "bad")">@(hk != null ? "Покрыто" : "Нет утвержденной ХК")</span>
                            </div>
                            <div class="formActions" style="grid-column:auto;justify-content:stretch;flex-direction:column">
                                @if (canEdit) { <button class="btn primary" @onclick="SaveNode">Сохранить привязку</button> }
                                @if (canEdit) { <button class="btn" @onclick="CreateHKForNode">Создать ХК</button> }
                                @if (canEdit) { <button class="btn ghost" @onclick="() => RemoveNode(selectedNode.Id)">Удалить изделие</button> }
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <div class="panelHeader"><h2>Сводка по изделию</h2><div class="hint">Готовность</div></div>
                <div class="panelBody">
                    @if (selectedComposition == null)
                    {
                        <div class="empty-state">Выберите состав</div>
                    }
                    else
                    {
                        var allNodes = selectedComposition.Parts.SelectMany(p => p.Nodes).ToList();
                        var total = allNodes.Count;
                        var covered = allNodes.Count(n => n.Node?.HKCards?.Any(h => h.Status == HKCardStatus.Approved) == true);
                        var dupes = allNodes.Count(n => n.Quantity > 1);
                        var readiness = total == 0 ? "—" : covered == total ? "Полная" : covered > 0 ? "Частичная" : "Нет";
                        <div class="metrics2">
                            <div class="metric"><div class="label">Изделий в составе</div><div class="value">@total</div></div>
                            <div class="metric"><div class="label">ХК привязано</div><div class="value">@covered / @total</div></div>
                            <div class="metric"><div class="label">Повторяющихся</div><div class="value">@dupes</div></div>
                            <div class="metric"><div class="label">Готовность</div><div class="value">@readiness</div></div>
                        </div>
                        <div class="note" style="margin-top:12px">
                            @(covered == total && total > 0 ? "Все изделия покрыты ХК. Можно формировать индивидуальные карты." : "До завершения расчёта необходимо закрыть изделия без актуальных ХК.")
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@code {
    private List<EquipmentModel> models = new();
    private List<Node> nodes = new();
    private List<ProductComposition> compositions = new();
    private ProductComposition? selectedComposition;
    private ProductCompositionNode? selectedNode;
    private bool loading = true;
    private bool canEdit;

    private Guid selectedModelId;
    private string modification = "";
    private string serialNumber = "";
    private string comment = "";
    private Guid selectedPartId;
    private string newPartName = "Основная часть";
    private int newPartSortOrder = 1;
    private Guid newNodeNodeId;
    private int newNodeQty = 1;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        canEdit = authState.User.IsInRole("NormAdmin");
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        models = await EquipService.GetModelsAsync();
        nodes = await EquipService.GetNodesAsync();
        await LoadCompositions();
    }

    async Task LoadCompositions()
    {
        compositions = await EquipService.GetCompositionsAsync();
        loading = false;
    }

    async Task CreateComposition()
    {
        if (selectedModelId == Guid.Empty) return;
        var comp = new ProductComposition
        {
            EquipmentModelId = selectedModelId,
            Comment = comment
        };
        await EquipService.CreateCompositionAsync(comp);
        await LoadCompositions();
        SelectComposition(comp.Id);
    }

    void SelectComposition(Guid id)
    {
        selectedComposition = compositions.FirstOrDefault(c => c.Id == id);
        selectedNode = null;
        selectedPartId = selectedComposition?.Parts.OrderBy(p => p.SortOrder).FirstOrDefault()?.Id ?? Guid.Empty;
    }

    async Task AddPart()
    {
        if (!canEdit || selectedComposition == null) return;
        if (string.IsNullOrWhiteSpace(newPartName)) return;
        await EquipService.AddPartAsync(selectedComposition.Id, newPartName.Trim(), newPartSortOrder);
        await LoadCompositions();
        SelectComposition(selectedComposition.Id);
    }

    async Task AddNode()
    {
        if (selectedComposition == null || newNodeNodeId == Guid.Empty) return;
        if (selectedPartId == Guid.Empty) return;
        var node = await EquipService.AddNodeAsync(selectedPartId, newNodeNodeId, newNodeQty);
        var part = selectedComposition.Parts.FirstOrDefault(p => p.Id == selectedPartId);
        part?.Nodes.Add(node);
        newNodeNodeId = Guid.Empty;
        newNodeQty = 1;
    }

    void SelectNode(ProductCompositionNode node) => selectedNode = node;

    async Task SaveNode()
    {
        if (selectedNode == null || !canEdit) return;
        await EquipService.UpdateNodeAsync(selectedNode);
        await LoadCompositions();
        SelectComposition(selectedComposition!.Id);
    }

    async Task RemoveNode(Guid nodeId)
    {
        await EquipService.RemoveNodeAsync(nodeId);
        if (selectedComposition != null)
        {
            foreach (var part in selectedComposition.Parts)
            {
                var node = part.Nodes.FirstOrDefault(n => n.Id == nodeId);
                if (node != null) { part.Nodes.Remove(node); break; }
            }
        }
        selectedNode = null;
    }

    void CreateHKForNode()
    {
        if (selectedNode != null)
            Nav.NavigateTo($"/хк/создать?nodeId={selectedNode.NodeId}");
    }

    async Task DeleteComposition(Guid id)
    {
        await EquipService.DeleteCompositionAsync(id);
        compositions.RemoveAll(c => c.Id == id);
        if (selectedComposition?.Id == id) { selectedComposition = null; selectedNode = null; }
    }
}
