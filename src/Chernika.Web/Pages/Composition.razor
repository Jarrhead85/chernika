@page "/состав-изделия"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Web.Components
@using Chernika.Web.Services
@inject EquipmentService EquipService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Конструктивный состав изделия</h2>
            <div class="hint">Изделие → составные части → узлы → количество</div>
        </div>
        <div class="panelBody">
            <div class="form">
                <div class="field"><label>Модель техники</label>
                    <select @bind="selectedModelId" class="field-select">
                        <option value="">— Выберите модель —</option>
                        @foreach (var m in models)
                        {
                            <option value="@m.Id">@m.Index — @m.Name</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Комментарий</label><input @bind="comment" /></div>
                <div class="formActions">
                    <button class="btn" @onclick="LoadCompositions">Обновить список</button>
                    @if (canCreate) { <button class="btn primary" @onclick="CreateComposition">Создать черновик</button> }
                </div>
            </div>
        </div>
    </section>

    <div class="grid">
        <div class="stack">
            <section class="panel">
                <div class="panelHeader">
                    <h2>Реестр составов</h2>
                    <div class="hint">@compositions.Count записей</div>
                </div>
                <div class="panelBody">
                    @if (loading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (!compositions.Any())
                    {
                        <div class="empty-state">Нет конструктивных составов. Выберите модель и нажмите «Создать черновик».</div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Версия</th>
                                    <th>Статус</th>
                                    <th>Дата создания</th>
                                    <th>Период действия</th>
                                    <th>Узлов</th>
                                    <th>Покрытие ХК</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in compositions)
                                {
                                    <tr class="compositionRow--clickable" @onclick="() => SelectCompositionAsync(comp.Id)">
                                        <td class="mono">@comp.Version</td>
                                        <td><CompositionStatusBadge Status="@comp.Status" /></td>
                                        <td class="mono">@comp.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td class="mono">@FormatPeriod(comp.EffectiveDate, comp.ExpirationDate)</td>
                                        <td>@(comp.AggregateCount ?? 0)</td>
                                        <td><span class="tag @((comp.CoveredCount ?? 0) == (comp.AggregateCount ?? 0) && (comp.AggregateCount ?? 0) > 0 ? "ok" : "warn")">@(comp.CoveredCount ?? 0) / @(comp.AggregateCount ?? 0)</span></td>
                                        <td>
                                            <div class="rowActions">
                                                <button class="linkBtn" @onclick="() => SelectCompositionAsync(comp.Id)">Открыть</button>
                                                @if (CanEditComposition(comp.Status))
                                                {
                                                    <button class="linkBtn" @onclick="() => DeleteComposition(comp.Id)">Удалить</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            @if (selectedComposition != null)
            {
                <section class="panel compositionSelectedPanel">
                    <div class="panelHeader compositionHeader">
                        <div>
                            <div class="compositionType">Состав изделия</div>
                            <h2>@selectedComposition.EquipmentModel?.Index · @selectedComposition.EquipmentModel?.Name</h2>
                            <div class="compositionVersionLine">
                                <span class="mono">Версия @selectedComposition.Version</span>
                                <CompositionStatusBadge Status="@selectedComposition.Status" />
                            </div>
                        </div>
                        <div class="compositionHeaderActions">
                            @if (selectedComposition.Status == ProductCompositionStatus.Draft)
                            {
                                @if (canSubmit)
                                {
                                    <button class="btn primary" @onclick="SubmitForReview">Отправить на согласование</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.OnReview)
                            {
                                @if (canApprove)
                                {
                                    <button class="btn primary" @onclick="ApproveComposition">Утвердить</button>
                                }
                                @if (canReturn)
                                {
                                    <button class="btn" @onclick="ReturnToDraft">Вернуть на доработку</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.Approved)
                            {
                                @if (canApprove)
                                {
                                    <button class="btn" @onclick="ArchiveComposition">Архивировать</button>
                                }
                                @if (canCreateVersion)
                                {
                                    <button class="btn primary" @onclick="CreateNewVersion">Создать новую версию</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.Archived && canCreateVersion)
                            {
                                <button class="btn primary" @onclick="CreateNewVersion">Создать новую версию</button>
                            }
                            <a class="btn ghost" href="/составы/изделия/@selectedComposition.EquipmentModelId/версии/@selectedComposition.Id">Открыть версию →</a>
                        </div>
                    </div>
                    <div class="panelBody">
                        @if (selectedComposition.Status != ProductCompositionStatus.Draft || !canEditDraft)
                        {
                            <div class="compositionReadOnlyBanner @ReadOnlyBannerClass">
                                @ReadOnlyBannerText
                            </div>
                        }
                        @if (selectedComposition.Status == ProductCompositionStatus.OnReview)
                        {
                            <div class="field compositionReviewComment">
                                <label>Комментарий к решению</label>
                                <input @bind="reviewComment" class="field-input" placeholder="Необязательно" />
                            </div>
                        }

                        @if (CanEditSelectedDraft)
                        {
                            <div class="form compositionFormRow">
                                <div class="field full-width"><label>Комментарий</label><input @bind="editComment" /></div>
                                <div class="field"><label>Дата начала действия</label><input type="date" @bind="editEffectiveDate" @bind:format="yyyy-MM-dd" class="field-input" /></div>
                                <div class="field"><label>Дата окончания</label><input type="date" @bind="editExpirationDate" @bind:format="yyyy-MM-dd" class="field-input" /></div>
                                <div class="formActions">
                                    <button class="btn primary" @onclick="SaveCompositionDraft">Сохранить</button>
                                </div>
                            </div>

                            <div class="form compositionFormRow compositionAddPartRow">
                                <div class="field"><label>Новая часть</label><input @bind="inlinePartName" placeholder="Напр. Силовая установка" class="field-input" /></div>
                                <div class="field compositionFormAction">
                                    <button class="btn" @onclick="AddPart">+ Добавить часть</button>
                                </div>
                            </div>
                        }

                        <div class="form compositionFilterForm">
                            <div class="field compositionFilterInput"><label>Фильтр агрегатов</label><input @bind="nodeFilter" placeholder="Поиск по коду или наименованию..." class="field-input" /></div>
                        </div>

                        @if (CanEditSelectedDraft || selectedComposition.UngroupedAggregates.Any())
                        {
                            <div class="compositionPartPanel">
                                <div class="compositionPartHeader">
                                    <span>Без группы</span>
                                    <span class="hint">@selectedComposition.UngroupedAggregates.Count агрегатов</span>
                                </div>
                                @RenderAggregateTable(selectedComposition.UngroupedAggregates)
                                @if (CanEditSelectedDraft)
                                {
                                    @RenderInlineAddAggregate(null)
                                }
                            </div>
                        }

                        @foreach (var part in selectedComposition.Parts.OrderBy(p => p.SortOrder))
                        {
                            <div class="compositionPartPanel">
                                <div class="compositionPartHeader">
                                    @if (editingPartId == part.Id)
                                    {
                                        <div class="field"><input @bind="editingPartName" class="field-input" /></div>
                                        <div class="rowActions">
                                            <button class="linkBtn" @onclick="() => SavePartName(part.Id)">Сохранить</button>
                                            <button class="linkBtn" @onclick="CancelEditPart">Отмена</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>@part.Name</span>
                                        <div class="compositionPartMeta">
                                            <span class="hint">@part.Aggregates.Count агрегатов</span>
                                            @if (CanEditSelectedDraft)
                                            {
                                                <button class="linkBtn" @onclick="() => StartEditPart(part)">Переименовать</button>
                                                <button class="linkBtn compositionPartDelete" @onclick="() => PromptDeletePart(part.Id)">Удалить часть</button>
                                            }
                                        </div>
                                    }
                                </div>
                                @RenderAggregateTable(part.Aggregates)
                                @if (CanEditSelectedDraft)
                                {
                                    @RenderInlineAddAggregate(part.Id)
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="stack compositionSidebar">
            <section class="panel">
                <div class="panelHeader"><h2>Сводка</h2><div class="hint">Детали версии</div></div>
                <div class="panelBody">
                    @if (selectedComposition == null)
                    {
                        <div class="empty-state">Выберите состав</div>
                    }
                    else
                    {
                        <div class="field"><label>Статус</label><CompositionStatusBadge Status="@selectedComposition.Status" /></div>
                        <div class="field"><label>Версия</label><div class="mono">@selectedComposition.Version</div></div>
                        <div class="field"><label>Автор</label><div>@(selectedComposition.AuthorName ?? "—")</div></div>
                        <div class="field"><label>Создан</label><div class="mono">@selectedComposition.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        <div class="field"><label>Обновлён</label><div class="mono">@selectedComposition.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        @if (selectedComposition.ApprovedAt.HasValue)
                        {
                            <div class="field"><label>Утверждён</label><div class="mono">@selectedComposition.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</div></div>
                        }
                        @if (selectedComposition.EffectiveDate.HasValue)
                        {
                            <div class="field"><label>Действует с</label><div class="mono">@selectedComposition.EffectiveDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (selectedComposition.ExpirationDate.HasValue)
                        {
                            <div class="field"><label>Действует до</label><div class="mono">@selectedComposition.ExpirationDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (!string.IsNullOrEmpty(selectedComposition.Comment))
                        {
                            <div class="field"><label>Комментарий</label><div>@selectedComposition.Comment</div></div>
                        }
                        <div class="compositionSidebarActions">
                            <a class="btn ghost" href="/журнал-аудита?entity=ProductComposition&id=@(selectedComposition.Id)">Журнал аудита →</a>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@if (replacingAggregateId.HasValue)
{
    <div class="modalOverlay" @onclick="CancelReplaceAggregate">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Замена агрегата</h3>
                <button type="button" class="linkBtn" @onclick="CancelReplaceAggregate">✕</button>
            </div>
            <div class="modalBody">
                <div class="field"><label>Новый агрегат</label>
                    <select @bind="replaceWithAggregateId" class="field-select">
                        <option value="">— Выберите агрегат —</option>
                        @foreach (var a in aggregates.OrderBy(a => a.Code))
                        {
                            <option value="@a.Id">@a.Code — @a.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="CancelReplaceAggregate">Отмена</button>
                <button type="button" class="btn primary" disabled="@(replaceWithAggregateId == Guid.Empty)" @onclick="ConfirmReplaceAggregate">Заменить</button>
            </div>
    </div>
</div>
}

@if (deletingPartId.HasValue)
{
    <div class="modalOverlay" @onclick="CancelDeletePart">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Удаление составной части</h3>
                <button type="button" class="linkBtn" @onclick="CancelDeletePart">✕</button>
            </div>
            <div class="modalBody">
                @{
                    var partToDelete = selectedComposition?.Parts.FirstOrDefault(p => p.Id == deletingPartId);
                }
                <p>Удалить часть «@(partToDelete?.Name ?? "—")»?</p>
                @if (partToDelete != null)
                {
                    <p class="hint">Агрегатов в части: @partToDelete.Aggregates.Count. Они будут сохранены и перенесены в раздел «Без группы».</p>
                }
                @if (!string.IsNullOrEmpty(deletePartError))
                {
                    <div class="note warn">@deletePartError</div>
                }
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="CancelDeletePart">Отмена</button>
                <button type="button" class="btn danger" @onclick="ConfirmDeletePart">Удалить</button>
            </div>
        </div>
    </div>
}

@code {
    private List<EquipmentModel> models = new();
    private List<Aggregate> aggregates = new();
    private List<CompositionVersionSummary> compositions = new();
    private ProductCompositionReadModel? selectedComposition;
    private bool loading = true;
    private bool canCreate;
    private bool canEditDraft;
    private bool canSubmit;
    private bool canApprove;
    private bool canReturn;
    private bool canCreateVersion;
    private bool CanEditSelectedDraft => selectedComposition?.Status == ProductCompositionStatus.Draft && canEditDraft;
    private bool ShowRowActions => CanEditSelectedDraft;
    private CancellationTokenSource? _loadCts;

    private Guid selectedModelId;
    private string comment = "";

    private string editComment = "";
    private DateTime? editEffectiveDate;
    private DateTime? editExpirationDate;
    private string reviewComment = "";

    private string inlinePartName = "";

    private Guid? editingPartId;
    private string editingPartName = "";

    private bool _isInlineAddOpen;
    private Guid? _inlineAddForPartId;
    private Guid inlineAddAggregateId;
    private int inlineAddQty = 1;
    private string? inlineAddError;

    private Guid? editingAggregateId;
    private int editAggregateQty;

    private Guid? movingAggregateId;
    private Guid? moveTargetPartId;
    private string? moveError;

    private string nodeFilter = "";
    private Guid? replacingAggregateId;
    private Guid replaceWithAggregateId = Guid.Empty;
    private Guid? deletingPartId;
    private string? deletePartError;
    private string? error;

    private bool IsInlineAddOpenFor(Guid? partId) => _isInlineAddOpen && _inlineAddForPartId == partId;

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;
    private DateTime _now => TimeProvider.GetUtcNow().UtcDateTime;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canCreate = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreate);
        canEditDraft = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelEditDraft);
        canSubmit = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelSubmit);
        canApprove = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelApprove);
        canReturn = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelReturnForRevision);
        canCreateVersion = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreateVersion);
        _loadCts = new CancellationTokenSource();
        await LoadData();
    }

    private async Task LoadData()
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            loading = true;
            models = await EquipService.GetModelsAsync();
            aggregates = await EquipService.GetAggregatesAsync();
            await LoadCompositions();
        }
    }

    async Task LoadCompositions()
    {
        var ct = _loadCts?.Token ?? default;
        compositions = (await EquipService.GetProductCompositionSummariesAsync(selectedModelId != Guid.Empty ? selectedModelId : null, ct)).ToList();
        loading = false;
    }

    async Task CreateComposition()
    {
        if (selectedModelId == Guid.Empty) return;
        var comp = await EquipService.CreateCompositionDraftAsync(
            new CreateCompositionRequest(selectedModelId, string.IsNullOrWhiteSpace(comment) ? null : comment));
        await LoadCompositions();
        await SelectCompositionAsync(comp.Id);
    }

    async Task SelectCompositionAsync(Guid id)
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            selectedComposition = await EquipService.GetProductCompositionDetailAsync(id, ct);
        }

        if (selectedComposition != null)
        {
            editComment = selectedComposition.Comment ?? "";
            editEffectiveDate = selectedComposition.EffectiveDate;
            editExpirationDate = selectedComposition.ExpirationDate;
            editingAggregateId = null;
            movingAggregateId = null;
            moveTargetPartId = null;
            moveError = null;
            _isInlineAddOpen = false;
            _inlineAddForPartId = null;
            inlineAddError = null;
            editingPartId = null;
            deletePartError = null;
            error = null;
        }
    }

    async Task SaveCompositionDraft()
    {
        if (!CanEditSelectedDraft) return;

        await EquipService.UpdateCompositionDraftAsync(
            new UpdateCompositionDraftRequest(selectedComposition!.Id,
                string.IsNullOrWhiteSpace(editComment) ? null : editComment,
                editEffectiveDate?.ToUniversalTime(),
                editExpirationDate?.ToUniversalTime()));
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task SubmitForReview()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.Draft || !canSubmit) return;
        await EquipService.SubmitForReviewAsync(selectedComposition.Id);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task ApproveComposition()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.OnReview || !canApprove) return;
        await EquipService.ApproveCompositionAsync(selectedComposition.Id,
            string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task ReturnToDraft()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.OnReview || !canReturn) return;
        await EquipService.ReturnToDraftAsync(selectedComposition.Id,
            string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task ArchiveComposition()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.Approved || !canApprove) return;
        await EquipService.ArchiveCompositionAsync(selectedComposition.Id);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task AddPart()
    {
        if (!CanEditSelectedDraft || string.IsNullOrWhiteSpace(inlinePartName)) return;
        var nextOrder = selectedComposition!.Parts.Any()
            ? selectedComposition.Parts.Max(p => p.SortOrder) + 1
            : 1;
        await EquipService.AddPartAsync(new AddPartRequest(selectedComposition.Id, inlinePartName.Trim(), null, nextOrder));
        inlinePartName = "";
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task RemovePart(Guid partId)
    {
        if (!CanEditSelectedDraft) return;
        await EquipService.RemovePartAsync(partId);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition!.Id);
    }

    void ShowInlineAddForm(Guid? partId)
    {
        _isInlineAddOpen = true;
        _inlineAddForPartId = partId;
        inlineAddAggregateId = Guid.Empty;
        inlineAddQty = 1;
        inlineAddError = null;
    }

    void CancelInlineAdd()
    {
        _isInlineAddOpen = false;
        _inlineAddForPartId = null;
        inlineAddError = null;
    }

    async Task AddAggregateToPart(Guid? partId)
    {
        if (!CanEditSelectedDraft || inlineAddAggregateId == Guid.Empty) return;
        try
        {
            await EquipService.AddAggregateAsync(new AddProductCompositionAggregateRequest(
                selectedComposition!.Id, partId, inlineAddAggregateId, inlineAddQty));
            _isInlineAddOpen = false;
            _inlineAddForPartId = null;
            inlineAddAggregateId = Guid.Empty;
            inlineAddQty = 1;
            inlineAddError = null;
            await LoadCompositions();
            await SelectCompositionAsync(selectedComposition.Id);
        }
        catch (InvalidOperationException ex)
        {
            inlineAddError = ex.Message;
        }
        catch (Exception)
        {
            inlineAddError = "Не удалось выполнить действие. Повторите попытку.";
        }
    }

    void StartEditPart(ProductCompositionPartReadModel part)
    {
        editingPartId = part.Id;
        editingPartName = part.Name;
    }

    void CancelEditPart()
    {
        editingPartId = null;
        editingPartName = "";
    }

    async Task SavePartName(Guid partId)
    {
        if (!CanEditSelectedDraft || string.IsNullOrWhiteSpace(editingPartName)) return;
        var part = selectedComposition?.Parts.FirstOrDefault(p => p.Id == partId);
        if (part == null) return;
        await EquipService.UpdatePartAsync(new UpdatePartRequest(partId, editingPartName.Trim(), part.Description, part.SortOrder));
        editingPartId = null;
        editingPartName = "";
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition!.Id);
    }

    void StartMoveAggregate(ProductCompositionAggregateReadModel pca)
    {
        movingAggregateId = pca.Id;
        moveTargetPartId = null;
        moveError = null;
    }

    void CancelMoveAggregate()
    {
        movingAggregateId = null;
        moveTargetPartId = null;
        moveError = null;
    }

    async Task ConfirmMoveAggregate(Guid aggregateItemId)
    {
        if (!CanEditSelectedDraft || !movingAggregateId.HasValue) return;
        try
        {
            await EquipService.MoveProductCompositionAggregateAsync(aggregateItemId, moveTargetPartId);
            movingAggregateId = null;
            moveTargetPartId = null;
            moveError = null;
            await LoadCompositions();
            await SelectCompositionAsync(selectedComposition!.Id);
        }
        catch (InvalidOperationException ex)
        {
            moveError = ex.Message;
        }
        catch (Exception)
        {
            moveError = "Не удалось выполнить действие. Повторите попытку.";
        }
    }

    void StartEditAggregateQty(Guid id, int qty)
    {
        editingAggregateId = id;
        editAggregateQty = qty;
    }

    void CancelEditAggregate()
    {
        editingAggregateId = null;
    }

    async Task SaveAggregateQuantity(Guid id)
    {
        if (!CanEditSelectedDraft) return;
        await EquipService.UpdateAggregateQuantityAsync(new UpdateProductCompositionAggregateRequest(id, editAggregateQty, 0, null));
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition!.Id);
        editingAggregateId = null;
    }

    async Task RemoveAggregate(Guid id)
    {
        if (!CanEditSelectedDraft) return;
        await EquipService.RemoveAggregateAsync(id);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition!.Id);
    }

    void PromptReplaceAggregate(ProductCompositionAggregateReadModel pca)
    {
        replacingAggregateId = pca.Id;
        replaceWithAggregateId = Guid.Empty;
    }

    void CancelReplaceAggregate()
    {
        replacingAggregateId = null;
        replaceWithAggregateId = Guid.Empty;
    }

    void PromptDeletePart(Guid partId)
    {
        deletingPartId = partId;
    }

    void CancelDeletePart()
    {
        deletingPartId = null;
        deletePartError = null;
    }

    async Task ConfirmDeletePart()
    {
        if (!deletingPartId.HasValue) return;
        try
        {
            await RemovePart(deletingPartId.Value);
            deletingPartId = null;
            deletePartError = null;
        }
        catch (InvalidOperationException ex)
        {
            deletePartError = ex.Message;
        }
        catch (Exception)
        {
            deletePartError = "Не удалось выполнить действие. Повторите попытку.";
        }
    }

    async Task ConfirmReplaceAggregate()
    {
        if (!CanEditSelectedDraft || !replacingAggregateId.HasValue || replaceWithAggregateId == Guid.Empty) return;
        var oldAggregate = selectedComposition!.Parts
            .SelectMany(p => p.Aggregates)
            .Concat(selectedComposition.UngroupedAggregates)
            .FirstOrDefault(a => a.Id == replacingAggregateId.Value);
        if (oldAggregate == null) return;

        await EquipService.RemoveAggregateAsync(replacingAggregateId.Value);
        await EquipService.AddAggregateAsync(new AddProductCompositionAggregateRequest(selectedComposition!.Id, oldAggregate.PartId, replaceWithAggregateId, oldAggregate.Quantity));
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
        replacingAggregateId = null;
        replaceWithAggregateId = Guid.Empty;
    }

    async Task DeleteComposition(Guid id)
    {
        var comp = compositions.FirstOrDefault(c => c.Id == id);
        if (comp == null || comp.Status != ProductCompositionStatus.Draft || !canEditDraft) return;
        await EquipService.DeleteCompositionDraftAsync(id);
        compositions.RemoveAll(c => c.Id == id);
        if (selectedComposition?.Id == id) { selectedComposition = null; editingAggregateId = null; }
    }

    void OpenHK(Guid hkId) => Nav.NavigateTo($"/хк/{hkId}");

    void CreateHKForAggregate(Guid aggregateId) => Nav.NavigateTo($"/хк/создать?aggregateId={aggregateId}");

    private List<ProductCompositionAggregateReadModel> FilteredAggregates(IEnumerable<ProductCompositionAggregateReadModel> aggregates) =>
        aggregates
            .Where(a => a.Aggregate != null && (string.IsNullOrWhiteSpace(nodeFilter)
                || (a.Aggregate.Code?.Contains(nodeFilter, StringComparison.OrdinalIgnoreCase) ?? false)
                || (a.Aggregate.Name?.Contains(nodeFilter, StringComparison.OrdinalIgnoreCase) ?? false)))
            .OrderBy(a => a.Aggregate!.Code)
            .ToList();

    private RenderFragment RenderAggregateTable(IEnumerable<ProductCompositionAggregateReadModel> aggregates)
    {
        var filtered = FilteredAggregates(aggregates);
        if (!filtered.Any())
        {
            return @<div class="empty-state compositionEmptyCompact">Нет агрегатов.</div>;
        }

        return @<div class="tableWrap">
            <table>
                <thead>
                    <tr><th>Код агрегата</th><th>Наименование</th><th class="numeric">Количество</th>@if (ShowRowActions) { <th>Действия</th> }</tr>
                </thead>
                <tbody>
                    @foreach (var pca in filtered)
                    {
                        <tr>
                            <td class="mono">@pca.Aggregate?.Code</td>
                            <td>@pca.Aggregate?.Name</td>
                            <td class="numeric">
                                @if (editingAggregateId == pca.Id && CanEditSelectedDraft)
                                {
                                    <input type="number" @bind="editAggregateQty" class="field-input compositionQtyInput" min="1" />
                                    <button class="linkBtn" @onclick="() => SaveAggregateQuantity(pca.Id)">✓</button>
                                    <button class="linkBtn" @onclick="CancelEditAggregate">✕</button>
                                }
                                else
                                {
                                    <span>@pca.Quantity</span>
                                }
                            </td>
                            @if (ShowRowActions)
                            {
                                <td>
                                    @if (movingAggregateId == pca.Id)
                                    {
                                        <div class="rowActions compositionMoveRow">
                                            <select class="field-select" @bind="moveTargetPartId">
                                                @if (pca.PartId.HasValue)
                                                {
                                                    <option value="@((Guid?)null)">Без группы</option>
                                                }
                                                @foreach (var p in selectedComposition!.Parts
                                                    .Where(p => p.Id != pca.PartId)
                                                    .OrderBy(x => x.SortOrder))
                                                {
                                                    <option value="@p.Id">@p.Name</option>
                                                }
                                            </select>
                                            <button class="linkBtn" @onclick="() => ConfirmMoveAggregate(pca.Id)">Переместить</button>
                                            <button class="linkBtn" @onclick="CancelMoveAggregate">Отмена</button>
                                            @if (!string.IsNullOrEmpty(moveError))
                                            {
                                                <span class="note warn compositionMoveError">@moveError</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rowActions">
                                            <button class="linkBtn" @onclick="() => StartEditAggregateQty(pca.Id, pca.Quantity)">Изменить кол-во</button>
                                            <button class="linkBtn" @onclick="() => StartMoveAggregate(pca)">Переместить</button>
                                            <button class="linkBtn" @onclick="() => PromptReplaceAggregate(pca)">Заменить</button>
                                            <button class="linkBtn" @onclick="() => RemoveAggregate(pca.Id)">Удалить</button>
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>;
    }

    private RenderFragment RenderInlineAddAggregate(Guid? partId)
    {
        if (!IsInlineAddOpenFor(partId))
        {
            return @<div class="compositionSectionAction">
                <button class="linkBtn" @onclick="() => ShowInlineAddForm(partId)">+ Добавить агрегат @(partId.HasValue ? "в часть" : "без группы")</button>
            </div>;
        }

        return @<div class="form compositionFormRow compositionInlineAddRow">
            <div class="field">
                <label>Агрегат</label>
                <select @bind="inlineAddAggregateId" class="field-select">
                    <option value="">— Выберите агрегат —</option>
                    @foreach (var a in aggregates.OrderBy(x => x.Code))
                    {
                        <option value="@a.Id">@a.Code — @a.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Количество</label>
                <input type="number" @bind="inlineAddQty" min="1" class="field-input" />
            </div>
            <div class="field compositionFormAction">
                <button class="btn primary" @onclick="() => AddAggregateToPart(partId)" disabled="@(inlineAddAggregateId == Guid.Empty)">Добавить</button>
                <button class="btn ghost" @onclick="CancelInlineAdd">Отмена</button>
            </div>
            @if (!string.IsNullOrEmpty(inlineAddError))
            {
                <div class="note warn compositionInlineAddError">@inlineAddError</div>
            }
        </div>;
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

