@page "/состав-изделия"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Web.Components
@using Chernika.Web.Services
@using Microsoft.AspNetCore.Identity
@inject EquipmentService EquipService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@inject UserManager<ApplicationUser> UserManager
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Конструктивный состав изделия</h2>
            <div class="hint">Изделие → составные части → узлы → количество</div>
        </div>
        <div class="panelBody">
            <div class="form">
                <div class="field"><label>Модель техники</label>
                    <select @bind="selectedModelId" class="field-select">
                        <option value="">— Выберите модель —</option>
                        @foreach (var m in models)
                        {
                            <option value="@m.Id">@m.Index — @m.Name</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Комментарий</label><input @bind="comment" /></div>
                <div class="formActions">
                    <button class="btn" @onclick="LoadCompositions">Обновить список</button>
                    @if (canCreate) { <button class="btn primary" @onclick="CreateComposition">Создать черновик</button> }
                </div>
            </div>
        </div>
    </section>

    <div class="grid">
        <div class="stack">
            <section class="panel">
                <div class="panelHeader">
                    <h2>Реестр составов</h2>
                    <div class="hint">@compositions.Count записей</div>
                </div>
                <div class="panelBody">
                    @if (loading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (!compositions.Any())
                    {
                        <div class="empty-state">Нет конструктивных составов. Выберите модель и нажмите «Создать черновик».</div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Версия</th>
                                    <th>Статус</th>
                                    <th>Дата создания</th>
                                    <th>Период действия</th>
                                    <th>Узлов</th>
                                    <th>Покрытие ХК</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in compositions)
                                {
                                    var allNodes = comp.Parts.SelectMany(p => p.Aggregates).ToList();
                                    var covered = allNodes.Count(a => HasApprovedHK(a.Aggregate));
                                    <tr @onclick="() => SelectComposition(comp.Id)" style="cursor:pointer">
                                        <td class="mono">@comp.Version</td>
                                        <td><CompositionStatusBadge Status="@comp.Status" /></td>
                                        <td class="mono">@comp.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td class="mono">@FormatPeriod(comp.EffectiveDate, comp.ExpirationDate)</td>
                                        <td>@allNodes.Count</td>
                                        <td><span class="tag @(covered == allNodes.Count && allNodes.Count > 0 ? "ok" : "warn")">@covered / @allNodes.Count</span></td>
                                        <td>
                                            <div class="rowActions">
                                                <button class="linkBtn" @onclick="() => SelectComposition(comp.Id)">Открыть</button>
                                                @if (CanEditComposition(comp.Status))
                                                {
                                                    <button class="linkBtn" @onclick="() => DeleteComposition(comp.Id)">Удалить</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            @if (selectedComposition != null)
            {
                <section class="panel compositionSelectedPanel">
                    <div class="panelHeader compositionHeader">
                        <div>
                            <div class="compositionType">Состав изделия</div>
                            <h2>@selectedComposition.EquipmentModel?.Index · @selectedComposition.EquipmentModel?.Name</h2>
                            <div class="compositionVersionLine">
                                <span class="mono">Версия @selectedComposition.Version</span>
                                <CompositionStatusBadge Status="@selectedComposition.Status" />
                            </div>
                        </div>
                        <div class="compositionHeaderActions">
                            @if (selectedComposition.Status == ProductCompositionStatus.Draft)
                            {
                                @if (canSubmit)
                                {
                                    <button class="btn primary" @onclick="SubmitForReview">Отправить на согласование</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.OnReview)
                            {
                                @if (canApprove)
                                {
                                    <button class="btn primary" @onclick="ApproveComposition">Утвердить</button>
                                }
                                @if (canReturn)
                                {
                                    <button class="btn" @onclick="ReturnToDraft">Вернуть на доработку</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.Approved)
                            {
                                @if (canApprove)
                                {
                                    <button class="btn" @onclick="ArchiveComposition">Архивировать</button>
                                }
                                @if (canCreateVersion)
                                {
                                    <button class="btn primary" @onclick="CreateNewVersion">Создать новую версию</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.Archived && canCreateVersion)
                            {
                                <button class="btn primary" @onclick="CreateNewVersion">Создать новую версию</button>
                            }
                            <a class="btn ghost" href="/составы/изделия/@selectedComposition.EquipmentModelId/версии/@selectedComposition.Id">Открыть версию →</a>
                        </div>
                    </div>
                    <div class="panelBody">
                        @if (selectedComposition.Status != ProductCompositionStatus.Draft || !canEditDraft)
                        {
                            <div class="compositionReadOnlyBanner @ReadOnlyBannerClass">
                                @ReadOnlyBannerText
                            </div>
                        }
                        @if (selectedComposition.Status == ProductCompositionStatus.OnReview)
                        {
                            <div class="field" style="margin-top:10px;max-width:400px">
                                <label>Комментарий к решению</label>
                                <input @bind="reviewComment" class="field-input" placeholder="Необязательно" />
                            </div>
                        }

                        @if (selectedComposition.Status == ProductCompositionStatus.Draft && canEditDraft)
                        {
                            <div class="form" style="margin-bottom:12px">
                                <div class="field full-width"><label>Комментарий</label><input @bind="editComment" /></div>
                                <div class="field"><label>Дата начала действия</label><input type="date" @bind="editEffectiveDate" @bind:format="yyyy-MM-dd" class="field-input" /></div>
                                <div class="field"><label>Дата окончания</label><input type="date" @bind="editExpirationDate" @bind:format="yyyy-MM-dd" class="field-input" /></div>
                                <div class="formActions">
                                    <button class="btn primary" @onclick="SaveCompositionDraft">Сохранить</button>
                                </div>
                            </div>

                            <div class="form" style="margin-bottom:12px">
                                <div class="field"><label>Составная часть</label>
                                    <select @bind="selectedPartId" class="field-select">
                                        <option value="">— Выберите часть —</option>
                                        @foreach (var p in selectedComposition.Parts.OrderBy(p => p.SortOrder))
                                        {
                                            <option value="@p.Id">@p.SortOrder. @p.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Новая часть</label><input @bind="newPartName" placeholder="Напр. Силовая установка" /></div>
                                <div class="field"><label>Порядок</label><input type="number" @bind="newPartSortOrder" class="field-input" /></div>
                                <div class="field" style="display:flex;align-items:flex-end">
                                    <button class="btn" @onclick="AddPart">+ Добавить часть</button>
                                </div>
                            </div>

                            <div class="form" style="margin-bottom:12px">
                                <div class="field"><label>Агрегат</label>
                                    <select @bind="newAggregateId" class="field-select">
                                        <option value="">— Выберите агрегат —</option>
                                        @foreach (var a in aggregates)
                                        {
                                            <option value="@a.Id">@a.Code — @a.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Количество</label><input type="number" @bind="newAggregateQty" min="1" class="field-input" /></div>
                                <div class="field" style="display:flex;align-items:flex-end">
                                    <button class="btn primary" @onclick="AddAggregate" disabled="@(selectedPartId == Guid.Empty)">+ Добавить агрегат</button>
                                </div>
                            </div>
                        }

                        @if (!selectedComposition.Parts.Any())
                        {
                            <div class="empty-state">Нет составных частей. Добавьте часть и агрегаты.</div>
                        }
                        else
                        {
                            <div class="form" style="margin-bottom:8px">
                                <div class="field" style="max-width:300px"><label>Фильтр агрегатов</label><input @bind="nodeFilter" placeholder="Поиск по коду или наименованию..." class="field-input" /></div>
                            </div>
                            @foreach (var part in selectedComposition.Parts.OrderBy(p => p.SortOrder))
                            {
                                <div class="compositionPartPanel">
                                    <div class="compositionPartHeader">
                                        <span>@part.Name</span>
                                        <span class="hint">@part.Aggregates.Count агрегатов</span>
                                    </div>
                                    @{
                                        var filteredAggregates = part.Aggregates
                                            .Where(a => a.Aggregate != null && (string.IsNullOrWhiteSpace(nodeFilter)
                                                || (a.Aggregate.Code?.Contains(nodeFilter, StringComparison.OrdinalIgnoreCase) ?? false)
                                                || (a.Aggregate.Name?.Contains(nodeFilter, StringComparison.OrdinalIgnoreCase) ?? false)))
                                            .OrderBy(a => a.Aggregate.Code)
                                            .ToList();
                                    }
                                    @if (!filteredAggregates.Any())
                                    {
                                        <div class="empty-state" style="padding:4px 0">В этой части нет агрегатов.</div>
                                    }
                                    else
                                    {
                                        <div class="tableWrap">
                                            <table>
                                                <thead>
                                                    <tr><th>Код агрегата</th><th>Наименование</th><th class="numeric">Количество</th><th>Действия</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var pca in filteredAggregates)
                                                    {
                                                        <tr>
                                                            <td class="mono">@pca.Aggregate?.Code</td>
                                                            <td>@pca.Aggregate?.Name</td>
                                                            <td class="numeric">
                                                                @if (editingAggregateId == pca.Id && selectedComposition.Status == ProductCompositionStatus.Draft)
                                                                {
                                                                    <input type="number" @bind="editAggregateQty" class="field-input" style="width:70px" min="1" />
                                                                    <button class="linkBtn" @onclick="() => SaveAggregateQuantity(pca.Id)">✓</button>
                                                                    <button class="linkBtn" @onclick="() => CancelEditAggregate()">✕</button>
                                                                }
                                                                else
                                                                {
                                                                    <span>@pca.Quantity</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                <div class="rowActions">
                                                                    @if (selectedComposition.Status == ProductCompositionStatus.Draft && canEditDraft)
                                                                    {
                                                                        <button class="linkBtn" @onclick="() => StartEditAggregateQty(pca.Id, pca.Quantity)">Изменить кол-во</button>
                                                                        <button class="linkBtn" @onclick="() => PromptReplaceAggregate(pca)">Заменить</button>
                                                                        <button class="linkBtn" @onclick="() => RemoveAggregate(pca.Id)">Удалить</button>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="stack compositionSidebar">
            <section class="panel">
                <div class="panelHeader"><h2>Сводка</h2><div class="hint">Детали версии</div></div>
                <div class="panelBody">
                    @if (selectedComposition == null)
                    {
                        <div class="empty-state">Выберите состав</div>
                    }
                    else
                    {
                        <div class="field"><label>Статус</label><CompositionStatusBadge Status="@selectedComposition.Status" /></div>
                        <div class="field"><label>Версия</label><div class="mono">@selectedComposition.Version</div></div>
                        <div class="field"><label>Автор</label><div>@(authorName ?? "—")</div></div>
                        <div class="field"><label>Создан</label><div class="mono">@selectedComposition.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        <div class="field"><label>Обновлён</label><div class="mono">@selectedComposition.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        @if (selectedComposition.ApprovedAt.HasValue)
                        {
                            <div class="field"><label>Утверждён</label><div class="mono">@selectedComposition.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</div></div>
                        }
                        @if (selectedComposition.EffectiveDate.HasValue)
                        {
                            <div class="field"><label>Действует с</label><div class="mono">@selectedComposition.EffectiveDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (selectedComposition.ExpirationDate.HasValue)
                        {
                            <div class="field"><label>Действует до</label><div class="mono">@selectedComposition.ExpirationDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (!string.IsNullOrEmpty(selectedComposition.Comment))
                        {
                            <div class="field"><label>Комментарий</label><div>@selectedComposition.Comment</div></div>
                        }
                        <div style="margin-top:10px">
                            <a class="btn ghost" href="/журнал-аудита?entity=ProductComposition&id=@(selectedComposition.Id)">Журнал аудита →</a>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@if (replacingAggregateId.HasValue)
{
    <div class="modalOverlay" @onclick="CancelReplaceAggregate">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Замена агрегата</h3>
                <button type="button" class="linkBtn" @onclick="CancelReplaceAggregate">✕</button>
            </div>
            <div class="modalBody">
                <div class="field"><label>Новый агрегат</label>
                    <select @bind="replaceWithAggregateId" class="field-select">
                        <option value="">— Выберите агрегат —</option>
                        @foreach (var a in aggregates.OrderBy(a => a.Code))
                        {
                            <option value="@a.Id">@a.Code — @a.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="CancelReplaceAggregate">Отмена</button>
                <button type="button" class="btn primary" disabled="@(replaceWithAggregateId == Guid.Empty)" @onclick="ConfirmReplaceAggregate">Заменить</button>
            </div>
        </div>
    </div>
}

@code {
    private List<EquipmentModel> models = new();
    private List<Aggregate> aggregates = new();
    private List<ProductComposition> compositions = new();
    private ProductComposition? selectedComposition;
    private bool loading = true;
    private bool canCreate;
    private bool canEditDraft;
    private bool canSubmit;
    private bool canApprove;
    private bool canReturn;
    private bool canCreateVersion;
    private string? authorName;
    private CancellationTokenSource? _loadCts;

    private Guid selectedModelId;
    private string comment = "";

    private Guid selectedPartId;
    private string newPartName = "Основная часть";
    private int newPartSortOrder = 1;
    private Guid newAggregateId;
    private int newAggregateQty = 1;

    private string editComment = "";
    private DateTime? editEffectiveDate;
    private DateTime? editExpirationDate;
    private string reviewComment = "";

    private Guid? editingAggregateId;
    private int editAggregateQty;

    private string nodeFilter = "";
    private Guid? replacingAggregateId;
    private Guid replaceWithAggregateId = Guid.Empty;

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;
    private DateTime _now => TimeProvider.GetUtcNow().UtcDateTime;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canCreate = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreate);
        canEditDraft = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelEditDraft);
        canSubmit = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelSubmit);
        canApprove = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelApprove);
        canReturn = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelReturnForRevision);
        canCreateVersion = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreateVersion);
        _loadCts = new CancellationTokenSource();
        await LoadData();
    }

    private async Task LoadData()
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            loading = true;
            models = await EquipService.GetModelsAsync();
            aggregates = await EquipService.GetAggregatesAsync();
            await LoadCompositions();
        }
    }

    async Task LoadCompositions()
    {
        var ct = _loadCts?.Token ?? default;
        compositions = await EquipService.GetCompositionsWithCoverageAsync(selectedModelId != Guid.Empty ? selectedModelId : null, ct);
        loading = false;
    }

    async Task CreateComposition()
    {
        if (selectedModelId == Guid.Empty) return;
        var comp = await EquipService.CreateCompositionDraftAsync(
            new CreateCompositionRequest(selectedModelId, string.IsNullOrWhiteSpace(comment) ? null : comment));
        await LoadCompositions();
        await SelectComposition(comp.Id);
    }

    async Task SelectComposition(Guid id)
    {
        selectedComposition = compositions.FirstOrDefault(c => c.Id == id);
        if (selectedComposition != null)
        {
            editComment = selectedComposition.Comment ?? "";
            editEffectiveDate = selectedComposition.EffectiveDate;
            editExpirationDate = selectedComposition.ExpirationDate;
            selectedPartId = selectedComposition.Parts.OrderBy(p => p.SortOrder).FirstOrDefault()?.Id ?? Guid.Empty;
            editingAggregateId = null;
            authorName = await ResolveAuthorNameAsync(selectedComposition.AuthorId);
        }
        else
        {
            authorName = null;
        }
    }

    private async Task<string?> ResolveAuthorNameAsync(string? authorId)
    {
        if (string.IsNullOrWhiteSpace(authorId)) return null;
        var user = await UserManager.FindByIdAsync(authorId);
        return user?.FullName ?? authorId;
    }

    async Task SaveCompositionDraft()
    {
        if (selectedComposition == null || !canEditDraft) return;

        await EquipService.UpdateCompositionDraftAsync(
            new UpdateCompositionDraftRequest(selectedComposition.Id,
                string.IsNullOrWhiteSpace(editComment) ? null : editComment,
                editEffectiveDate?.ToUniversalTime(),
                editExpirationDate?.ToUniversalTime()));
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task SubmitForReview()
    {
        if (selectedComposition == null || !canEditDraft) return;
        await EquipService.SubmitForReviewAsync(selectedComposition.Id);
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task ApproveComposition()
    {
        if (selectedComposition == null || !canEditDraft) return;
        await EquipService.ApproveCompositionAsync(selectedComposition.Id,
            string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment);
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task ReturnToDraft()
    {
        if (selectedComposition == null || !canEditDraft) return;
        await EquipService.ReturnToDraftAsync(selectedComposition.Id,
            string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment);
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task ArchiveComposition()
    {
        if (selectedComposition == null || !canEditDraft) return;
        await EquipService.ArchiveCompositionAsync(selectedComposition.Id);
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task AddPart()
    {
        if (selectedComposition == null || !canEditDraft) return;
        if (string.IsNullOrWhiteSpace(newPartName)) return;
        await EquipService.AddPartAsync(new AddPartRequest(selectedComposition.Id, newPartName.Trim(), null, newPartSortOrder));
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task RemovePart(Guid partId)
    {
        if (selectedComposition == null || !canEditDraft) return;
        await EquipService.RemovePartAsync(partId);
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
    }

    async Task AddAggregate()
    {
        if (selectedComposition == null || newAggregateId == Guid.Empty) return;
        if (selectedPartId == Guid.Empty) return;
        await EquipService.AddAggregateAsync(new AddProductCompositionAggregateRequest(selectedPartId, newAggregateId, newAggregateQty));
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
        newAggregateId = Guid.Empty;
        newAggregateQty = 1;
    }

    void StartEditAggregateQty(Guid id, int qty)
    {
        editingAggregateId = id;
        editAggregateQty = qty;
    }

    void CancelEditAggregate()
    {
        editingAggregateId = null;
    }

    async Task SaveAggregateQuantity(Guid id)
    {
        if (!canEditDraft) return;
        await EquipService.UpdateAggregateQuantityAsync(new UpdateProductCompositionAggregateRequest(id, editAggregateQty, 0, null));
        await LoadCompositions();
        await SelectComposition(selectedComposition!.Id);
        editingAggregateId = null;
    }

    async Task RemoveAggregate(Guid id)
    {
        await EquipService.RemoveAggregateAsync(id);
        if (selectedComposition != null)
        {
            await LoadCompositions();
            await SelectComposition(selectedComposition.Id);
        }
    }

    void PromptReplaceAggregate(ProductCompositionAggregate pca)
    {
        replacingAggregateId = pca.Id;
        replaceWithAggregateId = Guid.Empty;
    }

    void CancelReplaceAggregate()
    {
        replacingAggregateId = null;
        replaceWithAggregateId = Guid.Empty;
    }

    async Task ConfirmReplaceAggregate()
    {
        if (!replacingAggregateId.HasValue || replaceWithAggregateId == Guid.Empty || selectedComposition == null) return;
        var oldAggregate = selectedComposition.Parts
            .SelectMany(p => p.Aggregates)
            .FirstOrDefault(a => a.Id == replacingAggregateId.Value);
        if (oldAggregate == null) return;

        await EquipService.RemoveAggregateAsync(replacingAggregateId.Value);
        await EquipService.AddAggregateAsync(new AddProductCompositionAggregateRequest(oldAggregate.PartId ?? Guid.Empty, replaceWithAggregateId, oldAggregate.Quantity));
        await LoadCompositions();
        await SelectComposition(selectedComposition.Id);
        replacingAggregateId = null;
        replaceWithAggregateId = Guid.Empty;
    }

    async Task DeleteComposition(Guid id)
    {
        await EquipService.DeleteCompositionDraftAsync(id);
        compositions.RemoveAll(c => c.Id == id);
        if (selectedComposition?.Id == id) { selectedComposition = null; selectedPartId = Guid.Empty; editingAggregateId = null; }
    }

    void OpenHK(Guid hkId) => Nav.NavigateTo($"/хк/{hkId}");

    void CreateHKForAggregate(Guid aggregateId) => Nav.NavigateTo($"/хк/создать?aggregateId={aggregateId}");

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    // ── Coverage helpers (TBD: re-enable when Aggregate → Node → HK chain is available) ──

    private bool HasApprovedHK(Aggregate? _) => false;

    private (string Tag, string Label) GetCoverageStatus(Aggregate? _) => ("bad", "Нет ХК");

    // ── Status helpers ───────────────────────────────────────────────────

    private static string StatusLabel(ProductCompositionStatus status) => status switch
    {
        ProductCompositionStatus.Draft => "Черновик",
        ProductCompositionStatus.OnReview => "На проверке",
        ProductCompositionStatus.Approved => "Утверждён",
        ProductCompositionStatus.Archived => "Архивный",
        _ => status.ToString()
    };

    private static string StatusTag(ProductCompositionStatus status) => status switch
    {
        ProductCompositionStatus.Draft => "warn",
        ProductCompositionStatus.OnReview => "warn",
        ProductCompositionStatus.Approved => "ok",
        ProductCompositionStatus.Archived => "",
        _ => ""
    };

    private string ReadOnlyBannerClass => selectedComposition?.Status switch
    {
        ProductCompositionStatus.Draft => "compositionReadOnlyBanner--info",
        ProductCompositionStatus.OnReview => "compositionReadOnlyBanner--warn",
        ProductCompositionStatus.Archived => "compositionReadOnlyBanner--info",
        _ => "compositionReadOnlyBanner--info"
    };

    private string ReadOnlyBannerText => selectedComposition?.Status switch
    {
        ProductCompositionStatus.Draft => "Черновик доступен только для просмотра. У вас нет права редактирования этого состава.",
        ProductCompositionStatus.OnReview => "На согласовании — состав заблокирован до решения согласующего.",
        ProductCompositionStatus.Approved => "Утверждён — для изменения создайте новую версию.",
        ProductCompositionStatus.Archived => "В архиве — историческая версия доступна только для просмотра.",
        _ => ""
    };

    private async Task CreateNewVersion()
    {
        if (selectedComposition == null) return;
        var result = await EquipService.CreateProductCompositionVersionAsync(selectedComposition.Id);
        if (result.Success && result.CompositionId.HasValue)
            Nav.NavigateTo($"/составы/изделия/{selectedComposition.EquipmentModelId}/версии/{result.CompositionId}", forceLoad: true);
    }

    private bool CanEditComposition(ProductCompositionStatus status) =>
        canEditDraft && (status == ProductCompositionStatus.Draft);

    private static string FormatPeriod(DateTime? from, DateTime? to)
    {
        if (!from.HasValue && !to.HasValue) return "—";
        if (from.HasValue && to.HasValue) return $"{from.Value:dd.MM.yy}–{to.Value:dd.MM.yy}";
        if (from.HasValue) return $"с {from.Value:dd.MM.yy}";
        return $"до {to!.Value:dd.MM.yy}";
    }
}
