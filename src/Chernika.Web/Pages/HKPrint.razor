@page "/печать-хк/{Id:guid}"
@attribute [Authorize(Policy = "ViewHK")]
@inject HKCardService HKCardService
@inject ReportService ReportService
@inject NavigationManager Nav

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Печатная форма ХК</h2>
            <div class="hint">@card?.Code</div>
        </div>
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (card == null)
            {
                <div class="empty-state">ХК не найдена</div>
            }
            else
            {
                <div class="btnRow" style="margin-bottom:16px">
                    <button class="btn primary" @onclick="DownloadPdf">📄 Скачать PDF</button>
                    <button class="btn" @onclick="DownloadExcel">📊 Скачать XLSX</button>
                    <button class="btn ghost" @onclick="Back">← Назад</button>
                </div>

                <div style="border:1px solid var(--line);border-radius:10px;padding:20px;background:var(--panel2)">
                    <div style="text-align:center;margin-bottom:16px">
                        <h2 style="margin:0;font-size:18px">ХИММОТОЛОГИЧЕСКАЯ КАРТА</h2>
                        <div class="mono" style="margin-top:4px">@card.Code | @card.Version | @card.Status</div>
                    </div>

                    <table style="width:100%;margin-bottom:16px">
                        <tr><td style="padding:6px;font-weight:700;width:180px">Уровень:</td><td style="padding:6px">@LevelName(card.ObjectLevel)</td></tr>
                        <tr><td style="padding:6px;font-weight:700">Объект:</td><td style="padding:6px">@ObjectName(card)</td></tr>
                        <tr><td style="padding:6px;font-weight:700">Филиал:</td><td style="padding:6px">@card.Branch?.Name</td></tr>
                        <tr><td style="padding:6px;font-weight:700">Дата утверждения:</td><td style="padding:6px">@card.ApprovedDate?.ToString("dd.MM.yyyy")</td></tr>
                        <tr><td style="padding:6px;font-weight:700">Срок действия:</td><td style="padding:6px">@card.EffectiveDate?.ToString("dd.MM.yyyy") — @card.ExpirationDate?.ToString("dd.MM.yyyy")</td></tr>
                    </table>

                    @if (card.ObjectLevel == Domain.Enums.HKObjectLevel.Node && card.Items.Any())
                    {
                        <h3 style="font-size:14px;margin:16px 0 8px">Сборочные единицы и нормы ГСМ:</h3>
                        <table>
                            <thead>
                                <tr>
                                    <th>Сборочная единица</th>
                                    <th>Кол-во</th>
                                    <th>Масса/объём</th>
                                    <th>Ед.изм.</th>
                                    <th>Периодичность</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in card.Items.OrderBy(i => i.SortOrder))
                                {
                                    <tr>
                                        <td>@item.AssemblyUnit?.Name</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Volume.ToString("F3")</td>
                                        <td>@(item.UnitOfMeasure ?? "кг")</td>
                                        <td>@(item.Periodicity ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (card.ObjectLevel != Domain.Enums.HKObjectLevel.Node)
                    {
                        <h3 style="font-size:14px;margin:16px 0 8px">Состав ХК (агрегированные строки):</h3>
                        @if (aggregatedRows.Count == 0)
                        {
                            <div class="note">Нет дочерних ХК в составе</div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>ХК-источник</th>
                                        <th>Сборочная единица</th>
                                        <th>Масса/объём</th>
                                        <th>Ед.изм.</th>
                                        <th>Марка ГСМ</th>
                                        <th>ГОСТ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in aggregatedRows)
                                    {
                                        <tr>
                                            <td class="mono">@row.SourceCardCode</td>
                                            <td>@row.AssemblyUnitName</td>
                                            <td>@row.Volume.ToString("F3")</td>
                                            <td>@(row.UnitOfMeasure ?? "кг")</td>
                                            <td>@row.GsmMaterialName</td>
                                            <td class="mono">@row.Gost</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @if (!string.IsNullOrEmpty(card.Purpose))
                    {
                        <div style="margin-top:16px">
                            <strong>Назначение:</strong>
                            <p style="margin:4px 0 0">@card.Purpose</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(card.NormativeBasis))
                    {
                        <div style="margin-top:8px">
                            <strong>Основание для разработки:</strong>
                            <p style="margin:4px 0 0">@card.NormativeBasis</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(card.Notes))
                    {
                        <div style="margin-top:8px">
                            <strong>Примечание:</strong>
                            <p style="margin:4px 0 0">@card.Notes</p>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>

@using Chernika.Domain.Enums
@using Chernika.Domain.Models

@code {
    [Parameter] public Guid Id { get; set; }
    private HKCard? card;
    private bool loading = true;
    private List<AggregatedRowDto> aggregatedRows = new();

    protected override async Task OnInitializedAsync()
    {
        card = await HKCardService.GetByIdAsync(Id);
        if (card != null && card.ObjectLevel != HKObjectLevel.Node)
        {
            aggregatedRows = await HKCardService.GetAggregatedRowsAsync(card.Id);
        }
        loading = false;
    }

    async Task DownloadPdf()
    {
        if (card == null) return;
        var pdfBytes = ReportService.GenerateHKCardPdf(card);
        await JS.InvokeVoidAsync("downloadFile", "HK-" + card.Code + ".pdf", "application/pdf", Convert.ToBase64String(pdfBytes));
    }

    async Task DownloadExcel()
    {
        if (card == null) return;
        var cards = await HKCardService.GetAllAsync();
        var excelBytes = ReportService.GenerateHKRegistryExcel(cards);
        await JS.InvokeVoidAsync("downloadFile", "Registry_HK.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(excelBytes));
    }

    void Back() => Nav.NavigateTo("/реестр-хк");

    [Inject] IJSRuntime JS { get; set; } = null!;

    private static string LevelName(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Complex => "Комплекс",
        HKObjectLevel.EquipmentModel => "Изделие",
        HKObjectLevel.Aggregate => "Агрегат",
        HKObjectLevel.Node => "Узел",
        _ => "—"
    };

    private string ObjectName(HKCard c) => c.ObjectLevel switch
    {
        HKObjectLevel.Complex => c.Complex?.Name ?? "—",
        HKObjectLevel.EquipmentModel => c.EquipmentModel?.Name ?? "—",
        HKObjectLevel.Aggregate => c.Aggregate?.Name ?? "—",
        HKObjectLevel.Node => c.Node?.Name ?? "—",
        _ => "—"
    };
}
