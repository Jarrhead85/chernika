@page "/профиль"
@attribute [Authorize]
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Data
@using Chernika.Infrastructure.Services
@using Chernika.Web.Services
@inject AccountService AccountSvc
@inject CircuitDbLock DbLock
@inject NavigationManager Nav
@inject NotificationRefreshService NotifRefresh
@inject ILogger<Profile> Logger
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Мой аккаунт</h2>
        </div>
        <div class="panelBody">
            @if (_pageError is not null)
            {
                <div class="note bad profileNote">@_pageError</div>
            }

            @if (_account is null && _pageError is null)
            {
                <div class="loading">Загрузка…</div>
            }
            else if (_account is not null)
            {
                @if (_account.MustChangePassword)
                {
                    <div class="note warn profileNote">Администратор установил временный пароль. Смените его перед продолжением работы.</div>
                    <div class="profileGrid profileGridSingle">
                        <div class="profileCol">
                            <h3>Безопасность</h3>
                            @SecurityPanel()
                        </div>
                    </div>
                }
                else
                {
                    <div class="profileGrid">
                        <div class="profileCol">
                            <h3>Профиль</h3>
                            @ProfilePanel()
                        </div>
                        <div class="profileCol">
                            <h3>Безопасность</h3>
                            @SecurityPanel()
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>

@code {
    private MyAccountDto? _account;
    private string _fullName = "";
    private string? _pageError;
    private string? _profileError;
    private string? _securityError;
    private string? _avatarError;
    private string? _securitySuccess;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _savingProfile;
    private bool _changingPassword;

    [Parameter, SupplyParameterFromQuery(Name = "forcePasswordChange")] public string? ForceQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrlQuery { get; set; }

    /// <summary>
    /// Безопасный returnUrl: только один начальный слэш локального пути.
    /// Отбрасываются схемы, «//», обратные слэши и их URL-кодировки
    /// (%2F/%5C) — иначе «/%2F%2Fhost» обходит проверку «//».
    /// </summary>
    private string? _safeReturnUrl =>
        string.IsNullOrEmpty(ReturnUrlQuery)
            ? null
            : ReturnUrlQuery.StartsWith("/") && !ReturnUrlQuery.StartsWith("//")
                && !ReturnUrlQuery.Contains('\\')
                && ReturnUrlQuery.IndexOf("%2F", StringComparison.OrdinalIgnoreCase) < 0
                && ReturnUrlQuery.IndexOf("%5C", StringComparison.OrdinalIgnoreCase) < 0
                ? ReturnUrlQuery
                : null;

    private string AccountAvatarUrl =>
        _account is { HasAvatar: true }
            ? $"/api/account/me/avatar/content?v={_account.AvatarVersion}"
            : string.Empty;

    private string Initials
    {
        get
        {
            var n = _account?.FullName;
            return string.IsNullOrEmpty(n) ? "?" : n[..1].ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAccountAsync();

    private async Task LoadAccountAsync()
    {
        try
        {
            _account = await DbLock.LockedAsync(() => AccountSvc.GetMyAccountAsync());
            _fullName = _account.FullName ?? "";
        }
        catch (UnauthorizedAccessException ex)
        {
            _pageError = ex.Message;
        }
    }

    // ── Раздел «Профиль» ──────────────────────────────────────────────────

    private RenderFragment ProfilePanel() => __builder =>
    {
        <div class="avatarBlock">
            @if (!string.IsNullOrEmpty(AccountAvatarUrl))
            {
                <img class="avatar profileAvatar" src="@AccountAvatarUrl" alt="Аватар" />
            }
            else
            {
                <div class="avatar profileAvatar">@Initials</div>
            }
            <div class="avatarActions">
                <label class="btn avatarInputBtn">
                    Изменить фото
                    <InputFile OnChange="HandleAvatarSelectedAsync" accept=".jpg,.jpeg,.png,.webp" />
                </label>
                @if (_account?.HasAvatar == true)
                {
                    <button type="button" class="btn" @onclick="DeleteAvatarAsync">Удалить фото</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(_avatarError))
            {
                <div class="note bad profileNote">@_avatarError</div>
            }
        </div>

        <div class="field">
            <label class="field-label" for="fullName">ФИО</label>
            <input id="fullName" class="field-input" type="text" value="@_fullName"
                   @oninput="OnFullNameInput" />
        </div>
        @if (!string.IsNullOrEmpty(_profileError))
        {
            <div class="note bad profileNote">@_profileError</div>
        }
        <div class="btnRow">
            <button class="btn primary" disabled="@_savingProfile" @onclick="SaveProfileAsync">Сохранить профиль</button>
        </div>

        <div class="definitionRows">
            <div class="definitionRow"><span class="definitionLabel">Логин</span><span class="definitionValue">@_account?.Login</span></div>
            <div class="definitionRow"><span class="definitionLabel">Должность</span><span class="definitionValue">@(string.IsNullOrEmpty(_account?.Position) ? "—" : _account?.Position)</span></div>
            <div class="definitionRow"><span class="definitionLabel">Базовая роль</span><span class="definitionValue">@_account?.BaseRoleDisplay</span></div>
            <div class="definitionRow"><span class="definitionLabel">Организация</span><span class="definitionValue">@(string.IsNullOrEmpty(_account?.BranchName) ? "—" : _account?.BranchName)</span></div>
            <div class="definitionRow"><span class="definitionLabel">Дата создания учётной записи</span><span class="definitionValue">@(_account?.CreatedAt.ToString("dd.MM.yyyy") ?? "")</span></div>
        </div>
    };

    private RenderFragment SecurityPanel() => __builder =>
    {
        @if (!string.IsNullOrEmpty(_securitySuccess))
        {
            <div class="note ok profileNote">@_securitySuccess</div>
        }
        @if (!string.IsNullOrEmpty(_securityError))
        {
            <div class="note bad profileNote">@_securityError</div>
        }
        <form class="securityForm" @onsubmit="ChangePasswordAsync">
            <div class="field">
                <label class="field-label" for="currentPassword">Текущий пароль</label>
                <input id="currentPassword" type="password" class="field-input"
                       value="@_currentPassword"
                       @oninput="OnCurrentPasswordInput" />
            </div>
            <div class="field">
                <label class="field-label" for="newPassword">Новый пароль</label>
                <input id="newPassword" type="password" class="field-input"
                       value="@_newPassword"
                       @oninput="OnNewPasswordInput" />
            </div>
            <div class="field">
                <label class="field-label" for="confirmPassword">Повторите новый пароль</label>
                <input id="confirmPassword" type="password" class="field-input"
                       value="@_confirmPassword"
                       @oninput="OnConfirmPasswordInput" />
            </div>
            <div class="btnRow">
                <button type="submit" class="btn primary" disabled="@_changingPassword">Сменить пароль</button>
            </div>
        </form>
    };

    // ── Обработчики ──────────────────────────────────────────────────────

    private async Task HandleAvatarSelectedAsync(InputFileChangeEventArgs e)
    {
        _avatarError = null;
        var file = e.File;
        if (file is null)
            return;

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 3 * 1024 * 1024);
            await DbLock.LockedAsync(() => AccountSvc.UploadMyAvatarAsync(stream, file.Name, file.ContentType, file.Size));
            await LoadAccountAsync();
            await NotifRefresh.NotifyChangedAsync();
        }
        catch (ArgumentException ex)
        {
            _avatarError = ex.Message;
            StateHasChanged();
        }
        catch (UnauthorizedAccessException ex)
        {
            _avatarError = ex.Message;
            StateHasChanged();
        }
    }

    private async Task DeleteAvatarAsync()
    {
        _avatarError = null;
        try
        {
            await DbLock.LockedAsync(() => AccountSvc.DeleteMyAvatarAsync());
            await LoadAccountAsync();
            await NotifRefresh.NotifyChangedAsync();
            StateHasChanged();
        }
        catch (UnauthorizedAccessException ex)
        {
            _avatarError = ex.Message;
        }
    }

    private async Task SaveProfileAsync()
    {
        _profileError = null;
        _savingProfile = true;
        try
        {
            await DbLock.LockedAsync(() => AccountSvc.UpdateMyProfileAsync(new UpdateMyProfileRequest { FullName = _fullName.Trim() }));
            await LoadAccountAsync();
        }
        catch (ArgumentException ex)
        {
            _profileError = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            _profileError = ex.Message;
        }
        finally
        {
            _savingProfile = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _securityError = null;
        _securitySuccess = null;
        _changingPassword = true;
        try
        {
            await DbLock.LockedAsync(() => AccountSvc.ChangeMyPasswordAsync(new ChangeMyPasswordRequest
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword,
            }));

            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
            _securitySuccess = "Пароль успешно изменён.";
            await LoadAccountAsync();
            await NotifRefresh.NotifyChangedAsync();

            // Обязательная смена временного пароля завершена: вернуться к
            // исходному запрошенному локальному URL или на главную.
            var returnUrl = _safeReturnUrl;
            if (_account is { MustChangePassword: false } && returnUrl is not null)
            {
                Nav.NavigateTo(returnUrl, forceLoad: true);
                return;
            }
        }
        catch (ArgumentException ex)
        {
            _securityError = ex.Message;
            _currentPassword = "";
            _newPassword = "";
            _confirmPassword = "";
        }
        catch (UnauthorizedAccessException ex)
        {
            _securityError = ex.Message;
        }
        finally
        {
            _changingPassword = false;
        }
    }

    private void OnFullNameInput(ChangeEventArgs e) => _fullName = e.Value?.ToString() ?? "";
    private void OnCurrentPasswordInput(ChangeEventArgs e) => _currentPassword = e.Value?.ToString() ?? "";
    private void OnNewPasswordInput(ChangeEventArgs e) => _newPassword = e.Value?.ToString() ?? "";

    private void OnConfirmPasswordInput(ChangeEventArgs e) => _confirmPassword = e.Value?.ToString() ?? "";

    public void Dispose()
    {
    }
}
