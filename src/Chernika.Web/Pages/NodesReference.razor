@page "/справочник-узлов"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Техника" Current="Узлы" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование изделия" : "Новое изделие")</h2>
                <div class="hint">Общесистемный справочник</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Код изделия</label><input @ref="_firstField" @bind="newNode.Code" /></div>
                    <div class="field"><label>Наименование</label><input @bind="newNode.Name" /></div>
                    <div class="field full-width"><label>Описание</label><input @bind="newNode.Description" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveNode">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список изделий</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по коду, наименованию, описанию..." />
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="Code">Сортировка: код</option>
                    <option value="Name">Сортировка: наименование</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!nodes.Any())
            {
                <div class="empty-state">Нет изделий</div>
            }
            else
            {
                <div class="referenceTableWrap">
                    <table>
                        <thead>
                            <tr><th>Код</th><th>Наименование</th><th>Описание</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var n in nodes)
                            {
                                var rowClickable = canEdit && !n.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(n)" @onkeydown="(ev) => OnRowKeyDown(ev, n)">
                                    <td class="mono">@n.Code</td>
                                    <td>@n.Name</td>
                                    <td>@n.Description</td>
                                    <td><span class="tag @(n.IsDeleted ? "bad" : "ok")">@(n.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (n.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreNode(n.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditNode(n)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteNode(n.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @nodes.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<Node> nodes = new();
    private Node newNode = new();
    private bool editing = false;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private int statusFilter = 0;
    private string sortBy = "Code";
    private bool sortDesc = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search) || statusFilter != 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    private async Task OnFiltersChanged()
    {
        currentPage = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        bool? showDeleted = statusFilter switch
        {
            1 => true,
            2 => null,
            _ => false
        };

        loading = true;
        try
        {
            var result = await EquipService.GetNodesPagedAsync(new NodeQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);

            if (ct.IsCancellationRequested)
                return;

            nodes = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await ReloadAsync();
                return;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                loading = false;
        }
    }

    async Task SaveNode()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newNode.Name))
        {
            errorMessage = "Укажите наименование.";
            return;
        }

        try
        {
            if (editing)
                await EquipService.UpdateNodeAsync(newNode);
            else
                await EquipService.CreateNodeAsync(newNode);
            ResetForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить запись справочника. Обновите список и повторите попытку."
                : "Не удалось создать запись справочника. Обновите список и повторите попытку.";
        }
    }

    Task EditNode(Node n)
    {
        newNode = new Node { Id = n.Id, Code = n.Code, Name = n.Name, Description = n.Description };
        editing = true;
        _focusForm = true;
        return Task.CompletedTask;
    }

    async Task OnRowDblClick(Node n)
    {
        if (!canEdit || n.IsDeleted) return;
        await EditNode(n);
    }

    async Task OnRowKeyDown(KeyboardEventArgs ev, Node n)
    {
        if (!canEdit || n.IsDeleted || ev.Key != "Enter") return;
        await EditNode(n);
    }

    async Task DeleteNode(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await EquipService.DeleteNodeAsync(id);
            if (!ok) errorMessage = "Не удалось удалить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task RestoreNode(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await EquipService.RestoreNodeAsync(id);
            if (!ok) errorMessage = "Не удалось восстановить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    void ResetForm()
    {
        newNode = new Node();
        editing = false;
        errorMessage = null;
    }

    async Task ToggleSortDir()
    {
        sortDesc = !sortDesc;
        await ReloadAsync();
    }

    async Task ResetFilters()
    {
        search = "";
        statusFilter = 0;
        sortBy = "Code";
        sortDesc = false;
        currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await ReloadAsync();
    }

    async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await ReloadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
