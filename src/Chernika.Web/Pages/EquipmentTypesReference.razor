@page "/справочники/техника/виды-техники"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Техника" Current="Виды техники" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование вида техники" : "Новый вид техники")</h2>
                <div class="hint">Справочник видов / категорий техники</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Вид техники</label><input @ref="_firstField" @bind="newType.TypeGroup" maxlength="250" /></div>
                    <div class="field"><label>Наименование</label><input @bind="newType.Name" maxlength="250" /></div>
                    <div class="field full-width"><label>Описание</label><input @bind="newType.Description" maxlength="1000" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveType">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список видов техники</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по виду, наименованию, описанию..." />
                <select class="field-select" @bind="typeFilter" @bind:after="OnFiltersChanged">
                    <option value="">Все виды техники</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="TypeGroup">Сортировка: вид техники</option>
                    <option value="Name">Сортировка: наименование</option>
                    <option value="CreatedAt">Сортировка: дата создания</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!types.Any())
            {
                <div class="empty-state">Нет записей</div>
            }
            else
            {
                <div class="militaryBranchesTableWrap">
                    <table>
                        <thead>
                            <tr><th>Вид техники</th><th>Наименование</th><th>Описание</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in types)
                            {
                                var rowClickable = canEdit && !t.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(t)" @onkeydown="(ev) => OnRowKeyDown(ev, t)">
                                    <td>@t.TypeGroup</td>
                                    <td>@t.Name</td>
                                    <td>@t.Description</td>
                                    <td><span class="tag @(t.IsDeleted ? "bad" : "ok")">@(t.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (t.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreType(t.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditType(t)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteType(t.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @types.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<EquipmentType> types = new();
    private List<string> groups = new();
    private EquipmentType newType = new();
    private bool editing = false;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private string? typeFilter;
    private int statusFilter = 0;
    private string sortBy = "TypeGroup";
    private bool sortDesc = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(typeFilter) || statusFilter != 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = await Perms.HasPermissionAsync(userId!, PermissionCodes.ReferenceEdit);
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    private async Task OnFiltersChanged()
    {
        currentPage = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        bool? showDeleted = statusFilter switch
        {
            1 => true,
            2 => null,
            _ => false
        };

        loading = true;
        try
        {
            var result = await EquipService.GetEquipmentTypesPagedAsync(new EquipmentTypeQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                TypeGroup = string.IsNullOrWhiteSpace(typeFilter) ? null : typeFilter,
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);

            List<string>? loadedGroups = null;
            if (showDeleted != true)
                loadedGroups = await EquipService.GetEquipmentTypeGroupsAsync(ct);

            if (ct.IsCancellationRequested)
                return;

            types = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await ReloadAsync();
                return;
            }
            if (loadedGroups != null)
                groups = loadedGroups;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                loading = false;
        }
    }

    async Task SaveType()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newType.Name))
        {
            errorMessage = "Укажите наименование.";
            return;
        }

        try
        {
            if (editing)
                await EquipService.UpdateEquipmentTypeAsync(newType);
            else
                await EquipService.CreateEquipmentTypeAsync(newType);
            ResetForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить запись справочника. Обновите список и повторите попытку."
                : "Не удалось создать запись справочника. Обновите список и повторите попытку.";
        }
    }

    Task EditType(EquipmentType t)
    {
        newType = new EquipmentType { Id = t.Id, TypeGroup = t.TypeGroup, Name = t.Name, Description = t.Description, IsDeleted = t.IsDeleted, CreatedAt = t.CreatedAt, UpdatedAt = t.UpdatedAt };
        editing = true;
        _focusForm = true;
        return Task.CompletedTask;
    }

    async Task OnRowDblClick(EquipmentType t)
    {
        if (!canEdit || t.IsDeleted) return;
        await EditType(t);
    }

    async Task OnRowKeyDown(KeyboardEventArgs ev, EquipmentType t)
    {
        if (!canEdit || t.IsDeleted || ev.Key != "Enter") return;
        await EditType(t);
    }

    async Task DeleteType(Guid id)
    {
        try
        {
            await EquipService.DeleteEquipmentTypeAsync(id);
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task RestoreType(Guid id)
    {
        try
        {
            await EquipService.RestoreEquipmentTypeAsync(id);
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    void ResetForm()
    {
        newType = new EquipmentType();
        editing = false;
        errorMessage = null;
    }

    async Task ToggleSortDir()
    {
        sortDesc = !sortDesc;
        await ReloadAsync();
    }

    async Task ResetFilters()
    {
        search = "";
        typeFilter = null;
        statusFilter = 0;
        sortBy = "TypeGroup";
        sortDesc = false;
        currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await ReloadAsync();
    }

    async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await ReloadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
