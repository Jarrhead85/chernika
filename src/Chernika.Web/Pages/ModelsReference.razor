@page "/справочник-моделей"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Техника" Current="Модели техники" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование модели" : "Новая модель техники")</h2>
                <div class="hint">Модели / образцы</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Индекс</label><input @ref="_firstField" @bind="newModel.Index" /></div>
                    <div class="field"><label>Наименование</label><input @bind="newModel.Name" /></div>
                    <div class="field">
                        <label>Вид техники из справочника</label>
                        <SearchablePopoverSelect TItem="EquipmentType"
                                                  Items="_equipmentTypes"
                                                  Selected="_selectedEquipmentType"
                                                  DisplayTextSelector="TypeDisplayName"
                                                  SearchPredicate="TypeMatchesSearch"
                                                  Placeholder="Выберите вид техники"
                                                  EmptyText="Виды техники не найдены"
                                                  OnSelected="OnEquipmentTypeSelectedAsync">
                            <ItemTemplate Context="type">@TypeDisplayName(type)</ItemTemplate>
                        </SearchablePopoverSelect>
                    </div>
                    <div class="field"><label>Устаревший текстовый вид техники</label><input @bind="newModel.Type" /></div>
                    <div class="field"><label>Марка</label><input @bind="newModel.Brand" /></div>
                    <div class="field"><label>Модификация</label><input @bind="newModel.Modification" /></div>
                    <div class="field full-width"><label>Описание</label><input @bind="newModel.Description" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveModel">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список моделей</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по индексу, наименованию, виду, марке..." />
                <select class="field-select" @bind="typeFilter" @bind:after="OnFiltersChanged">
                    <option value="">Все виды техники</option>
                    @foreach (var t in _equipmentTypes)
                    {
                        <option value="@t.Id">@TypeDisplayName(t)</option>
                    }
                </select>
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="Index">Сортировка: индекс</option>
                    <option value="Name">Сортировка: наименование</option>
                    <option value="Type">Сортировка: вид техники</option>
                    <option value="Brand">Сортировка: марка</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!models.Any())
            {
                <div class="empty-state">Нет моделей техники</div>
            }
            else
            {
                <div class="referenceTableWrap">
                    <table>
                        <thead>
                            <tr><th>Индекс</th><th>Наименование</th><th>Вид</th><th>Марка</th><th>Модификация</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in models)
                            {
                                var rowClickable = canEdit && !m.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(m)" @onkeydown="(ev) => OnRowKeyDown(ev, m)">
                                    <td class="mono">@m.Index</td>
                                    <td>@m.Name</td>
                                    <td>@TypeDisplay(m)</td>
                                    <td>@m.Brand</td>
                                    <td>@m.Modification</td>
                                    <td><span class="tag @(m.IsDeleted ? "bad" : "ok")">@(m.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (m.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreModel(m.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditModel(m)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteModel(m.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @models.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<EquipmentModel> models = new();
    private List<EquipmentType> _equipmentTypes = new();
    private EquipmentModel newModel = new();
    private bool editing;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private string? typeFilter;
    private int statusFilter;
    private string sortBy = "Index";
    private bool sortDesc;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private EquipmentType? _selectedEquipmentType => _equipmentTypes.FirstOrDefault(t => t.Id == newModel.EquipmentTypeId);
    private static string TypeDisplayName(EquipmentType t) => string.IsNullOrWhiteSpace(t.TypeGroup) ? t.Name : $"{t.TypeGroup} — {t.Name}";
    private static bool TypeMatchesSearch(EquipmentType t, string text) => ((t.TypeGroup ?? "") + " " + t.Name).Contains(text, StringComparison.OrdinalIgnoreCase);
    private static string TypeDisplay(EquipmentModel m) => m.EquipmentType != null ? TypeDisplayName(m.EquipmentType) : (m.Type ?? "—");
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(typeFilter) || statusFilter != 0;

    private Task OnEquipmentTypeSelectedAsync(EquipmentType type)
    {
        newModel.EquipmentTypeId = type.Id;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        await LoadEquipmentTypes();
        await ReloadAsync();
    }

    private async Task LoadEquipmentTypes()
    {
        try { _equipmentTypes = await EquipService.GetActiveEquipmentTypesAsync(); }
        catch { _equipmentTypes = new List<EquipmentType>(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm) { _focusForm = false; await _firstField.FocusAsync(); }
    }

    private async Task OnFiltersChanged() { currentPage = 1; await ReloadAsync(); }

    private async Task ReloadAsync()
    {
        _cts?.Cancel(); _cts?.Dispose(); _cts = new CancellationTokenSource(); var ct = _cts.Token;
        bool? showDeleted = statusFilter switch { 1 => true, 2 => null, _ => false };
        loading = true;
        try
        {
            var result = await EquipService.GetModelsPagedAsync(new EquipmentModelQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                EquipmentTypeId = string.IsNullOrEmpty(typeFilter) ? null : Guid.Parse(typeFilter),
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);
            if (ct.IsCancellationRequested) return;
            models = result.Items.ToList(); totalCount = result.TotalCount; totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0) { currentPage = totalPages; await ReloadAsync(); return; }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally { if (!ct.IsCancellationRequested) loading = false; }
    }

    async Task SaveModel()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newModel.Name)) { errorMessage = "Укажите наименование."; return; }
        try
        {
            if (editing) await EquipService.UpdateModelAsync(newModel); else await EquipService.CreateModelAsync(newModel);
            ResetForm(); await ReloadAsync();
        }
        catch (InvalidOperationException ex) { errorMessage = ex.Message; }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить модель. Обновите список и повторите попытку."
                : "Не удалось создать модель. Обновите список и повторите попытку.";
        }
    }

    Task EditModel(EquipmentModel m)
    {
        newModel = new EquipmentModel
        {
            Id = m.Id, Index = m.Index, Name = m.Name, Type = m.Type,
            Brand = m.Brand, Modification = m.Modification, Description = m.Description,
            EquipmentTypeId = m.EquipmentTypeId
        };
        editing = true; _focusForm = true; return Task.CompletedTask;
    }

    async Task OnRowDblClick(EquipmentModel m) { if (!canEdit || m.IsDeleted) return; await EditModel(m); }
    async Task OnRowKeyDown(KeyboardEventArgs ev, EquipmentModel m) { if (!canEdit || m.IsDeleted || ev.Key != "Enter") return; await EditModel(m); }

    async Task DeleteModel(Guid id)
    {
        errorMessage = null;
        try { var ok = await EquipService.DeleteModelAsync(id); if (!ok) errorMessage = "Не удалось удалить запись."; await ReloadAsync(); }
        catch (InvalidOperationException ex) { errorMessage = ex.Message; }
    }

    async Task RestoreModel(Guid id)
    {
        errorMessage = null;
        try { var ok = await EquipService.RestoreModelAsync(id); if (!ok) errorMessage = "Не удалось восстановить запись."; await ReloadAsync(); }
        catch (InvalidOperationException ex) { errorMessage = ex.Message; }
    }

    void ResetForm() { newModel = new EquipmentModel(); editing = false; errorMessage = null; }
    async Task ToggleSortDir() { sortDesc = !sortDesc; await ReloadAsync(); }

    async Task ResetFilters()
    {
        search = ""; typeFilter = null; statusFilter = 0; sortBy = "Index"; sortDesc = false; currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage() { if (currentPage <= 1) return; currentPage--; await ReloadAsync(); }
    async Task NextPage() { if (currentPage >= totalPages) return; currentPage++; await ReloadAsync(); }

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
