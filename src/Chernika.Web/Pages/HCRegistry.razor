@page "/реестр-хк"
@attribute [Authorize(Policy = "ViewHK")]
@implements System.IDisposable
@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Web.Services
@inject HKCardService HKCardService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService Perms
@inject CircuitDbLock DbLock

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Оперативная сводка по формам</h2>
            <div class="hint">Обновлено: @DateTime.UtcNow.ToString("dd.MM.yyyy HH:mm") UTC</div>
        </div>
        <div class="panelBody">
            <div class="hero">
                <div class="heroBox">
                    <div class="eyebrow">Нормативный контур • Веб-интерфейс</div>
                    <h3>Химмотологические карты</h3>
                    <p>Ведение нормативных ХК по изделиям: разрешённые марки ГСМ, базовые объёмы и версии карточек</p>
                </div>
                <div class="heroGrid">
                    <div class="heroStat">
                        <div class="label">ХК в банке <span class="tag ok">актуальные</span></div>
                        <div class="value">@totalCount</div>
                        <div class="trend">@statusCounts.GetValueOrDefault(HKCardStatus.Approved) утверждённых</div>
                    </div>
                    <div class="heroStat">
                        <div class="label">Изделия состава <span class="tag warn">в работе</span></div>
                        <div class="value">@statusCounts.GetValueOrDefault(HKCardStatus.OnReview)</div>
                        <div class="trend">@statusCounts.GetValueOrDefault(HKCardStatus.RevisionRequired) требуют доработки</div>
                    </div>
                    <div class="heroStat">
                        <div class="label">Инд. карты <span class="tag ok">расчет</span></div>
                        <div class="value">—</div>
                        <div class="trend">Модуль в разработке</div>
                    </div>
                    <div class="heroStat">
                        <div class="label">Замечания <span class="tag bad">контроль</span></div>
                        <div class="value">@statusCounts.GetValueOrDefault(HKCardStatus.RevisionRequired)</div>
                        <div class="trend">Требуют внимания</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="grid">
        <div class="stack">
            <section class="panel">
                <div class="panelHeader">
                    <h2>Реестр ХК</h2>
                    <div class="hint">Поиск / фильтрация / версии</div>
                </div>
                <div class="panelBody">
                    <div class="form">
                        <div class="field"><label>Номер ХК</label><input @bind="filterCode" placeholder="HK-2026-001301" /></div>
                        <div class="field"><label>Статус</label>
                            <select @bind="filterStatus" class="field-select">
                                <option value="">Все</option>
                                <option value="Draft">Черновик</option>
                                <option value="OnReview">На проверке</option>
                                <option value="RevisionRequired">На доработке</option>
                                <option value="Approved">Утверждена</option>
                                <option value="Archived">Архивная</option>
                            </select>
                        </div>
                        <div class="field"><label>Версия</label><input @bind="filterVersion" placeholder="v0426" /></div>
                        <div class="field"><label>Уровень</label>
                            <select @bind="filterLevel" class="field-select">
                                <option value="">Все</option>
                                <option value="Complex">Комплекс</option>
                                <option value="EquipmentModel">Изделие</option>
                                <option value="Aggregate">Агрегат</option>
                                <option value="Node">Узел</option>
                            </select>
                        </div>
                        <div class="field"><label>Изделие</label><input @bind="filterNode" placeholder="UZ-044 / двигатель" /></div>
                        <div class="formActions">
                            <button class="btn" @onclick="ApplyFilters">Применить фильтры</button>
                            @if (canCreate) { <button class="btn primary" @onclick="GoToCreate">Создать ХК</button> }
                        </div>
                    </div>
                    <div class="chips">
                        <span class="pill">Все версии</span>
                        <span class="pill">Только действующие</span>
                        @if (!string.IsNullOrEmpty(filterStatus))
                        {
                            <span class="pill">Статус: @filterStatus</span>
                        }
                    </div>
                </div>
            </section>

            <section class="panel">
                <div class="panelHeader">
                    <h2>Список ХК</h2>
                    <div class="hint">@filteredCards.Count записей</div>
                </div>
                <div class="panelBody">
                    @if (loading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (!filteredCards.Any())
                    {
                        <div class="empty-state">Нет ХК, соответствующих фильтру</div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>№ ХК</th>
                                    <th>Изделие</th>
                                    <th>Статус</th>
                                    <th>Версия</th>
                                    <th>Филиал</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in filteredCards)
                                {
                                    <tr @onclick="() => SelectCard(card.Id)" @ondblclick="() => GoToEdit(card.Id)" style="cursor:pointer">
                                        <td class="mono">@card.Code</td>
                                        <td>@card.ObjectName<br /><span class="mono">@card.ObjectCode</span></td>
                                        <td><StatusBadge Status="@card.Status" /></td>
                                        <td class="mono">@card.Version</td>
                                        <td>@card.BranchName</td>
                                        <td>
                                            <div class="rowActions">
                                                <button class="linkBtn" @onclick="() => GoToEdit(card.Id)" @onclick:stopPropagation="true">Открыть</button>
                                                @if (CanDeleteCard(card)) { <button class="linkBtn" @onclick="() => DeleteCard(card.Id)" @onclick:stopPropagation="true">Удалить</button> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="footer">
                            <div>Двойной клик по строке — открыть карточку ХК.</div>
                            <div class="mono">Показано @filteredCards.Count из @totalCount</div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside class="stack">
            <section class="panel">
                <div class="panelHeader"><h2>Карточка ХК</h2><div class="hint">Быстрый просмотр</div></div>
                <div class="panelBody">
                    @if (selectedCard == null)
                    {
                        <div class="empty-state">Выберите ХК из списка</div>
                    }
                    else
                    {
                        <div class="metrics2">
                            <div class="metric"><div class="label">Статус</div><div class="value"><StatusBadge Status="@selectedCard.Status" /></div></div>
                            <div class="metric"><div class="label">Версия</div><div class="value mono">@selectedCard.Version</div></div>
                            <div class="metric"><div class="label">Уровень</div><div class="value">@LevelName(selectedCard.ObjectLevel)</div></div>
                            <div class="metric"><div class="label">Объект</div><div class="value">@(selectedCard.Node?.Name ?? selectedCard.Aggregate?.Name ?? selectedCard.EquipmentModel?.Name ?? selectedCard.Complex?.Name)</div></div>
                            <div class="metric"><div class="label">Строк в ХК</div><div class="value">@selectedCard.Items.Count</div></div>
                            <div class="metric"><div class="label">Дата создания</div><div class="value">@selectedCard.CreatedAt.ToString("dd.MM.yyyy")</div></div>
                        </div>
                        <div class="note" style="margin-top:12px;">
                            @(selectedCard.Purpose?.Length > 120 ? selectedCard.Purpose[..120] : selectedCard.Purpose)
                        </div>
                        <div class="btnRow" style="margin-top:12px">
                            <button class="btn primary" @onclick="() => GoToEdit(selectedCard.Id)">Открыть</button>
                        </div>
                    }
                </div>
            </section>

            <section class="panel">
                <div class="panelHeader"><h2>Мои задачи</h2><div class="hint">Рабочий процесс</div></div>
                <div class="panelBody">
                    <div class="alerts">
                        @foreach (var card in taskCardsOnReview)
                        {
                            <div class="alert">
                                <div class="top"><p class="title">Согласовать @card.Code</p><span class="tag warn">до @card.CreatedAt.AddDays(7).ToString("dd.MM")</span></div>
                                <p class="desc">Проверить состав марок ГСМ и маршрут согласования.</p>
                            </div>
                        }
                        @foreach (var card in taskCardsRevision)
                        {
                            <div class="alert">
                                <div class="top"><p class="title">Замечания по @card.Code</p><span class="tag bad">критично</span></div>
                                <p class="desc">Заполнить поля «срок действия» и «основание утверждения».</p>
                            </div>
                        }
                        @if (!taskCardsOnReview.Any() && !taskCardsRevision.Any())
                        {
                            <div class="note">Нет активных задач</div>
                        }
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>

@if (_showDeleteDialog && _deleteCard != null)
{
    <div class="modalOverlay" @onclick="CloseDeleteDialog">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="delete-title">Удаление ХК</h3>
                <button type="button" class="modalCloseButton" @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="modalBody">
                <p>ХК «@_deleteCard.Code», версия @_deleteCard.Version, будет переведена в статус «Удалена».</p>
                <div class="field">
                    <label>Причина удаления <span class="text-danger">*</span></label>
                    <textarea @bind="_deleteReason" rows="3" style="width:100%;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:8px;font-family:inherit;font-size:14px" placeholder="Укажите причину…"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="note bad" style="margin-top:12px">@_deleteError</div>
                }
            </div>
            <div class="modalFooter">
                <button class="btn ghost" @onclick="CloseDeleteDialog">Отмена</button>
                <button class="btn bad" @onclick="ConfirmDeleteAsync" disabled="@string.IsNullOrWhiteSpace(_deleteReason)">Удалить</button>
            </div>
        </div>
    </div>
}

@code {
    private List<HKCardListItemDto> filteredCards = new();
    private List<HKCardListItemDto> taskCardsOnReview = new();
    private List<HKCardListItemDto> taskCardsRevision = new();
    private Dictionary<HKCardStatus, int> statusCounts = new();
    private int totalCount;
    private HKCard? selectedCard;
    private bool loading = true;
    private bool canCreate;
    private bool canSendToApprove;
    private bool canApprove;
    private bool canVerify;
    private bool canReturn;
    private string userBranchId = "";
    private string currentUserId = "";
    private readonly HashSet<HKCardStatus> _deletableStatuses = new();
    private bool canSystemConfig;
    private System.Security.Claims.ClaimsPrincipal? _currentUser;

    private bool _showDeleteDialog;
    private Guid _deleteCardId;
    private string _deleteReason = "";
    private string? _deleteError;
    private HKCardListItemDto? _deleteCard;
    private CancellationTokenSource? _loadCts;

    private string filterCode = "";
    private string filterStatus = "";
    private string filterVersion = "";
    private string filterLevel = "";
    private string filterNode = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUser = user;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        canCreate = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKNodeCreate, PermissionCodes.HKAggregateCreate, PermissionCodes.HKEquipmentCreate, PermissionCodes.HKComplexCreate);
        canSendToApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKNodeSubmit, PermissionCodes.HKAggregateSubmit, PermissionCodes.HKEquipmentSubmit, PermissionCodes.HKComplexSubmit);
        canApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKApprove);
        canVerify = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKReview);
        canReturn = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKReview);
        canSystemConfig = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.SystemConfig);

        var checks = new (HKCardStatus Status, string PermissionCode)[]
        {
            (HKCardStatus.Draft, PermissionCodes.HKDeleteDraft),
            (HKCardStatus.OnReview, PermissionCodes.HKDeleteOnReview),
            (HKCardStatus.RevisionRequired, PermissionCodes.HKDeleteRevisionRequired),
        };
        foreach (var (status, permissionCode) in checks)
        {
            if (await Perms.HasPermissionAsync(currentUserId, permissionCode))
                _deletableStatuses.Add(status);
        }

        var claim = user.FindFirst("BranchId");
        if (claim != null) userBranchId = claim.Value;
        _loadCts = new CancellationTokenSource();
        await LoadCards();
    }

    private async Task LoadCards()
    {
        if (_loadCts is null)
            return;

        var ct = _loadCts.Token;
        loading = true;
        try
        {
            await using (await DbLock.WaitAsync(ct))
            {
                if (ct.IsCancellationRequested)
                    return;

                Guid? branchFilter = Guid.TryParse(userBranchId, out var branchId) ? branchId : null;
                statusCounts = await HKCardService.GetStatusCountsAsync(branchFilter, ct);
                totalCount = statusCounts.Values.Sum();

                HKCardStatus? statusFilter = null;
                if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<HKCardStatus>(filterStatus, out var parsedStatus))
                    statusFilter = parsedStatus;

                HKObjectLevel? levelFilter = null;
                if (!string.IsNullOrEmpty(filterLevel) && Enum.TryParse<HKObjectLevel>(filterLevel, out var parsedLevel))
                    levelFilter = parsedLevel;

                var paged = await HKCardService.GetFilteredAsync(
                    code: string.IsNullOrWhiteSpace(filterCode) ? null : filterCode,
                    status: statusFilter,
                    objectLevel: levelFilter,
                    version: string.IsNullOrWhiteSpace(filterVersion) ? null : filterVersion,
                    nodeSearch: string.IsNullOrWhiteSpace(filterNode) ? null : filterNode,
                    branchId: branchFilter,
                    page: 1,
                    pageSize: 200,
                    ct: ct);
                filteredCards = paged.Items.ToList();

                taskCardsOnReview = await HKCardService.GetTaskCardsAsync(HKCardStatus.OnReview, branchFilter, ct);
                taskCardsRevision = await HKCardService.GetTaskCardsAsync(HKCardStatus.RevisionRequired, branchFilter, ct);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // компонент уже уничтожен, не обновляем UI
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        await LoadCards();
    }

    private async Task SelectCard(Guid id)
    {
        selectedCard = await HKCardService.GetByIdAsync(id);
    }

    private void GoToCreate() => Nav.NavigateTo("/хк/создать");
    private void GoToEdit(Guid id) => Nav.NavigateTo($"/хк/{id}");

    private bool CanDeleteCard(HKCardListItemDto card)
    {
        if (!_deletableStatuses.Contains(card.Status)) return false;
        if (canSystemConfig) return true;
        return card.BranchId.ToString() == userBranchId;
    }

    private void OpenDeleteDialog(HKCardListItemDto card)
    {
        if (!CanDeleteCard(card)) return;
        _deleteCard = card;
        _deleteCardId = card.Id;
        _deleteReason = "";
        _deleteError = null;
        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        _showDeleteDialog = false;
        _deleteCard = null;
        _deleteCardId = Guid.Empty;
        _deleteReason = "";
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var reason = _deleteReason?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(reason))
        {
            _deleteError = "Укажите причину удаления ХК.";
            return;
        }

        var (success, error) = await HKCardService.DeleteAsync(_deleteCardId, reason);
        if (!success)
        {
            _deleteError = error ?? "Не удалось удалить ХК.";
            return;
        }

        CloseDeleteDialog();
        await LoadCards();
    }

    private static string LevelName(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Complex => "Комплекс",
        HKObjectLevel.EquipmentModel => "Изделие",
        HKObjectLevel.Aggregate => "Агрегат",
        HKObjectLevel.Node => "Узел",
        _ => "—"
    };

    private void DeleteCard(Guid id)
    {
        var card = filteredCards.FirstOrDefault(c => c.Id == id);
        if (card == null || !CanDeleteCard(card)) return;
        OpenDeleteDialog(card);
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}