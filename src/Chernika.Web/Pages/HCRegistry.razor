        "ComplexComposition" when task.EntityId.HasValue => $"/составы/комплексы/{task.EntityId.Value}/версии/{task.EntityId.Value}",
        "AggregateComposition" when task.EntityId.HasValue => $"/составы/агрегаты/{task.EntityId.Value}/версии/{task.EntityId.Value}",
