    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;

    private void GoToCreate() => Nav.NavigateTo("/хк/создать");
    private void GoToEdit(Guid id) => Nav.NavigateTo($"/хк/{id}");
    private string PdfUrl(Guid id) => $"{Nav.BaseUri}api/hkcards/{id}/attachment/content?inline=true";

    private async Task SelectCard(Guid id)
    {
        _openActionMenuCardId = null;
        _selectedCard = _result.Items.FirstOrDefault(c => c.Id == id);
        if (_selectedCard == null)
        {
            await using (await DbLock.WaitAsync())
            {
                var card = await HKCardService.GetByIdAsync(id);
                if (card != null)
                {
                    _selectedCard = new HKCardRegistryListItemDto
                    {
                        Id = card.Id,
                        Code = card.Code,
                        Version = card.Version,
                        Status = card.Status,
                        ObjectLevel = card.ObjectLevel,
                        BranchId = card.BranchId,
                        BranchName = card.Branch?.Name,
                        EffectiveDate = card.EffectiveDate,
                        ExpirationDate = card.ExpirationDate,
                        RequestOrganization = card.RequestOrganization,
                        IncomingLetterNumber = card.IncomingLetterNumber,
                        OutgoingLetterNumber = card.OutgoingLetterNumber,
                        AuthorId = card.AuthorId?.ToString()
                    };
                }
            }
        }
    }

    private void ToggleActionMenu(Guid cardId)
    {
        _openActionMenuCardId = _openActionMenuCardId == cardId ? null : cardId;
    }

    private List<ActionGroup> GetActionGroups(HKCardRegistryListItemDto card)
    {
        var document = new List<ActionItem>();
        if (CanEdit(card))
            document.Add(new ActionItem("edit", "Редактировать"));
        if (CanCreateNewVersion(card))
            document.Add(new ActionItem("version", "Создать новую версию"));
        if (card.HasPdf)
            document.Add(new ActionItem("pdf", "Открыть PDF"));

        var approval = new List<ActionItem>();
        if (CanSubmit(card))
            approval.Add(new ActionItem("submit", "Отправить на согласование"));
        if (CanReturn(card))
            approval.Add(new ActionItem("return", "Вернуть в черновик"));
        if (CanApprove(card))
            approval.Add(new ActionItem("approve", "Утвердить"));
        if (CanArchive(card))
            approval.Add(new ActionItem("archive", "Архивировать"));

        var closing = new List<ActionItem>();
        if (CanDelete(card))
            closing.Add(new ActionItem("delete", "Удалить"));

        var groups = new List<ActionGroup>();
        if (document.Any()) groups.Add(new ActionGroup("Документ", document));
        if (approval.Any()) groups.Add(new ActionGroup("Согласование", approval));
        if (closing.Any()) groups.Add(new ActionGroup("Закрытие", closing));
        return groups;
    }

    private async Task ExecuteAction(HKCardRegistryListItemDto card, string key)
    {
        _openActionMenuCardId = null;
        switch (key)
        {
            case "edit": GoToEdit(card.Id); break;
            case "version": await CreateNewVersion(card.Id); break;
            case "pdf": Nav.NavigateTo(PdfUrl(card.Id), forceLoad: true); break;
            case "submit": await ChangeStatus(card.Id, HKCardStatus.OnReview, "Отправлено на согласование из реестра"); break;
            case "return": await ChangeStatus(card.Id, HKCardStatus.RevisionRequired, "Возвращено в черновик из реестра"); break;
            case "approve": await ChangeStatus(card.Id, HKCardStatus.Approved, "Утверждено из реестра"); break;
            case "archive": await OpenArchiveModal(card.Id); break;
            case "delete": OpenDeleteDialog(card); break;
        }
    }

    private async Task ChangeStatus(Guid id, HKCardStatus status, string comment)
    {
        var (success, error) = await HKCardService.ChangeStatusAsync(id, status, comment);
        if (!success)
        {
            _errorMessage = error ?? "Не удалось изменить статус.";
            return;
        }
        await LoadDataAsync();
    }

    private bool CanEdit(HKCardRegistryListItemDto card) =>
        (card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired)
        && HasEditDraftPermission(card.ObjectLevel)
        && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private bool HasEditDraftPermission(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Node => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKNodeEditDraft).Result,
        HKObjectLevel.Aggregate => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKAggregateEditDraft).Result,
        HKObjectLevel.EquipmentModel => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKEquipmentEditDraft).Result,
        HKObjectLevel.Complex => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKComplexEditDraft).Result,
        _ => false
    };

    private bool CanSubmit(HKCardRegistryListItemDto card) =>
        (card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired)
        && HasSubmitPermission(card.ObjectLevel)
        && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private bool HasSubmitPermission(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Node => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKNodeSubmit).Result,
        HKObjectLevel.Aggregate => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKAggregateSubmit).Result,
        HKObjectLevel.EquipmentModel => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKEquipmentSubmit).Result,
        HKObjectLevel.Complex => Perms.HasPermissionAsync(_currentUserId, PermissionCodes.HKComplexSubmit).Result,
        _ => false
    };

    private bool CanReturn(HKCardRegistryListItemDto card) =>
        card.Status == HKCardStatus.OnReview && _canReview && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private bool CanApprove(HKCardRegistryListItemDto card) =>
        card.Status == HKCardStatus.OnReview && _canApprove && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private bool CanArchive(HKCardRegistryListItemDto card) =>
        card.Status == HKCardStatus.Approved && _canArchive && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private bool CanCreateNewVersion(HKCardRegistryListItemDto card) =>
        (card.Status is HKCardStatus.Approved or HKCardStatus.Archived)
        && _canCreateAnyHk
        && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private bool CanDelete(HKCardRegistryListItemDto card) =>
        _deletableStatuses.Contains(card.Status) && (card.BranchId.ToString() == _userBranchId || _canSystemConfig);

    private async Task CreateNewVersion(Guid id)
    {
        var (success, newCardId, error) = await HKCardService.CreateNewVersionAsync(id);
        if (success && newCardId.HasValue)
            Nav.NavigateTo($"/хк/{newCardId.Value}");
        else
            _errorMessage = error ?? "Не удалось создать версию.";
    }

    private async Task OpenArchiveModal(Guid id)
    {
        _archiveCardId = id;
        _archiveVersions = await HKCardService.GetVersionsAsync(id);
        _archiveReplacementCardId = _archiveVersions
            .Where(v => v.Id != id && v.Status == HKCardStatus.Approved)
            .Select(v => (Guid?)v.Id)
            .FirstOrDefault() ?? Guid.Empty;
        _archiveReason = "";
        _archiveError = null;
        _showArchiveModal = true;
    }

    private void CloseArchiveModal()
    {
        _showArchiveModal = false;
        _archiveCardId = Guid.Empty;
        _archiveVersions = new List<HKCardVersionDto>();
        _archiveReplacementCardId = Guid.Empty;
        _archiveReason = "";
        _archiveError = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        var reason = _archiveReason?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(reason))
        {
            _archiveError = "Укажите причину архивирования ХК.";
            return;
        }
        if (_archiveReplacementCardId == Guid.Empty)
        {
            _archiveError = "Выберите заменяющую утверждённую ХК.";
            return;
        }
        var (success, error) = await HKCardService.ArchiveAsync(_archiveCardId, _archiveReplacementCardId, reason);
        if (!success)
        {
            _archiveError = error ?? "Не удалось заархивировать ХК.";
            return;
        }
        CloseArchiveModal();
        await LoadDataAsync();
    }

    private void OpenDeleteDialog(HKCardRegistryListItemDto card)
    {
        if (!CanDelete(card)) return;
        _deleteCard = card;
        _deleteCardId = card.Id;
        _deleteReason = "";
        _deleteError = null;
        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        _showDeleteDialog = false;
        _deleteCard = null;
        _deleteCardId = Guid.Empty;
        _deleteReason = "";
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var reason = _deleteReason?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(reason))
        {
            _deleteError = "Укажите причину удаления ХК.";
            return;
        }
        var (success, error) = await HKCardService.DeleteAsync(_deleteCardId, reason);
        if (!success)
        {
            _deleteError = error ?? "Не удалось удалить ХК.";
            return;
        }
        CloseDeleteDialog();
        await LoadDataAsync();
    }

