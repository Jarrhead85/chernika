@page "/реестр-хк"
@attribute [Authorize(Policy = "ViewHK")]
@implements System.IDisposable
@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Web.Services
@using Chernika.Web.Components
@inject HKCardService HKCardService
@inject TaskService TaskService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@inject IJSRuntime JS

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <div>
                <h2>Реестр ХК</h2>
                <div class="muted">Нормативные документы по технике и ГСМ</div>
            </div>
            @if (_canCreateAnyHk)
            {
                <button class="btn primary" @onclick="GoToCreate">+ Создать ХК</button>
            }
        </div>
    </section>

    <div class="registryPageGrid">
        <section class="panel registryKpiPanel">
            <div class="panelBody">
                <div class="heroGrid">
                    <div class="heroStat" @onclick="() => SetStatusFilter(null)">
                        <div class="label">Всего ХК</div>
                        <div class="value">@_kpi.Total</div>
                    </div>
                    <div class="heroStat" @onclick="() => SetStatusFilter(HKCardStatus.Draft)">
                        <div class="label">Черновики</div>
                        <div class="value">@_kpi.Draft</div>
                    </div>
                    <div class="heroStat" @onclick="() => SetStatusFilter(HKCardStatus.OnReview)">
                        <div class="label">На согласовании</div>
                        <div class="value">@_kpi.OnReview</div>
                    </div>
                    <div class="heroStat" @onclick="() => SetStatusFilter(HKCardStatus.RevisionRequired)">
                        <div class="label">На доработке</div>
                        <div class="value">@_kpi.RevisionRequired</div>
                    </div>
                    <div class="heroStat" @onclick="() => SetStatusFilter(HKCardStatus.Approved)">
                        <div class="label">Утверждённые</div>
                        <div class="value">@_kpi.Approved</div>
                    </div>
                    <div class="heroStat" @onclick="() => SetRequiresMyAction(true)">
                        <div class="label">Требуют моих действий</div>
                        <div class="value">@_kpi.RequiresMyAction</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="panel registryTasksPanel">
            <div class="panelHeader"><h2>Мои задачи</h2><div class="hint">@_myTasks.Count открытых</div></div>
            <div class="panelBody">
                @if (!_myTasks.Any())
                {
                    <div class="registryEmptyState">Нет открытых задач</div>
                }
                else
                {
                    <div class="taskPreviewList">
                        @foreach (var task in _myTasks.Take(3))
                        {
                            <WorkTaskRow Task="task" />
                        }
                    </div>
                }
                <a class="btn ghost tasksAllLink" href="/задачи">Все задачи →</a>
            </div>
        </section>

        <section class="panel registryFiltersPanel">
            <div class="panelHeader"><h2>Поиск и фильтры</h2><div class="hint">Серверная фильтрация</div></div>
            <div class="panelBody">
                <div class="registryFiltersForm">
                    <div class="registryFilterPrimaryRow @(_canSystemConfig ? "" : "noBranch")">
                        <div class="field">
                            <label>Поиск</label>
                            <input @bind="_query.SearchText" placeholder="Код, версия, объект, организация, письмо…" />
                        </div>
                        <div class="field">
                            <label>Статус</label>
                            <select @bind="_query.Status" class="field-select">
                                <option value="">Все</option>
                                @foreach (var s in _statusOptions)
                                {
                                    <option value="@s.Value">@s.Label</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>Уровень ХК</label>
                            <select @bind="_query.ObjectLevel" class="field-select">
                                <option value="">Все</option>
                                @foreach (var l in _levelOptions)
                                {
                                    <option value="@l.Value">@l.Label</option>
                                }
                            </select>
                        </div>
                        @if (_canSystemConfig)
                        {
                            <div class="field">
                                <label>Филиал</label>
                                <select class="field-select" @bind="_branchFilterId">
                                    <option value="">Все</option>
                                    @foreach (var b in _branches)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    <div class="registryFilterOptionsRow">
                        <div class="field">
                            <label>Сортировка</label>
                            <select @bind="_query.SortBy" class="field-select">
                                <option value="created">По созданию</option>
                                <option value="code">По коду</option>
                                <option value="status">По статусу</option>
                                <option value="level">По уровню</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Направление</label>
                            <select @bind="_sortDescStr" class="field-select">
                                <option value="true">По убыванию</option>
                                <option value="false">По возрастанию</option>
                            </select>
                        </div>
                        <div class="registryQuickFilters" aria-label="Быстрые фильтры">
                            <button type="button"
                                    class="filterToggle @(_query.OnlyMine ? "active" : null)"
                                    aria-pressed="@_query.OnlyMine"
                                    @onclick="ToggleOnlyMine">
                                <span class="filterToggleMark">@(_query.OnlyMine ? "✓" : "")</span>
                                Только мои
                            </button>
                            <button type="button"
                                    class="filterToggle @(_query.RequiresMyAction ? "active" : null)"
                                    aria-pressed="@_query.RequiresMyAction"
                                    @onclick="ToggleRequiresMyAction">
                                <span class="filterToggleMark">@(_query.RequiresMyAction ? "✓" : "")</span>
                                Требуют моих действий
                            </button>
                        </div>
                    </div>

                    <div class="registryFilterActions">
                        <button class="btn" @onclick="ToggleAdvanced">@(_showAdvanced ? "Скрыть" : "Дополнительно")</button>
                        <button class="btn primary" @onclick="ApplyFilters">Применить</button>
                        <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                    </div>

                    @if (_showAdvanced)
                    {
                        <div class="registryFilterAdvanced">
                            <div class="field"><label>Дата создания с</label><input type="date" @bind="_query.CreatedFrom" class="field-input" /></div>
                            <div class="field"><label>Дата создания по</label><input type="date" @bind="_query.CreatedTo" class="field-input" /></div>
                            <div class="field"><label>Дата утверждения с</label><input type="date" @bind="_query.ApprovedFrom" class="field-input" /></div>
                            <div class="field"><label>Дата утверждения по</label><input type="date" @bind="_query.ApprovedTo" class="field-input" /></div>
                            <div class="field">
                                <label>Срок действия</label>
                                <select @bind="_query.ExpirationFilter" class="field-select">
                                    @foreach (var e in _expirationOptions)
                                    {
                                        <option value="@e.Value">@e.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>PDF-скан</label>
                                <select @bind="_hasPdfStr" class="field-select">
                                    <option value="">Все</option>
                                    <option value="true">Есть PDF</option>
                                    <option value="false">Нет PDF</option>
                                </select>
                            </div>
                            <div class="field registryFilterAuthor">
                                <label>Автор</label>
                                <select @bind="_query.AuthorId" class="field-select">
                                    <option value="">Все</option>
                                    @foreach (var a in _authors)
                                    {
                                        <option value="@a.Id">@a.FullName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="panel registryListPanel">
            <div class="panelHeader">
                <h2>Список ХК</h2>
                <div class="hint">@_result.TotalCount записей</div>
            </div>
            <div class="panelBody">
                @if (_loading)
                {
                    <div class="loading-state">Загрузка…</div>
                }
                else if (!_result.Items.Any())
                {
                    <div class="registryEmptyState">Нет ХК, соответствующих фильтру</div>
                }
                else
                {
                    <div class="registryTableWrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Код / Версия</th>
                                    <th>Объект</th>
                                    <th>Уровень</th>
                                    <th>Статус</th>
                                    <th>Филиал</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in _result.Items)
                                {
                                    var actionGroups = GetActionGroups(card);
                                    var hasActions = actionGroups.Any(g => g.Actions.Count > 0);
                                    <tr class="clickableRow @(_selectedCard?.Id == card.Id ? "row-active" : "")"
                                        @onclick="() => SelectCard(card.Id)"
                                        @ondblclick="() => GoToEdit(card.Id)">
                                        <td class="mono">@card.Code<br/><span class="muted">@card.Version</span></td>
                                        <td>@card.ObjectName<br/><span class="mono muted">@card.ObjectCode</span></td>
                                        <td>@LevelName(card.ObjectLevel)</td>
                                        <td><StatusBadge Status="@card.Status" /></td>
                                        <td>@card.BranchName</td>
                                        <td>
                                            <div class="rowActions">
                                                <button type="button" class="btn ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => GoToEdit(card.Id)">Открыть</button>
                                                @if (hasActions)
                                                {
                                                    <button type="button"
                                                            class="btn ghost iconBtn"
                                                            aria-label="Дополнительные действия"
                                                            aria-haspopup="menu"
                                                            aria-expanded="@(_openActionMenuCardId == card.Id)"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="@(e => ToggleActionMenuAsync(card.Id, e))">
                                                        ⋯
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="footer">
                        <div>
                            @if (_result.Page > 1)
                            {
                                <button class="linkBtn" @onclick="() => GoToPage(_result.Page - 1)">← Назад</button>
                            }
                            <span class="mono">стр. @_result.Page из @Math.Max(1, (_result.TotalCount + _result.PageSize - 1) / _result.PageSize)</span>
                            @if (_result.Page < (_result.TotalCount + _result.PageSize - 1) / _result.PageSize)
                            {
                                <button class="linkBtn" @onclick="() => GoToPage(_result.Page + 1)">Вперёд →</button>
                            }
                        </div>
                        <div class="mono">Показано @_result.Items.Count из @_result.TotalCount</div>
                    </div>
                }
            </div>
        </section>

        <aside class="registryDetailPanel">
            <section class="panel">
                <div class="panelHeader"><h2>Карточка ХК</h2><div class="hint">Быстрый просмотр</div></div>
                <div class="panelBody">
                    @if (_selectedCard == null)
                    {
                        <div class="registryEmptyState">Выберите ХК из списка</div>
                    }
                    else
                    {
                        <div class="metrics2">
                            <div class="metric"><div class="label">Код</div><div class="value mono">@_selectedCard.Code</div></div>
                            <div class="metric"><div class="label">Версия</div><div class="value mono">@_selectedCard.Version</div></div>
                            <div class="metric"><div class="label">Статус</div><div class="value"><StatusBadge Status="@_selectedCard.Status" /></div></div>
                            <div class="metric"><div class="label">Уровень</div><div class="value">@LevelName(_selectedCard.ObjectLevel)</div></div>
                            <div class="metric"><div class="label">Объект</div><div class="value">@_selectedCard.ObjectName</div></div>
                            <div class="metric"><div class="label">Филиал</div><div class="value">@_selectedCard.BranchName</div></div>
                            <div class="metric"><div class="label">Автор</div><div class="value">@(_selectedCard.AuthorName ?? "—")</div></div>
                            <div class="metric"><div class="label">Создана</div><div class="value mono">@_selectedCard.CreatedAt.ToString("dd.MM.yyyy")</div></div>
                        </div>
                        <div class="field">
                            <label>Период действия</label>
                            <div>
                                @if (_selectedCard.EffectiveDate.HasValue)
                                {
                                    <span>Действует с @_selectedCard.EffectiveDate.Value.ToString("dd.MM.yyyy")</span>
                                    @if (_selectedCard.ExpirationDate.HasValue)
                                    {
                                        <span> — @_selectedCard.ExpirationDate.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                }
                                else
                                {
                                    <span class="muted">Не задан</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_selectedCard.RequestOrganization) || !string.IsNullOrEmpty(_selectedCard.IncomingLetterNumber) || !string.IsNullOrEmpty(_selectedCard.OutgoingLetterNumber))
                        {
                            <div class="field">
                                <label>Основание</label>
                                <div class="mono">
                                    @if (!string.IsNullOrEmpty(_selectedCard.RequestOrganization))
                                    {
                                        <div>@_selectedCard.RequestOrganization</div>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedCard.IncomingLetterNumber))
                                    {
                                        <div>Вход. № @_selectedCard.IncomingLetterNumber</div>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedCard.OutgoingLetterNumber))
                                    {
                                        <div>Исх. № @_selectedCard.OutgoingLetterNumber</div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="field">
                            <label>PDF-скан</label>
                            @if (_selectedCard.HasPdf)
                            {
                                <a class="btn" href="@PdfUrl(_selectedCard.Id)" target="_blank">Открыть PDF</a>
                            }
                            else
                            {
                                <span class="muted">PDF не прикреплён</span>
                            }
                        </div>
                        <div class="btnRow">
                            <button class="btn primary" @onclick="() => GoToEdit(_selectedCard.Id)">Открыть карточку</button>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@if (_openActionMenuCardId is Guid cardId)
{
    var card = _result.Items.FirstOrDefault(item => item.Id == cardId);
    if (card is not null)
    {
        var actionGroups = GetActionGroups(card);
        if (actionGroups.Any(group => group.Actions.Count > 0))
        {
            <div class="actionMenuBackdrop" @onclick="CloseActionMenu"></div>

            <div class="registryActionOverlay @(_actionMenuOpenUpward ? "opensUpward" : null)"
                 role="menu"
                 tabindex="-1"
                 style="@ActionMenuStyle"
                 @ref="_actionMenuOverlayRef"
                 @onkeydown="HandleMenuKeyDown">
                @foreach (var group in actionGroups)
                {
                    @if (!string.IsNullOrEmpty(group.Title))
                    {
                        <div class="actionMenuTitle">@group.Title</div>
                    }

                    @foreach (var action in group.Actions)
                    {
                        <button type="button"
                                class="actionMenuItem"
                                role="menuitem"
                                @onclick="() => ExecuteAction(card, action.Key)">
                            @action.Label
                        </button>
                    }
                }
            </div>
        }
    }
}

@if (_showDeleteDialog && _deleteCard != null)
{
    <div class="modalOverlay" @onclick="CloseDeleteDialog">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="delete-title">Удаление ХК</h3>
                <button type="button" class="modalCloseButton" @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="modalBody">
                <p>ХК «@_deleteCard.Code», версия @_deleteCard.Version, будет переведена в статус «Удалена».</p>
                <div class="field">
                    <label>Причина удаления <span class="text-danger">*</span></label>
                    <textarea @bind="_deleteReason" rows="3" class="fieldInput" placeholder="Укажите причину…"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="note bad" style="margin-top:12px">@_deleteError</div>
                }
            </div>
            <div class="modalFooter">
                <button class="btn ghost" @onclick="CloseDeleteDialog">Отмена</button>
                <button class="btn bad" @onclick="ConfirmDeleteAsync" disabled="@string.IsNullOrWhiteSpace(_deleteReason)">Удалить</button>
            </div>
        </div>
    </div>
}

@if (_showArchiveModal)
{
    <div class="modalOverlay" @onclick="CloseArchiveModal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="archive-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="archive-title">Архивирование ХК</h3>
                <button type="button" class="modalCloseButton" @onclick="CloseArchiveModal">×</button>
            </div>
            <div class="modalBody">
                <p>ХК будет переведена в статус «Архивная».</p>
                <div class="field">
                    <label>Заменяющая утверждённая ХК <span class="text-danger">*</span></label>
                    <select class="field-select" @bind="_archiveReplacementCardId">
                        <option value="@Guid.Empty">— выберите —</option>
                        @foreach (var v in _archiveVersions.Where(v => v.Id != _archiveCardId && v.Status == HKCardStatus.Approved).OrderBy(v => v.Version))
                        {
                            <option value="@v.Id">@v.Version</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Причина архивирования <span class="text-danger">*</span></label>
                    <textarea @bind="_archiveReason" rows="3" class="fieldInput" placeholder="Укажите причину…"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_archiveError))
                {
                    <div class="note bad" style="margin-top:12px">@_archiveError</div>
                }
            </div>
            <div class="modalFooter">
                <button class="btn ghost" @onclick="CloseArchiveModal">Отмена</button>
                <button class="btn primary" @onclick="ConfirmArchiveAsync" disabled="@(string.IsNullOrWhiteSpace(_archiveReason) || _archiveReplacementCardId == Guid.Empty)">Архивировать</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="error" style="margin-top:12px">@_errorMessage</div>
}

@code {
    private HKCardKpiDto _kpi = new();
    private PagedResult<HKCardRegistryListItemDto> _result = new() { Items = new List<HKCardRegistryListItemDto>() };
    private List<WorkTaskListItemDto> _myTasks = new();
    private HKCardRegistryListItemDto? _selectedCard;
    private HKCardRegistryQuery _query = new() { PageSize = 50 };
    private List<Branch> _branches = new();
    private List<HKCardRegistryAuthorDto> _authors = new();
    private bool _loading = true;
    private bool _showAdvanced;
    private string _sortDescStr = "true";
    private string _hasPdfStr = "";
    private string _branchFilterId = "";
    private string _currentUserId = "";
    private string _userBranchId = "";
    private bool _canCreateAnyHk;
    private bool _canSystemConfig;
    private bool _canReview;
    private bool _canApprove;
    private bool _canArchive;
    private readonly HashSet<HKCardStatus> _deletableStatuses = new();
    private Guid? _openActionMenuCardId;
    private double _actionMenuLeft;
    private double _actionMenuTop;
    private bool _actionMenuOpenUpward;
    private bool _focusActionMenuAfterRender;
    private ElementReference _actionMenuOverlayRef;
    private CancellationTokenSource? _loadCts;
    private string? _errorMessage;

    private const double ActionMenuWidth = 220;
    private const double ActionMenuEstimatedHeight = 220;
    private const double ViewportPadding = 8;
    private readonly HashSet<string> _grantedPermissions = new(StringComparer.Ordinal);

    private bool _showDeleteDialog;
    private Guid _deleteCardId;
    private string _deleteReason = "";
    private string? _deleteError;
    private HKCardRegistryListItemDto? _deleteCard;

    private bool _showArchiveModal;
    private Guid _archiveCardId;
    private IReadOnlyList<HKCardVersionDto> _archiveVersions = new List<HKCardVersionDto>();
    private Guid _archiveReplacementCardId;
    private string _archiveReason = "";
    private string? _archiveError;

    private static readonly string[] RegistryPermissionCodes =
    {
        PermissionCodes.HKNodeCreate,
        PermissionCodes.HKAggregateCreate,
        PermissionCodes.HKEquipmentCreate,
        PermissionCodes.HKComplexCreate,
        PermissionCodes.HKNodeEditDraft,
        PermissionCodes.HKAggregateEditDraft,
        PermissionCodes.HKEquipmentEditDraft,
        PermissionCodes.HKComplexEditDraft,
        PermissionCodes.HKNodeSubmit,
        PermissionCodes.HKAggregateSubmit,
        PermissionCodes.HKEquipmentSubmit,
        PermissionCodes.HKComplexSubmit,
        PermissionCodes.HKReview,
        PermissionCodes.HKApprove,
        PermissionCodes.HKArchive,
        PermissionCodes.HKDeleteDraft,
        PermissionCodes.HKDeleteOnReview,
        PermissionCodes.HKDeleteRevisionRequired,
        PermissionCodes.SystemConfig,
    };

    private readonly List<StatusOption> _statusOptions = new()
    {
        new(HKCardStatus.Draft, "Черновик"),
        new(HKCardStatus.OnReview, "На согласовании"),
        new(HKCardStatus.RevisionRequired, "На доработке"),
        new(HKCardStatus.Approved, "Утверждена"),
        new(HKCardStatus.Archived, "В архиве"),
        new(HKCardStatus.Deleted, "Закрыта")
    };

    private readonly List<LevelOption> _levelOptions = new()
    {
        new(HKObjectLevel.Complex, "Комплекс"),
        new(HKObjectLevel.EquipmentModel, "Изделие"),
        new(HKObjectLevel.Aggregate, "Агрегат"),
        new(HKObjectLevel.Node, "Узел")
    };

    private readonly List<ExpirationOption> _expirationOptions = new()
    {
        new(HKCardExpirationFilter.All, "Все"),
        new(HKCardExpirationFilter.Expiring90Days, "Истекает в течение 90 дней"),
        new(HKCardExpirationFilter.Expiring30Days, "Истекает в течение 30 дней"),
        new(HKCardExpirationFilter.Expired, "Просрочена")
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _userBranchId = user.FindFirst("BranchId")?.Value ?? "";

        await LoadPermissionMatrixAsync();

        _canCreateAnyHk = HasCreatePermission(HKObjectLevel.Node)
            || HasCreatePermission(HKObjectLevel.Aggregate)
            || HasCreatePermission(HKObjectLevel.EquipmentModel)
            || HasCreatePermission(HKObjectLevel.Complex);
        _canSystemConfig = HasPermission(PermissionCodes.SystemConfig);
        _canReview = HasPermission(PermissionCodes.HKReview);
        _canApprove = HasPermission(PermissionCodes.HKApprove);
        _canArchive = HasPermission(PermissionCodes.HKArchive);

        if (HasPermission(PermissionCodes.HKDeleteDraft))
            _deletableStatuses.Add(HKCardStatus.Draft);
        if (HasPermission(PermissionCodes.HKDeleteOnReview))
            _deletableStatuses.Add(HKCardStatus.OnReview);
        if (HasPermission(PermissionCodes.HKDeleteRevisionRequired))
            _deletableStatuses.Add(HKCardStatus.RevisionRequired);

        _loadCts = new CancellationTokenSource();
        await LoadBranchesAsync();
        await LoadAuthorsAsync();
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusActionMenuAfterRender && _openActionMenuCardId.HasValue)
        {
            _focusActionMenuAfterRender = false;
            try
            {
                await _actionMenuOverlayRef.FocusAsync();
            }
            catch
            {
                // ignore if ref not yet rendered
            }
        }
    }

    private async Task LoadPermissionMatrixAsync()
    {
        if (string.IsNullOrEmpty(_currentUserId))
            return;

        foreach (var code in RegistryPermissionCodes)
        {
            if (await Perms.HasPermissionAsync(_currentUserId, code))
                _grantedPermissions.Add(code);
        }
    }

    private bool HasPermission(string code) => _grantedPermissions.Contains(code);

    private bool HasCreatePermission(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Node => HasPermission(PermissionCodes.HKNodeCreate),
        HKObjectLevel.Aggregate => HasPermission(PermissionCodes.HKAggregateCreate),
        HKObjectLevel.EquipmentModel => HasPermission(PermissionCodes.HKEquipmentCreate),
        HKObjectLevel.Complex => HasPermission(PermissionCodes.HKComplexCreate),
        _ => false
    };

    private async Task LoadBranchesAsync()
    {
        if (!_canSystemConfig) return;
        await using (await DbLock.WaitAsync())
        {
            _branches = await HKCardService.GetAllBranchesAsync();
        }
    }

    private async Task LoadAuthorsAsync()
    {
        await using (await DbLock.WaitAsync())
        {
            _authors = await HKCardService.GetAuthorsAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        if (_loadCts is null) return;
        CloseActionMenu();
        var ct = _loadCts.Token;
        _loading = true;
        _errorMessage = null;
        try
        {
            await using (await DbLock.WaitAsync(ct))
            {
                if (ct.IsCancellationRequested) return;

                _query.BranchId = Guid.TryParse(_branchFilterId, out var b) ? b : (_canSystemConfig ? null : Guid.TryParse(_userBranchId, out var ub) ? ub : null);
                _query.SortDescending = _sortDescStr == "true";
                _query.HasPdf = _hasPdfStr switch { "true" => true, "false" => false, _ => null };

                _kpi = await HKCardService.GetRegistryKpiAsync(_query.BranchId, ct);
                _result = await HKCardService.GetRegistryPageAsync(_query, ct);

                var taskResult = await TaskService.GetMyTasksAsync(new WorkTaskQuery
                {
                    Page = 1,
                    PageSize = 3,
                    ActiveOnly = true,
                    SortBy = "due",
                    SortDescending = false
                }, ct);
                _myTasks = taskResult.Items.ToList();

                if (_selectedCard != null)
                {
                    _selectedCard = _result.Items.FirstOrDefault(c => c.Id == _selectedCard.Id);
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _query.Page = 1;
        await LoadDataAsync();
    }

    private async Task ResetFilters()
    {
        _query = new HKCardRegistryQuery { PageSize = 50 };
        _sortDescStr = "true";
        _hasPdfStr = "";
        _branchFilterId = "";
        _showAdvanced = false;
        await LoadDataAsync();
    }

    private async Task GoToPage(int page)
    {
        _query.Page = page;
        await LoadDataAsync();
    }

    private async Task SetStatusFilter(HKCardStatus? status)
    {
        _query.Status = status;
        _query.RequiresMyAction = false;
        _query.Page = 1;
        await LoadDataAsync();
    }

    private async Task SetRequiresMyAction(bool value)
    {
        _query.RequiresMyAction = value;
        _query.Status = null;
        _query.Page = 1;
        await LoadDataAsync();
    }

    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;
    private void ToggleOnlyMine() => _query.OnlyMine = !_query.OnlyMine;
    private void ToggleRequiresMyAction() => _query.RequiresMyAction = !_query.RequiresMyAction;

    private void GoToCreate() => Nav.NavigateTo("/хк/создать");
    private void GoToEdit(Guid id) => Nav.NavigateTo($"/хк/{id}");
    private string PdfUrl(Guid id) => $"{Nav.BaseUri}api/hkcards/{id}/attachment/content?inline=true";

    private async Task SelectCard(Guid id)
    {
        CloseActionMenu();
        _selectedCard = _result.Items.FirstOrDefault(c => c.Id == id);
        if (_selectedCard == null)
        {
            await using (await DbLock.WaitAsync())
            {
                var card = await HKCardService.GetByIdAsync(id);
                if (card != null)
                {
                    _selectedCard = new HKCardRegistryListItemDto
                    {
                        Id = card.Id,
                        Code = card.Code,
                        Version = card.Version,
                        Status = card.Status,
                        ObjectLevel = card.ObjectLevel,
                        BranchId = card.BranchId,
                        BranchName = card.Branch?.Name,
                        EffectiveDate = card.EffectiveDate,
                        ExpirationDate = card.ExpirationDate,
                        RequestOrganization = card.RequestOrganization,
                        IncomingLetterNumber = card.IncomingLetterNumber,
                        OutgoingLetterNumber = card.OutgoingLetterNumber,
                        AuthorId = card.AuthorId?.ToString()
                    };
                }
            }
        }
    }

    private async Task ToggleActionMenuAsync(Guid cardId, MouseEventArgs e)
    {
        if (_openActionMenuCardId == cardId)
        {
            CloseActionMenu();
            return;
        }

        ViewportSize viewport;
        try
        {
            viewport = await JS.InvokeAsync<ViewportSize>("chernika.getViewportSize");
        }
        catch
        {
            viewport = new ViewportSize { Width = 1024, Height = 768 };
        }

        var opensLeft = e.ClientX + ActionMenuWidth + ViewportPadding > viewport.Width;
        _actionMenuOpenUpward = e.ClientY + ActionMenuEstimatedHeight + ViewportPadding > viewport.Height;

        _actionMenuLeft = opensLeft
            ? Math.Max(ViewportPadding, e.ClientX - ActionMenuWidth)
            : Math.Min(e.ClientX, viewport.Width - ActionMenuWidth - ViewportPadding);

        _actionMenuTop = _actionMenuOpenUpward
            ? Math.Max(ViewportPadding, e.ClientY - 6)
            : Math.Min(e.ClientY + 6, viewport.Height - ViewportPadding);

        _openActionMenuCardId = cardId;
        _focusActionMenuAfterRender = true;
    }

    private string ActionMenuStyle => $"position:fixed;left:{_actionMenuLeft:F0}px;top:{_actionMenuTop:F0}px;";

    private void CloseActionMenu()
    {
        _openActionMenuCardId = null;
        _actionMenuOpenUpward = false;
        _focusActionMenuAfterRender = false;
    }

    private void HandleMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseActionMenu();
        }
    }

    private List<ActionGroup> GetActionGroups(HKCardRegistryListItemDto card)
    {
        var document = new List<ActionItem>();
        if (CanEdit(card))
            document.Add(new ActionItem("edit", "Редактировать"));
        if (CanCreateNewVersion(card))
            document.Add(new ActionItem("version", "Создать новую версию"));
        if (card.HasPdf)
            document.Add(new ActionItem("pdf", "Открыть PDF"));

        var approval = new List<ActionItem>();
        if (CanSubmit(card))
            approval.Add(new ActionItem("submit", "Отправить на согласование"));
        if (CanReturn(card))
            approval.Add(new ActionItem("return", "Вернуть на доработку"));
        if (CanApprove(card))
            approval.Add(new ActionItem("approve", "Утвердить"));
        if (CanArchive(card))
            approval.Add(new ActionItem("archive", "Архивировать"));

        var closing = new List<ActionItem>();
        if (CanDelete(card))
            closing.Add(new ActionItem("delete", "Удалить"));

        var groups = new List<ActionGroup>();
        if (document.Any()) groups.Add(new ActionGroup("Документ", document));
        if (approval.Any()) groups.Add(new ActionGroup("Согласование", approval));
        if (closing.Any()) groups.Add(new ActionGroup("Закрытие", closing));
        return groups;
    }

    private async Task ExecuteAction(HKCardRegistryListItemDto card, string key)
    {
        CloseActionMenu();
        switch (key)
        {
            case "edit": GoToEdit(card.Id); break;
            case "version": await CreateNewVersion(card.Id); break;
            case "pdf": Nav.NavigateTo(PdfUrl(card.Id), forceLoad: true); break;
            case "submit": await ChangeStatus(card.Id, HKCardStatus.OnReview, "Отправлено на согласование из реестра"); break;
            case "return": await ChangeStatus(card.Id, HKCardStatus.RevisionRequired, "Возвращено на доработку из реестра"); break;
            case "approve": await ChangeStatus(card.Id, HKCardStatus.Approved, "Утверждено из реестра"); break;
            case "archive": await OpenArchiveModal(card.Id); break;
            case "delete": OpenDeleteDialog(card); break;
        }
    }

    private async Task ChangeStatus(Guid id, HKCardStatus status, string comment)
    {
        var (success, error) = await HKCardService.ChangeStatusAsync(id, status, comment);
        if (!success)
        {
            _errorMessage = error ?? "Не удалось изменить статус.";
            return;
        }
        await LoadDataAsync();
    }

    private bool CanEdit(HKCardRegistryListItemDto card) =>
        (card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired)
        && HasEditDraftPermission(card.ObjectLevel)
        && IsSameBranchOrSystemConfig(card.BranchId);

    private bool HasEditDraftPermission(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Node => HasPermission(PermissionCodes.HKNodeEditDraft),
        HKObjectLevel.Aggregate => HasPermission(PermissionCodes.HKAggregateEditDraft),
        HKObjectLevel.EquipmentModel => HasPermission(PermissionCodes.HKEquipmentEditDraft),
        HKObjectLevel.Complex => HasPermission(PermissionCodes.HKComplexEditDraft),
        _ => false
    };

    private bool CanSubmit(HKCardRegistryListItemDto card) =>
        (card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired)
        && HasSubmitPermission(card.ObjectLevel)
        && IsSameBranchOrSystemConfig(card.BranchId);

    private bool HasSubmitPermission(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Node => HasPermission(PermissionCodes.HKNodeSubmit),
        HKObjectLevel.Aggregate => HasPermission(PermissionCodes.HKAggregateSubmit),
        HKObjectLevel.EquipmentModel => HasPermission(PermissionCodes.HKEquipmentSubmit),
        HKObjectLevel.Complex => HasPermission(PermissionCodes.HKComplexSubmit),
        _ => false
    };

    private bool CanReturn(HKCardRegistryListItemDto card) =>
        card.Status == HKCardStatus.OnReview && _canReview && IsSameBranchOrSystemConfig(card.BranchId);

    private bool CanApprove(HKCardRegistryListItemDto card) =>
        card.Status == HKCardStatus.OnReview && _canApprove && IsSameBranchOrSystemConfig(card.BranchId);

    private bool CanArchive(HKCardRegistryListItemDto card) =>
        card.Status == HKCardStatus.Approved && _canArchive && IsSameBranchOrSystemConfig(card.BranchId);

    private bool CanCreateNewVersion(HKCardRegistryListItemDto card) =>
        (card.Status is HKCardStatus.Approved or HKCardStatus.Archived)
        && _canCreateAnyHk
        && IsSameBranchOrSystemConfig(card.BranchId);

    private bool CanDelete(HKCardRegistryListItemDto card) =>
        _deletableStatuses.Contains(card.Status) && IsSameBranchOrSystemConfig(card.BranchId);

    private bool IsSameBranchOrSystemConfig(Guid branchId) =>
        _canSystemConfig || branchId.ToString() == _userBranchId;

    private async Task CreateNewVersion(Guid id)
    {
        var (success, newCardId, error) = await HKCardService.CreateNewVersionAsync(id);
        if (success && newCardId.HasValue)
            Nav.NavigateTo($"/хк/{newCardId.Value}");
        else
            _errorMessage = error ?? "Не удалось создать версию.";
    }

    private async Task OpenArchiveModal(Guid id)
    {
        _archiveCardId = id;
        _archiveVersions = await HKCardService.GetVersionsAsync(id);
        _archiveReplacementCardId = _archiveVersions
            .Where(v => v.Id != id && v.Status == HKCardStatus.Approved)
            .Select(v => (Guid?)v.Id)
            .FirstOrDefault() ?? Guid.Empty;
        _archiveReason = "";
        _archiveError = null;
        _showArchiveModal = true;
    }

    private void CloseArchiveModal()
    {
        _showArchiveModal = false;
        _archiveCardId = Guid.Empty;
        _archiveVersions = new List<HKCardVersionDto>();
        _archiveReplacementCardId = Guid.Empty;
        _archiveReason = "";
        _archiveError = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        var reason = _archiveReason?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(reason))
        {
            _archiveError = "Укажите причину архивирования ХК.";
            return;
        }
        if (_archiveReplacementCardId == Guid.Empty)
        {
            _archiveError = "Выберите заменяющую утверждённую ХК.";
            return;
        }
        var (success, error) = await HKCardService.ArchiveAsync(_archiveCardId, _archiveReplacementCardId, reason);
        if (!success)
        {
            _archiveError = error ?? "Не удалось заархивировать ХК.";
            return;
        }
        CloseArchiveModal();
        await LoadDataAsync();
    }

    private void OpenDeleteDialog(HKCardRegistryListItemDto card)
    {
        if (!CanDelete(card)) return;
        _deleteCard = card;
        _deleteCardId = card.Id;
        _deleteReason = "";
        _deleteError = null;
        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        _showDeleteDialog = false;
        _deleteCard = null;
        _deleteCardId = Guid.Empty;
        _deleteReason = "";
        _deleteError = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var reason = _deleteReason?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(reason))
        {
            _deleteError = "Укажите причину удаления ХК.";
            return;
        }
        var (success, error) = await HKCardService.DeleteAsync(_deleteCardId, reason);
        if (!success)
        {
            _deleteError = error ?? "Не удалось удалить ХК.";
            return;
        }
        CloseDeleteDialog();
        await LoadDataAsync();
    }

    private static string LevelName(HKObjectLevel level) => level switch
    {
        HKObjectLevel.Complex => "Комплекс",
        HKObjectLevel.EquipmentModel => "Изделие",
        HKObjectLevel.Aggregate => "Агрегат",
        HKObjectLevel.Node => "Узел",
        _ => "—"
    };

