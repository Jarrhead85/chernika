@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@page "/Р·Р°РґР°С‡Рё/{Id:guid}"
@attribute [Authorize(Policy = "ViewTasks")]
@implements IDisposable
@inject TaskService TaskService
@inject AuditService AuditSvc
@inject NavigationManager Nav
@inject IPermissionService PermSvc
@inject AuthenticationStateProvider AuthState
@inject ILogger<TaskCard> Logger

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Р—Р°РґР°С‡Р°</h2>
            <div class="hint"><a href="/Р·Р°РґР°С‡Рё" class="linkBtn">в†ђ Рљ СЃРїРёСЃРєСѓ Р·Р°РґР°С‡</a></div>
        </div>
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Р—Р°РіСЂСѓР·РєР°...</div>
            }
            else if (task == null)
            {
                <div class="empty-state">Р—Р°РґР°С‡Р° РЅРµ РЅР°Р№РґРµРЅР° РёР»Рё РЅРµРґРѕСЃС‚СѓРїРЅР°</div>
            }
            else
            {
                <div class="metrics2">
                    <div class="metric"><div class="label">РЎС‚Р°С‚СѓСЃ</div><div class="value"><span class="tag @StatusClass(task.Status)">@StatusLabel(task.Status)</span></div></div>
                    <div class="metric"><div class="label">РўРёРї</div><div class="value">@TypeLabel(task.Type)</div></div>
                    <div class="metric"><div class="label">РџСЂРёРѕСЂРёС‚РµС‚</div><div class="value">@PriorityLabel(task.Priority)</div></div>
                    <div class="metric"><div class="label">РСЃРїРѕР»РЅРёС‚РµР»СЊ</div><div class="value">@(task.AssignedToUserName ?? task.AssignedRole ?? "вЂ”")</div></div>
                    <div class="metric"><div class="label">РђРІС‚РѕСЂ</div><div class="value">@(task.CreatedByUserName ?? "вЂ”")</div></div>
                    <div class="metric"><div class="label">РЎРѕР·РґР°РЅР°</div><div class="value mono">@task.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</div></div>
                    <div class="metric"><div class="label">РЎСЂРѕРє</div><div class="value mono">@(task.DueDateUtc?.ToString("dd.MM.yyyy HH:mm") ?? "вЂ”")</div></div>
                    @if (task.StartedAtUtc.HasValue)
                    {
                        <div class="metric"><div class="label">РќР°С‡Р°С‚Р°</div><div class="value mono">@task.StartedAtUtc.Value.ToString("dd.MM.yyyy HH:mm")</div></div>
                    }
                    @if (task.CompletedAtUtc.HasValue)
                    {
                        <div class="metric"><div class="label">Р—Р°РІРµСЂС€РµРЅР°</div><div class="value mono">@task.CompletedAtUtc.Value.ToString("dd.MM.yyyy HH:mm")</div></div>
                    }
                    @if (task.CompletedByUserName != null)
                    {
                        <div class="metric"><div class="label">РљРµРј Р·Р°РІРµСЂС€РµРЅР°</div><div class="value">@task.CompletedByUserName</div></div>
                    }
                    @if (!string.IsNullOrEmpty(task.EntityCodeSnapshot))
                    {
                        <div class="metric"><div class="label">РћР±СЉРµРєС‚</div><div class="value mono">@task.EntityCodeSnapshot @task.EntityTitleSnapshot</div></div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(task.Description))
                {
                    <div class="note" style="margin-top:12px">@task.Description</div>
                }
                @if (!string.IsNullOrEmpty(task.CompletionComment))
                {
                    <div class="note" style="margin-top:12px">РљРѕРјРјРµРЅС‚Р°СЂРёР№ РІС‹РїРѕР»РЅРµРЅРёСЏ: @task.CompletionComment</div>
                }
                <div class="btnRow" style="margin-top:12px">
                    @if (CanStart)
                    {
                        <button class="btn primary" @onclick="StartTask">в–¶ Р’Р·СЏС‚СЊ РІ СЂР°Р±РѕС‚Сѓ</button>
                    }
                    @if (CanComplete)
                    {
                        <button class="btn primary" @onclick="() => OpenComplete()">вњ“ Р’С‹РїРѕР»РЅРёС‚СЊ</button>
                    }
                    @if (_canCancel)
                    {
                        <button class="btn" @onclick="CancelTask">РћС‚РјРµРЅРёС‚СЊ</button>
                    }
                    @if (task.EntityType == "HKCard" && task.EntityId.HasValue)
                    {
                        <button class="btn" @onclick="() => GoToHk(task.EntityId.Value)">РћС‚РєСЂС‹С‚СЊ РҐРљ</button>
                    }
                </div>
            }
        </div>
    </section>

    @if (task != null)
    {
        <section class="panel">
            <div class="panelHeader"><h2>РСЃС‚РѕСЂРёСЏ</h2><div class="hint">@auditLogs.Count Р·Р°РїРёСЃРµР№</div></div>
            <div class="panelBody">
                @if (!auditLogs.Any())
                {
                    <div class="empty-state">РСЃС‚РѕСЂРёСЏ РїСѓСЃС‚Р°</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th>Р”Р°С‚Р°</th><th>Р”РµР№СЃС‚РІРёРµ</th><th>РџРѕР»СЊР·РѕРІР°С‚РµР»СЊ</th><th>РљРѕРјРјРµРЅС‚Р°СЂРёР№</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var log in auditLogs)
                            {
                                <tr>
                                    <td class="mono">@log.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@AuditDisplayCatalog.GetAction(log.Action).Title</td>
                                    <td>@(log.ActorFullName ?? "РЎРёСЃС‚РµРјР°")</td>
                                    <td>@(log.Details ?? "вЂ”")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>
    }
</div>

@if (showCompleteModal && task != null)
{
    <div class="modalOverlay" @onclick="() => showCompleteModal = false">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="complete-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="complete-title">Р’С‹РїРѕР»РЅРµРЅРёРµ Р·Р°РґР°С‡Рё</h3>
                <button type="button" class="modalCloseButton" @onclick="() => showCompleteModal = false">Г—</button>
            </div>
            <div class="modalBody">
                <div class="note" style="margin-bottom:12px">@task.Title</div>
                @if (RequiresComment)
                {
                    <div class="note warn" style="margin-bottom:8px">Р”Р»СЏ Р·Р°РґР°С‡ В«Р”РѕСЂР°Р±РѕС‚РєР° РҐРљВ» РєРѕРјРјРµРЅС‚Р°СЂРёР№ РІС‹РїРѕР»РЅРµРЅРёСЏ РѕР±СЏР·Р°С‚РµР»РµРЅ.</div>
                }
                <div class="field"><label>РљРѕРјРјРµРЅС‚Р°СЂРёР№ РІС‹РїРѕР»РЅРµРЅРёСЏ</label>
                    <textarea @bind="completeComment" rows="3" style="width:100%;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:8px;font-family:inherit;font-size:14px" placeholder="РћРїРёС€РёС‚Рµ СЂРµР·СѓР»СЊС‚Р°С‚вЂ¦"></textarea>
                </div>
            </div>
            <div class="modalFooter">
                <button class="btn" @onclick="() => showCompleteModal = false">РћС‚РјРµРЅР°</button>
                <button class="btn primary" @onclick="ConfirmComplete">Р’С‹РїРѕР»РЅРёС‚СЊ</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="note" style="margin-top:12px">@errorMessage</div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private WorkTaskDto? task;
    private List<Chernika.Domain.Entities.AuditLog> auditLogs = new();
    private bool loading = true;
    private bool _canComplete;
    private bool _canCancel;
    private bool _canSystemConfig;
    private string currentUserId = "";
    private string completeComment = "";
    private bool showCompleteModal;
    private string? errorMessage;
    private CancellationTokenSource? _loadCts;

    private bool CanStart =>
        task != null && _canComplete && WorkTaskTransitions.CanStart(task.Status)
        && (task.AssignedToUserId == currentUserId || _canSystemConfig);

    private bool CanComplete =>
        task != null && _canComplete && WorkTaskTransitions.IsActive(task.Status)
        && (task.AssignedToUserId == currentUserId || _canSystemConfig);

    private bool RequiresComment =>
        task is { Type: WorkTaskType.HKRevision or WorkTaskType.ReferenceProposalReview };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        if (currentUserId != "")
        {
            _canComplete = await PermSvc.HasPermissionAsync(currentUserId, PermissionCodes.TaskComplete);
            _canCancel = await PermSvc.HasPermissionAsync(currentUserId, PermissionCodes.TaskCancel);
            _canSystemConfig = await PermSvc.HasPermissionAsync(currentUserId, PermissionCodes.SystemConfig);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        await LoadAsync(Id, _loadCts.Token);
    }

    private async Task LoadAsync(Guid requestedId, CancellationToken ct)
    {
        Logger.LogInformation("TaskCard.LoadAsync РЅР°С‡Р°Р»Рѕ: {Id}", requestedId);

        loading = true;
        errorMessage = null;
        task = null;
        auditLogs = new();

        try
        {
            var loaded = await TaskService.GetByIdAsync(requestedId, ct);
            var logs = loaded == null
                ? new List<Chernika.Domain.Entities.AuditLog>()
                : await AuditSvc.GetLogsByEntityAsync("WorkTask", requestedId.ToString());

            if (!ct.IsCancellationRequested && requestedId == Id)
            {
                task = loaded;
                auditLogs = logs;
                Logger.LogInformation("TaskCard.LoadAsync Р·Р°РІРµСЂС€РµРЅРёРµ: {Id}", requestedId);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            Logger.LogInformation("TaskCard.LoadAsync РѕС‚РјРµРЅРµРЅР°: {Id}", requestedId);
        }
        catch (Exception ex)
        {
            if (!ct.IsCancellationRequested && requestedId == Id)
            {
                Logger.LogWarning(ex, "TaskCard.LoadAsync РѕС€РёР±РєР°: {Id}", requestedId);
                errorMessage = ex.Message;
            }
        }
        finally
        {
            if (!ct.IsCancellationRequested && requestedId == Id)
                loading = false;
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    private void OpenComplete()
    {
        completeComment = "";
        showCompleteModal = true;
    }

    private async Task ConfirmComplete()
    {
        if (task == null) return;
        if (RequiresComment && string.IsNullOrWhiteSpace(completeComment))
        {
            errorMessage = "Р”Р»СЏ СЌС‚РѕРіРѕ С‚РёРїР° Р·Р°РґР°С‡Рё РєРѕРјРјРµРЅС‚Р°СЂРёР№ РІС‹РїРѕР»РЅРµРЅРёСЏ РѕР±СЏР·Р°С‚РµР»РµРЅ.";
            return;
        }
        try
        {
            await TaskService.CompleteAsync(new CompleteWorkTaskCommand(Id, completeComment.Trim()));
            showCompleteModal = false;
            await LoadAsync(Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task StartTask()
    {
        try
        {
            await TaskService.StartAsync(Id);
            await LoadAsync(Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CancelTask()
    {
        try
        {
            await TaskService.CancelAsync(new CancelWorkTaskCommand(Id, "РћС‚РјРµРЅРµРЅР° РїРѕР»СЊР·РѕРІР°С‚РµР»РµРј"));
            await LoadAsync(Id, CancellationToken.None);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void GoToHk(Guid id) => Nav.NavigateTo($"/С…Рє/{id}");

    private static string StatusLabel(WorkTaskStatus status) => status switch
    {
        WorkTaskStatus.Open => "РћС‚РєСЂС‹С‚Р°",
        WorkTaskStatus.InProgress => "Р’ СЂР°Р±РѕС‚Рµ",
        WorkTaskStatus.Completed => "Р’С‹РїРѕР»РЅРµРЅР°",
        WorkTaskStatus.Cancelled => "РћС‚РјРµРЅРµРЅР°",
        WorkTaskStatus.Overdue => "РџСЂРѕСЃСЂРѕС‡РµРЅР°",
        _ => status.ToString()
    };

    private static string StatusClass(WorkTaskStatus status) => status switch
    {
        WorkTaskStatus.Open => "warn",
        WorkTaskStatus.InProgress => "",
        WorkTaskStatus.Completed => "ok",
        WorkTaskStatus.Cancelled => "",
        WorkTaskStatus.Overdue => "bad",
        _ => ""
    };

    private static string PriorityLabel(WorkTaskPriority priority) => priority switch
    {
        WorkTaskPriority.Low => "РќРёР·РєРёР№",
        WorkTaskPriority.Normal => "РћР±С‹С‡РЅС‹Р№",
        WorkTaskPriority.High => "Р’С‹СЃРѕРєРёР№",
        WorkTaskPriority.Critical => "РљСЂРёС‚РёС‡РµСЃРєРёР№",
        _ => priority.ToString()
    };

    private static string TypeLabel(WorkTaskType type) => type switch
    {
        WorkTaskType.HKReview => "РџСЂРѕРІРµСЂРєР° РҐРљ",
        WorkTaskType.HKRevision => "Р”РѕСЂР°Р±РѕС‚РєР° РҐРљ",
        WorkTaskType.HKExpirationReview => "РЎСЂРѕРє РґРµР№СЃС‚РІРёСЏ РҐРљ",
        WorkTaskType.ParentHKRevision => "Р”РѕСЂР°Р±РѕС‚РєР° СЂРѕРґРёС‚РµР»СЊСЃРєРѕР№ РҐРљ",
        WorkTaskType.ReferenceProposalReview => "РџСЂРѕРІРµСЂРєР° РїСЂРµРґР»РѕР¶РµРЅРёСЏ",
        WorkTaskType.UserAdministration => "РђРґРјРёРЅРёСЃС‚СЂРёСЂРѕРІР°РЅРёРµ РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№",
        _ => type.ToString()
    };
}
