@page "/составы-хк/{Id:guid}"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Web.Components

<div class="stack hkCompositionView">
    <section class="panel">
        <div class="panelHeader">
            <h2>Состав ХК</h2>
            <div class="hint">Принятая редакция</div>
        </div>
        <div class="panelBody">
            @* Отдельный просмотр принятой редакции: тот же блок состава, что и
               в раскрытой строке реестра «Составы ХК». *@
            <HKCompositionBlock CardId="Id" />
        </div>
    </section>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
}
