    private string BuildUrl(SearchQuery query)
    {
        var url = new List<string>();
        void AddParam(string name, string? rawValue)
        {
            if (!string.IsNullOrWhiteSpace(rawValue))
                url.Add($"{name}={Uri.EscapeDataString(rawValue)}");
        }

        AddParam("q", query.Text);
        AddParam("entityType", query.EntityType);
        AddParam("createdFrom", query.CreatedFrom?.ToString("yyyy-MM-dd"));
        AddParam("createdTo", query.CreatedTo?.ToString("yyyy-MM-dd"));
        AddParam("hkCardStatus", query.HKCardStatus?.ToString());
        AddParam("hkObjectLevel", query.HKObjectLevel?.ToString());
        AddParam("hkValidity", query.HKValidity?.ToString());
        AddParam("hasAttachment", query.HasAttachment?.ToString());
        AddParam("icStatus", query.IndividualCardStatus?.ToString());
        AddParam("icObjectLevel", query.IndividualCardObjectLevel?.ToString());
        AddParam("icIsFormed", query.IsFormed?.ToString());
        AddParam("icHasCoefficients", query.HasCoefficients?.ToString());
        AddParam("relatedScope", query.RelatedScope?.ToString());
        AddParam("taskStatus", query.TaskStatus?.ToString());
        AddParam("taskPriority", query.TaskPriority?.ToString());
        AddParam("branchId", query.BranchId?.ToString());
        AddParam("sortBy", query.SortBy);
        AddParam("sortDescending", query.SortDescending ? "true" : null);
        AddParam("page", query.Page > 1 ? query.Page.ToString() : null);
        return url.Count == 0 ? "/поиск" : "/поиск?" + string.Join("&", url);
    }

