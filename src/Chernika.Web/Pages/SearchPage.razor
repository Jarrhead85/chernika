@page "/поиск"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Data
@using Chernika.Infrastructure.Services
@using Chernika.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject SearchService SearchSvc
@inject NavigationManager Nav
@inject CircuitDbLock DbLock
@inject AuthenticationStateProvider AuthState
@inject AppDbContext Db
@inject ILogger<SearchPage> Logger
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Расширенный поиск</h2>
        </div>
        <div class="panelBody">
            <div class="searchRow">
                <input class="field-input searchTextInput"
                       placeholder="Код, версия, объект, СЕ, марка ГСМ, ГОСТ/ТУ, реквизиты…"
                       value="@_text" @oninput="OnTextChanged" @onkeydown="OnTextKeyDown" />
                <button type="button"
                        class="btn searchFilterToggle"
                        title="Фильтры"
                        aria-label="Открыть фильтры"
                        aria-expanded="@_filtersOpen"
                        @onclick="ToggleFilters">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <circle cx="9" cy="6" r="2.2"></circle>
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <circle cx="15" cy="12" r="2.2"></circle>
                        <line x1="4" y1="18" x2="20" y2="18"></line>
                        <circle cx="7" cy="18" r="2.2"></circle>
                    </svg>
                    @if (_activeFilterCount > 0)
                    {
                        <span class="searchFilterBadge">@_activeFilterCount</span>
                    }
                </button>
            </div>

            @if (_error is not null)
            {
                <div class="note bad searchHint">@_error</div>
            }

            @if (_filtersOpen)
            {
                <div class="searchFilterDrawer">
                    <div class="searchFilterGrid">
                        <div class="field">
                            <label class="field-label" for="entityType">Тип результата</label>
                            <select id="entityType" class="field-select" value="@(_entityType ?? "")" @onchange="OnEntityTypeChanged">
                                @foreach (var (value, label) in EntityTypeOptions)
                                {
                                    <option value="@value" selected="@(value == (_entityType ?? ""))">@label</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label" for="sortBy">Сортировка</label>
                            <select id="sortBy" class="field-select" value="@_sortBy" @onchange="OnSortByChanged">
                                <option value="Relevance" selected="@AddIsSelected(_sortBy == "Relevance")">По релевантности</option>
                                <option value="CreatedAt" selected="@AddIsSelected(_sortBy == "CreatedAt")">Дата создания</option>
                                <option value="ApprovedDate" selected="@AddIsSelected(_sortBy == "ApprovedDate")">Дата утверждения</option>
                                <option value="Title" selected="@AddIsSelected(_sortBy == "Title")">Наименование</option>
                                <option value="EntityType" selected="@AddIsSelected(_sortBy == "EntityType")">Тип результата</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field-label" for="sortDescending">Направление</label>
                            <select id="sortDescending" class="field-select" value="@(_sortDescending ? "true" : "false")" @onchange="OnSortDirectionChanged">
                                <option value="true" selected="@_sortDescending">По убыванию</option>
                                <option value="false" selected="@(!_sortDescending)">По возрастанию</option>
                            </select>
                        </div>
                    </div>
                    <div class="searchDateGrid">
                        <div class="field">
                            <label class="field-label" for="createdFrom">Создано с</label>
                            <input id="createdFrom" class="field-input" type="date"
                                   value="@_createdFrom?.ToString("yyyy-MM-dd")" @onchange="OnCreatedFromChanged" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="createdTo">Создано по</label>
                            <input id="createdTo" class="field-input" type="date"
                                   value="@_createdTo?.ToString("yyyy-MM-dd")" @onchange="OnCreatedToChanged" />
                        </div>
                        @if (_isSystemAdmin)
                        {
                            <div class="field">
                                <label class="field-label" for="branch">Филиал</label>
                                <select id="branch" class="field-select" value="@(_branchId?.ToString() ?? "")" @onchange="OnBranchChanged">
                                    <option value="">Все филиалы</option>
                                    @foreach (var branch in _branches)
                                    {
                                        <option value="@branch.Id" selected="@(branch.Id == _branchId)">@branch.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    @if (_entityType == "HKCard")
                    {
                        <div class="searchDateGrid">
                            <div class="field">
                                <label class="field-label" for="hkStatus">Статус ХК</label>
                                <select id="hkStatus" class="field-select" value="@(_hkCardStatus?.ToString() ?? "")" @onchange="OnHKStatusChanged">
                                    <option value="">Любой</option>
                                    @foreach (var (value, label) in HKStatusOptions)
                                    {
                                        <option value="@value" selected="@(value == (_hkCardStatus?.ToString() ?? ""))">@label</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="hkLevel">Уровень ХК</label>
                                <select id="hkLevel" class="field-select" value="@(_hkObjectLevel?.ToString() ?? "")" @onchange="OnHKLevelChanged">
                                    <option value="">Любой</option>
                                    @foreach (var (value, label) in HKLevelOptions)
                                    {
                                        <option value="@value" selected="@(value == (_hkObjectLevel?.ToString() ?? ""))">@label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="searchDateGrid">
                            <div class="field">
                                <label class="field-label" for="hkValidity">Срок действия</label>
                                <select id="hkValidity" class="field-select" value="@(_hkValidity?.ToString() ?? "")" @onchange="OnHKValidityChanged">
                                    <option value="">Любой</option>
                                    <option value="Active" selected="@(_hkValidity == HKValidityFilter.Active)">Действует</option>
                                    <option value="Expiring" selected="@(_hkValidity == HKValidityFilter.Expiring)">Истекает</option>
                                    <option value="Expired" selected="@(_hkValidity == HKValidityFilter.Expired)">Истёк</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="hasAttachment">PDF-вложение</label>
                                <select id="hasAttachment" class="field-select" value="@(_hasAttachment?.ToString() ?? "")" @onchange="OnHasAttachmentChanged">
                                    <option value="">Любое</option>
                                    <option value="true" selected="@(_hasAttachment == true)">Есть</option>
                                    <option value="false" selected="@(_hasAttachment == false)">Нет</option>
                                </select>
                            </div>
                        </div>
                    }
                    else if (_entityType == "IndividualCard")
                    {
                        <div class="searchDateGrid">
                            <div class="field">
                                <label class="field-label" for="icStatus">Статус ИК</label>
                                <select id="icStatus" class="field-select" value="@(_icStatus?.ToString() ?? "")" @onchange="OnICStatusChanged">
                                    <option value="">Любой</option>
                                    @foreach (var (value, label) in ICStatusOptions)
                                    {
                                        <option value="@value" selected="@(value == (_icStatus?.ToString() ?? ""))">@label</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="icLevel">Уровень объекта</label>
                                <select id="icLevel" class="field-select" value="@(_icObjectLevel?.ToString() ?? "")" @onchange="OnICLevelChanged">
                                    <option value="">Любой</option>
                                    @foreach (var (value, label) in ICLevelOptions)
                                    {
                                        <option value="@value" selected="@(value == (_icObjectLevel?.ToString() ?? ""))">@label</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="searchDateGrid">
                            <div class="field">
                                <label class="field-label" for="icFormed">Состояние формирования</label>
                                <select id="icFormed" class="field-select" value="@(_icIsFormed?.ToString() ?? "")" @onchange="OnICFormedChanged">
                                    <option value="">Любое</option>
                                    <option value="true" selected="@(_icIsFormed == true)">Сформирована</option>
                                    <option value="false" selected="@(_icIsFormed == false)">Не сформирована</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="icCoefficients">Наличие применённых коэффициентов</label>
                                <select id="icCoefficients" class="field-select" value="@(_icHasCoefficients?.ToString() ?? "")" @onchange="OnICCoefficientsChanged">
                                    <option value="">Любое</option>
                                    <option value="true" selected="@(_icHasCoefficients == true)">Есть</option>
                                    <option value="false" selected="@(_icHasCoefficients == false)">Нет</option>
                                </select>
                            </div>
                        </div>
                    }
                    else if (_entityType == "WorkTask")
                    {
                        <div class="searchDateGrid">
                            <div class="field">
                                <label class="field-label" for="taskStatus">Статус задачи</label>
                                <select id="taskStatus" class="field-select" value="@(_taskStatus?.ToString() ?? "")" @onchange="OnTaskStatusChanged">
                                    <option value="">Любой</option>
                                    @foreach (var (value, label) in TaskStatusOptions)
                                    {
                                        <option value="@value" selected="@(value == (_taskStatus?.ToString() ?? ""))">@label</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="taskPriority">Приоритет задачи</label>
                                <select id="taskPriority" class="field-select" value="@(_taskPriority?.ToString() ?? "")" @onchange="OnTaskPriorityChanged">
                                    <option value="">Любой</option>
                                    @foreach (var (value, label) in TaskPriorityOptions)
                                    {
                                        <option value="@value" selected="@(value == (_taskPriority?.ToString() ?? ""))">@label</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else if (_entityType is "GsmMaterial" or "Coefficient" or "Complex" or "EquipmentModel"
                             or "Aggregate" or "Node" or "AssemblyUnit" or "EquipmentInstance")
                    {
                        <div class="field searchRelatedScope">
                            <select class="field-select" value="@(_relatedScope is null ? "" : _relatedScope.Value.ToString())" @onchange="OnRelatedScopeChanged">
                                @foreach (var (value, label) in RelatedScopeOptionsFor(_entityType))
                                {
                                    <option value="@value" selected="@(value == (_relatedScope is null ? "" : _relatedScope.Value.ToString()))">@label</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="searchResetActions">
                        <button class="btn" @onclick="Reset">Сбросить</button>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>Результаты поиска</h2>
            @if (_loaded)
            {
                <div class="hint">@_totalCount совпадений</div>
            }
        </div>
        <div class="panelBody">
            @if (_error is not null)
            {
                <div class="note bad">@_error</div>
            }
            else if (!_loaded)
            {
                <div class="empty-state">Введите не менее 3 символов для поиска или откройте фильтры.</div>
            }
            else if (_loading)
            {
                <div class="loading">Загрузка…</div>
            }
            else if (_items.Count == 0)
            {
                <div class="empty-state">Ничего не найдено. Измените текст запроса или параметры фильтрации.</div>
            }
            else
            {
                <div class="searchResultList">
                    @foreach (var r in _items)
                    {
                        <a href="@r.NavigationUrl" class="searchResultCard">
                            <div class="searchResultTop">
                                <span class="tag">@SearchDisplayCatalog.EntityTypeTag(r.EntityType)</span>
                                @if (!string.IsNullOrEmpty(r.StatusDisplay))
                                {
                                    <span class="tag @StatusClass(r.EntityType, r.Status)">@r.StatusDisplay</span>
                                }
                            </div>
                            <div class="searchResultTitle">@r.Title</div>
                            @if (!string.IsNullOrEmpty(r.Subtitle))
                            {
                                <div class="searchResultSub">@r.Subtitle</div>
                            }
                            <div class="searchResultMeta">
                                @if (r.CreatedAt is { } createdAt)
                                {
                                    <span>Создано: @createdAt.ToString("dd.MM.yyyy")</span>
                                }
                                @if (!string.IsNullOrEmpty(r.BranchName))
                                {
                                    <span>· Филиал: @r.BranchName</span>
                                }
                                @if (!string.IsNullOrEmpty(r.MatchContext))
                                {
                                    <span class="searchResultCtx">· @r.MatchContext</span>
                                }
                            </div>
                            <div class="searchResultGo"><span class="mono">Перейти →</span></div>
                        </a>
                    }
                </div>

                @if (_totalCount > SearchPageSize)
                {
                    <div class="btnRow pager">
                        @if (PageCurrent > 1)
                        {
                            <button class="btn ghost" @onclick="() => GoToPage(PageCurrent - 1)">← Назад</button>
                        }
                        <span class="hint">Страница @PageCurrent из @_totalPages</span>
                        @if (PageCurrent < _totalPages)
                        {
                            <button class="btn ghost" @onclick="() => GoToPage(PageCurrent + 1)">Вперёд →</button>
                        }
                    </div>
                    <div class="searchRange hint">Показано @((_totalCount - 1) / SearchPageSize + 1)–@Math.Min(PageCurrent * SearchPageSize, _totalCount) из @_totalCount</div>
                }
                else
                {
                    <div class="searchRange hint">Показано 1–@_totalCount из @_totalCount</div>
                }
            }
        </div>
    </section>
</div>

@code {
    private string _text = "";
    private string? _entityType;
    private DateTime? _createdFrom;
    private DateTime? _createdTo;
    private HKCardStatus? _hkCardStatus;
    private HKObjectLevel? _hkObjectLevel;
    private HKValidityFilter? _hkValidity;
    private bool? _hasAttachment;
    private IndividualCardStatus? _icStatus;
    private IndividualCardObjectLevel? _icObjectLevel;
    private bool? _icIsFormed;
    private bool? _icHasCoefficients;
    private RelatedResultsScope? _relatedScope;
    private WorkTaskStatus? _taskStatus;
    private WorkTaskPriority? _taskPriority;
    private Guid? _branchId;
    private string _sortBy = "Relevance";
    private bool _sortDescending = true;

    private bool _isSystemAdmin;
    private bool _filtersOpen;
    private bool _loading;
    private bool _loaded;
    private List<SearchResultDto> _items = [];
    private int _totalCount;
    private int _totalPages;
    private string? _error;
    private string _lastUrl = "";
    private CancellationTokenSource? _searchCts;
    

    private const int SearchPageSize = 50;

    private int PageCurrent
    {
        get
        {
            var current = ParseInt(PageQuery) ?? 1;
            return Math.Max(1, current);
        }
    }

    private int _activeFilterCount => CountActiveFilters();

    // ── URL параметры ─────────────────────────────────────────────────────
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? QQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "entityType")] public string? EntityTypeQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "createdFrom")] public string? CreatedFromQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "createdTo")] public string? CreatedToQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "hkCardStatus")] public string? HKCardStatusQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "hkObjectLevel")] public string? HKObjectLevelQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "hkValidity")] public string? HKValidityQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "hasAttachment")] public string? HasAttachmentQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "icStatus")] public string? ICStatusQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "icObjectLevel")] public string? ICObjectLevelQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "icIsFormed")] public string? ICIsFormedQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "icHasCoefficients")] public string? ICHasCoefficientsQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "relatedScope")] public string? RelatedScopeQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "taskStatus")] public string? TaskStatusQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "taskPriority")] public string? TaskPriorityQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "branchId")] public string? BranchIdQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "sortBy")] public string? SortByQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "sortDescending")] public string? SortDescendingQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "page")] public string? PageQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadRoleAndBranchesAsync();
        ParseFromUri();
        if (HasAnyFilterActive())
            _filtersOpen = true;
        await QueueSearchAsync(0, PageCurrent);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Nav.Uri == _lastUrl)
            return; // навигация выполнена самой QueueSearchAsync — не запускаем второй поиск
        await LoadRoleAndBranchesAsync();
        ParseFromUri();
        await QueueSearchAsync(0, PageCurrent);
    }

    private async Task LoadRoleAndBranchesAsync()
    {
        if (_isSystemAdmin)
            return;
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isSystemAdmin = auth.User.IsInRole(UserRole.SystemAdmin.ToString());
        if (_isSystemAdmin && _branches is null)
        {
            var branchList = await Db.Branches.AsNoTracking()
                .OrderBy(b => b.Name)
                .ToListAsync();
            _branches = branchList;
        }
    }

    private List<Branch>? _branches;

    private void ParseFromUri()
    {
        _text = QQuery ?? "";
        _entityType = string.IsNullOrWhiteSpace(EntityTypeQuery) ? null : EntityTypeQuery;
        _createdFrom = ParseDate(CreatedFromQuery);
        _createdTo = ParseDate(CreatedToQuery);
        _hkCardStatus = ParseEnum<HKCardStatus>(HKCardStatusQuery);
        _hkObjectLevel = ParseEnum<HKObjectLevel>(HKObjectLevelQuery);
        _hkValidity = ParseEnum<HKValidityFilter>(HKValidityQuery);
        _hasAttachment = ParseBool(HasAttachmentQuery);
        _icStatus = ParseEnum<IndividualCardStatus>(ICStatusQuery);
        _icObjectLevel = ParseEnum<IndividualCardObjectLevel>(ICObjectLevelQuery);
        _icIsFormed = ParseBool(ICIsFormedQuery);
        _icHasCoefficients = ParseBool(ICHasCoefficientsQuery);
        _relatedScope = ParseEnum<RelatedResultsScope>(RelatedScopeQuery);
        _taskStatus = ParseEnum<WorkTaskStatus>(TaskStatusQuery);
        _taskPriority = ParseEnum<WorkTaskPriority>(TaskPriorityQuery);
        _branchId = ParseGuid(BranchIdQuery);
        _sortBy = SortByQuery ?? "";
        _sortDescending = ParseBool(SortDescendingQuery) ?? true;
        _lastUrl = Nav.Uri;
    }

    // ── Поиск: единая точка входа QueueSearchAsync после debounce ─────────

    private long _searchVersion;

    /// <summary>
    /// Единая точка выполнения автоматического поиска: каждый новый запрос
    /// отменяет предыдущий; результаты применяются только если версия запроса
    /// актуальна; исключения логируются через ILogger.
    /// </summary>
    private async Task QueueSearchAsync(int delayMs, int page)
    {
        // Отменяем и освобождаем ТОЛЬКО предыдущий запрос.
        _searchCts?.Cancel();
        _searchCts?.Dispose();

        // Локальный CTS: отменённый старый запрос никогда не dispose-ит новый.
        var cts = new CancellationTokenSource();
        _searchCts = cts;
        var ct = cts.Token;
        var version = ++_searchVersion;

        try
        {
            if (delayMs > 0)
                await Task.Delay(delayMs, ct);

            if (ct.IsCancellationRequested || version != _searchVersion)
                return;

            var textOK = _text.Trim().Length >= 3;
            if (!textOK && !HasAnyFilterActive())
                return;

            var query = BuildQuery(page, SearchPageSize);
            var url = BuildUrl(query);
            if (Nav.Uri != url)
            {
                _lastUrl = url;
                Nav.NavigateTo(url, new NavigationOptions { ReplaceHistoryEntry = true });
            }

            _loading = true;
            _error = null;
            await InvokeAsync(StateHasChanged);

            var result = await SearchSvc.SearchAsync(query, ct);
            if (ct.IsCancellationRequested || version != _searchVersion)
                return;

            _items = result.Items.ToList();
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
            _loaded = true;
            _error = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Ожидаемая отмена устаревшего запроса. Не трогать _searchCts.
        }
        catch (ArgumentException inversion)
        {
            if (ct.IsCancellationRequested || version != _searchVersion)
                return;

            _error = inversion.Message;
            _items = [];
            _totalCount = 0;
            _totalPages = 0;
            _loaded = true;
        }
        catch (UnauthorizedAccessException access)
        {
            if (ct.IsCancellationRequested || version != _searchVersion)
                return;

            _error = access.Message;
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested || version != _searchVersion)
                return;

            Logger.LogError(ex, "Расширенный поиск: ошибка выполнения запроса");
            _error = "Не удалось выполнить поиск. Повторите попытку.";
            _items = [];
            _totalCount = 0;
            _totalPages = 0;
            _loaded = true;
        }
        finally
        {
            if (ReferenceEquals(_searchCts, cts))
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private SearchQuery BuildQuery(int page, int pageSize) => new()
    {
        Text = _text,
        EntityType = _entityType,
        CreatedFrom = _createdFrom,
        CreatedTo = _createdTo,
        HKCardStatus = _hkCardStatus,
        HKObjectLevel = _hkObjectLevel,
        HKValidity = _hkValidity,
        HasAttachment = _hasAttachment,
        IndividualCardStatus = _icStatus,
        IndividualCardObjectLevel = _icObjectLevel,
        IsFormed = _icIsFormed,
        HasCoefficients = _icHasCoefficients,
        RelatedScope = _relatedScope,
        TaskStatus = _taskStatus,
        TaskPriority = _taskPriority,
        BranchId = _isSystemAdmin ? _branchId : null,
        SortBy = _sortBy,
        SortDescending = _sortDescending,
        Page = page,
        PageSize = pageSize,
    };

    // ── Авто-поиск ────────────────────────────────────────────────────────

    private void OnTextKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = QueueSearchAsync(0, 1);
    }

    private void OnTextChanged(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        // Не сбрасывать текст при смене фильтров; автопоиск по debounce.
        if (_text.Trim().Length >= 3)
            QueueSearchAsync(400, 1);
    }

    private void ToggleFilters() => _filtersOpen = !_filtersOpen;

    private void OnEntityTypeChanged(ChangeEventArgs e)
    {
        _entityType = e.Value?.ToString() is { Length: > 0 } value ? value : null;
        if (_entityType is not "HKCard")
        {
            _hkCardStatus = null;
            _hkObjectLevel = null;
            _hkValidity = null;
            _hasAttachment = null;
        }
        if (_entityType is not "IndividualCard")
        {
            _icStatus = null;
            _icObjectLevel = null;
            _icIsFormed = null;
            _icHasCoefficients = null;
        }
        if (_entityType is not "WorkTask")
        {
            _taskStatus = null;
            _taskPriority = null;
        }
        // Смена типа сбрасывает устаревшую область связанных данных.
        _relatedScope = null;
        QueueSearchAsync(200, 1);
    }

