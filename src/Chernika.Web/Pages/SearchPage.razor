        if (_icHasCoefficients is not null) count++;
        if (_relatedScope is not null) count++;
        if (_taskStatus is not null) count++;
        if (_taskPriority is not null) count++;
        if (_isSystemAdmin && _branchId is not null) count++;
        return count;
    }

