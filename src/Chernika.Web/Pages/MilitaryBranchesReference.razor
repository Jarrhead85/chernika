@page "/справочник-родов-войск"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Классификаторы" Current="Рода войск" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование рода войск" : "Новый род войск")</h2>
                <div class="hint">Вид ВС РФ — классификационная группа, может повторяться</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Вид ВС РФ</label><input @ref="_firstField" @bind="newBranch.ArmedForcesType" maxlength="250" /></div>
                    <div class="field"><label>Наименование</label><input @bind="newBranch.Name" maxlength="250" /></div>
                    <div class="field full-width"><label>Описание</label><input @bind="newBranch.Description" maxlength="1000" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveBranch">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список родов войск</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по виду ВС РФ, наименованию, описанию..." />
                <select class="field-select" @bind="typeFilter" @bind:after="OnFiltersChanged">
                    <option value="">Все виды ВС РФ</option>
                    @foreach (var t in branchTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="ArmedForcesType">Сортировка: вид ВС РФ</option>
                    <option value="Name">Сортировка: наименование</option>
                    <option value="CreatedAt">Сортировка: дата создания</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!branches.Any())
            {
                <div class="empty-state">Нет записей</div>
            }
            else
            {
                <div class="referenceTableWrap">
                    <table>
                        <thead>
                            <tr><th>Вид ВС РФ</th><th>Наименование</th><th>Описание</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var b in branches)
                            {
                                var rowClickable = canEdit && !b.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(b)" @onkeydown="(ev) => OnRowKeyDown(ev, b)">
                                    <td>@b.ArmedForcesType</td>
                                    <td>@b.Name</td>
                                    <td>@b.Description</td>
                                    <td><span class="tag @(b.IsDeleted ? "bad" : "ok")">@(b.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (b.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreBranch(b.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditBranch(b)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteBranch(b.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @branches.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<MilitaryBranch> branches = new();
    private List<string> branchTypes = new();
    private MilitaryBranch newBranch = new();
    private bool editing = false;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private string? typeFilter;
    private int statusFilter = 0;
    private string sortBy = "ArmedForcesType";
    private bool sortDesc = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(typeFilter) || statusFilter != 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    private async Task OnFiltersChanged()
    {
        currentPage = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        bool? showDeleted = statusFilter switch
        {
            1 => true,
            2 => null,
            _ => false
        };

        loading = true;
        try
        {
            var result = await EquipService.GetMilitaryBranchesPagedAsync(new MilitaryBranchQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                ArmedForcesType = string.IsNullOrWhiteSpace(typeFilter) ? null : typeFilter,
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);

            List<string>? loadedTypes = null;
            if (showDeleted != true)
                loadedTypes = await EquipService.GetMilitaryBranchTypesAsync(ct);

            if (ct.IsCancellationRequested)
                return;

            branches = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await ReloadAsync();
                return;
            }
            if (loadedTypes != null)
                branchTypes = loadedTypes;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                loading = false;
        }
    }

    async Task SaveBranch()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newBranch.ArmedForcesType) || string.IsNullOrWhiteSpace(newBranch.Name))
        {
            errorMessage = "Укажите вид ВС РФ и наименование.";
            return;
        }

        try
        {
            if (editing)
                await EquipService.UpdateMilitaryBranchAsync(newBranch);
            else
                await EquipService.CreateMilitaryBranchAsync(newBranch);
            ResetForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить запись справочника. Обновите список и повторите попытку."
                : "Не удалось создать запись справочника. Обновите список и повторите попытку.";
        }
    }

    Task EditBranch(MilitaryBranch b)
    {
        newBranch = new MilitaryBranch { Id = b.Id, ArmedForcesType = b.ArmedForcesType, Name = b.Name, Description = b.Description, IsDeleted = b.IsDeleted, CreatedAt = b.CreatedAt, UpdatedAt = b.UpdatedAt };
        editing = true;
        _focusForm = true;
        return Task.CompletedTask;
    }

    async Task OnRowDblClick(MilitaryBranch b)
    {
        if (!canEdit || b.IsDeleted) return;
        await EditBranch(b);
    }

    async Task OnRowKeyDown(KeyboardEventArgs ev, MilitaryBranch b)
    {
        if (!canEdit || b.IsDeleted || ev.Key != "Enter") return;
        await EditBranch(b);
    }

    async Task DeleteBranch(Guid id)
    {
        errorMessage = null;
        try
        {
            await EquipService.DeleteMilitaryBranchAsync(id);
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task RestoreBranch(Guid id)
    {
        errorMessage = null;
        try
        {
            await EquipService.RestoreMilitaryBranchAsync(id);
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    void ResetForm()
    {
        newBranch = new MilitaryBranch();
        editing = false;
        errorMessage = null;
    }

    async Task ToggleSortDir()
    {
        sortDesc = !sortDesc;
        await ReloadAsync();
    }

    async Task ResetFilters()
    {
        search = "";
        typeFilter = null;
        statusFilter = 0;
        sortBy = "ArmedForcesType";
        sortDesc = false;
        currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await ReloadAsync();
    }

    async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await ReloadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
