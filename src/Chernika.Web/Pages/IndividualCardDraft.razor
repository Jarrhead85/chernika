@page "/инд-карты/черновик/{Id:guid}"
@page "/инд-карты/{Id:guid}"
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using System.Globalization
@using Chernika.Web.Services
@inject IndividualCardService IndCardService
@inject IPermissionService Perms
@inject AuthenticationStateProvider AuthState
@inject CircuitDbLock DbLock
@inject NavigationManager Nav
@inject ILogger<IndividualCardDraft> Logger
@implements IDisposable

@* Модуль ИК законсервирован. Сформированная карта открывается только для
   чтения: экспорт, новая версия и архивирование отключены границей модуля, и их
   кнопок в интерфейсе нет. Черновик недоступен для работы: пересчёт, выбор
   коэффициентов и формирование закрыты на сервере. *@
<IndividualCardConservedNotice />
<div class="stack">
    @if (_loading)
    {
        <section class="panel">
            <div class="panelBody"><div class="loading-state">Загрузка...</div></div>
        </section>
    }
    else if (_draft is null)
    {
        @if (_detail is not null)
        {
            <section class="panel icHeaderPanel">
                <div class="panelHeader icCompactHeader">
                    <h2>ИК @_detail.Code @_detail.Version</h2>
                    <div class="hint">@_detail.ObjectLevelDisplay: @_detail.ObjectCode — @_detail.ObjectName · @(_detail.BranchName ?? "—")</div>
                    <span class="tag @(_detail.Status == IndividualCardStatus.Formed ? "ok" : "")">@IndividualCardDisplay.Status(_detail.Status)</span>
                </div>
                <div class="icHeaderActions">
                    @* Экспорт, новая версия и архивирование отключены: все три
                       обращаются к закрытым операциям ИК. Ссылки PDF/XLSX убраны,
                       чтобы пользователь не получал контролируемый отказ вместо
                       просмотра сохранённого документа. *@
                </div>
                <div class="panelBody icPanelBodyNoPad">
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="hkc-error">@_error</div>
                    }

                    <IndividualCardDetailSections Detail="_detail"/>
                </div>
            </section>
        }
        else
        {
            <section class="panel">
                <div class="panelBody"><div class="note">@(string.IsNullOrEmpty(_error) ? "ИК не найдена." : _error)</div></div>
            </section>
        }
    }
    else
    {
        @* Черновик ИК сохраняется, но работать с ним нельзя: пересчёт, выбор
           коэффициентов и формирование закрыты границей модуля. Показываем
           сохранённый документ только для чтения. Сценарий черновика оставлен в
           коде страницы и вернётся при возобновлении модуля. *@
        <section class="panel">
            <div class="panelHeader">
                <h2>Черновик ИК @_draft.Code @_draft.Version</h2>
                <div class="hint">@_draft.ObjectLevelDisplay: @_draft.ObjectCode @_draft.ObjectName</div>
                <span class="tag">@IndividualCardDisplay.Status(_draft.Status)</span>
            </div>
            <div class="panelBody">
                <div class="note">
                    Черновик сохранён без изменений, но недоступен для работы: выбор
                    коэффициентов, пересчёт и формирование отключены вместе с модулем ИК.
                </div>
                <button type="button" class="btn ghost" @onclick="GoBack">Назад к списку</button>
            </div>
        </section>
    }
</div>

@* Модальные окна новой версии и архивирования недостижимы: кнопки, которые их
   открывали, убраны вместе с отключением операций модуля ИК. Код сохранён и
   вернётся при возобновлении модуля. *@

@code {
    // Сценарий черновика, новой версии и архивирования сохранён целиком, но
    // модуль ИК законсервирован: кнопки, которые запускали эти операции, убраны,
    // а вызовы сервиса отклоняются границей модуля. Состояние остаётся в коде и
    // вернётся при возобновлении модуля, поэтому предупреждения о неиспользуемых
    // полях здесь сняты.
#pragma warning disable CS0414
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private IndividualCardDraftDto? _draft;
    private IndividualCardCalculationDto? _savedCalculation;

    private bool _canSelectCoefficients;
    private bool _canRecalculate;
    private bool _canForm;

    private string _coefficientSearch = string.Empty;
    private List<CoefficientListItemDto> _coefficients = new();
    private List<(Guid TypeId, string TypeName, List<CoefficientListItemDto> Items)> _coefficientGroups = new();
    private HashSet<Guid> _selectedCoefficientIds = new();
    private bool _recalculating;
    private string? _recalcError;
    private bool _forming;

    private bool _canCreateVersion;
    private bool _canArchive;
    private IndividualCardActionHeaderDto? _actionHeader;
    private IndividualCardDetailDto? _detail;
    private IndividualCardVersionComparisonDto? _comparison;
    private bool _comparisonLoading;
    private bool _showVersionModal;
    private bool _showArchiveConfirm;
    private Guid _selectedRootHKCardId;
    private bool _creatingVersion;
    private bool _archiving;

    protected override async Task OnInitializedAsync()
    {
        // LoadAsync сам сериализует каждое обращение к БД через CircuitDbLock;
        // внешний захват привёл бы к дедлоку (семафор нереентерабельный).
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _error = null;
        _draft = await DbLock.LockedAsync(() => IndCardService.GetDraftByIdAsync(Id));
        if (_draft is null)
        {
            // Не черновик: облегчённая шапка только для просмотра и полный
            // граф карточки только для чтения; действия «новая версия» и «архив»
            // проверяются по правам независимо друг от друга.
            _actionHeader = await DbLock.LockedAsync(() => IndCardService.GetIndividualCardActionHeaderAsync(Id));
            _detail = await DbLock.LockedAsync(() => IndCardService.GetDetailAsync(Id));
            _comparison = null;
            _selectedRootHKCardId = Guid.Empty;

            var authState = await AuthState.GetAuthenticationStateAsync();
            var headerUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

            var isFormed = _actionHeader is { Status: IndividualCardStatus.Formed };
            _canCreateVersion = isFormed && await DbLock.LockedAsync(() => Perms.HasPermissionAsync(headerUserId, PermissionCodes.IndividualCardCreateVersion));
            _canArchive = isFormed && await DbLock.LockedAsync(() => Perms.HasPermissionAsync(headerUserId, PermissionCodes.IndividualCardArchive));

            // Переход по ссылке из действий реестра.
            var action = Microsoft.AspNetCore.WebUtilities.QueryHelpers
                .ParseQuery(new Uri(Nav.Uri).Query)
                .TryGetValue("action", out var values) ? values.ToString() : null;
            if (action == "version" && _canCreateVersion)
                await OpenVersionModalAsync();
            else if (action == "archive" && _canArchive)
                _showArchiveConfirm = true;
            return;
        }

        _savedCalculation = await DbLock.LockedAsync(() => IndCardService.GetDraftCalculationAsync(Id));
        _detail = await DbLock.LockedAsync(() => IndCardService.GetDetailAsync(Id));

        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var isAuthor = userId != null && _draft.CreatedByUserId == userId;
        var effectiveUserId = userId ?? string.Empty;

        _canSelectCoefficients = isAuthor || await DbLock.LockedAsync(() => Perms.HasPermissionAsync(effectiveUserId, PermissionCodes.IndividualCardEditDraft));
        _canRecalculate = _canSelectCoefficients && await DbLock.LockedAsync(() => Perms.HasPermissionAsync(effectiveUserId, PermissionCodes.IndividualCardRecalculateDraft));
        _canForm = await DbLock.LockedAsync(() => Perms.HasPermissionAsync(effectiveUserId, PermissionCodes.IndividualCardForm));

        if (_draft.Status == IndividualCardStatus.Formed)
        {
            _selectedCoefficientIds = new HashSet<Guid>(
                _savedCalculation?.Coefficients.Select(c => c.SourceCoefficientId) ?? Enumerable.Empty<Guid>());
        }

        if (_draft.Status == IndividualCardStatus.Draft && _canSelectCoefficients)
        {
            await LoadCoefficientsAsync();
            _selectedCoefficientIds = new HashSet<Guid>(
                _savedCalculation?.Coefficients.Select(c => c.SourceCoefficientId) ?? Enumerable.Empty<Guid>());
        }
    }

    private async Task LoadCoefficientsAsync()
    {
        try
        {
            _coefficients = (await DbLock.LockedAsync(() => IndCardService.GetWorkingCoefficientsForDraftSelectAsync(Id, _coefficientSearch)))?.ToList() ?? new();
        }
        catch (UnauthorizedAccessException)
        {
            _coefficients = new();
        }
        _coefficientGroups = _coefficients
            .GroupBy(c => c.CoefficientTypeId)
            .Select(g => (g.First().CoefficientTypeId, g.First().CoefficientTypeName, g.ToList()))
            .ToList();
    }

    private async Task OnCoefficientSearchChanged(ChangeEventArgs args)
    {
        _coefficientSearch = args.Value?.ToString() ?? string.Empty;
        // LoadCoefficientsAsync сам берёт CircuitDbLock; внешний захват привёл бы к дедлоку.
        await LoadCoefficientsAsync();
        StateHasChanged();
    }

    private async Task ToggleCoefficient(
        Guid typeId,
        Guid coefficientId)
    {
        // Внутри одного типа допускается 0 или 1 коэффициент; разные типы
        // независимы. Повторный клик по выбранному — снимает его.
        if (_selectedCoefficientIds.Contains(coefficientId))
        {
            _selectedCoefficientIds.Remove(coefficientId);
        }
        else
        {
            var group = _coefficientGroups.FirstOrDefault(g => g.TypeId == typeId);
            if (group.Items is { } items)
            {
                foreach (var other in items
                    .Select(i => i.Id)
                    .Where(id => id != coefficientId && _selectedCoefficientIds.Contains(id)))
                {
                    _selectedCoefficientIds.Remove(other);
                }
            }
            _selectedCoefficientIds.Add(coefficientId);
        }

        // Автоматический пересчёт Draft после выбора/снятия коэффициента.
        ScheduleAutoRecalculate();
        await Task.CompletedTask;
    }

    private async Task ResetCoefficients()
    {
        if (_selectedCoefficientIds.Count == 0)
            return;

        _selectedCoefficientIds.Clear();
        ScheduleAutoRecalculate();
        await Task.CompletedTask;
    }

    private CancellationTokenSource? _recalcCts;
    private long _recalcVersion;

    /// <summary>
    /// Debounce авто-пересчёта: 300 мс после последнего выбора, каждый новый
    /// выбор отменяет предыдущий запрос; параллельные вызовы невозможны.
    /// </summary>
    private void ScheduleAutoRecalculate()
    {
        if (!_canRecalculate)
            return;

        _recalcCts?.Cancel();
        _recalcCts?.Dispose();
        _recalcCts = new CancellationTokenSource();
        var token = _recalcCts.Token;
        var version = ++_recalcVersion;
        _ = AutoRecalculateAsync(version, token);
    }

    private async Task AutoRecalculateAsync(long version, CancellationToken token)
    {
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested || version != _recalcVersion)
            return;

        _recalcError = null;
        _recalculating = true;
        StateHasChanged();

        try
        {
            await using (await DbLock.WaitAsync(token))
            {
                var result = await IndCardService.RecalculateDraftAsync(
                    new RecalculateIndividualCardDraftRequest(Id, _selectedCoefficientIds.ToList()),
                    token);

                if (version != _recalcVersion || token.IsCancellationRequested)
                    return;

                _savedCalculation = result;
            }
        }
        catch (OperationCanceledException)
        {
            // заменён более свежим выбором
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (version != _recalcVersion || token.IsCancellationRequested)
                return;
            _recalcError = ex.Message;
        }
        catch (Exception ex)
        {
            // Задача запускается без ожидания: любое исключение нужно погасить,
            // иначе оно станет необработанным и уронит circuit.
            if (version != _recalcVersion || token.IsCancellationRequested)
                return;
            Logger.LogError(ex, "Ошибка автоматического пересчёта черновика ИК {Id}", Id);
            _recalcError = "Не удалось выполнить пересчёт. Повторите попытку.";
        }
        finally
        {
            if (version == _recalcVersion)
            {
                _recalculating = false;
                StateHasChanged();
            }
        }
    }

    private async Task Recalculate()
    {
        _error = null;
        _recalculating = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _savedCalculation = await IndCardService.RecalculateDraftAsync(
                    new RecalculateIndividualCardDraftRequest(Id, _selectedCoefficientIds.ToList()));
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _recalculating = false;
        }
    }

    private async Task Form()
    {
        _error = null;
        _forming = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _savedCalculation = await IndCardService.FormDraftAsync(new FormIndividualCardRequest(Id));
            }
            // LoadAsync берёт лок сам — вызывать его внутри блока нельзя.
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _forming = false;
        }
    }

    private async Task OpenVersionModalAsync()
    {
        _error = null;
        _comparisonLoading = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _comparison = await IndCardService.BuildNewVersionComparisonAsync(
                    new IndividualCardVersionPreflightRequest(Id));
            }
            _selectedRootHKCardId = Guid.Empty;
            _showVersionModal = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _comparisonLoading = false;
        }
    }

    private async Task SelectVersionRootAsync(Guid rootHKCardId)
    {
        _selectedRootHKCardId = rootHKCardId;
        _error = null;

        try
        {
            await using (await DbLock.WaitAsync())
            {
                // Повторяем предварительную проверку с явно выбранной корневой ХК: сервис
                // должен подтвердить допустимость до включения кнопки создания.
                _comparison = await IndCardService.BuildNewVersionComparisonAsync(
                    new IndividualCardVersionPreflightRequest(Id, rootHKCardId));
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateNewVersion()
    {
        _error = null;
        _creatingVersion = true;
        try
        {
            Guid newDraftId;
            await using (await DbLock.WaitAsync())
            {
                var created = await IndCardService.CreateNewVersionAsync(
                    new CreateIndividualCardVersionRequest(Id, _selectedRootHKCardId));
                newDraftId = created.Id;
            }
            Nav.NavigateTo($"/инд-карты/черновик/{newDraftId}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
            _showVersionModal = false;
        }
        finally
        {
            _creatingVersion = false;
        }
    }

    private async Task Archive()
    {
        _error = null;
        _archiving = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                await IndCardService.ArchiveIndividualCardAsync(Id);
            }
            _showArchiveConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
            _showArchiveConfirm = false;
        }
        finally
        {
            _archiving = false;
        }
    }

    private static string DiffName(string state) => state switch
    {
        "Added" => "Добавлено",
        "Removed" => "Удалено",
        "Changed" => "Изменено",
        _ => "Без изменений",
    };

    private static string DiffTagClass(string state) => state switch
    {
        "Added" => "ok",
        "Removed" => "bad",
        "Changed" => "warn",
        _ => "",
    };

    private void OpenVersionCard(Guid id) => Nav.NavigateTo($"/инд-карты/{id}");

    private void GoBack() => Nav.NavigateTo("/инд-карты");

    private static string FormatGram(decimal value) => value.ToString("F0", CultureInfo.InvariantCulture);

    private static string FormatCoefficient(decimal value) => value.ToString("F2", CultureInfo.InvariantCulture);

    private static string CategoryName(GsmCategory category) => category switch
    {
        GsmCategory.Primary => "Основное",
        GsmCategory.Duplicate => "Дублирующее",
        GsmCategory.Reserve => "Резервное",
        GsmCategory.Foreign => "Зарубежное",
        _ => category.ToString(),
    };

    private static string Plural(int count) => count switch
    {
        1 => "коэффициент",
        var n when n % 10 == 2 && n % 100 != 12 => "коэффициента",
        var n when n % 10 is >= 3 and <= 4 && (n % 100 < 10 || n % 100 >= 20) => "коэффициента",
        _ => "коэффициентов",
    };

    public void Dispose()
    {
        _recalcCts?.Cancel();
        _recalcCts?.Dispose();
        _recalcCts = null;
    }
}
