@page "/инд-карты/черновик/{Id:guid}"
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using System.Globalization
@using Chernika.Web.Services
@inject IndividualCardService IndCardService
@inject IPermissionService Perms
@inject AuthenticationStateProvider AuthState
@inject CircuitDbLock DbLock
@inject NavigationManager Nav

<div class="stack">
    @if (_loading)
    {
        <section class="panel">
            <div class="panelBody"><div class="loading-state">Загрузка...</div></div>
        </section>
    }
    else if (_draft is null)
    {
        @if (_comparison is not null)
        {
            <section class="panel">
                <div class="panelHeader">
                    <h2>ИК @_comparison.SourceCode @_comparison.SourceVersion</h2>
                    <div class="hint">@_comparison.SourceObjectLevelDisplay: @_comparison.SourceObjectName</div>
                    <span class="tag ok">Сформирована</span>
                </div>
                <div class="panelBody">
                    @if (_canCreateVersion || _canArchive)
                    {
                        <div class="formActions">
                            @if (_canCreateVersion)
                            {
                                <button type="button" class="btn primary" @onclick="() => _showVersionModal = true">Создать новую версию ИК</button>
                            }
                            @if (_canArchive)
                            {
                                <button type="button" class="btn ghost" @onclick="() => _showArchiveConfirm = true">В архив</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="note">Недостаточно прав для работы с ИК.</div>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="panel">
                <div class="panelBody"><div class="note">@(string.IsNullOrEmpty(_error) ? "ИК не найдена." : _error)</div></div>
            </section>
        }
    }
    else
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>Черновик ИК @_draft.Code @_draft.Version</h2>
                <div class="hint">@_draft.ObjectLevelDisplay: @_draft.ObjectCode @_draft.ObjectName</div>
                <span class="tag @(_draft.Status == IndividualCardStatus.Formed ? "ok" : "")">@IndividualCardDisplay.Status(_draft.Status)</span>
            </div>
            <div class="panelBody">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="hkc-error">@_error</div>
                }

                @if (_draft.Status == IndividualCardStatus.Draft && _canSelectCoefficients)
                {
                    <div class="field">
                        <label>Коэффициенты</label>
                        <input class="fieldInput" placeholder="Поиск по типу, наименованию, условию, основанию…"
                               value="@_coefficientSearch" @oninput="OnCoefficientSearchChanged" />
                    </div>

                    @foreach (var group in _coefficientGroups)
                    {
                        <div class="hkc-group">
                            <div class="hkc-group-title">@group.TypeName</div>
                            @foreach (var coefficient in group.Items)
                            {
                                var selected = _selectedCoefficientIds.Contains(coefficient.Id);
                                <label class="hkc-item @(selected ? "selected" : "")">
                                    <input type="radio" name="@($"coef-{group.TypeId}")" checked="@selected"
                                           @onchange="() => ToggleCoefficient(group, coefficient)" />
                                    <span class="hkc-item-name">@coefficient.Name</span>
                                    <span class="mono hkc-item-value">@FormatF6(coefficient.Value)</span>
                                    @if (!string.IsNullOrWhiteSpace(coefficient.ConditionDescription))
                                    {
                                        <span class="hkc-item-desc">@coefficient.ConditionDescription</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(coefficient.NormativeBasis))
                                    {
                                        <span class="hkc-item-desc">@coefficient.NormativeBasis</span>
                                    }
                                </label>
                            }
                        </div>
                    }

                    <div class="hkc-summary">
                        <span>Выбрано: @_selectedCoefficientIds.Count @(Plural(_selectedCoefficientIds.Count))</span>
                        <span>Общий коэффициент: <span class="mono">@FormatF6(_savedCalculation?.TotalCoefficient ?? 1m)</span></span>
                        @if (_canRecalculate)
                        {
                            <button type="button" class="btn primary" disabled="@(_recalculating)"
                                    @onclick="Recalculate">
                                @(_recalculating ? "Пересчёт…" : "Пересчитать")
                            </button>
                        }
                    </div>
                }
                else if (_draft.Status == IndividualCardStatus.Draft)
                {
                    <div class="note">Выбор коэффициентов недоступен: недостаточно прав.</div>
                }
            </div>
        </section>

        @if (_savedCalculation is not null)
        {
            <section class="panel">
                <div class="panelHeader">
                    <h2>Расчёт</h2>
                    <div class="hint">Общий коэффициент: <span class="mono">@FormatF6(_savedCalculation.TotalCoefficient)</span></div>
                </div>
                <div class="panelBody">
                    @if (_savedCalculation.Problems.Count > 0)
                    {
                        <div class="hkc-problems">
                            @foreach (var problem in _savedCalculation.Problems)
                            {
                                <div class="note">⚠ @problem.Message</div>
                            }
                        </div>
                    }

                    @if (_savedCalculation.Rows.Count > 0)
                    {
                        <div class="hk-items-table-wrapper">
                        <table class="hk-items-table">
                            <thead>
                                <tr>
                                    <th>№</th>
                                    <th>ХК узла</th>
                                    <th>Сборочная единица</th>
                                    <th>Кол-во СЕ</th>
                                    <th>Кол-во узлов</th>
                                    <th>Кол-во агрегатов</th>
                                    <th>Кол-во изделий</th>
                                    <th>Норма ХК</th>
                                    <th>Базовая норма</th>
                                    <th>Расчётная норма, г</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _savedCalculation.Rows)
                                {
                                    <tr>
                                        <td>@(row.SortOrder + 1)</td>
                                        <td class="mono">@row.HKCardCode @row.HKCardVersion</td>
                                        <td>@row.AssemblyUnitName</td>
                                        <td>@row.AssemblyUnitQuantity</td>
                                        <td>@row.NodeQuantity</td>
                                        <td>@row.AggregateQuantity</td>
                                        <td>@row.ProductQuantity</td>
                                        <td class="mono">@FormatF6(row.SourceVolume)</td>
                                        <td class="mono">@FormatF6(row.BaseVolume)</td>
                                        <td class="mono">@FormatF6(row.CalculatedVolume)</td>
                                    </tr>
                                    @foreach (var material in row.Materials)
                                    {
                                        <tr class="hkc-material-row">
                                            <td></td>
                                            <td colspan="9">
                                                <span class="tag @(material.Category == GsmCategory.Primary ? "ok" : "")">@CategoryName(material.Category)</span>
                                                @material.MaterialName
                                                @if (!string.IsNullOrWhiteSpace(material.Gost))
                                                {
                                                    <span class="hkc-gost">ГОСТ/ТУ: @material.Gost</span>
                                                }
                                                — <span class="mono">@FormatF6(material.CalculatedVolume) @material.UnitOfMeasure</span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    else
                    {
                        <div class="note">Расчёт не выполнялся.</div>
                    }

                    @if (_savedCalculation.PrimaryTotals.Count > 0)
                    {
                        <h3 class="hkc-subtitle">Основные марки ГСМ (альтернативы, не суммируются)</h3>
                        <table class="hk-items-table">
                            <thead>
                                <tr>
                                    <th>Марка ГСМ</th>
                                    <th>ГОСТ/ТУ</th>
                                    <th>Ед. изм.</th>
                                    <th>Количество строк</th>
                                    <th>Итого</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var total in _savedCalculation.PrimaryTotals)
                                {
                                    <tr>
                                        <td>@total.MaterialName</td>
                                        <td>@total.Gost</td>
                                        <td>@total.UnitOfMeasure</td>
                                        <td>@total.ItemCount</td>
                                        <td class="mono">@FormatF6(total.TotalVolume) @total.UnitOfMeasure</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <div class="formActions">
                        @if (_draft.Status == IndividualCardStatus.Draft && _canForm)
                        {
                            <button type="button" class="btn primary" disabled="@(!_savedCalculation.IsReadyToForm || _forming)"
                                    title="@(_savedCalculation.IsReadyToForm ? "" : "Устраните проблемы расчёта перед формированием")"
                                    @onclick="Form">
                                @(_forming ? "Формирование…" : "Сформировать ИК")
                            </button>
                        }
                        <button type="button" class="btn ghost" @onclick="GoBack">Назад</button>
                    </div>
                </div>
            </section>
        }
    }
</div>

@if (_showVersionModal && _comparison is not null)
{
    <div class="modalOverlay" @onclick="() => _showVersionModal = false">
        <div class="modal hkv-modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Создать новую версию ИК</h3>
                <button type="button" class="linkBtn" @onclick="() => _showVersionModal = false">✕</button>
            </div>
            <div class="modalBody">
                <div class="hkv-row"><span class="hkv-label">Источник:</span> ИК @_comparison.SourceCode @_comparison.SourceVersion</div>
                <div class="hkv-row"><span class="hkv-label">Новая версия:</span> будет Draft @_comparison.SourceCode с новым номером ревизии</div>

                @if (_comparison.RootState == IndividualCardPreflightRootState.SelectionRequired)
                {
                    <div class="field">
                        <label>ХК верхнего уровня (несколько кандидатов)</label>
                        @foreach (var candidate in _comparison.RootCandidates)
                        {
                            <label class="hkc-item">
                                <input type="radio" name="version-root" checked="@(_selectedRootHKCardId == candidate.HKCardId)"
                                       @onchange="() => _selectedRootHKCardId = candidate.HKCardId" />
                                <span class="hkc-item-name">@candidate.Code @candidate.Version — @candidate.ObjectName</span>
                            </label>
                        }
                    </div>
                }

                <h4 class="hkc-subtitle">Состав: было / стало</h4>
                @foreach (var change in _comparison.CompositionChanges)
                {
                    <div class="hkv-diff-row">
                        <span class="tag @(DiffTagClass(change.State))">@DiffName(change.State)</span>
                        <span>@change.What: @change.Display</span>
                        <span class="hkv-wasstalo">@change.Before → @change.After</span>
                    </div>
                }

                <h4 class="hkc-subtitle">ХК: было / стало</h4>
                @foreach (var change in _comparison.HKChanges)
                {
                    <div class="hkv-diff-row">
                        <span class="tag @(DiffTagClass(change.State))">@DiffName(change.State)</span>
                        <span>@change.What: @change.Display</span>
                        <span class="hkv-wasstalo">@change.Before → @change.After</span>
                    </div>
                }

                <div class="hkv-row"><span class="hkv-label">Коэффициенты:</span> будут выбраны заново в новой Draft</div>
                @if (_comparison.PreviousCoefficients.Count > 0)
                {
                    <div class="hkv-muted">
                        @foreach (var coefficient in _comparison.PreviousCoefficients)
                        {
                            <div>@coefficient.CoefficientTypeName / @coefficient.CoefficientName — <span class="mono">@FormatF6(coefficient.Value)</span></div>
                        }
                    </div>
                }

                <div class="hkv-row"><span class="hkv-label">Расчёт:</span> будет выполнен в новой Draft</div>
                @if (_comparison.HasCalculation && _comparison.PreviousPrimaryTotals.Count > 0)
                {
                    <div class="hkv-muted">
                        <div>Основные марки ГСМ в источнике (альтернативы, не суммируются):</div>
                        @foreach (var total in _comparison.PreviousPrimaryTotals)
                        {
                            <div>@total.MaterialName — <span class="mono">@FormatF6(total.TotalVolume) @total.UnitOfMeasure</span></div>
                        }
                        <div>Итоги новой версии: будут доступны после пересчёта новой версии.</div>
                    </div>
                }

                <div class="hkv-row"><span class="hkv-label">Нормативные пробелы:</span>
                    @if (_comparison.NormativeGaps.Count == 0)
                    {
                        <span>нет</span>
                    }
                    else
                    {
                        <span>@_comparison.NormativeGaps.Count (новая Draft будет частичной)</span>
                    }
                </div>
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="() => _showVersionModal = false">Отмена</button>
                <button type="button" class="btn primary" disabled="@(!_comparison.IsReadyToCreateDraft || _creatingVersion)"
                        @onclick="CreateNewVersion">
                    @(_creatingVersion ? "Создание…" : "Создать черновик новой версии")
                </button>
            </div>
        </div>
    </div>
}

@if (_showArchiveConfirm && _comparison is not null)
{
    <div class="modalOverlay" @onclick="() => _showArchiveConfirm = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Архивировать ИК</h3>
                <button type="button" class="linkBtn" @onclick="() => _showArchiveConfirm = false">✕</button>
            </div>
            <div class="modalBody">
                <div>Архивировать ИК «@_comparison.SourceCode @_comparison.SourceVersion»?</div>
                <div class="hkv-muted">Архивная ИК останется доступна для просмотра и истории, но не может быть изменена или сформирована повторно.</div>
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="() => _showArchiveConfirm = false">Отмена</button>
                <button type="button" class="btn primary" disabled="@_archiving" @onclick="Archive">
                    @(_archiving ? "Архивирование…" : "Архивировать")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private IndividualCardDraftDto? _draft;
    private IndividualCardCalculationDto? _savedCalculation;

    private bool _canSelectCoefficients;
    private bool _canRecalculate;
    private bool _canForm;

    private string _coefficientSearch = string.Empty;
    private List<CoefficientListItemDto> _coefficients = new();
    private List<(Guid TypeId, string TypeName, List<CoefficientListItemDto> Items)> _coefficientGroups = new();
    private HashSet<Guid> _selectedCoefficientIds = new();
    private bool _recalculating;
    private bool _forming;

    private bool _canCreateVersion;
    private bool _canArchive;
    private IndividualCardVersionComparisonDto? _comparison;
    private bool _showVersionModal;
    private bool _showArchiveConfirm;
    private Guid _selectedRootHKCardId;
    private bool _creatingVersion;
    private bool _archiving;

    protected override async Task OnInitializedAsync()
    {
        await using (await DbLock.WaitAsync())
        {
            await LoadAsync();
        }
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _error = null;
        _draft = await IndCardService.GetDraftByIdAsync(Id);
        if (_draft is null)
        {
            // Formed (or foreign) card: try the D5 comparison entry — it is the
            // minimal read available without a full D6 card.
            try
            {
                _comparison = await IndCardService.BuildNewVersionComparisonAsync(
                    new IndividualCardVersionPreflightRequest(Id));
            }
            catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
            {
                _comparison = null;
                _error = ex.Message;
            }

            var authState = await AuthState.GetAuthenticationStateAsync();
            var authUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            _canCreateVersion = await Perms.HasPermissionAsync(PermissionCodes.IndividualCardCreateVersion);
            _canArchive = await Perms.HasPermissionAsync(PermissionCodes.IndividualCardArchive);
            if (_comparison is not null)
            {
                _canCreateVersion &= _comparison.IsReadyToCreateDraft || _comparison.RootState == IndividualCardPreflightRootState.SelectionRequired;
            }
            return;
        }

        _savedCalculation = await IndCardService.GetDraftCalculationAsync(Id);

        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var isAuthor = userId != null && _draft.CreatedByUserId == userId;

        _canSelectCoefficients = isAuthor || await Perms.HasPermissionAsync(PermissionCodes.IndividualCardEditDraft);
        _canRecalculate = _canSelectCoefficients && await Perms.HasPermissionAsync(PermissionCodes.IndividualCardRecalculateDraft);
        _canForm = await Perms.HasPermissionAsync(PermissionCodes.IndividualCardForm);

        if (_draft.Status == IndividualCardStatus.Formed)
        {
            _selectedCoefficientIds = new HashSet<Guid>(
                _savedCalculation?.Coefficients.Select(c => c.SourceCoefficientId) ?? Enumerable.Empty<Guid>());
        }

        if (_draft.Status == IndividualCardStatus.Draft && _canSelectCoefficients)
        {
            await LoadCoefficientsAsync();
            _selectedCoefficientIds = new HashSet<Guid>(
                _savedCalculation?.Coefficients.Select(c => c.SourceCoefficientId) ?? Enumerable.Empty<Guid>());
        }
    }

    private async Task LoadCoefficientsAsync()
    {
        try
        {
            _coefficients = (await IndCardService.GetWorkingCoefficientsForDraftSelectAsync(Id, _coefficientSearch))?.ToList() ?? new();
        }
        catch (UnauthorizedAccessException)
        {
            _coefficients = new();
        }
        _coefficientGroups = _coefficients
            .GroupBy(c => c.CoefficientTypeId)
            .Select(g => (g.First().CoefficientTypeId, g.First().CoefficientTypeName, g.ToList()))
            .ToList();
    }

    private async Task OnCoefficientSearchChanged(ChangeEventArgs args)
    {
        _coefficientSearch = args.Value?.ToString() ?? string.Empty;
        await using (await DbLock.WaitAsync())
        {
            await LoadCoefficientsAsync();
        }
        StateHasChanged();
    }

    private async Task ToggleCoefficient(
        (Guid TypeId, string TypeName, List<CoefficientListItemDto> Items) group,
        CoefficientListItemDto coefficient)
    {
        // Radio semantics: choosing a value within one type replaces only that
        // type's choice; other types keep their selections.
        if (_selectedCoefficientIds.Contains(coefficient.Id))
        {
            _selectedCoefficientIds.Remove(coefficient.Id);
        }
        else
        {
            foreach (var other in group.Items.Select(i => i.Id))
                _selectedCoefficientIds.Remove(other);
            _selectedCoefficientIds.Add(coefficient.Id);
        }
        await Task.CompletedTask;
    }

    private async Task Recalculate()
    {
        _error = null;
        _recalculating = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _savedCalculation = await IndCardService.RecalculateDraftAsync(
                    new RecalculateIndividualCardDraftRequest(Id, _selectedCoefficientIds.ToList()));
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _recalculating = false;
        }
    }

    private async Task Form()
    {
        _error = null;
        _forming = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _savedCalculation = await IndCardService.FormDraftAsync(new FormIndividualCardRequest(Id));
                await LoadAsync();
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _forming = false;
        }
    }

    private async Task CreateNewVersion()
    {
        _error = null;
        _creatingVersion = true;
        try
        {
            Guid newDraftId;
            await using (await DbLock.WaitAsync())
            {
                var created = await IndCardService.CreateNewVersionAsync(
                    new CreateIndividualCardVersionRequest(Id, _selectedRootHKCardId));
                newDraftId = created.Id;
            }
            Nav.NavigateTo($"/инд-карты/черновик/{newDraftId}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
            _showVersionModal = false;
        }
        finally
        {
            _creatingVersion = false;
        }
    }

    private async Task Archive()
    {
        _error = null;
        _archiving = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                await IndCardService.ArchiveIndividualCardAsync(Id);
            }
            _showArchiveConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
            _showArchiveConfirm = false;
        }
        finally
        {
            _archiving = false;
        }
    }

    private static string DiffName(string state) => state switch
    {
        "Added" => "Добавлено",
        "Removed" => "Удалено",
        "Changed" => "Изменено",
        _ => "Без изменений",
    };

    private static string DiffTagClass(string state) => state switch
    {
        "Added" => "ok",
        "Removed" => "bad",
        "Changed" => "warn",
        _ => "",
    };

    private void GoBack() => Nav.NavigateTo("/инд-карты");

    private static string FormatF6(decimal value) => value.ToString("F6", CultureInfo.InvariantCulture);

    private static string CategoryName(GsmCategory category) => category switch
    {
        GsmCategory.Primary => "Основное",
        GsmCategory.Duplicate => "Дублирующее",
        GsmCategory.Reserve => "Резервное",
        GsmCategory.Foreign => "Зарубежное",
        _ => category.ToString(),
    };

    private static string Plural(int count) => count switch
    {
        1 => "коэффициент",
        var n when n % 10 == 2 && n % 100 != 12 => "коэффициента",
        var n when n % 10 is >= 3 and <= 4 && (n % 100 < 10 || n % 100 >= 20) => "коэффициента",
        _ => "коэффициентов",
    };
}
