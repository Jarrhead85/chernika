@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@page "/задачи"
@attribute [Authorize(Policy = "ViewTasks")]
@inject TaskService TaskService
@inject NavigationManager Nav
@inject IPermissionService PermSvc
@inject AuthenticationStateProvider AuthState

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Входящие задачи</h2>
            <div class="hint">@activeCount активных</div>
        </div>
        <div class="panelBody">
            <div class="form" style="grid-template-columns:1fr auto">
                <div class="field"><label>Фильтр</label>
                    <select @bind="filter" class="field-select">
                        <option value="all">Все задачи</option>
                        <option value="hk_review">На проверку ХК</option>
                        <option value="hk_revision">На доработку ХК</option>
                        <option value="recalculate">Пересчёт инд. карт</option>
                    </select>
                </div>
                <div class="field" style="display:flex;align-items:flex-end">
                    <button class="btn primary" @onclick="LoadTasks">Обновить</button>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>Активные задачи</h2>
            <div class="hint">@activeTasks.Count</div>
        </div>
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!activeTasks.Any())
            {
                <div class="empty-state">Нет активных задач</div>
            }
            else
            {
                <div class="alerts">
                    @foreach (var task in activeTasks)
                    {
                        var isUrgent = task.DueDateUtc.HasValue && task.DueDateUtc.Value < DateTime.UtcNow.AddDays(2);
                        <div class="alert">
                            <div class="top">
                                <p class="title">@task.Title</p>
                                <span class="tag @(isUrgent ? "bad" : task.DueDateUtc.HasValue ? "warn" : "ok")">
                                    @(task.DueDateUtc?.ToString("dd.MM") ?? "Без срока")
                                </span>
                            </div>
                            <p class="desc">@task.Description</p>
                            <div class="rowActions" style="margin-top:8px">
                                @if (_canComplete)
                                {
                                    <button class="linkBtn" @onclick="() => CompleteTask(task.Id)">✓ Выполнено</button>
                                }
                                @if (task.EntityType == "HKCard" && task.EntityId.HasValue)
                                {
                                    <button class="linkBtn" @onclick="() => OpenEntity(task)">Открыть</button>
                                }
                                @if (_canCancel)
                                {
                                    <button class="linkBtn" @onclick="() => CancelTask(task.Id)">Отменить</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>Выполненные</h2>
            <div class="hint">Последние @completedTasks.Count</div>
        </div>
        <div class="panelBody">
            @if (completedTasks.Any())
            {
                <table>
                    <thead>
                        <tr><th>Задача</th><th>Создана</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var task in completedTasks)
                        {
                            <tr>
                                <td>@task.Title</td>
                                <td class="mono">@task.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Нет выполненных задач</div>
            }
        </div>
    </section>
</div>

@code {
    private List<WorkTaskListItemDto> activeTasks = new();
    private List<WorkTaskListItemDto> completedTasks = new();
    private bool loading = true;
    private int activeCount = 0;
    private string filter = "all";
    private bool _canComplete;
    private bool _canCancel;

    protected override async Task OnInitializedAsync()
    {
        var userId = (await AuthState.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            _canComplete = await PermSvc.HasPermissionAsync(userId, PermissionCodes.TaskComplete);
            _canCancel = await PermSvc.HasPermissionAsync(userId, PermissionCodes.TaskCancel);
        }
        await LoadTasks();
    }

    async Task LoadTasks()
    {
        loading = true;
        var typeFilter = filter switch
        {
            "hk_review" => (WorkTaskType?)WorkTaskType.HKReview,
            "hk_revision" => (WorkTaskType?)WorkTaskType.HKRevision,
            _ => null
        };
        var active = await TaskService.GetMyTasksAsync(new WorkTaskQuery { PageSize = 200, Type = typeFilter });
        activeTasks = active.Items
            .Where(t => t.Status != WorkTaskStatus.Completed && t.Status != WorkTaskStatus.Cancelled)
            .ToList();
        var done = await TaskService.GetMyTasksAsync(new WorkTaskQuery
        {
            PageSize = 50,
            Status = WorkTaskStatus.Completed,
            Type = typeFilter
        });
        completedTasks = done.Items.ToList();
        activeCount = await TaskService.GetOpenTaskCountAsync();
        loading = false;
    }

    async Task CompleteTask(Guid id)
    {
        await TaskService.CompleteAsync(new CompleteWorkTaskCommand(id));
        await LoadTasks();
    }

    async Task CancelTask(Guid id)
    {
        await TaskService.CancelAsync(new CancelWorkTaskCommand(id, "Отменена пользователем"));
        await LoadTasks();
    }

    void OpenEntity(WorkTaskListItemDto task)
    {
        if (task.EntityType == "HKCard" && task.EntityId.HasValue)
            Nav.NavigateTo($"/хк/{task.EntityId.Value}");
    }
}
