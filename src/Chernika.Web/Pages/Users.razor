@page "/пользователи"
@attribute [Authorize(Policy = "ManageUsers")]
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@inject UserManagementService UserMgmt
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<Microsoft.AspNetCore.Identity.IdentityRole> RoleManager
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Управление пользователями</h2>
            <div class="hint">@users.Count зарегистрировано</div>
        </div>
        <div class="panelBody">
            <div class="btnRow" style="margin-bottom:16px">
                <button class="btn primary" @onclick="OpenCreate">+ Новый пользователь</button>
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!users.Any())
            {
                <div class="empty-state">Нет пользователей</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Логин</th>
                            <th>ФИО</th>
                            <th>Должность</th>
                            <th>Роль</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="mono">@user.UserName</td>
                                <td>@user.FullName</td>
                                <td>@user.Position</td>
                                <td><span class="badge">@GetRoleDisplayName(user.RoleName)</span></td>
                                <td>
                                    <span class="badge" style="background:@(user.IsActive ? "var(--ok)" : "var(--warn)")">
                                        @(user.IsActive ? "Активен" : "Заблокирован")
                                    </span>
                                </td>
                                <td>
                                    <button class="linkBtn" @onclick="() => OpenEdit(user)">Изменить</button>
                                    <button class="linkBtn" @onclick="() => OpenOverrides(user)">Права</button>
                                    <button class="linkBtn" style="color:var(--warn)" @onclick="() => ToggleBlock(user)">
                                        @(user.IsActive ? "Заблокировать" : "Разблокировать")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    @if (showUserModal)
    {
        <div class="modalOverlay" @onclick="CloseUserModal">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modalHeader">
                    <h3>@(isEdit ? "Редактирование" : "Новый пользователь")</h3>
                    <button class="linkBtn" @onclick="CloseUserModal">✕</button>
                </div>
                <div class="modalBody">
                    <div class="form">
                        <div class="field"><label>Логин *</label>
                            <input type="text" @bind="formUsername" class="fieldInput" disabled="@isEdit" />
                        </div>
                        <div class="field"><label>ФИО</label>
                            <input type="text" @bind="formFullName" class="fieldInput" />
                        </div>
                        <div class="field"><label>Должность</label>
                            <input type="text" @bind="formPosition" class="fieldInput" />
                        </div>
                        @if (!isEdit)
                        {
                            <div class="field"><label>Пароль *</label>
                                <input type="password" @bind="formPassword" class="fieldInput" />
                            </div>
                        }
                        <div class="field"><label>Роль</label>
                            <select @bind="formRole" class="field-select">
                                @foreach (var role in allRoles)
                                {
                                    <option value="@role">@GetRoleDisplayName(role)</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="loginError" style="margin-top:12px">@formError</div>
                    }
                </div>
                <div class="modalFooter">
                    <button class="btn" @onclick="CloseUserModal">Отмена</button>
                    <button class="btn primary" @onclick="SaveUser">Сохранить</button>
                </div>
            </div>
        </div>
    }

    @if (showOverridesModal)
    {
        <div class="modalOverlay" @onclick="CloseOverridesModal">
            <div class="modal wide" @onclick:stopPropagation="true">
                <div class="modalHeader">
                    <h3>Переопределения прав — @overridesUserName</h3>
                    <button class="linkBtn" @onclick="CloseOverridesModal">✕</button>
                </div>
                <div class="modalBody">
                    @if (overridesLoading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else
                    {
                        <div class="btnRow" style="margin-bottom:12px">
                            <button class="btn primary" @onclick="OpenAddOverride">+ Добавить</button>
                        </div>
                        @if (overrides.Count == 0)
                        {
                            <div class="empty-state">Нет переопределений</div>
                        }
                        else
                        {
                            <table>
                                <thead>
                                    <tr>
                                        <th>Разрешение</th>
                                        <th>Тип</th>
                                        <th>Причина</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var o in overrides)
                                    {
                                        <tr>
                                            <td class="mono">@o.PermissionCode</td>
                                            <td>
                                                <span class="badge" style="background:@(o.IsGranted ? "var(--ok)" : "var(--warn)")">
                                                    @(o.IsGranted ? "Разрешено" : "Запрещено")
                                                </span>
                                            </td>
                                            <td>@o.Reason</td>
                                            <td>
                                                <button class="linkBtn" style="color:var(--warn)" @onclick="() => RemoveOverride(o)">Удалить</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @if (showAddOverrideForm)
                    {
                        <div class="form" style="margin-top:16px;border-top:1px dashed var(--line);padding-top:16px">
                            <div class="field"><label>Код разрешения</label>
                                <select @bind="overridePermissionCode" class="field-select">
                                    @foreach (var pc in allPermissionCodes)
                                    {
                                        <option value="@pc">@pc</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Тип</label>
                                <select @bind="overrideIsGranted" class="field-select">
                                    <option value="true">Разрешить</option>
                                    <option value="false">Запретить</option>
                                </select>
                            </div>
                            <div class="field"><label>Причина</label>
                                <input type="text" @bind="overrideReason" class="fieldInput" />
                            </div>
                            @if (!string.IsNullOrEmpty(overrideError))
                            {
                                <div class="loginError">@overrideError</div>
                            }
                            <div class="btnRow">
                                <button class="btn" @onclick="CancelAddOverride">Отмена</button>
                                <button class="btn primary" @onclick="SaveOverride">Сохранить</button>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(overrideError))
                    {
                        <div class="loginError" style="margin-top:12px">@overrideError</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<UserListItem> users = new();
    private List<string> allRoles = new();
    private List<string> allPermissionCodes = new();
    private bool loading = true;

    private bool showUserModal = false;
    private bool isEdit = false;
    private string formError = "";
    private string editingUserId = "";

    private string formUsername = "";
    private string formFullName = "";
    private string formPosition = "";
    private string formPassword = "";
    private string formRole = "";

    private bool showOverridesModal = false;
    private bool overridesLoading = false;
    private string overridesUserId = "";
    private string overridesUserName = "";
    private List<UserPermissionOverrideDto> overrides = new();
    private bool showAddOverrideForm = false;
    private string overridePermissionCode = "";
    private bool overrideIsGranted = true;
    private string overrideReason = "";
    private string overrideError = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        allRoles = (await RoleManager.Roles.ToListAsync()).Select(r => r.Name ?? "").Where(n => !string.IsNullOrEmpty(n)).ToList();
        allPermissionCodes = PermissionCodes.All.OrderBy(x => x).ToList();
    }

    async Task LoadUsers()
    {
        loading = true;
        users = await UserMgmt.GetUsersAsync();
        loading = false;
        StateHasChanged();
    }

    string GetRoleDisplayName(string role) => role switch
    {
        "SystemAdmin" => "Системный администратор",
        "NormAdmin" => "Нормировщик",
        "Operator" => "Оператор",
        "HeadOfDepartment" => "Начальник отдела",
        "Guest" => "Гость",
        _ => role
    };

    void OpenCreate()
    {
        isEdit = false;
        editingUserId = "";
        formUsername = "";
        formFullName = "";
        formPosition = "";
        formPassword = "";
        formRole = allRoles.FirstOrDefault() ?? "";
        formError = "";
        showUserModal = true;
    }

    void OpenEdit(UserListItem user)
    {
        isEdit = true;
        editingUserId = user.Id;
        formUsername = user.UserName;
        formFullName = user.FullName;
        formPosition = user.Position;
        formPassword = "";
        formRole = user.RoleName;
        formError = "";
        showUserModal = true;
    }

    void CloseUserModal()
    {
        showUserModal = false;
        formError = "";
    }

    async Task SaveUser()
    {
        formError = "";

        if (isEdit)
        {
            var (success, error) = await UserMgmt.UpdateUserAsync(editingUserId, formFullName, formPosition, formRole);
            if (!success) { formError = error ?? ""; return; }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(formUsername)) { formError = "Логин обязателен"; return; }
            if (string.IsNullOrWhiteSpace(formPassword)) { formError = "Пароль обязателен"; return; }
            var (success, error) = await UserMgmt.CreateUserAsync(formUsername, formPassword, formFullName, formPosition, formRole);
            if (!success) { formError = error ?? ""; return; }
        }

        showUserModal = false;
        await LoadUsers();
    }

    async Task ToggleBlock(UserListItem user)
    {
        var (success, error) = await UserMgmt.ToggleBlockAsync(user.Id);
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task OpenOverrides(UserListItem user)
    {
        overridesUserId = user.Id;
        overridesUserName = $"{user.FullName} ({user.UserName})";
        overridesLoading = true;
        showOverridesModal = true;
        showAddOverrideForm = false;
        overrides = await UserMgmt.GetOverridesAsync(user.Id);
        overridesLoading = false;
        StateHasChanged();
    }

    void CloseOverridesModal()
    {
        showOverridesModal = false;
        overrideError = "";
    }

    void OpenAddOverride()
    {
        showAddOverrideForm = true;
        overridePermissionCode = allPermissionCodes.FirstOrDefault() ?? "";
        overrideIsGranted = true;
        overrideReason = "";
        overrideError = "";
    }

    void CancelAddOverride()
    {
        showAddOverrideForm = false;
        overrideError = "";
    }

    async Task SaveOverride()
    {
        overrideError = "";
        var (success, error) = await UserMgmt.SetOverrideAsync(overridesUserId, overridePermissionCode, overrideIsGranted, overrideReason);
        if (!success) { overrideError = error ?? ""; return; }
        showAddOverrideForm = false;
        overrides = await UserMgmt.GetOverridesAsync(overridesUserId);
        StateHasChanged();
    }

    async Task RemoveOverride(UserPermissionOverrideDto o)
    {
        await UserMgmt.RemoveOverrideAsync(overridesUserId, o.PermissionCode);
        overrides = await UserMgmt.GetOverridesAsync(overridesUserId);
        StateHasChanged();
    }

    public void Dispose() { }
}
