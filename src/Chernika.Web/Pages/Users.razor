@page "/пользователи"
@attribute [Authorize(Policy = "ManageUsers")]
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@inject UserManagementService UserMgmt
@inject EquipmentService EquipService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Управление пользователями</h2>
            <div class="hint">@users.Count зарегистрировано</div>
        </div>
        <div class="panelBody">
            <div class="btnRow" style="margin-bottom:16px">
                <button class="btn primary" @onclick="OpenCreate">+ Новый пользователь</button>
                <select class="fieldInput" style="max-width:200px" @bind="statusFilter" @bind:after="LoadUsers">
                    <option value="">Все (кроме удалённых)</option>
                    <option value="active">Активные</option>
                    <option value="blocked">Заблокированные</option>
                    <option value="deleted">Удалённые</option>
                    <option value="all">Все (включая удалённых)</option>
                </select>
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!users.Any())
            {
                <div class="empty-state">Нет пользователей</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Логин</th>
                            <th>ФИО</th>
                            <th>Должность</th>
                            <th>Роль</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="mono">@user.UserName</td>
                                <td>@user.FullName</td>
                                <td>@user.Position</td>
                                <td><span class="badge">@GetRoleDisplayName(user.RoleName)</span></td>
                                <td>
                                    @if (user.IsDeleted)
                                    {
                                        <span class="badge" style="background:var(--text3)">Удалён</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="badge" style="background:var(--ok)">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:var(--warn)">Заблокирован</span>
                                    }
                                </td>
                                <td>
                                    <button class="linkBtn" @onclick="() => OpenEdit(user)">Изменить</button>
                                    <button class="linkBtn" @onclick="() => OpenPermissions(user)">Полномочия</button>
                                    @if (user.IsDeleted)
                                    {
                                        <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreUser(user)">Восстановить</button>
                                    }
                                    else
                                    {
                                        <button class="linkBtn" style="color:var(--warn)" @onclick="() => ToggleBlock(user)">
                                            @(user.IsActive ? "Заблокировать" : "Разблокировать")
                                        </button>
                                        <button class="linkBtn" style="color:var(--error)" @onclick="() => DeleteUser(user)">Удалить</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    @if (showUserModal)
    {
        <div class="modalOverlay" @onclick="CloseUserModal">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modalHeader">
                    <h3>@(isEdit ? "Редактирование" : "Новый пользователь")</h3>
                    <button class="linkBtn" @onclick="CloseUserModal" aria-label="Закрыть">✕</button>
                </div>
                <div class="modalBody">
                    <form autocomplete="off" @onsubmit:preventDefault="true">
                        <div class="form">
                            <div class="field">
                                <label for="new-user-login">Логин *</label>
                                <input id="new-user-login" type="text" @bind="formUsername" @bind:event="oninput"
                                       class="fieldInput" disabled="@isEdit" autocomplete="off" maxlength="256" />
                            </div>
                            <div class="field">
                                <label for="new-user-fullname">ФИО</label>
                                <input id="new-user-fullname" type="text" @bind="formFullName" @bind:event="oninput"
                                       class="fieldInput" autocomplete="off" maxlength="256" />
                            </div>
                            <div class="field">
                                <label for="new-user-position">Должность</label>
                                <input id="new-user-position" type="text" @bind="formPosition" @bind:event="oninput"
                                       class="fieldInput" autocomplete="organization-title" maxlength="256"
                                       placeholder="Например: инженер по нормированию" />
                            </div>
                            @if (!isEdit)
                            {
                                <div class="field">
                                    <label for="new-user-password">Пароль *</label>
                                    <input id="new-user-password" type="password" @bind="formPassword" @bind:event="oninput"
                                           class="fieldInput" autocomplete="new-password" autocapitalize="none"
                                           spellcheck="false" maxlength="128"
                                           placeholder="Введите пароль нового пользователя" />
                                </div>
                            }
                            <div class="field">
                                <label for="new-user-role">Роль *</label>
                                <select id="new-user-role" @bind="formRole" class="field-select">
                                    @foreach (var role in creatableRoles)
                                    {
                                        <option value="@role">@GetRoleDisplayName(role)</option>
                                    }
                                </select>
                            </div>
                            @if (formRole != nameof(UserRole.SystemAdmin))
                            {
                                <div class="field">
                                    <label for="new-user-branch">Филиал *</label>
                                    <SearchablePopoverSelect TItem="Branch"
                                                              Items="_availableBranches"
                                                              Selected="_selectedBranch"
                                                              DisplayTextSelector="b => b.Name"
                                                              SearchPredicate="(b, text) => b.Name.Contains(text, StringComparison.OrdinalIgnoreCase)"
                                                              Placeholder="Выберите филиал"
                                                              EmptyText="Филиалы не найдены"
                                                              AllowQuickCreate="canQuickCreateBranch"
                                                              QuickCreateLabel="Добавить филиал"
                                                              OnSelected="OnBranchSelectedAsync"
                                                              @ref="_branchSelect">
                                        <ItemTemplate Context="branch">
                                            @branch.Name
                                        </ItemTemplate>
                                        <QuickCreateModalTemplate>
                                            <BranchQuickCreateModal OnCreated="OnBranchCreatedAsync"
                                                                    OnCancelled="CloseBranchQuickCreate" />
                                        </QuickCreateModalTemplate>
                                    </SearchablePopoverSelect>
                                </div>
                            }
                        </div>
                    </form>

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="loginError" style="margin-top:12px">@formError</div>
                    }
                </div>
                <div class="modalFooter">
                    <button class="btn" @onclick="CloseUserModal">Отмена</button>
                    <button class="btn primary" @onclick="SaveUser">Сохранить</button>
                </div>
            </div>
        </div>
    }

    @if (showPermissionsModal)
    {
        <div class="modalOverlay permissionsOverlay" @onclick="ClosePermissionsModal" @onkeydown="OnPermissionsKeyDown">
            <section class="modal permissionsModal"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="permissionsTitle"
                     @onclick:stopPropagation="true">
                <header class="modalHeader permissionsHeader">
                    <h3 id="permissionsTitle">Индивидуальные полномочия — @permissionsUserName</h3>
                    <button type="button"
                            class="modalCloseButton"
                            @onclick="ClosePermissionsModal"
                            aria-label="Закрыть окно «Индивидуальные полномочия»"
                            title="Закрыть">
                        <span aria-hidden="true">×</span>
                    </button>
                </header>
                <div class="modalBody permissionsBody">
                    @if (permissionsLoading)
                    {
                        <div class="permissionsState loading-state">Загрузка полномочий...</div>
                    }
                    else if (effectivePermissions == null)
                    {
                        <div class="permissionsState">
                            <div style="text-align:center">
                                <div class="loginError" style="display:inline-block">
                                    Не удалось загрузить полномочия.
                                    @if (!string.IsNullOrEmpty(permissionsError))
                                    {
                                        <div style="margin-top:4px">@permissionsError</div>
                                    }
                                </div>
                                <div style="margin-top:12px">
                                    <button class="btn primary" @onclick="() => OpenPermissionsById(permissionsUserId)">Повторить</button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(permissionsError))
                        {
                            <div class="loginError" style="margin-bottom:12px">@permissionsError</div>
                        }

                        @if (effectivePermissions.BaseRole == "SystemAdmin")
                        {
                            <div class="note" style="margin-bottom:12px">
                                Системный администратор всегда имеет полный доступ. Индивидуальные полномочия недоступны.
                            </div>
                        }

                        <div class="permissionsToolbar">
                            <div class="field">
                                <label>Поиск полномочия</label>
                                <input type="text" @bind="permSearch" class="fieldInput"
                                       placeholder="Название, описание или код..." />
                            </div>
                            <div class="field">
                                <label>Модуль</label>
                                <select @bind="permModuleFilter" class="field-select">
                                    <option value="">Все модули</option>
                                    @foreach (var m in allModules)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Статус</label>
                                <select @bind="permStatusFilter" class="field-select">
                                    <option value="">Все</option>
                                    <option value="effective">Разрешено</option>
                                    <option value="denied">Запрещено</option>
                                    <option value="override">С индивидуальным решением</option>
                                </select>
                            </div>
                        </div>

                        <div class="permCounters">
                            <span>Всего: <strong>@effectivePermissions.Permissions.Count</strong></span>
                            <span>Разрешено: <strong>@effectivePermissions.Permissions.Count(p => p.IsEffective)</strong></span>
                            <span>Запрещено: <strong>@effectivePermissions.Permissions.Count(p => !p.IsEffective)</strong></span>
                            <span>С индивидуальным решением: <strong>@effectivePermissions.Permissions.Count(p => p.OverrideIsGranted != null)</strong></span>
                        </div>

                        <div class="permissionsTableWrap" tabindex="0" aria-label="Таблица полномочий пользователя">
                            <table class="permissionsTable">
                                <thead>
                                    <tr>
                                        <th>Модуль</th>
                                        <th>Полномочие</th>
                                        <th>По роли</th>
                                        <th>Индивидуальное решение</th>
                                        <th>Итоговый доступ</th>
                                        @if (effectivePermissions.BaseRole != "SystemAdmin")
                                        {
                                            <th>Действия</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var perm in filteredPermissions)
                                    {
                                        <tr>
                                            <td><span class="tag">@perm.Module</span></td>
                                            <td class="permissionCell">
                                                <div class="permissionName">@perm.Name</div>
                                                <div class="permissionDescription">@perm.Description</div>
                                                <code class="permissionCode">Код системы: @perm.Code</code>
                                            </td>
                                            <td>
                                                @if (perm.GrantedByRole)
                                                {
                                                    <span class="permissionStatus permissionStatus--granted">✓ Разрешено</span>
                                                }
                                                else
                                                {
                                                    <span class="permissionStatus permissionStatus--denied">× Не предоставлено</span>
                                                }
                                            </td>
                                            <td>
                                                @if (perm.OverrideIsGranted == true)
                                                {
                                                    <span class="permissionStatus permissionStatus--granted">✓ Разрешено индивидуально</span>
                                                    @if (perm.GrantedByRole)
                                                    {
                                                        <div class="permSecondaryHint">Дополнительное разрешение не изменяет текущий доступ</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(perm.OverrideReason))
                                                    {
                                                        <div class="permReason">@perm.OverrideReason</div>
                                                    }
                                                }
                                                else if (perm.OverrideIsGranted == false)
                                                {
                                                    <span class="permissionStatus permissionStatus--warning">! Запрещено индивидуально</span>
                                                    @if (!string.IsNullOrEmpty(perm.OverrideReason))
                                                    {
                                                        <div class="permReason">@perm.OverrideReason</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="permissionStatus permissionStatus--neutral">— Не задано</span>
                                                }
                                            </td>
                                            <td>
                                                @if (perm.IsEffective)
                                                {
                                                    <span class="permissionStatus permissionStatus--granted">✓ Доступ разрешён</span>
                                                }
                                                else
                                                {
                                                    <span class="permissionStatus permissionStatus--denied">× Доступ запрещён</span>
                                                }
                                            </td>
                                            @if (effectivePermissions.BaseRole != "SystemAdmin")
                                            {
                                                <td>
                                                    @if (perm.RowSaving)
                                                    {
                                                        <span class="permissionStatus permissionStatus--neutral">Сохранение...</span>
                                                    }
                                                    else if (perm.OverrideIsGranted == null)
                                                    {
                                                        <div class="permActions">
                                                            <button class="linkBtn" @onclick="() => GrantPerm(perm)">Разрешить дополнительно</button>
                                                            <button class="linkBtn permActionDeny" @onclick="() => DenyPerm(perm)">Запретить</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="linkBtn" @onclick="() => RevokePerm(perm)">Отменить индивидуальное решение</button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
    }

    @if (showGrantDenyModal)
    {
        <div class="modalOverlay" @onclick="() => showGrantDenyModal = false">
            <div class="modal" @onclick:stopPropagation="true" style="max-width:400px">
                <div class="modalHeader">
                    <h3>@(grantDenyAction == "grant" ? "Разрешить дополнительно" : "Запретить")</h3>
                    <button class="linkBtn" @onclick="() => showGrantDenyModal = false"
                            aria-label="Закрыть">✕</button>
                </div>
                <div class="modalBody">
                    @if (grantDenyTarget != null)
                    {
                        <div style="margin-bottom:12px">
                            <div style="font-weight:700;font-size:14px">@grantDenyTarget.Name</div>
                            <div style="font-size:12px;color:var(--text2)">@grantDenyTarget.Module</div>
                            <div style="font-size:11px;color:var(--text3);margin-top:4px">@grantDenyTarget.Description</div>
                            <code style="display:inline-block;margin-top:7px;padding:2px 6px;border:1px solid var(--line);border-radius:5px;color:var(--muted);background:var(--panel2);font-family:var(--mono);font-size:11px">Код системы: @grantDenyTarget.Code</code>
                        </div>
                        @if (grantDenyAction == "deny" && grantDenyTarget.GrantedByRole)
                        {
                            <div class="note" style="margin-bottom:12px;color:var(--warn)">
                                Внимание: право разрешено базовой ролью. Запрет отнимет доступ.
                            </div>
                        }
                        <div class="field">
                            <label>Причина *</label>
                            <textarea @bind="grantDenyReason" rows="3" class="fieldInput"
                                      placeholder="Укажите причину (до 500 символов)..." maxlength="500"></textarea>
                        </div>
                        @if (grantDenyError != null)
                        {
                            <div class="loginError">@grantDenyError</div>
                        }
                    }
                </div>
                <div class="modalFooter">
                    <button class="btn" @onclick="() => showGrantDenyModal = false">Отмена</button>
                    <button class="btn primary" @onclick="SaveGrantDeny" disabled="@grantDenySaving">
                        @(grantDenySaving ? "Сохранение..." : (grantDenyAction == "grant" ? "Разрешить" : "Запретить"))
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<UserListItem> users = new();
    private List<string> allModules = new();
    private bool loading = true;
    private string statusFilter = "";
    private bool canQuickCreateBranch = false;
    private List<Branch> _availableBranches = new();
    private SearchablePopoverSelect<Branch>? _branchSelect;

    private Branch? _selectedBranch => _availableBranches.FirstOrDefault(b => b.Id == SelectedBranchId);

    private static readonly string[] creatableRoles = new[]
    {
        nameof(UserRole.Guest),
        nameof(UserRole.Operator),
        nameof(UserRole.NormAdmin),
        nameof(UserRole.HeadOfDepartment),
        nameof(UserRole.SystemAdmin)
    };

    private bool showUserModal = false;
    private bool isEdit = false;
    private string formError = "";
    private string editingUserId = "";
    private string formUsername = "";
    private string formFullName = "";
    private string formPosition = "";
    private string formPassword = "";
    private string formRole = nameof(UserRole.Guest);
    private string formBranchId = "";

    private Guid? SelectedBranchId
    {
        get => Guid.TryParse(formBranchId, out var parsed) ? parsed : null;
        set => formBranchId = value?.ToString() ?? "";
    }

    private bool showPermissionsModal = false;
    private bool permissionsLoading = false;
    private string permissionsUserId = "";
    private string permissionsUserName = "";
    private UserEffectivePermissionsDto? effectivePermissions;
    private string? permissionsError;
    private string permSearch = "";
    private string permModuleFilter = "";
    private string permStatusFilter = "";

    private bool showGrantDenyModal = false;
    private string grantDenyAction = "grant";
    private UserEffectivePermissionDto? grantDenyTarget;
    private string grantDenyReason = "";
    private string? grantDenyError;
    private bool grantDenySaving = false;

    IEnumerable<UserEffectivePermissionDto> filteredPermissions =>
        effectivePermissions?.Permissions.Where(p =>
            (string.IsNullOrEmpty(permSearch) ||
             p.Name.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
             p.Code.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
             p.Description.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
             p.Module.Contains(permSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(permModuleFilter) || p.Module == permModuleFilter) &&
            (string.IsNullOrEmpty(permStatusFilter) ||
             (permStatusFilter == "effective" && p.IsEffective) ||
             (permStatusFilter == "denied" && !p.IsEffective) ||
             (permStatusFilter == "override" && p.OverrideIsGranted != null))
        ) ?? Enumerable.Empty<UserEffectivePermissionDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadBranchesAsync();
        allModules = PermissionCatalog.GetAllModules().ToList();
        var authState = await AuthState.GetAuthenticationStateAsync();
        canQuickCreateBranch = authState.User.IsInRole(nameof(UserRole.SystemAdmin));
    }

    private async Task LoadBranchesAsync()
    {
        try
        {
            _availableBranches = (await EquipService.GetBranchesAsync())
                .OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            _availableBranches = new List<Branch>();
        }
    }

    private Task OnBranchSelectedAsync(Branch branch)
    {
        formBranchId = branch.Id.ToString();
        return Task.CompletedTask;
    }

    private async Task OnBranchCreatedAsync(Branch branch)
    {
        await LoadBranchesAsync();
        if (_branchSelect != null)
            await _branchSelect.NotifyQuickCreatedAsync(branch);
        else
            formBranchId = branch.Id.ToString();
    }

    private void CloseBranchQuickCreate() => _branchSelect?.CloseQuickCreate();

    async Task LoadUsers()
    {
        loading = true;
        users = await UserMgmt.GetUsersAsync(statusFilter: statusFilter);
        loading = false;
        StateHasChanged();
    }

    string GetRoleDisplayName(string role) => role switch
    {
        nameof(UserRole.SystemAdmin) => "Системный администратор",
        nameof(UserRole.NormAdmin) => "Нормировщик",
        nameof(UserRole.Operator) => "Оператор",
        nameof(UserRole.HeadOfDepartment) => "Начальник отдела",
        nameof(UserRole.Guest) => "Гость",
        _ => role
    };

    void OpenCreate()
    {
        isEdit = false;
        editingUserId = "";
        formUsername = "";
        formFullName = "";
        formPosition = "";
        formPassword = "";
        formRole = nameof(UserRole.Guest);
        formBranchId = "";
        formError = "";
        showUserModal = true;
    }

    void OpenEdit(UserListItem user)
    {
        isEdit = true;
        editingUserId = user.Id;
        formUsername = user.UserName;
        formFullName = user.FullName;
        formPosition = user.Position;
        formPassword = "";
        formRole = user.RoleName;
        formBranchId = user.BranchId?.ToString() ?? "";
        formError = "";
        showUserModal = true;
    }

    void CloseUserModal()
    {
        showUserModal = false;
        formError = "";
        formPassword = "";
    }

    async Task SaveUser()
    {
        formError = "";

        if (isEdit)
        {
            var (success, error) = await UserMgmt.UpdateUserAsync(editingUserId, formFullName, formPosition, formRole);
            if (!success) { formError = error ?? ""; return; }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(formUsername)) { formError = "Логин обязателен"; return; }
            if (string.IsNullOrWhiteSpace(formPassword)) { formError = "Пароль обязателен"; return; }
            if (string.IsNullOrWhiteSpace(formRole)) { formError = "Роль обязательна"; return; }

            Guid? branchId = null;
            if (formRole != nameof(UserRole.SystemAdmin))
            {
                if (string.IsNullOrEmpty(formBranchId) || !Guid.TryParse(formBranchId, out var parsed))
                {
                    formError = "Филиал обязателен для выбранной роли";
                    return;
                }
                branchId = parsed;
            }

            var (success, error) = await UserMgmt.CreateUserAsync(formUsername, formPassword, formFullName, formPosition, formRole, branchId);
            if (!success) { formError = error ?? ""; return; }
            formPassword = "";
        }

        showUserModal = false;
        await LoadUsers();
    }

    async Task ToggleBlock(UserListItem user)
    {
        var (success, error) = await UserMgmt.ToggleBlockAsync(user.Id);
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task DeleteUser(UserListItem user)
    {
        formError = "";
        var (success, error) = await UserMgmt.DeleteUserAsync(user.Id, "Удалено из интерфейса");
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task RestoreUser(UserListItem user)
    {
        formError = "";
        var (success, error) = await UserMgmt.RestoreUserAsync(user.Id, user.RoleName, user.BranchId);
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task OpenPermissions(UserListItem user)
    {
        await OpenPermissionsById(user.Id);
        permissionsUserName = $"{user.FullName} ({user.UserName})";
    }

    async Task OpenPermissionsById(string userId)
    {
        permissionsUserId = userId;
        permissionsLoading = true;
        permissionsError = null;
        showPermissionsModal = true;
        permSearch = "";
        permModuleFilter = "";
        permStatusFilter = "";
        effectivePermissions = null;
        StateHasChanged();

        effectivePermissions = await UserMgmt.GetEffectivePermissionsAsync(userId);
        permissionsLoading = false;
        StateHasChanged();
    }

    void ClosePermissionsModal()
    {
        showPermissionsModal = false;
        permissionsError = null;
        effectivePermissions = null;
        permissionsUserId = "";
        permissionsUserName = "";
        permSearch = "";
        permModuleFilter = "";
        permStatusFilter = "";
    }

    void OnPermissionsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !showGrantDenyModal && !grantDenySaving)
            ClosePermissionsModal();
    }

    void GrantPerm(UserEffectivePermissionDto perm)
    {
        grantDenyAction = "grant";
        grantDenyTarget = perm;
        grantDenyReason = "";
        grantDenyError = null;
        grantDenySaving = false;
        showGrantDenyModal = true;
    }

    void DenyPerm(UserEffectivePermissionDto perm)
    {
        grantDenyAction = "deny";
        grantDenyTarget = perm;
        grantDenyReason = "";
        grantDenyError = null;
        grantDenySaving = false;
        showGrantDenyModal = true;
    }

    async Task SaveGrantDeny()
    {
        if (grantDenyTarget == null) return;
        grantDenySaving = true;
        grantDenyError = null;

        UserEffectivePermissionsDto? result;
        string? error;

        if (grantDenyAction == "grant")
            (result, error) = await UserMgmt.GrantPermissionAsync(permissionsUserId, grantDenyTarget.Code, grantDenyReason);
        else
            (result, error) = await UserMgmt.DenyPermissionAsync(permissionsUserId, grantDenyTarget.Code, grantDenyReason);

        if (error != null)
        {
            grantDenyError = error;
            grantDenySaving = false;
            StateHasChanged();
            return;
        }

        effectivePermissions = result;
        showGrantDenyModal = false;
        grantDenySaving = false;
        StateHasChanged();
    }

    async Task RevokePerm(UserEffectivePermissionDto perm)
    {
        perm.RowSaving = true;
        StateHasChanged();

        var (result, error) = await UserMgmt.RevokePermissionAsync(permissionsUserId, perm.Code);
        perm.RowSaving = false;

        if (error != null)
        {
            permissionsError = error;
            StateHasChanged();
            return;
        }
        effectivePermissions = result;
        permissionsError = null;
        StateHasChanged();
    }

    public void Dispose() { }
}
