@page "/пользователи"
@attribute [Authorize(Policy = "ManageUsers")]
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@inject UserManagementService UserMgmt
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<Microsoft.AspNetCore.Identity.IdentityRole> RoleManager
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Управление пользователями</h2>
            <div class="hint">@users.Count зарегистрировано</div>
        </div>
        <div class="panelBody">
            <div class="btnRow" style="margin-bottom:16px">
                <button class="btn primary" @onclick="OpenCreate">+ Новый пользователь</button>
                <select class="fieldInput" style="max-width:200px" @bind="statusFilter" @bind:after="LoadUsers">
                    <option value="">Все (кроме удалённых)</option>
                    <option value="active">Активные</option>
                    <option value="blocked">Заблокированные</option>
                    <option value="deleted">Удалённые</option>
                    <option value="all">Все (включая удалённых)</option>
                </select>
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!users.Any())
            {
                <div class="empty-state">Нет пользователей</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Логин</th>
                            <th>ФИО</th>
                            <th>Должность</th>
                            <th>Роль</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="mono">@user.UserName</td>
                                <td>@user.FullName</td>
                                <td>@user.Position</td>
                                <td><span class="badge">@GetRoleDisplayName(user.RoleName)</span></td>
                                <td>
                                    @if (user.IsDeleted)
                                    {
                                        <span class="badge" style="background:var(--text3)">Удалён</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="badge" style="background:var(--ok)">Активен</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:var(--warn)">Заблокирован</span>
                                    }
                                </td>
                                <td>
                                    <button class="linkBtn" @onclick="() => OpenEdit(user)">Изменить</button>
                                    <button class="linkBtn" @onclick="() => OpenPermissions(user)">Полномочия</button>
                                    @if (user.IsDeleted)
                                    {
                                        <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreUser(user)">Восстановить</button>
                                    }
                                    else
                                    {
                                        <button class="linkBtn" style="color:var(--warn)" @onclick="() => ToggleBlock(user)">
                                            @(user.IsActive ? "Заблокировать" : "Разблокировать")
                                        </button>
                                        <button class="linkBtn" style="color:var(--error)" @onclick="() => DeleteUser(user)">Удалить</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    @if (showUserModal)
    {
        <div class="modalOverlay" @onclick="CloseUserModal">
            <div class="modal" @onclick:stopPropagation="true">
                <div class="modalHeader">
                    <h3>@(isEdit ? "Редактирование" : "Новый пользователь")</h3>
                    <button class="linkBtn" @onclick="CloseUserModal">✕</button>
                </div>
                <div class="modalBody">
                    <div class="form">
                        <div class="field"><label>Логин *</label>
                            <input type="text" @bind="formUsername" class="fieldInput" disabled="@isEdit" />
                        </div>
                        <div class="field"><label>ФИО</label>
                            <input type="text" @bind="formFullName" class="fieldInput" />
                        </div>
                        <div class="field"><label>Должность</label>
                            <input type="text" @bind="formPosition" class="fieldInput" />
                        </div>
                        @if (!isEdit)
                        {
                            <div class="field"><label>Пароль *</label>
                                <input type="password" @bind="formPassword" class="fieldInput" />
                            </div>
                        }
                        <div class="field"><label>Роль</label>
                            <select @bind="formRole" class="field-select">
                                @foreach (var role in allRoles)
                                {
                                    <option value="@role">@GetRoleDisplayName(role)</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="loginError" style="margin-top:12px">@formError</div>
                    }
                </div>
                <div class="modalFooter">
                    <button class="btn" @onclick="CloseUserModal">Отмена</button>
                    <button class="btn primary" @onclick="SaveUser">Сохранить</button>
                </div>
            </div>
        </div>
    }

    @if (showPermissionsModal)
    {
        <div class="modalOverlay" @onclick="ClosePermissionsModal">
            <div class="modal wide" @onclick:stopPropagation="true">
                <div class="modalHeader">
                    <h3>Индивидуальные полномочия — @permissionsUserName</h3>
                    <button class="linkBtn" @onclick="ClosePermissionsModal">✕</button>
                </div>
                <div class="modalBody">
                    @if (permissionsLoading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (effectivePermissions != null)
                    {
                        @if (permissionsError != null)
                        {
                            <div class="loginError" style="margin-bottom:12px">@permissionsError</div>
                        }

                        @if (effectivePermissions.BaseRole == "SystemAdmin")
                        {
                            <div style="padding:12px;background:var(--panel2);border-radius:8px;margin-bottom:12px;font-size:13px;color:var(--text2)">
                                Системный администратор всегда имеет полный доступ. Индивидуальные полномочия недоступны.
                            </div>
                        }

                        <div class="form" style="grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px">
                            <div class="field"><label>Поиск полномочия</label>
                                <input type="text" @bind="permSearch" class="fieldInput" placeholder="Название или код..." />
                            </div>
                            <div class="field"><label>Модуль</label>
                                <select @bind="permModuleFilter" class="field-select">
                                    <option value="">Все модули</option>
                                    @foreach (var m in allModules)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Статус</label>
                                <select @bind="permStatusFilter" class="field-select">
                                    <option value="">Все</option>
                                    <option value="effective">Разрешено</option>
                                    <option value="denied">Запрещено</option>
                                    <option value="override">С индивидуальным решением</option>
                                </select>
                            </div>
                        </div>

                        <div style="max-height:500px;overflow-y:auto">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Модуль</th>
                                        <th>Полномочие</th>
                                        <th>По роли</th>
                                        <th>Индивидуальное решение</th>
                                        <th>Итог</th>
                                        @if (effectivePermissions.BaseRole != "SystemAdmin")
                                        {
                                            <th>Действия</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var perm in filteredPermissions)
                                    {
                                        <tr>
                                            <td style="font-size:12px;color:var(--text2)">@perm.Module</td>
                                            <td>
                                                <div>@perm.Name</div>
                                                <div style="font-size:11px;color:var(--text3)">@perm.Description</div>
                                                <div style="font-size:10px;color:var(--text3)">Код системы: @perm.Code</div>
                                            </td>
                                            <td>
                                                @if (perm.GrantedByRole)
                                                {
                                                    <span class="badge" style="background:var(--ok)">Да</span>
                                                }
                                                else
                                                {
                                                    <span style="color:var(--text3)">Нет</span>
                                                }
                                            </td>
                                            <td>
                                                @if (perm.OverrideIsGranted == true)
                                                {
                                                    <span class="badge" style="background:var(--ok)">Индивидуально разрешено</span>
                                                }
                                                else if (perm.OverrideIsGranted == false)
                                                {
                                                    <span class="badge" style="background:var(--bad)">Индивидуально запрещено</span>
                                                }
                                                else
                                                {
                                                    <span style="color:var(--text3)">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (perm.IsEffective)
                                                {
                                                    <span class="badge" style="background:var(--ok)">Доступно</span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background:var(--bad)">Нет доступа</span>
                                                }
                                            </td>
                                            @if (effectivePermissions.BaseRole != "SystemAdmin")
                                            {
                                                <td>
                                                    @if (perm.OverrideIsGranted == null)
                                                    {
                                                        <button class="linkBtn" style="font-size:12px" @onclick="() => GrantPerm(perm)">Разрешить дополнительно</button>
                                                        <button class="linkBtn" style="font-size:12px;color:var(--warn)" @onclick="() => DenyPerm(perm)">Запретить</button>
                                                    }
                                                    else
                                                    {
                                                        <button class="linkBtn" style="font-size:12px;color:var(--warn)" @onclick="() => RevokePerm(perm)">Отменить индивидуальное решение</button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modalFooter">
                    <button class="btn" @onclick="ClosePermissionsModal">Закрыть</button>
                </div>
            </div>
        </div>
    }

    @if (showGrantDenyModal)
    {
        <div class="modalOverlay" @onclick="() => showGrantDenyModal = false">
            <div class="modal" @onclick:stopPropagation="true" style="max-width:400px">
                <div class="modalHeader">
                    <h3>@(grantDenyAction == "grant" ? "Разрешить дополнительно" : "Запретить")</h3>
                    <button class="linkBtn" @onclick="() => showGrantDenyModal = false">✕</button>
                </div>
                <div class="modalBody">
                    @if (grantDenyTarget != null)
                    {
                        <div style="margin-bottom:12px">
                            <div style="font-weight:700;font-size:14px">@grantDenyTarget.Name</div>
                            <div style="font-size:12px;color:var(--text2)">@grantDenyTarget.Module</div>
                            <div style="font-size:11px;color:var(--text3);margin-top:4px">@grantDenyTarget.Description</div>
                            <div style="font-size:10px;color:var(--text3)">Код системы: @grantDenyTarget.Code</div>
                        </div>
                        <div style="font-size:13px;color:var(--text2);margin-bottom:8px">
                            @if (grantDenyAction == "deny" && grantDenyTarget.GrantedByRole)
                            {
                                <span style="color:var(--warn)">Внимание: право разрешено базовой ролью. Запрет отнимет доступ.</span>
                            }
                        </div>
                        <div class="field">
                            <label>Причина *</label>
                            <textarea @bind="grantDenyReason" rows="3" class="fieldInput" placeholder="Укажите причину (до 500 символов)..." maxlength="500"></textarea>
                        </div>
                        @if (grantDenyError != null)
                        {
                            <div class="loginError">@grantDenyError</div>
                        }
                    }
                </div>
                <div class="modalFooter">
                    <button class="btn" @onclick="() => showGrantDenyModal = false">Отмена</button>
                    <button class="btn primary" @onclick="SaveGrantDeny" disabled="@grantDenySaving">
                        @(grantDenySaving ? "Сохранение..." : (grantDenyAction == "grant" ? "Разрешить" : "Запретить"))
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<UserListItem> users = new();
    private List<string> allRoles = new();
    private List<string> allModules = new();
    private bool loading = true;
    private string statusFilter = "";

    private bool showUserModal = false;
    private bool isEdit = false;
    private string formError = "";
    private string editingUserId = "";
    private string formUsername = "";
    private string formFullName = "";
    private string formPosition = "";
    private string formPassword = "";
    private string formRole = "";

    private bool showPermissionsModal = false;
    private bool permissionsLoading = false;
    private string permissionsUserId = "";
    private string permissionsUserName = "";
    private UserEffectivePermissionsDto? effectivePermissions;
    private string? permissionsError;
    private string permSearch = "";
    private string permModuleFilter = "";
    private string permStatusFilter = "";

    private bool showGrantDenyModal = false;
    private string grantDenyAction = "grant";
    private UserEffectivePermissionDto? grantDenyTarget;
    private string grantDenyReason = "";
    private string? grantDenyError;
    private bool grantDenySaving = false;

    IEnumerable<UserEffectivePermissionDto> filteredPermissions =>
        effectivePermissions?.Permissions.Where(p =>
            (string.IsNullOrEmpty(permSearch) ||
             p.Name.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
             p.Code.Contains(permSearch, StringComparison.OrdinalIgnoreCase) ||
             p.Description.Contains(permSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(permModuleFilter) || p.Module == permModuleFilter) &&
            (string.IsNullOrEmpty(permStatusFilter) ||
             (permStatusFilter == "effective" && p.IsEffective) ||
             (permStatusFilter == "denied" && !p.IsEffective) ||
             (permStatusFilter == "override" && p.OverrideIsGranted != null))
        ) ?? Enumerable.Empty<UserEffectivePermissionDto>();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        allRoles = (await RoleManager.Roles.ToListAsync()).Select(r => r.Name ?? "").Where(n => !string.IsNullOrEmpty(n)).ToList();
        allModules = PermissionCatalog.GetAllModules().ToList();
    }

    async Task LoadUsers()
    {
        loading = true;
        users = await UserMgmt.GetUsersAsync(statusFilter: statusFilter);
        loading = false;
        StateHasChanged();
    }

    string GetRoleDisplayName(string role) => role switch
    {
        "SystemAdmin" => "Системный администратор",
        "NormAdmin" => "Нормировщик",
        "Operator" => "Оператор",
        "HeadOfDepartment" => "Начальник отдела",
        "Guest" => "Гость",
        _ => role
    };

    void OpenCreate()
    {
        isEdit = false;
        editingUserId = "";
        formUsername = "";
        formFullName = "";
        formPosition = "";
        formPassword = "";
        formRole = allRoles.FirstOrDefault() ?? "";
        formError = "";
        showUserModal = true;
    }

    void OpenEdit(UserListItem user)
    {
        isEdit = true;
        editingUserId = user.Id;
        formUsername = user.UserName;
        formFullName = user.FullName;
        formPosition = user.Position;
        formPassword = "";
        formRole = user.RoleName;
        formError = "";
        showUserModal = true;
    }

    void CloseUserModal()
    {
        showUserModal = false;
        formError = "";
    }

    async Task SaveUser()
    {
        formError = "";

        if (isEdit)
        {
            var (success, error) = await UserMgmt.UpdateUserAsync(editingUserId, formFullName, formPosition, formRole);
            if (!success) { formError = error ?? ""; return; }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(formUsername)) { formError = "Логин обязателен"; return; }
            if (string.IsNullOrWhiteSpace(formPassword)) { formError = "Пароль обязателен"; return; }
            var (success, error) = await UserMgmt.CreateUserAsync(formUsername, formPassword, formFullName, formPosition, formRole);
            if (!success) { formError = error ?? ""; return; }
        }

        showUserModal = false;
        await LoadUsers();
    }

    async Task ToggleBlock(UserListItem user)
    {
        var (success, error) = await UserMgmt.ToggleBlockAsync(user.Id);
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task DeleteUser(UserListItem user)
    {
        formError = "";
        var (success, error) = await UserMgmt.DeleteUserAsync(user.Id, "Удалено из интерфейса");
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task RestoreUser(UserListItem user)
    {
        formError = "";
        var (success, error) = await UserMgmt.RestoreUserAsync(user.Id, user.RoleName, user.BranchId);
        if (!success)
        {
            formError = error ?? "";
            StateHasChanged();
            return;
        }
        await LoadUsers();
    }

    async Task OpenPermissions(UserListItem user)
    {
        permissionsUserId = user.Id;
        permissionsUserName = $"{user.FullName} ({user.UserName})";
        permissionsLoading = true;
        permissionsError = null;
        showPermissionsModal = true;
        permSearch = "";
        permModuleFilter = "";
        permStatusFilter = "";
        effectivePermissions = await UserMgmt.GetEffectivePermissionsAsync(user.Id);
        permissionsLoading = false;
        StateHasChanged();
    }

    void ClosePermissionsModal()
    {
        showPermissionsModal = false;
        permissionsError = null;
        effectivePermissions = null;
    }

    void GrantPerm(UserEffectivePermissionDto perm)
    {
        grantDenyAction = "grant";
        grantDenyTarget = perm;
        grantDenyReason = "";
        grantDenyError = null;
        grantDenySaving = false;
        showGrantDenyModal = true;
    }

    void DenyPerm(UserEffectivePermissionDto perm)
    {
        grantDenyAction = "deny";
        grantDenyTarget = perm;
        grantDenyReason = "";
        grantDenyError = null;
        grantDenySaving = false;
        showGrantDenyModal = true;
    }

    async Task SaveGrantDeny()
    {
        if (grantDenyTarget == null) return;
        grantDenySaving = true;
        grantDenyError = null;

        UserEffectivePermissionsDto? result;
        string? error;

        if (grantDenyAction == "grant")
            (result, error) = await UserMgmt.GrantPermissionAsync(permissionsUserId, grantDenyTarget.Code, grantDenyReason);
        else
            (result, error) = await UserMgmt.DenyPermissionAsync(permissionsUserId, grantDenyTarget.Code, grantDenyReason);

        if (error != null)
        {
            grantDenyError = error;
            grantDenySaving = false;
            StateHasChanged();
            return;
        }

        effectivePermissions = result;
        showGrantDenyModal = false;
        grantDenySaving = false;
        StateHasChanged();
    }

    async Task RevokePerm(UserEffectivePermissionDto perm)
    {
        var (result, error) = await UserMgmt.RevokePermissionAsync(permissionsUserId, perm.Code);
        if (error != null)
        {
            permissionsError = error;
            StateHasChanged();
            return;
        }
        effectivePermissions = result;
        permissionsError = null;
        StateHasChanged();
    }

    public void Dispose() { }
}
