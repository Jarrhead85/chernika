@page "/составы/комплексы/{complexId:guid}/версии/{compositionId:guid}"
@page "/составы/изделия/{equipmentModelId:guid}/версии/{compositionId:guid}"
@page "/составы/агрегаты/{aggregateId:guid}/версии/{compositionId:guid}"
@attribute [Authorize(Policy = "ViewComposition")]
@using Chernika.Domain
@using Chernika.Domain.Entities
@using AuditLogEntity = Chernika.Domain.Entities.AuditLog
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Web.Components
@using Chernika.Web.Services
@using Microsoft.AspNetCore.Identity
@inject EquipmentService EquipService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@inject UserManager<ApplicationUser> UserManager
@implements IDisposable

<div class="stack compositionPage">
    @if (selected != null)
    {
        <nav class="compositionBreadcrumbs" aria-label="Навигация">
            <a href="/составы">Составы</a>
            <span>/</span>
            <a href="@ListEditorUrl">@LevelPlural</a>
            <span>/</span>
            <a href="@ListEditorUrl">@objectCode</a>
            <span>/</span>
            <span>@selected.Version</span>
        </nav>

        <section class="panel compositionHeaderPanel">
            <div class="panelHeader compositionHeader">
                <div>
                    <div class="compositionType">Состав @LevelTitle.ToLower()</div>
                    <h2>@objectCode · @objectName</h2>
                    <div class="compositionVersionLine">
                        <span class="mono">Версия @selected.Version</span>
                        <CompositionStatusBadge Status="@selected.Status" />
                    </div>
                </div>
                <div class="compositionHeaderActions">
                    @if (selected.Status == ProductCompositionStatus.Draft)
                    {
                        @if (canEditDraft)
                        {
                            <a class="btn" href="@EditorUrl">Редактировать</a>
                        }
                        @if (canSubmit)
                        {
                            <button class="btn primary" @onclick="SubmitForReview">Отправить на согласование</button>
                        }
                    }
                    else if (selected.Status == ProductCompositionStatus.OnReview)
                    {
                        @if (canApprove)
                        {
                            <button class="btn primary" @onclick="Approve">Утвердить</button>
                        }
                        @if (canReturn)
                        {
                            <button class="btn" @onclick="ReturnToDraft">Вернуть на доработку</button>
                        }
                    }
                    else if (selected.Status == ProductCompositionStatus.Approved)
                    {
                        @if (canApprove)
                        {
                            <button class="btn" @onclick="Archive">Архивировать</button>
                        }
                        @if (canCreateVersion)
                        {
                            <button class="btn primary" @onclick="CreateVersion">Создать новую версию</button>
                        }
                    }
                    else if (selected.Status == ProductCompositionStatus.Archived && canCreateVersion)
                    {
                        <button class="btn primary" @onclick="CreateVersion">Создать новую версию</button>
                    }
                    <a class="btn ghost" href="/составы">← К реестру</a>
                </div>
            </div>
            <div class="panelBody">
                @if (selected.Status != ProductCompositionStatus.Draft)
                {
                    <div class="compositionReadOnlyBanner @ReadOnlyBannerClass">
                        @ReadOnlyBannerText
                    </div>
                }
                @if (selected.Status == ProductCompositionStatus.OnReview)
                {
                    <div class="field" style="margin-top:10px;max-width:400px">
                        <label>Комментарий к решению</label>
                        <input @bind="actionComment" class="field-input" placeholder="Необязательно" />
                    </div>
                }
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="note warn" style="margin-top:10px">@error</div>
                }
            </div>
        </section>
    }

    <div class="grid">
        <div class="stack compositionMain">
            <section class="panel">
                <div class="panelHeader">
                    <h2>@CompositionTableTitle</h2>
                    <div class="hint">@CompositionSummary</div>
                </div>
                <div class="panelBody">
                    @if (loading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (selected == null)
                    {
                        <div class="compositionEmpty">Версия не найдена.</div>
                    }
                    else if (Level == 1)
                    {
                        @if (!selectedProductComposition!.Parts.Any())
                        {
                            <div class="compositionEmpty">Нет составных частей.</div>
                        }
                        else
                        {
                            @foreach (var part in selectedProductComposition.Parts.OrderBy(p => p.SortOrder))
                            {
                                <div class="compositionPartPanel">
                                    <div class="compositionPartHeader">
                                        <span>@part.Name</span>
                                        <span class="hint">@part.Aggregates.Count агрегатов</span>
                                    </div>
                                    @if (!part.Aggregates.Any())
                                    {
                                        <div class="compositionEmpty" style="padding:8px 0">В этой части нет агрегатов.</div>
                                    }
                                    else
                                    {
                                        <div class="tableWrap">
                                            <table>
                                                <thead>
                                                    <tr><th>Код агрегата</th><th>Наименование</th><th class="numeric">Количество</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var a in part.Aggregates.OrderBy(x => x.Aggregate?.Code))
                                                    {
                                                        <tr>
                                                            <td class="mono">@a.Aggregate?.Code</td>
                                                            <td>@a.Aggregate?.Name</td>
                                                            <td class="numeric">@a.Quantity</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    else if (Level == 0)
                    {
                        @if (!selectedComplexComposition!.Items.Any())
                        {
                            <div class="compositionEmpty">Нет моделей в составе комплекса.</div>
                        }
                        else
                        {
                            <div class="tableWrap">
                                <table>
                                    <thead>
                                        <tr><th>Код изделия</th><th>Наименование</th><th class="numeric">Количество</th><th>Примечание</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in selectedComplexComposition.Items.OrderBy(i => i.SortOrder))
                                        {
                                            <tr>
                                                <td class="mono">@item.EquipmentModel?.Index</td>
                                                <td>@item.EquipmentModel?.Name</td>
                                                <td class="numeric">@item.Quantity</td>
                                                <td>@item.Notes</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (Level == 2)
                    {
                        @if (!selectedAggregateComposition!.Nodes.Any())
                        {
                            <div class="compositionEmpty">Нет узлов в составе агрегата.</div>
                        }
                        else
                        {
                            <div class="tableWrap">
                                <table>
                                    <thead>
                                        <tr><th>Код узла</th><th>Наименование</th><th class="numeric">Количество</th><th>Примечание</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var node in selectedAggregateComposition.Nodes.OrderBy(n => n.SortOrder))
                                        {
                                            <tr>
                                                <td class="mono">@node.Node?.Code</td>
                                                <td>@node.Node?.Name</td>
                                                <td class="numeric">@node.Quantity</td>
                                                <td>@node.Notes</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>

        <aside class="stack compositionSidebar">
            @if (selected != null)
            {
                <section class="panel">
                    <div class="panelHeader"><h2>Сводка версии</h2></div>
                    <div class="panelBody">
                        <div class="field"><label>Статус</label><CompositionStatusBadge Status="@selected.Status" /></div>
                        <div class="field"><label>Версия</label><div class="mono">@selected.Version</div></div>
                        <div class="field"><label>Автор</label><div>@(authorName ?? "—")</div></div>
                        <div class="field"><label>Создан</label><div class="mono">@selected.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        <div class="field"><label>Обновлён</label><div class="mono">@selected.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        @if (selected.ApprovedAt.HasValue)
                        {
                            <div class="field"><label>Утверждён</label><div class="mono">@selected.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</div></div>
                        }
                        @if (selected.EffectiveDate.HasValue)
                        {
                            <div class="field"><label>Действует с</label><div class="mono">@selected.EffectiveDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (selected.ExpirationDate.HasValue)
                        {
                            <div class="field"><label>Действует до</label><div class="mono">@selected.ExpirationDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (!string.IsNullOrEmpty(selected.Comment))
                        {
                            <div class="field"><label>Комментарий</label><div>@selected.Comment</div></div>
                        }
                        @if (selected.PredecessorId.HasValue && PredecessorVersion != null)
                        {
                            <div class="field"><label>Предшественник</label><a class="linkBtn" href="@VersionUrl(selected.PredecessorId.Value)">@PredecessorVersion ↗</a></div>
                        }
                    </div>
                </section>

                <section class="panel compositionVersionNavigator">
                    <div class="panelHeader"><h2>Версии состава</h2><div class="hint">@versions.Count</div></div>
                    <div class="panelBody">
                        @if (!versions.Any())
                        {
                            <div class="compositionEmpty">Версий нет</div>
                        }
                        else
                        {
                            <div class="listRows">
                                @foreach (var v in versions.OrderByDescending(v => v.CreatedAt))
                                {
                                    var active = v.Id == compositionId;
                                    <div class="rowCard @(active ? "current" : null)">
                                        <div class="top">
                                            @if (active)
                                            {
                                                <span class="mono">@v.Version</span>
                                            }
                                            else
                                            {
                                                <a class="linkBtn" href="@VersionUrl(v.Id)">@v.Version</a>
                                            }
                                            <CompositionStatusBadge Status="@v.Status" />
                                        </div>
                                        @if (v.EffectiveDate.HasValue)
                                        {
                                            <div class="sub">Действует с @v.EffectiveDate!.Value.ToString("dd.MM.yyyy")</div>
                                        }
                                        <div class="sub">@v.UpdatedAt.ToString("dd.MM.yyyy HH:mm") @(active ? "· Текущая" : "")</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel">
                    <div class="panelHeader"><h2>Нормативная готовность</h2><div class="hint">@readinessRows.Count</div></div>
                    <div class="panelBody">
                        @if (!readinessRows.Any())
                        {
                            <div class="compositionEmpty">Данных о готовности нет</div>
                        }
                        else
                        {
                            <div class="listRows">
                                @foreach (var r in readinessRows)
                                {
                                    <div class="rowCard">
                                        <div class="top">
                                            <span class="mono">@r.ChildCode</span>
                                            <span class="tag @ReadinessTag(r.Status)">@ReadinessLabel(r.Status)</span>
                                        </div>
                                        <div class="sub">@r.ChildName</div>
                                        <div class="sub">@ReadinessMessage(r)</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel">
                    <div class="panelHeader"><h2>Связанные задачи</h2><div class="hint">@linkedTasks.Count</div></div>
                    <div class="panelBody">
                        @if (!linkedTasks.Any())
                        {
                            <div class="compositionEmpty">Задач нет</div>
                        }
                        else
                        {
                            <div class="listRows">
                                @foreach (var t in linkedTasks)
                                {
                                    <div class="rowCard">
                                        <div class="top">
                                            <a class="linkBtn" href="/задачи/@t.Id">@WorkTaskTypeLabel(t.Type)</a>
                                            <span class="tag @TaskStatusTag(t.Status)">@TaskStatusLabel(t.Status)</span>
                                        </div>
                                        <div class="sub">@t.Title</div>
                                        <div class="sub">@t.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") @(t.WorkTaskGroupId.HasValue ? "(групп.)" : "")</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="panel">
                    <div class="panelHeader"><h2>История согласования</h2><div class="hint">@history.Count</div></div>
                    <div class="panelBody">
                        @if (!history.Any())
                        {
                            <div class="compositionEmpty">Записей нет</div>
                        }
                        else
                        {
                            <div class="listRows">
                                @foreach (var h in history)
                                {
                                    <div class="rowCard">
                                        <div class="top">
                                            <span>@AuditDisplayCatalog.GetAction(h.Action).Title</span>
                                            <span class="sub">@h.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(h.ActorFullName))
                                        {
                                            <div class="sub">@h.ActorFullName</div>
                                        }
                                        @if (!string.IsNullOrEmpty(h.Details))
                                        {
                                            <div class="sub">@h.Details</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        </aside>
    </div>
</div>

@code {
    [Parameter] public Guid? complexId { get; set; }
    [Parameter] public Guid? equipmentModelId { get; set; }
    [Parameter] public Guid? aggregateId { get; set; }
    [Parameter] public Guid compositionId { get; set; }

    private bool loading = true;
    private bool canCreateVersion;
    private bool canEditDraft;
    private bool canSubmit;
    private bool canReturn;
    private bool canApprove;
    private string? error;
    private string actionComment = "";
    private string? authorName;
    private CancellationTokenSource? _loadCts;

    private ProductComposition? selectedProductComposition;
    private ComplexComposition? selectedComplexComposition;
    private AggregateComposition? selectedAggregateComposition;
    private CompositionVersionSummary? selected;
    private Guid selectedObjectId;
    private string? objectCode;
    private string? objectName;
    private readonly List<CompositionVersionSummary> versions = new();
    private List<ReadinessRow> readinessRows = new();
    private List<WorkTask> linkedTasks = new();
    private List<AuditLogEntity> history = new();

    private int Level =>
        complexId.HasValue ? 0 :
        equipmentModelId.HasValue ? 1 :
        aggregateId.HasValue ? 2 : -1;

    private string LevelTitle => Level switch
    {
        0 => "Комплекс",
        1 => "Изделие",
        _ => "Агрегат"
    };

    private string LevelPlural => Level switch
    {
        0 => "Комплексы",
        1 => "Изделия",
        _ => "Агрегаты"
    };

    private string ListEditorUrl => Level switch
    {
        0 => "/состав-комплекса",
        1 => "/состав-изделия",
        _ => "/состав-агрегата"
    };

    private string CompositionTableTitle => Level switch
    {
        0 => "Изделия в составе комплекса",
        1 => "Агрегаты в составе изделия",
        _ => "Узлы в составе агрегата"
    };

    private string CompositionSummary
    {
        get
        {
            if (Level == 0)
            {
                var count = selectedComplexComposition?.Items.Count ?? 0;
                return $"{count} {(count == 1 ? "изделие" : count is >= 2 and <= 4 ? "изделия" : "изделий")}";
            }
            if (Level == 1)
            {
                var parts = selectedProductComposition?.Parts.Count ?? 0;
                var aggregates = selectedProductComposition?.Parts.Sum(p => p.Aggregates.Count) ?? 0;
                return $"{parts} {(parts == 1 ? "часть" : parts is >= 2 and <= 4 ? "части" : "частей")} · {aggregates} {(aggregates == 1 ? "агрегат" : aggregates is >= 2 and <= 4 ? "агрегата" : "агрегатов")}";
            }
            var nodes = selectedAggregateComposition?.Nodes.Count ?? 0;
            return $"{nodes} {(nodes == 1 ? "узел" : nodes is >= 2 and <= 4 ? "узла" : "узлов")}";
        }
    }

    private string ReadOnlyBannerClass => selected?.Status switch
    {
        ProductCompositionStatus.OnReview => "compositionReadOnlyBanner--warn",
        ProductCompositionStatus.Archived => "compositionReadOnlyBanner--info",
        _ => "compositionReadOnlyBanner--info"
    };

    private string ReadOnlyBannerText => selected?.Status switch
    {
        ProductCompositionStatus.OnReview => "На согласовании — состав заблокирован до решения согласующего.",
        ProductCompositionStatus.Approved => "Утверждён — для изменения создайте новую версию.",
        ProductCompositionStatus.Archived => "В архиве — историческая версия доступна только для просмотра.",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canCreateVersion = Level switch
        {
            0 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexCreateVersion),
            1 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreateVersion),
            _ => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateCreateVersion)
        };
        canEditDraft = Level switch
        {
            0 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexEditDraft),
            1 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelEditDraft),
            _ => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateEditDraft)
        };
        canSubmit = Level switch
        {
            0 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexSubmit),
            1 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelSubmit),
            _ => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateSubmit)
        };
        canReturn = Level switch
        {
            0 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexReturnForRevision),
            1 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelReturnForRevision),
            _ => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateReturnForRevision)
        };
        canApprove = Level switch
        {
            0 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexApprove),
            1 => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelApprove),
            _ => await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateApprove)
        };
        _loadCts = new CancellationTokenSource();
        await LoadData();
    }

    private async Task LoadData()
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            loading = true;
            try
            {
                switch (Level)
                {
                    case 0:
                        var complexComp = await EquipService.GetComplexCompositionAsync(compositionId, ct);
                        var allComplexVersions = await EquipService.GetComplexCompositionsAsync(complexId!.Value, ct);
                        selectedComplexComposition = complexComp;
                        selectedObjectId = complexComp?.ComplexId ?? complexId.Value;
                        objectCode ??= complexComp?.Complex?.Code;
                        objectName ??= complexComp?.Complex?.Name;
                        versions.Clear();
                        foreach (var v in allComplexVersions)
                        {
                            versions.Add(ToComplexSummary(v));
                            objectCode ??= v.Complex?.Code;
                            objectName ??= v.Complex?.Name;
                        }
                        break;
                    case 1:
                        var productComp = await EquipService.GetCompositionAsync(compositionId, ct);
                        var allProductVersions = await EquipService.GetCompositionsAsync(equipmentModelId!.Value, ct);
                        selectedProductComposition = productComp;
                        selectedObjectId = productComp?.EquipmentModelId ?? equipmentModelId.Value;
                        objectCode ??= productComp?.EquipmentModel?.Index;
                        objectName ??= productComp?.EquipmentModel?.Name;
                        versions.Clear();
                        foreach (var v in allProductVersions)
                        {
                            versions.Add(ToProductSummary(v));
                            objectCode ??= v.EquipmentModel?.Index;
                            objectName ??= v.EquipmentModel?.Name;
                        }
                        break;
                    default:
                        var aggregComp = await EquipService.GetAggregateCompositionAsync(compositionId, ct);
                        var allAggregVersions = await EquipService.GetAggregateCompositionsAsync(aggregateId!.Value, ct);
                        selectedAggregateComposition = aggregComp;
                        selectedObjectId = aggregComp?.AggregateId ?? aggregateId!.Value;
                        objectCode ??= aggregComp?.Aggregate?.Code;
                        objectName ??= aggregComp?.Aggregate?.Name;
                        versions.Clear();
                        foreach (var v in allAggregVersions)
                        {
                            versions.Add(ToAggregateSummary(v));
                            objectCode ??= v.Aggregate?.Code;
                            objectName ??= v.Aggregate?.Name;
                        }
                        break;
                }
                selected = versions.FirstOrDefault(v => v.Id == compositionId);
                if (selected != null)
                {
                    await ResolveAuthorAsync();
                    readinessRows = (await EquipService.EvaluateReadinessAsync(Level, compositionId, ct)).ToList();
                    linkedTasks = (await EquipService.GetCompositionTasksAsync(Level, compositionId, ct)).ToList();
                    history = (await EquipService.GetCompositionHistoryAsync(Level, compositionId, ct)).ToList();
                }
            }
            catch (Exception ex)
            {
                error = $"Ошибка загрузки: {ex.Message}";
            }
            loading = false;
        }
    }

    private async Task ResolveAuthorAsync()
    {
        var authorId = Level switch
        {
            0 => selectedComplexComposition?.AuthorId,
            1 => selectedProductComposition?.AuthorId,
            _ => selectedAggregateComposition?.AuthorId
        };
        if (string.IsNullOrWhiteSpace(authorId)) return;
        var user = await UserManager.FindByIdAsync(authorId);
        authorName = user?.FullName ?? authorId;
    }

    private string? PredecessorVersion
    {
        get
        {
            if (selected?.PredecessorId is null || selected.PredecessorId == Guid.Empty)
                return null;
            return versions.FirstOrDefault(v => v.Id == selected.PredecessorId)?.Version;
        }
    }

    private string VersionUrl(Guid id) => Level switch
    {
        0 => $"/составы/комплексы/{selectedObjectId}/версии/{id}",
        1 => $"/составы/изделия/{selectedObjectId}/версии/{id}",
        _ => $"/составы/агрегаты/{selectedObjectId}/версии/{id}"
    };

    private string EditorUrl => Level switch
    {
        0 => "/состав-комплекса",
        1 => "/состав-изделия",
        _ => "/состав-агрегата"
    };

    private static CompositionVersionSummary ToComplexSummary(ComplexComposition c) =>
        new(c.Id, c.ComplexId, c.Version, c.Status, c.CreatedAt, c.UpdatedAt, c.EffectiveDate, c.ExpirationDate, c.ApprovedAt, c.Comment, c.SupersedesComplexCompositionId);

    private static CompositionVersionSummary ToProductSummary(ProductComposition p) =>
        new(p.Id, p.EquipmentModelId, p.Version, p.Status, p.CreatedAt, p.UpdatedAt, p.EffectiveDate, p.ExpirationDate, p.ApprovedAt, p.Comment, p.SupersedesProductCompositionId);

    private static CompositionVersionSummary ToAggregateSummary(AggregateComposition a) =>
        new(a.Id, a.AggregateId, a.Version, a.Status, a.CreatedAt, a.UpdatedAt, a.EffectiveDate, a.ExpirationDate, a.ApprovedAt, a.Comment, a.SupersedesAggregateCompositionId);

    private async Task CreateVersion()
    {
        error = null;
        try
        {
            switch (Level)
            {
                case 0:
                    var complexResult = await EquipService.CreateComplexCompositionVersionAsync(compositionId);
                    if (complexResult.Success && complexResult.CompositionId.HasValue)
                        Nav.NavigateTo($"/составы/комплексы/{selectedObjectId}/версии/{complexResult.CompositionId}", forceLoad: true);
                    else
                        error = complexResult.Error ?? "Не удалось создать версию.";
                    break;
                case 1:
                    var modelResult = await EquipService.CreateProductCompositionVersionAsync(compositionId);
                    if (modelResult.Success && modelResult.CompositionId.HasValue)
                        Nav.NavigateTo($"/составы/изделия/{selectedObjectId}/версии/{modelResult.CompositionId}", forceLoad: true);
                    else
                        error = modelResult.Error ?? "Не удалось создать версию.";
                    break;
                default:
                    var aggregateResult = await EquipService.CreateAggregateCompositionVersionAsync(compositionId);
                    if (aggregateResult.Success && aggregateResult.CompositionId.HasValue)
                        Nav.NavigateTo($"/составы/агрегаты/{selectedObjectId}/версии/{aggregateResult.CompositionId}", forceLoad: true);
                    else
                        error = aggregateResult.Error ?? "Не удалось создать версию.";
                    break;
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            error = $"Ошибка: {ex.Message}";
        }
    }

    private async Task SubmitForReview()
    {
        error = null;
        try
        {
            var ct = _loadCts?.Token ?? default;
            var result = Level switch
            {
                0 => await EquipService.SubmitComplexCompositionForReviewAsync(compositionId, ct),
                1 => await EquipService.SubmitForReviewAsync(compositionId, ct),
                _ => await EquipService.SubmitAggregateCompositionForReviewAsync(compositionId, ct)
            };
            if (result)
                await LoadData();
            else
                error = "Не удалось отправить на проверку.";
        }
        catch (Exception ex)
        {
            error = $"Ошибка: {ex.Message}";
        }
    }

