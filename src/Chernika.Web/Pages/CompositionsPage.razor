@page "/составы"
@attribute [Authorize(Policy = "ViewComposition")]
@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Web.Components
@using Chernika.Web.Services
@inject EquipmentService EquipService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@implements IDisposable

<div class="stack compositionRegistry">
    <section class="panel">
        <div class="panelHeader">
            <h2>Составы техники</h2>
            <div class="hint">Агрегаты • Изделия • Комплексы</div>
        </div>
        <div class="panelBody">
            <div class="btnRow compositionRegistryTabs">
                <button class="btn @(IsActiveTab(CompositionRegistryLevel.Aggregate) ? "primary" : "ghost")" @onclick="() => SetTab(CompositionRegistryLevel.Aggregate)">Агрегаты</button>
                <button class="btn @(IsActiveTab(CompositionRegistryLevel.EquipmentModel) ? "primary" : "ghost")" @onclick="() => SetTab(CompositionRegistryLevel.EquipmentModel)">Изделия</button>
                <button class="btn @(IsActiveTab(CompositionRegistryLevel.Complex) ? "primary" : "ghost")" @onclick="() => SetTab(CompositionRegistryLevel.Complex)">Комплексы</button>
            </div>

            <div class="form compositionRegistryFilters">
                <div class="field compositionRegistrySearch">
                    <label>Поиск по всем составам техники</label>
                    <input @bind="searchText" @bind:event="oninput" placeholder="Код, наименование или версия..." class="field-input" />
                </div>
                <div class="field">
                    <label>Статус</label>
                    <select @bind="statusFilter" class="field-select">
                        <option value="">Все</option>
                        <option value="@ProductCompositionStatus.Draft">Черновик</option>
                        <option value="@ProductCompositionStatus.OnReview">На проверке</option>
                        <option value="@ProductCompositionStatus.Approved">Утверждён</option>
                        <option value="@ProductCompositionStatus.Archived">Архивный</option>
                    </select>
                </div>
                <div class="field">
                    <label>Наличие состава</label>
                    <select @bind="presence" class="field-select">
                        <option value="@CompositionPresenceFilter.All">Все объекты</option>
                        <option value="@CompositionPresenceFilter.WithComposition">Только с составом</option>
                        <option value="@CompositionPresenceFilter.WithoutComposition">Только без состава</option>
                    </select>
                </div>
                <div class="field compositionRegistryToggle">
                    <label>&nbsp;</label>
                    <label class="btn ghost">
                        <input type="checkbox" @bind="showArchived" />
                        Архивные версии
                    </label>
                </div>
                <div class="field compositionRegistryFilterAction">
                    <label>&nbsp;</label>
                    <button class="btn primary" @onclick="ApplyFilters">Обновить</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="note warn compositionRegistryError">@error</div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>@PageTitle</h2>
            <div class="hint">@(registry?.TotalCount ?? 0) записей</div>
        </div>
        @if (registry?.HasMoreResults == true)
        {
            <div class="note warn compositionRegistryLimit">Показаны первые @registry.TotalCount результатов. Уточните запрос.</div>
        }
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (registry?.Items is null || !registry.Items.Any())
            {
                <div class="empty-state">Нет записей по заданным условиям.</div>
            }
            else
            {
                <div class="tableWrap">
                    <table>
                        <thead>
                            <tr>
                                @if (IsGlobalSearch)
                                {
                                    <th>Уровень</th>
                                }
                                <th>Код</th>
                                <th>Наименование</th>
                                <th>Версия</th>
                                <th>Статус</th>
                                <th>Состав</th>
                                <th>Обновлено</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in registry.Items)
                            {
                                <tr class="@(row.IsHistoricalArchiveRow ? "compositionRegistryRow--archive" : null)">
                                    @if (IsGlobalSearch)
                                    {
                                        <td>
                                            @if (row.IsHistoricalArchiveRow)
                                            {
                                                <span class="hint">Историческая версия</span>
                                            }
                                            else
                                            {
                                                <span class="tag">@LevelLabel(row.Level)</span>
                                            }
                                        </td>
                                    }
                                    <td class="mono">@row.ObjectCode</td>
                                    <td>@row.ObjectName</td>
                                    <td class="mono">@(row.Version ?? "—")</td>
                                    <td>
                                        @if (row.Status.HasValue)
                                        {
                                            <CompositionStatusBadge Status="@row.Status.Value" />
                                        }
                                        else if (row.IsHistoricalArchiveRow)
                                        {
                                            <span class="tag">Архивный</span>
                                        }
                                        else
                                        {
                                            <span class="tag">Нет состава</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.CompositionId.HasValue)
                                        {
                                            <span>@GetCompositionSummary(row)</span>
                                        }
                                        else if (HasArchivedOnly(row))
                                        {
                                            <span class="hint">Нет актуальной версии</span>
                                        }
                                        else
                                        {
                                            <span class="hint">—</span>
                                        }
                                    </td>
                                    <td class="mono">@(row.UpdatedAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td>
                                        <div class="rowActions">
                                            @if (row.CompositionId.HasValue)
                                            {
                                                <button class="linkBtn" @onclick="() => OpenComposition(row)">Открыть состав</button>
                                            }
                                            @if (CanCreateDraft(row))
                                            {
                                                <button class="linkBtn" @onclick="() => CreateDraft(row)">Создать черновик</button>
                                            }
                                            @if (CanCreateVersion(row))
                                            {
                                                <button class="linkBtn" @onclick="() => CreateVersion(row)">Создать версию</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (registry.TotalCount > registry.PageSize)
                {
                    <div class="pager">
                        <button class="btn ghost" disabled="@(registry.Page <= 1)" @onclick="PrevPage">← Назад</button>
                        <span class="hint">Страница @registry.Page из @((int)Math.Ceiling((double)registry.TotalCount / registry.PageSize))</span>
                        <button class="btn ghost" disabled="@(registry.Page * registry.PageSize >= registry.TotalCount)" @onclick="NextPage">Вперёд →</button>
                    </div>
                }
            }
        </div>
    </section>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "level")] public string? LevelQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "search")] public string? SearchQuery { get; set; }

    private CompositionRegistryLevel level = CompositionRegistryLevel.Aggregate;
    private string searchText = "";
    private ProductCompositionStatus? statusFilter;
    private CompositionPresenceFilter presence = CompositionPresenceFilter.All;
    private bool showArchived;
    private int page = 1;
    private const int PageSize = 50;

    private bool loading = true;
    private string? error;
    private PagedResult<CompositionRegistryRow> registry = new()
    {
        Items = new List<CompositionRegistryRow>(),
        TotalCount = 0,
        Page = 1,
        PageSize = PageSize
    };

    private bool canCreateComplex;
    private bool canCreateModel;
    private bool canCreateAggregate;
    private bool canCreateVersionComplex;
    private bool canCreateVersionModel;
    private bool canCreateVersionAggregate;

    private CancellationTokenSource? _loadCts;

    private bool IsGlobalSearch => !string.IsNullOrWhiteSpace(searchText);

    private string PageTitle => (IsGlobalSearch, level) switch
    {
        (true, _) => "Результаты поиска",
        (_, CompositionRegistryLevel.Aggregate) => "Составы агрегатов",
        (_, CompositionRegistryLevel.EquipmentModel) => "Составы изделий",
        (_, CompositionRegistryLevel.Complex) => "Составы комплексов",
        _ => "Составы техники"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canCreateComplex = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexCreate);
        canCreateModel = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreate);
        canCreateAggregate = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateCreate);
        canCreateVersionComplex = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexCreateVersion);
        canCreateVersionModel = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionEquipmentModelCreateVersion);
        canCreateVersionAggregate = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionAggregateCreateVersion);

        if (!string.IsNullOrEmpty(LevelQuery) &&
            Enum.TryParse<CompositionRegistryLevel>(LevelQuery, true, out var parsedLevel))
        {
            level = parsedLevel;
        }
        if (!string.IsNullOrEmpty(SearchQuery))
        {
            searchText = SearchQuery;
        }

        _loadCts = new CancellationTokenSource();
        await LoadData();
    }

    private async Task LoadData()
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            loading = true;
            error = null;
            try
            {
                var query = new CompositionRegistryQuery
                {
                    Level = IsGlobalSearch ? CompositionRegistryLevel.All : level,
                    SearchText = searchText,
                    Status = statusFilter,
                    Presence = presence,
                    ShowArchivedVersions = showArchived,
                    Page = page,
                    PageSize = PageSize,
                    SortBy = "name"
                };
                registry = await EquipService.GetCompositionRegistryAsync(query, ct);
            }
            catch (Exception ex)
            {
                error = $"Ошибка загрузки реестра: {ex.Message}";
                registry = new PagedResult<CompositionRegistryRow>
                {
                    Items = new List<CompositionRegistryRow>(),
                    TotalCount = 0,
                    Page = 1,
                    PageSize = PageSize
                };
            }
            loading = false;
        }
    }

    private void SetTab(CompositionRegistryLevel l)
    {
        level = l;
        searchText = "";
        page = 1;
        error = null;
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        _ = LoadData();
    }

    private bool IsActiveTab(CompositionRegistryLevel l) => !IsGlobalSearch && level == l;

    private async Task ApplyFilters()
    {
        page = 1;
        await LoadData();
    }

    private async Task PrevPage()
    {
        if (registry.Page > 1)
        {
            page = registry.Page - 1;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (registry.Page * registry.PageSize < registry.TotalCount)
        {
            page = registry.Page + 1;
            await LoadData();
        }
    }

    private static string LevelLabel(CompositionRegistryLevel l) => l switch
    {
        CompositionRegistryLevel.Aggregate => "Агрегат",
        CompositionRegistryLevel.EquipmentModel => "Изделие",
        CompositionRegistryLevel.Complex => "Комплекс",
        _ => "—"
    };

    private static string GetCompositionSummary(CompositionRegistryRow row) => row.Level switch
    {
        CompositionRegistryLevel.Aggregate => $"{row.NodeCount} {Decline(row.NodeCount, "узел", "узла", "узлов")}",
        CompositionRegistryLevel.EquipmentModel => $"{row.PartCount} {Decline(row.PartCount, "часть", "части", "частей")} · {row.AggregateCount} {Decline(row.AggregateCount, "агрегат", "агрегата", "агрегатов")}",
        CompositionRegistryLevel.Complex => $"{row.ItemCount} {Decline(row.ItemCount, "изделие", "изделия", "изделий")}",
        _ => "—"
    };

    private static bool HasArchivedOnly(CompositionRegistryRow row) => !row.CompositionId.HasValue && !row.Status.HasValue && row.HasArchivedVersions;

    private bool CanCreateDraft(CompositionRegistryRow row) => row.Level switch
    {
        CompositionRegistryLevel.Complex => canCreateComplex && !row.CompositionId.HasValue,
        CompositionRegistryLevel.EquipmentModel => canCreateModel && !row.CompositionId.HasValue,
        CompositionRegistryLevel.Aggregate => canCreateAggregate && !row.CompositionId.HasValue,
        _ => false
    };

    private bool CanCreateVersion(CompositionRegistryRow row) =>
        row.CompositionId.HasValue &&
        row.Status is ProductCompositionStatus.Approved or ProductCompositionStatus.Archived &&
        row.Level switch
        {
            CompositionRegistryLevel.Complex => canCreateVersionComplex,
            CompositionRegistryLevel.EquipmentModel => canCreateVersionModel,
            CompositionRegistryLevel.Aggregate => canCreateVersionAggregate,
            _ => false
        };

    private void OpenComposition(CompositionRegistryRow row)
    {
        if (!row.CompositionId.HasValue) return;
        var url = row.Level switch
        {
            CompositionRegistryLevel.Complex => $"/составы/комплексы/{row.ObjectId}/версии/{row.CompositionId}",
            CompositionRegistryLevel.EquipmentModel => $"/составы/изделия/{row.ObjectId}/версии/{row.CompositionId}",
            CompositionRegistryLevel.Aggregate => $"/составы/агрегаты/{row.ObjectId}/версии/{row.CompositionId}",
            _ => "/составы"
        };
        Nav.NavigateTo(url);
    }

    private async Task CreateDraft(CompositionRegistryRow row)
    {
        error = null;
        try
        {
            switch (row.Level)
            {
                case CompositionRegistryLevel.Complex:
                    var cc = await EquipService.CreateComplexCompositionAsync(new CreateComplexCompositionRequest(row.ObjectId, null));
                    Nav.NavigateTo($"/составы/комплексы/{row.ObjectId}/версии/{cc.Id}", forceLoad: true);
                    break;
                case CompositionRegistryLevel.EquipmentModel:
                    var pc = await EquipService.CreateCompositionDraftAsync(new CreateCompositionRequest(row.ObjectId, null));
                    Nav.NavigateTo($"/составы/изделия/{row.ObjectId}/версии/{pc.Id}", forceLoad: true);
                    break;
                case CompositionRegistryLevel.Aggregate:
                    var ac = await EquipService.CreateAggregateCompositionAsync(new CreateAggregateCompositionRequest(row.ObjectId, null));
                    Nav.NavigateTo($"/составы/агрегаты/{row.ObjectId}/версии/{ac.Id}", forceLoad: true);
                    break;
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            error = $"Ошибка: {ex.Message}";
        }
    }

    private async Task CreateVersion(CompositionRegistryRow row)
    {
        if (!row.CompositionId.HasValue) return;
        error = null;
        try
        {
            var (success, id, err) = row.Level switch
            {
                CompositionRegistryLevel.Complex => await EquipService.CreateComplexCompositionVersionAsync(row.CompositionId.Value),
                CompositionRegistryLevel.EquipmentModel => await EquipService.CreateProductCompositionVersionAsync(row.CompositionId.Value),
                CompositionRegistryLevel.Aggregate => await EquipService.CreateAggregateCompositionVersionAsync(row.CompositionId.Value),
                _ => (false, null, null)
            };
            if (success && id.HasValue)
            {
                var url = row.Level switch
                {
                    CompositionRegistryLevel.Complex => $"/составы/комплексы/{row.ObjectId}/версии/{id}",
                    CompositionRegistryLevel.EquipmentModel => $"/составы/изделия/{row.ObjectId}/версии/{id}",
                    CompositionRegistryLevel.Aggregate => $"/составы/агрегаты/{row.ObjectId}/версии/{id}",
                    _ => "/составы"
                };
                Nav.NavigateTo(url, forceLoad: true);
            }
            else
            {
                error = err ?? "Не удалось создать версию.";
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            error = $"Ошибка: {ex.Message}";
        }
    }

    private static string Decline(int count, string one, string few, string many) => count % 10 == 1 && count % 100 != 11
        ? one
        : count % 10 is >= 2 and <= 4 && (count % 100 < 10 || count % 100 >= 20)
            ? few
            : many;

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
