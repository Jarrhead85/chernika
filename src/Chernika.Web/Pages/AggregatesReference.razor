@page "/справочник-агрегатов"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Техника" Current="Агрегаты" />
    <section class="panel">
        <div class="panelHeader">
            <h2>Справочник агрегатов</h2>
            <div class="hint">Общесистемный справочник</div>
        </div>
        <div class="panelBody">
            <div class="form">
                <div class="field"><label>Код агрегата</label><input @bind="newEntity.Code" /></div>
                <div class="field"><label>Наименование</label><input @bind="newEntity.Name" /></div>
                <div class="field full-width"><label>Описание</label><input @bind="newEntity.Description" /></div>
                <div class="formActions">
                    <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                    @if (canEdit) { <button class="btn primary" @onclick="SaveEntity">@(editing ? "Сохранить" : "Добавить")</button> }
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>Список агрегатов</h2>
            <div class="hint">@entities.Count записей</div>
        </div>
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!entities.Any())
            {
                <div class="empty-state">Нет агрегатов</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr><th>Код</th><th>Наименование</th><th>Описание</th><th>Действия</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in entities)
                        {
                            <tr>
                                <td class="mono">@e.Code</td>
                                <td>@e.Name</td>
                                <td>@e.Description</td>
                                <td>
                                    <div class="rowActions">
                                        @if (canEdit) { <button class="linkBtn" @onclick="() => EditEntity(e)">Изменить</button> }
                                        @if (canEdit) { <button class="linkBtn" @onclick="() => DeleteEntity(e.Id)">Удалить</button> }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
</div>

@code {
    private List<Aggregate> entities = new();
    private Aggregate newEntity = new();
    private bool editing;
    private bool loading = true;
    private bool canEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = await Perms.HasPermissionAsync(userId!, PermissionCodes.ReferenceEdit);
        await LoadEntities();
    }

    async Task LoadEntities()
    {
        loading = true;
        entities = await EquipService.GetAggregatesAsync();
        loading = false;
    }

    async Task SaveEntity()
    {
        if (string.IsNullOrWhiteSpace(newEntity.Name)) return;
        if (editing)
            await EquipService.UpdateAggregateAsync(new Domain.Models.UpdateAggregateRequest(newEntity.Id, newEntity.Code, newEntity.Name, newEntity.Description));
        else
            await EquipService.CreateAggregateAsync(new Domain.Models.CreateAggregateRequest(newEntity.Code, newEntity.Name, newEntity.Description));
        ResetForm();
        await LoadEntities();
    }

    void EditEntity(Aggregate a)
    {
        newEntity = new Aggregate { Id = a.Id, Code = a.Code, Name = a.Name, Description = a.Description };
        editing = true;
    }

    async Task DeleteEntity(Guid id)
    {
        await EquipService.DeleteAggregateAsync(id);
        await LoadEntities();
    }

    void ResetForm()
    {
        newEntity = new Aggregate();
        editing = false;
    }
}
