@page "/справочник-гсм"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Материалы" Current="Смазочные материалы" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование материала" : "Новый смазочный материал")</h2>
                <div class="hint">Горюче-смазочные материалы</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Наименование</label><input @ref="_firstField" @bind="newGsm.Name" /></div>
                    <div class="field"><label>Тип</label><input @bind="newGsm.Type" /></div>
                    <div class="field"><label>ГОСТ</label><input @bind="newGsm.Gost" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveGsm">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список материалов</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по наименованию, типу, ГОСТу..." />
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="Name">Сортировка: наименование</option>
                    <option value="Type">Сортировка: тип</option>
                    <option value="Gost">Сортировка: ГОСТ</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!gsms.Any())
            {
                <div class="empty-state">Нет материалов</div>
            }
            else
            {
                <div class="referenceTableWrap">
                    <table>
                        <thead>
                            <tr><th>Наименование</th><th>Тип</th><th>ГОСТ</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in gsms)
                            {
                                var rowClickable = canEdit && !m.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(m)" @onkeydown="(ev) => OnRowKeyDown(ev, m)">
                                    <td>@m.Name</td>
                                    <td>@m.Type</td>
                                    <td>@m.Gost</td>
                                    <td><span class="tag @(m.IsDeleted ? "bad" : "ok")">@(m.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (m.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreGsm(m.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditGsm(m)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteGsm(m.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @gsms.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<GsmMaterial> gsms = new();
    private GsmMaterial newGsm = new();
    private bool editing = false;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private int statusFilter = 0;
    private string sortBy = "Name";
    private bool sortDesc = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search) || statusFilter != 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    private async Task OnFiltersChanged()
    {
        currentPage = 1;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        bool? showDeleted = statusFilter switch
        {
            1 => true,
            2 => null,
            _ => false
        };

        loading = true;
        try
        {
            var result = await EquipService.GetGsmMaterialsPagedAsync(new GsmMaterialQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);

            if (ct.IsCancellationRequested)
                return;

            gsms = result.Items.ToList();
            totalCount = result.TotalCount;
            totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0)
            {
                currentPage = totalPages;
                await ReloadAsync();
                return;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                loading = false;
        }
    }

    async Task SaveGsm()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newGsm.Name) || string.IsNullOrWhiteSpace(newGsm.Type))
        {
            errorMessage = "Укажите наименование и тип.";
            return;
        }

        try
        {
            if (editing)
                await EquipService.UpdateGsmMaterialAsync(newGsm);
            else
                await EquipService.CreateGsmMaterialAsync(newGsm);
            ResetForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить запись справочника. Обновите список и повторите попытку."
                : "Не удалось создать запись справочника. Обновите список и повторите попытку.";
        }
    }

    Task EditGsm(GsmMaterial m)
    {
        newGsm = new GsmMaterial { Id = m.Id, Name = m.Name, Type = m.Type, Gost = m.Gost };
        editing = true;
        _focusForm = true;
        return Task.CompletedTask;
    }

    async Task OnRowDblClick(GsmMaterial m)
    {
        if (!canEdit || m.IsDeleted) return;
        await EditGsm(m);
    }

    async Task OnRowKeyDown(KeyboardEventArgs ev, GsmMaterial m)
    {
        if (!canEdit || m.IsDeleted || ev.Key != "Enter") return;
        await EditGsm(m);
    }

    async Task DeleteGsm(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await EquipService.DeleteGsmMaterialAsync(id);
            if (!ok) errorMessage = "Не удалось удалить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    async Task RestoreGsm(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await EquipService.RestoreGsmMaterialAsync(id);
            if (!ok) errorMessage = "Не удалось восстановить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    void ResetForm()
    {
        newGsm = new GsmMaterial();
        editing = false;
        errorMessage = null;
    }

    async Task ToggleSortDir()
    {
        sortDesc = !sortDesc;
        await ReloadAsync();
    }

    async Task ResetFilters()
    {
        search = "";
        statusFilter = 0;
        sortBy = "Name";
        sortDesc = false;
        currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await ReloadAsync();
    }

    async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await ReloadAsync();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
