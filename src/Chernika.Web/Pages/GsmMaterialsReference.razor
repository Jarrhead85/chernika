@page "/справочник-гсм"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms

<div class="stack">
    <ReferenceBreadcrumb Group="Материалы" Current="Смазочные материалы" />
    <section class="panel">
        <div class="panelHeader">
            <h2>Справочник смазочных материалов</h2>
            <div class="hint">Горюче-смазочные материалы</div>
        </div>
        <div class="panelBody">
            <div class="form">
                <div class="field"><label>Наименование</label><input @ref="_firstField" @bind="newGsm.Name" /></div>
                <div class="field"><label>Тип</label><input @bind="newGsm.Type" /></div>
                <div class="field"><label>ГОСТ</label><input @bind="newGsm.Gost" /></div>
                <div class="formActions">
                    <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                    @if (canEdit) { <button class="btn primary" @onclick="SaveGsm">@(editing ? "Сохранить" : "Добавить")</button> }
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>Список материалов</h2>
            <div class="hint">@gsms.Count записей</div>
        </div>
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!gsms.Any())
            {
                <div class="empty-state">Нет материалов</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr><th>Наименование</th><th>Тип</th><th>ГОСТ</th><th>Действия</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in gsms)
                        {
                            <tr class="@(canEdit ? "clickableRow" : "")" tabindex="@(canEdit ? "0" : "-1")" @ondblclick="() => OnRowDblClick(m)" @onkeydown="(ev) => OnRowKeyDown(ev, m)">
                                <td>@m.Name</td>
                                <td>@m.Type</td>
                                <td>@m.Gost</td>
                                <td @ondblclick:stopPropagation="true">
                                    <div class="rowActions">
                                        @if (canEdit) { <button class="linkBtn" @onclick="() => EditGsm(m)">Изменить</button> }
                                        @if (canEdit) { <button class="linkBtn" @onclick="() => DeleteGsm(m.Id)">Удалить</button> }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
</div>

@code {
    private List<GsmMaterial> gsms = new();
    private GsmMaterial newGsm = new();
    private bool editing = false;
    private bool loading = true;
    private bool canEdit;
    private ElementReference _firstField;
    private bool _focusForm;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = await Perms.HasPermissionAsync(userId!, PermissionCodes.ReferenceEdit);
        await LoadGsms();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    async Task LoadGsms()
    {
        loading = true;
        gsms = await EquipService.GetGsmMaterialsAsync();
        loading = false;
    }

    async Task SaveGsm()
    {
        if (string.IsNullOrWhiteSpace(newGsm.Name) || string.IsNullOrWhiteSpace(newGsm.Type)) return;
        if (editing)
            await EquipService.UpdateGsmMaterialAsync(newGsm);
        else
            await EquipService.CreateGsmMaterialAsync(newGsm);
        ResetForm();
        await LoadGsms();
    }

    Task EditGsm(GsmMaterial m)
    {
        newGsm = new GsmMaterial { Id = m.Id, Name = m.Name, Type = m.Type, Gost = m.Gost };
        editing = true;
        _focusForm = true;
        return Task.CompletedTask;
    }

    async Task OnRowDblClick(GsmMaterial m)
    {
        if (!canEdit) return;
        await EditGsm(m);
    }

    async Task OnRowKeyDown(KeyboardEventArgs ev, GsmMaterial m)
    {
        if (!canEdit || ev.Key != "Enter") return;
        await EditGsm(m);
    }

    async Task DeleteGsm(Guid id)
    {
        var ok = await EquipService.DeleteGsmMaterialAsync(id);
        if (ok) await LoadGsms();
    }

    void ResetForm()
    {
        newGsm = new GsmMaterial();
        editing = false;
    }
}
