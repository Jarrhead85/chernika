@page "/справочник-гсм"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Web.Services
@inject GsmMaterialService GsmService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock

<div class="stack">
    <ReferenceBreadcrumb Group="Материалы" Current="Смазочные материалы" />

    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование марки" : "Новая марка ГСМ")</h2>
            </div>
            <div class="panelBody">
                @* Сетка 12 колонок с РАЗНЫМИ долями по строкам: описанию нужно
                   больше места, индексу НАТО и признаку ГОСТ — меньше. Высоты
                   контролов во всех строках одинаковы, поэтому пустые поля не
                   раздувают строку. *@
                <div class="gsmForm">
                    @* Строка 1 *@
                    <div class="field gsmF4">
                        <label for="gsmGroup">Группа ГСМ <span class="gsmReq">*</span></label>
                        <input id="gsmGroup" @bind="form.GroupName" />
                        @if (groupError is not null)
                        {
                            <div class="gsmFieldError">@groupError</div>
                        }
                    </div>
                    <div class="field gsmF4">
                        <label for="gsmSubgroup">Подгруппа ГСМ <span class="gsmReq">*</span></label>
                        @* Кнопка «Добавить» ВНУТРИ контура поля, по образцу кнопки
                           лупы в быстром поиске: не перекрывает ввод, у input
                           достаточный правый отступ под неё. *@
                        <div class="gsmInlineField">
                            <input id="gsmSubgroup" class="gsmInlineInput" @bind="subgroupInput"
                                   @bind:event="oninput" @onkeydown="OnSubgroupKeyDown" />
                            <button type="button" class="gsmInlineBtn" @onclick="AddSubgroup">Добавить</button>
                        </div>
                        @if (subgroupError is not null)
                        {
                            <div class="gsmFieldError">@subgroupError</div>
                        }
                    </div>
                    <div class="field gsmF4">
                        <label for="gsmName">Марка ГСМ <span class="gsmReq">*</span></label>
                        <input id="gsmName" @ref="_firstField" @bind="form.Name" />
                        @if (nameError is not null)
                        {
                            <div class="gsmFieldError">@nameError</div>
                        }
                    </div>

                    @if (formSubgroups.Count > 0)
                    {
                        <div class="field gsmF12">
                            <label>Добавленные подгруппы</label>
                            <div class="gsmChips">
                                @foreach (var sub in formSubgroups)
                                {
                                    <span class="gsmChip">
                                        @sub
                                        <button type="button" class="gsmChipX"
                                                aria-label="Убрать подгруппу @sub"
                                                title="Убрать подгруппу @sub"
                                                @onclick="() => RemoveSubgroup(sub)">×</button>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @* Строка 2. Подпись «Нормативные документы» — только в этой форме;
                       имя поля GsmMaterial.Nd в БД и API не меняется. *@
                    <div class="field gsmF4">
                        <label for="gsmNd">Нормативные документы</label>
                        <input id="gsmNd" @bind="form.Nd" />
                    </div>
                    <div class="field gsmF4">
                        <label for="gsmUse">Назначение и условия применения</label>
                        <textarea id="gsmUse" class="gsmAutoTextarea" @bind="form.IntendedUse"></textarea>
                    </div>
                    <div class="field gsmF4">
                        <label for="gsmNato">Индекс НАТО</label>
                        <input id="gsmNato" @bind="form.NatoIndex" />
                    </div>

                    @* Строка 3 *@
                    <div class="field gsmF4">
                        <label for="gsmNote">Общее примечание</label>
                        <textarea id="gsmNote" class="gsmAutoTextarea" @bind="form.Note"></textarea>
                    </div>
                    <div class="field gsmF4">
                        <label id="gsmSuitLabel">Пригодность</label>
                        @* Тот же паттерн переключателя, что «Только мои» в Реестре ХК.
                           Общий filterToggle — отдельного третьего стиля нет. *@
                        <div class="gsmToggles" role="group" aria-labelledby="gsmSuitLabel">
                            <button type="button"
                                    class="filterToggle @(form.SuitabilityGround ? "active" : null)"
                                    aria-pressed="@form.SuitabilityGround"
                                    @onclick="() => form.SuitabilityGround = !form.SuitabilityGround">
                                <span class="filterToggleMark">@(form.SuitabilityGround ? "✓" : "")</span>
                                Наземная
                            </button>
                            <button type="button"
                                    class="filterToggle @(form.SuitabilityAir ? "active" : null)"
                                    aria-pressed="@form.SuitabilityAir"
                                    @onclick="() => form.SuitabilityAir = !form.SuitabilityAir">
                                <span class="filterToggleMark">@(form.SuitabilityAir ? "✓" : "")</span>
                                Авиационная
                            </button>
                            <button type="button"
                                    class="filterToggle @(form.SuitabilitySea ? "active" : null)"
                                    aria-pressed="@form.SuitabilitySea"
                                    @onclick="() => form.SuitabilitySea = !form.SuitabilitySea">
                                <span class="filterToggleMark">@(form.SuitabilitySea ? "✓" : "")</span>
                                Морская
                            </button>
                        </div>
                    </div>
                    <div class="field gsmF4">
                        <label id="gsmGostLabel">Включена в номенклатуру по ГОСТ</label>
                        <div class="gsmToggles" role="group" aria-labelledby="gsmGostLabel">
                            <button type="button"
                                    class="filterToggle @(form.InGostNomenclature ? "active" : null)"
                                    aria-pressed="@form.InGostNomenclature"
                                    @onclick="() => form.InGostNomenclature = !form.InGostNomenclature">
                                <span class="filterToggleMark">@(form.InGostNomenclature ? "✓" : "")</span>
                                В номенклатуре по ГОСТ
                            </button>
                        </div>
                    </div>
                </div>

                <div class="gsmFormActions">
                    <button class="btn ghost" @onclick="ResetForm">@(editing ? "Отмена" : "Очистить")</button>
                    <button class="btn primary" @onclick="SaveGsmAsync" disabled="@saving">
                        @(editing ? "Сохранить" : "Добавить")
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="gsmError">@errorMessage</div>
                }
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список марок ГСМ</h2>
            <div class="gsmHeaderRight">
                @* Три колонки связей здесь только на чтение. После изменений во
                   втором справочнике они обновляются по кнопке: DTO марки через
                   форму связей не пишется. *@
                <a class="btn ghost" href="/справочник-гсм-связи">Связи марок</a>
                <button class="btn ghost" @onclick="RefreshAsync" disabled="@loading">Обновить</button>
            </div>
        </div>
        <div class="panelBody">
            @* Фильтры: подстроковый поиск, сортировка, признаки-переключатели и
               селекты значений, которые реально есть в справочнике. Поля удалённых
               марок здесь намеренно нет — см. примечание к таблице ниже. *@
            <div class="mbFilters gsmFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged"
                       placeholder="Поиск: наименование, НД, группа, индекс НАТО..." />
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged"
                        aria-label="Сортировка списка марок">
                    <option value="Name">Сортировка: марка</option>
                    <option value="Group">Сортировка: группа</option>
                    <option value="Nd">Сортировка: НД</option>
                    <option value="NatoIndex">Сортировка: индекс НАТО</option>
                </select>
                <select class="field-select" @bind="onlyUnclassified" @bind:after="OnFiltersChanged"
                        aria-label="Отбор по наличию классификации">
                    <option value="0">Все марки</option>
                    <option value="1">Без классификации (вкл. черновики)</option>
                </select>
                <select class="field-select" @bind="groupFilter" @bind:after="OnFiltersChanged"
                        aria-label="Фильтр по группе ГСМ">
                    <option value="">Группа: любая</option>
                    @foreach (var g in filterOptions.GroupNames)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
                <select class="field-select" @bind="subgroupFilter" @bind:after="OnFiltersChanged"
                        aria-label="Фильтр по подгруппе ГСМ">
                    <option value="">Подгруппа: любая</option>
                    @foreach (var sg in filterOptions.SubgroupNames)
                    {
                        <option value="@sg">@sg</option>
                    }
                </select>
                <select class="field-select" @bind="natoFilter" @bind:after="OnFiltersChanged"
                        aria-label="Фильтр по индексу НАТО">
                    <option value="">Индекс НАТО: любой</option>
                    @foreach (var n in filterOptions.NatoIndexes)
                    {
                        <option value="@n">@n</option>
                    }
                </select>
                @* Переключатели — тот же паттерн, что «Только мои» в Реестре ХК:
                   класс active даёт акцентную рамку и заливку, галочка в круге
                   дублирует состояние для скринридеров. *@
                <div class="gsmFilterToggles" role="group" aria-label="Быстрые фильтры марок">
                    <button type="button"
                            class="filterToggle @(inGost == 1 ? "active" : null)"
                            aria-pressed="@(inGost == 1)"
                            @onclick="ToggleInGost">
                        <span class="filterToggleMark">@(inGost == 1 ? "✓" : "")</span>
                        Номенклатура по ГОСТ
                    </button>
                    <button type="button"
                            class="filterToggle @(suitabilityAny == 1 ? "active" : null)"
                            aria-pressed="@(suitabilityAny == 1)"
                            @onclick="ToggleSuitabilityAny">
                        <span class="filterToggleMark">@(suitabilityAny == 1 ? "✓" : "")</span>
                        С пригодностью
                    </button>
                </div>
                <button class="btn ghost gsmSortBtn" @onclick="ToggleSortDir">
                    @(sortDesc ? "По убыванию" : "По возрастанию")
                </button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost gsmSortBtn" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!items.Any())
            {
                <div class="empty-state">Марок не найдено</div>
            }
            else
            {
                <div class="tableWrap" data-scroll="contained" style="--table-max-height: 60vh;">
                    <table class="gsmTable">
                        <thead>
                            <tr>
                                <th>Группа ГСМ</th>
                                <th>Подгруппы ГСМ</th>
                                <th>Марка ГСМ</th>
                                <th>НД</th>
                                <th>Номенклатура по ГОСТ</th>
                                <th>Назначение и условия применения</th>
                                <th>Пригодность</th>
                                <th>Индекс НАТО</th>
                                <th>Дублирующие</th>
                                <th>Резервные</th>
                                <th>Зарубежные</th>
                                <th>Общее примечание</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in items)
                            {
                                var rowClickable = canEdit && !m.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")"
                                    @ondblclick="() => OnRowDblClick(m)" @onkeydown="(ev) => OnRowKeyDown(ev, m)">
                                    <td>
                                        @if (m.GroupName is null)
                                        {
                                            <span class="tag warn">Без классификации</span>
                                        }
                                        else
                                        {
                                            @m.GroupName
                                        }
                                    </td>
                                    <td class="gsmSubgroups">
                                        @if (m.SubgroupNames.Count == 0)
                                        {
                                            <span class="gsmMuted">—</span>
                                        }
                                        else
                                        {
                                            @string.Join("; ", m.SubgroupNames)
                                        }
                                    </td>
                                    <td>
                                        @m.Name
                                        @if (m.IsDeleted)
                                        {
                                            <span class="tag bad">Удалена</span>
                                        }
                                        @if (m.IsDraft)
                                        {
                                            <span class="tag warn">Черновик</span>
                                        }
                                    </td>
                                    <td class="gsmWrap">@(m.Nd ?? "—")</td>
                                    <td>
                                        @if (m.InGostNomenclature)
                                        {
                                            <span class="tag ok">Да</span>
                                        }
                                        else
                                        {
                                            <span class="tag">Нет</span>
                                        }
                                    </td>
                                    <td class="gsmWrap">@(m.IntendedUse ?? "—")</td>
                                    <td class="gsmWrap">@SuitabilityText(m)</td>
                                    <td class="mono">@(m.NatoIndex ?? "—")</td>
                                    <td>@RelationCell(m.DuplicateNames, m.Id)</td>
                                    <td>@RelationCell(m.ReserveNames, m.Id)</td>
                                    <td>@RelationCell(m.ForeignNames, m.Id)</td>
                                    <td class="gsmWrap">
                                        @* Длинное примечание показывается свёрнутым, полный
                                           текст доступен по раскрытию: иначе одна строка
                                           превращается в огромный пустой блок. *@
                                        @if (IsLongNote(m.Note))
                                        {
                                            <div class="@(expandedNotes.Contains(m.Id) ? "gsmClamp gsmClampOpen" : "gsmClamp")">
                                                @m.Note
                                            </div>
                                            <button type="button" class="gsmNoteToggle"
                                                    aria-expanded="@(expandedNotes.Contains(m.Id) ? "true" : "false")"
                                                    @onclick="() => ToggleNote(m.Id)">
                                                @(expandedNotes.Contains(m.Id) ? "Свернуть" : "Показать полностью")
                                            </button>
                                        }
                                        else
                                        {
                                            @(m.Note ?? "—")
                                        }
                                    </td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (m.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreGsm(m.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditGsm(m)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteGsm(m.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд</button>
                    </div>
                    <div class="mono">Показано @items.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>

</div>

@code {
    private List<GsmMaterialSummary> items = new();
    private GsmMaterialWriteRequest form = new();
    private List<string> formSubgroups = new();
    private string subgroupInput = "";
    private Guid formId;
    private bool editing = false;
    private bool loading = true;
    private bool saving;
    private bool canEdit;
    private string? errorMessage;
    private string? groupError;
    private string? subgroupError;
    private string? nameError;
    private string search = "";
    private string sortBy = "Name";
    private bool sortDesc = false;
    private int onlyUnclassified = 0;
    private int inGost = 0;
    private int suitabilityAny = 0;
    private string groupFilter = "";
    private string subgroupFilter = "";
    private string natoFilter = "";
    private GsmFilterOptions filterOptions = new();
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search)
        || onlyUnclassified != 0
        || inGost != 0
        || suitabilityAny != 0
        || !string.IsNullOrWhiteSpace(groupFilter)
        || !string.IsNullOrWhiteSpace(subgroupFilter)
        || !string.IsNullOrWhiteSpace(natoFilter);

    private async Task ToggleInGost()
    {
        inGost = inGost == 1 ? 0 : 1;
        await OnFiltersChanged();
    }

    private async Task ToggleSuitabilityAny()
    {
        suitabilityAny = suitabilityAny == 1 ? 0 : 1;
        await OnFiltersChanged();
    }

    /// <summary>Примечание длиннее порога показывается свёрнутым с раскрытием.</summary>
    private const int NoteClampThreshold = 220;

    private static bool IsLongNote(string? note) =>
        note is not null && note.Length > NoteClampThreshold;

    private readonly HashSet<Guid> expandedNotes = new();

    private void ToggleNote(Guid id)
    {
        if (!expandedNotes.Add(id))
            expandedNotes.Remove(id);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await DbLock.LockedAsync(() => Perms.HasPermissionAsync(userId!, PermissionCodes.ReferenceEdit));
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm)
        {
            _focusForm = false;
            await _firstField.FocusAsync();
        }
    }

    private async Task OnFiltersChanged()
    {
        currentPage = 1;
        await ReloadAsync();
    }

    /// <summary>
    /// Перечитывает список вместе с read-only колонками связей. Нужен после
    /// изменений во втором справочнике: связи здесь только отображаются.
    /// </summary>
    private async Task RefreshAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        // Поля фильтра удалённых марок в UI больше нет (по требованию), поэтому
        // список показывает только действующие записи: ShowDeleted = false.
        // Удалённые марки по-прежнему доступны для просмотра и восстановления
        // только через прямые ссылки/API — см. примечание в отчёте.
        const bool showDeleted = false;

        loading = true;
        try
        {
            await using (await DbLock.WaitAsync(ct))
            {
                var result = await GsmService.GetPagedAsync(new GsmMaterialQuery
                {
                    Page = currentPage,
                    PageSize = 50,
                    Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                    ShowDeleted = showDeleted,
                    SortBy = sortBy,
                    SortDescending = sortDesc,
                    OnlyUnclassified = onlyUnclassified == 1 ? true : null,
                    InGostNomenclature = inGost == 1 ? true : null,
                    SuitabilityAny = suitabilityAny == 1 ? true : null,
                    GroupName = string.IsNullOrWhiteSpace(groupFilter) ? null : groupFilter.Trim(),
                    SubgroupName = string.IsNullOrWhiteSpace(subgroupFilter) ? null : subgroupFilter.Trim(),
                    NatoIndex = string.IsNullOrWhiteSpace(natoFilter) ? null : natoFilter.Trim(),
                }, ct);

                // Значения для селектов берём из справочника: фильтр предлагает
                // только реально существующие значения.
                filterOptions = await GsmService.GetFilterOptionsAsync(ct);

                if (ct.IsCancellationRequested)
                    return;

                items = result.Items.ToList();
                totalCount = result.TotalCount;
                totalPages = result.TotalPages;
                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                    await ReloadAsync();
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        finally
        {
            if (!ct.IsCancellationRequested)
                loading = false;
        }
    }

    // ── Форма ──────────────────────────────────────────────────────────────

    private void OnSubgroupKeyDown(KeyboardEventArgs ev)
    {
        if (ev.Key != "Enter") return;
        AddSubgroup();
    }

    private void AddSubgroup()
    {
        var value = subgroupInput?.Trim();
        if (string.IsNullOrWhiteSpace(value)) return;
        if (!formSubgroups.Any(s => string.Equals(s, value, StringComparison.OrdinalIgnoreCase)))
            formSubgroups.Add(value);
        subgroupInput = "";
        errorMessage = null;
    }

    private void RemoveSubgroup(string value) =>
        formSubgroups.RemoveAll(s => string.Equals(s, value, StringComparison.OrdinalIgnoreCase));

    private void CollectSubgroups()
    {
        AddSubgroup();
        form.SubgroupNames = formSubgroups.ToList();
    }

    private async Task SaveGsmAsync()
    {
        errorMessage = null;
        groupError = null;
        subgroupError = null;
        nameError = null;
        CollectSubgroups();

        // Сообщения адресные: показываются под конкретным полем, а не общей
        // подсказкой в шапке панели.
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            nameError = "Укажите наименование марки ГСМ.";
            return;
        }

        // Правило совпадает с серверным (GsmMaterialService.NormalizeRequest и
        // CreateAsync/UpdateAsync), чтобы форма не отклоняла то, что сервер примет,
        // и наоборот:
        //   создание опубликованной марки — группа и минимум одна подгруппа;
        //   правка — если группа не задана и подгрупп нет, обычные поля править можно
        //     (правка изначально неклассифицированной legacy-марки, группу не выдумываем);
        //   если группа задана — нужна минимум одна подгруппа;
        //   если подгруппы есть без группы — ошибка группы.
        var hasGroup = !string.IsNullOrWhiteSpace(form.GroupName);
        var hasSubgroups = form.SubgroupNames.Count > 0;

        if (!editing && !hasGroup)
        {
            groupError = "Укажите группу ГСМ: новая марка публикуется с одной группой и минимум одной подгруппой.";
            return;
        }
        if (!editing && !hasSubgroups)
        {
            subgroupError = "Укажите минимум одну подгруппу ГСМ.";
            return;
        }
        if (hasGroup && !hasSubgroups)
        {
            subgroupError = "Укажите минимум одну подгруппу ГСМ.";
            return;
        }
        if (!hasGroup && hasSubgroups)
        {
            groupError = "Подгруппы указаны без группы. Укажите группу или уберите подгруппы.";
            return;
        }

        saving = true;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                if (editing)
                    await GsmService.UpdateAsync(formId, form);
                else
                    await GsmService.CreateAsync(form);
            }
            ResetForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            // Сообщения сервиса адресны: привязываем к полю, если понимаем, о чём речь.
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось сохранить марку. Обновите список и повторите попытку."
                : "Не удалось создать марку. Обновите список и повторите попытку.";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task EditGsm(GsmMaterialSummary m)
    {
        errorMessage = null;
        groupError = null;
        subgroupError = null;
        nameError = null;
        GsmMaterialEditView? view = null;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                view = await GsmService.GetEditViewAsync(m.Id);
            }
        }
        catch (Exception)
        {
            errorMessage = "Не удалось открыть карточку марки. Обновите список и повторите попытку.";
            return;
        }

        if (view == null)
        {
            errorMessage = "Марка не найдена. Обновите список.";
            return;
        }

        formId = view.Id;
        form = new GsmMaterialWriteRequest
        {
            Name = view.Name,
            Nd = view.Nd,
            InGostNomenclature = view.InGostNomenclature,
            IntendedUse = view.IntendedUse,
            SuitabilityGround = view.SuitabilityGround,
            SuitabilityAir = view.SuitabilityAir,
            SuitabilitySea = view.SuitabilitySea,
            NatoIndex = view.NatoIndex,
            Note = view.Note,
            GroupName = view.GroupName,
            SubgroupNames = view.SubgroupNames.ToList(),
        };
        formSubgroups = view.SubgroupNames.ToList();
        subgroupInput = "";
        editing = true;
        _focusForm = true;
    }

    private async Task OnRowDblClick(GsmMaterialSummary m)
    {
        if (!canEdit || m.IsDeleted) return;
        await EditGsm(m);
    }

    private async Task OnRowKeyDown(KeyboardEventArgs ev, GsmMaterialSummary m)
    {
        if (!canEdit || m.IsDeleted || ev.Key != "Enter") return;
        await EditGsm(m);
    }

    private async Task DeleteGsm(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await DbLock.LockedAsync(() => GsmService.DeleteAsync(id));
            if (!ok) errorMessage = "Не удалось удалить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task RestoreGsm(Guid id)
    {
        errorMessage = null;
        try
        {
            var ok = await DbLock.LockedAsync(() => GsmService.RestoreAsync(id));
            if (!ok) errorMessage = "Не удалось восстановить запись. Обновите список и повторите попытку.";
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    /// <summary>Выход из редактирования без записи в БД: форма очищается,
    /// сохранённые значения марки не меняются.</summary>
    private void ResetForm()
    {
        form = new GsmMaterialWriteRequest();
        formSubgroups = new List<string>();
        subgroupInput = "";
        formId = Guid.Empty;
        editing = false;
        errorMessage = null;
        groupError = null;
        subgroupError = null;
        nameError = null;
    }

    private async Task ToggleSortDir()
    {
        sortDesc = !sortDesc;
        await ReloadAsync();
    }

    private async Task ResetFilters()
    {
        search = "";
        onlyUnclassified = 0;
        inGost = 0;
        suitabilityAny = 0;
        groupFilter = "";
        subgroupFilter = "";
        natoFilter = "";
        currentPage = 1;
        await ReloadAsync();
    }

    private async Task PrevPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await ReloadAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await ReloadAsync();
    }

    // ── Ячейки ─────────────────────────────────────────────────────────────

    private static string SuitabilityText(GsmMaterialSummary m)
    {
        var parts = new List<string>();
        if (m.SuitabilityGround) parts.Add("наземная");
        if (m.SuitabilityAir) parts.Add("авиационная");
        if (m.SuitabilitySea) parts.Add("морская");
        return parts.Count == 0 ? "—" : string.Join(" / ", parts);
    }

    /// <summary>
    /// Связи показываются только для чтения. Длинный список сворачивается в
    /// счётчик с раскрытием — редактирования связи из первого справочника нет.
    /// </summary>
    private RenderFragment RelationCell(IReadOnlyList<string> names, Guid rowId) => builder =>
    {
        if (names.Count == 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "gsmMuted");
            builder.AddContent(2, "—");
            builder.CloseElement();
            return;
        }

        const int limit = 2;
        var expanded = expandedRelations.Contains(rowId);

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "gsmRelations");

        if (expanded || names.Count <= limit)
        {
            builder.OpenElement(2, "div");
            foreach (var n in names)
            {
                builder.OpenElement(3, "div");
                builder.AddContent(4, n);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(2, "div");
            builder.AddContent(3, string.Join("; ", names.Take(limit)));
            builder.CloseElement();
        }

        if (names.Count > limit)
        {
            builder.OpenElement(2, "button");
            builder.AddAttribute(3, "type", "button");
            builder.AddAttribute(4, "class", "linkBtn");
            builder.AddAttribute(5, "onclick",
                EventCallback.Factory.Create(this, () => ToggleRelations(rowId)));
            builder.AddContent(6, expanded ? "Свернуть" : $"Ещё {names.Count - limit}");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private readonly HashSet<Guid> expandedRelations = new();

    private void ToggleRelations(Guid id)
    {
        if (!expandedRelations.Add(id))
            expandedRelations.Remove(id);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
