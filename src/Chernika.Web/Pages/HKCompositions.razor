@page "/составы-хк"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Structure
@using Chernika.Infrastructure.Services
@using Chernika.Web.Components
@using Chernika.Web.Services
@inject HKCardRevisionService Revisions
@inject CircuitDbLock DbLock
@inject NavigationManager Nav
@inject IPermissionService Perms
@implements IDisposable

<div class="stack hkCompositionsRegistry">
    <section class="panel">
        <div class="panelHeader">
            <h2>Составы ХК</h2>
            <div class="hint">Только принятые редакции</div>
        </div>
        <div class="panelBody">
            <div class="hkCompositionsFilters">
                <div class="field hkCompositionsSearch">
                    <label for="hkCompositionsSearch">Поиск по номеру или названию ХК</label>
                    <input id="hkCompositionsSearch" value="@_search" @oninput="OnSearchInput"
                           placeholder="Например: ХК-2026 или Агрегат" class="field-input" />
                </div>
                @if (_canSeeBranches)
                {
                    <div class="field">
                        <label for="hkCompositionsBranch">Филиал</label>
                        <select id="hkCompositionsBranch" value="@(_branchId?.ToString() ?? "")"
                                @onchange="OnBranchChanged" class="field-select">
                            <option value="">Все доступные</option>
                            @foreach (var b in _branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @if (_loading)
            {
                <div class="loading-state">Загрузка реестра составов…</div>
            }
            else if (_error is not null)
            {
                <div class="error">@_error</div>
            }
            else if (_items.Count == 0)
            {
                <div class="note">
                    @if (string.IsNullOrWhiteSpace(_search))
                    {
                        <text>Карт с принятыми редакциями нет.</text>
                    }
                    else
                    {
                        <text>По запросу «@_search» карт с принятыми редакциями не найдено.</text>
                    }
                </div>
            }
            else
            {
                <div class="tableWrap">
                    <table class="table hkCompositionsTable">
                        <thead>
                            <tr>
                                <th>Уровень</th>
                                <th>№ ХК</th>
                                <th>Название</th>
                                <th>Версия / редакция</th>
                                <th>Дата принятия</th>
                                <th>Масса ГСМ</th>
                                <th>Объём ГСМ</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr class="@(item.CardId == _expandedCardId ? "hkCompositionsRowExpanded" : null)"
                                    @key="item.CardId"
                                    @onclick="() => ToggleCard(item.CardId)">
                                    <td>@LevelTitle(item.Level)</td>
                                    <td class="mono">@item.Code</td>
                                    <td>@item.Name</td>
                                    <td>
                                        <span class="mono">@item.Version</span>
                                        <span class="tag ok">редакция №@item.RevisionNumber</span>
                                    </td>
                                    <td class="mono">@(item.AcceptedAtUtc is { } accepted ? AppTime.Fmt(accepted, "dd.MM.yyyy") : "не зафиксирована")</td>
                                    <td>@FormatQuantity(item.Totals, HKPhysicalQuantity.Mass)</td>
                                    <td>@FormatQuantity(item.Totals, HKPhysicalQuantity.Liquid)</td>
                                    <td>
                                        <button type="button" class="btn ghost btn-sm"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => ToggleCard(item.CardId)">
                                            @(item.CardId == _expandedCardId ? "Свернуть" : "Открыть состав")
                                        </button>
                                    </td>
                                </tr>
                                @if (item.CardId == _expandedCardId)
                                {
                                    <tr class="hkCompositionsExpandedRow">
                                        <td colspan="8">
                                            @* Состав выбранной карты раскрывается прямо
                                               в реестре: отдельная страница остаётся
                                               для работы с большой картой. *@
                                            <HKCompositionBlock CardId="item.CardId" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="hkCompositionsPager">
                    <span class="hint">
                        Показано @_items.Count из @_totalCount
                    </span>
                    <div class="hkCompositionsPagerButtons">
                        <button type="button" class="btn ghost" disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)">Назад</button>
                        <span class="mono">@_page</span>
                        <button type="button" class="btn ghost" disabled="@(_page * PageSize >= _totalCount)" @onclick="() => GoToPage(_page + 1)">Вперёд</button>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private const int PageSize = 25;

    /// <summary>
    /// Раскрытая карта. Задаётся deep-ссылкой ?карта={id}: по ней реестр
    /// открывается с уже раскрытым составом.
    /// </summary>
    [SupplyParameterFromQuery(Name = "карта")]
    public Guid? CardId { get; set; }

    private IReadOnlyList<HKAcceptedCompositionListItemDto> _items = Array.Empty<HKAcceptedCompositionListItemDto>();
    private List<(Guid Id, string Name)> _branches = new();
    private string _search = string.Empty;
    private Guid? _branchId;
    private int _page = 1;
    private int _totalCount;
    private bool _loading = true;
    private bool _canSeeBranches;
    private string? _error;
    private Guid? _expandedCardId;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        _canSeeBranches = await Perms.HasPermissionAsync(PermissionCodes.SystemConfig);
        _expandedCardId = CardId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        _loading = true;
        _error = null;

        try
        {
            await using (await DbLock.WaitAsync("HKCompositions: реестр принятых редакций"))
            {
                var result = await Revisions.GetAcceptedCompositionsAsync(
                    _search, _branchId, _page, PageSize, ct);

                _items = result.Items;
                _totalCount = result.TotalCount;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            _error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Раскрытие состава карты прямо в реестре. Раскрыта одна карта: иначе
    /// страница превращалась бы в несколько деревьев сразу.
    /// </summary>
    private void ToggleCard(Guid cardId)
    {
        _expandedCardId = _expandedCardId == cardId ? null : cardId;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        query.Remove("карта");
        if (_expandedCardId is { } expanded)
            query["карта"] = expanded.ToString();

        Nav.NavigateTo($"{uri.AbsolutePath}?{query}", replace: true, forceLoad: false);
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnBranchChanged(ChangeEventArgs args)
    {
        _branchId = Guid.TryParse(args.Value?.ToString(), out var branch) ? branch : null;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1)
            return;

        _page = page;
        await LoadAsync();
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    private static string LevelTitle(HKObjectLevel? level) => level switch
    {
        HKObjectLevel.Complex => "Комплекс",
        HKObjectLevel.EquipmentModel => "Изделие",
        HKObjectLevel.Aggregate => "Агрегат",
        HKObjectLevel.Node => "Узел",
        _ => "—"
    };

    private static string FormatQuantity(IReadOnlyList<HKMeasuredTotal> totals, HKPhysicalQuantity quantity)
    {
        var total = totals.FirstOrDefault(t => t.Quantity == quantity);
        return total is null ? "—" : HKTotalFormatter.Format(total);
    }
}
