@page "/журнал-аудита"
@attribute [Authorize(Policy = "ViewAuditLog")]
@using Chernika.Domain
@using Chernika.Infrastructure.Dtos
@inject AuditService AuditService
@inject NavigationManager Nav

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Журнал событий</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="form" style="grid-template-columns:1fr 1fr 1fr auto">
                <div class="field"><label>Тип сущности</label>
                    <select @bind="filterEntityType" class="field-select">
                        <option value="">Все</option>
                        <option value="HKCard">Химмотологическая карта</option>
                        <option value="Complex">Комплекс</option>
                        <option value="Aggregate">Узел</option>
                        <option value="EquipmentModel">Изделие</option>
                        <option value="EquipmentInstance">Экземпляр техники</option>
                        <option value="IndividualCard">Индивидуальная карта</option>
                        <option value="GsmMaterial">Марка ГСМ</option>
                        <option value="AssemblyUnit">Сборочная единица</option>
                        <option value="Branch">Филиал</option>
                        <option value="Coefficient">Коэффициент</option>
                        <option value="CoefficientType">Тип коэффициента</option>
                        <option value="WorkTask">Задача</option>
                        <option value="User">Пользователь</option>
                        <option value="UserPermissionOverride">Индивидуальное полномочие</option>
                        <option value="SecurityRepair">Конфигурация безопасности</option>
                        <option value="ProductComposition">Состав изделия</option>
                        <option value="AggregateComposition">Состав узла</option>
                        <option value="ComplexComposition">Состав комплекса</option>
                    </select>
                </div>
                <div class="field"><label>Действие</label>
                    <select @bind="filterAction" class="field-select">
                        <option value="">Все действия</option>
                        <option value="Create">Создание</option>
                        <option value="Update">Изменение</option>
                        <option value="Delete">Удаление</option>
                        <option value="StatusChange">Изменение статуса</option>
                        <option value="UserManagement">Управление пользователями</option>
                        <option value="PermissionOverride">Индивидуальные полномочия</option>
                        <option value="Security">Конфигурация безопасности</option>
                    </select>
                </div>
                <div class="field"><label>Период</label>
                    <select @bind="filterPeriod" class="field-select">
                        <option value="7">Последние 7 дней</option>
                        <option value="30">Последние 30 дней</option>
                        <option value="90">Последние 90 дней</option>
                        <option value="0">Все время</option>
                    </select>
                </div>
                <div class="field" style="display:flex;align-items:flex-end">
                    <button class="btn" @onclick="ApplyFilters">Применить</button>
                </div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panelHeader">
            <h2>Записи журнала</h2>
            <div class="hint">Страница @currentPage из @totalPages</div>
        </div>
        <div class="panelBody">
            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!logs.Any())
            {
                <div class="empty-state">Нет записей</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Действие</th>
                            <th>Сущность</th>
                            <th>Объект</th>
                            <th>Детали</th>
                            <th>Пользователь</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in logs)
                        {
                            <tr>
                                <td class="mono">@log.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="auditAction auditAction--@GetSeverityClass(log.ActionSeverity)">@log.ActionDisplay</span></td>
                                <td><span class="tag">@log.EntityTypeDisplay</span></td>
                                <td>
                                    <div class="auditObjectName">@log.EntityDisplayName</div>
                                    @if (log.IsEntitySnapshotMissing)
                                    {
                                        <div class="auditLegacyHint">Историческое имя объекта отсутствует</div>
                                    }
                                </td>
                                <td>
                                    @if (log.DetailsDisplay != "—")
                                    {
                                        <button type="button" class="linkBtn" @onclick="() => OpenDetails(log)">
                                            @(log.DetailsDisplay.Length > 60 ? log.DetailsDisplay[..60] + "…" : log.DetailsDisplay)
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="auditActorName">@log.ActorFullName</div>
                                    @if (!string.IsNullOrWhiteSpace(log.ActorLogin) && log.ActorLogin != "system")
                                    {
                                        <div class="auditActorLogin">@log.ActorLogin</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">← Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд →</button>
                    </div>
                    <div class="mono">Показано @logs.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@if (showDetails && selectedLog != null)
{
    <div class="modalOverlay" @onclick="CloseDetails">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:560px">
            <div class="modalHeader">
                <h3>Детали события</h3>
                <button type="button" class="modalCloseButton"
                        @onclick="CloseDetails"
                        aria-label="Закрыть"
                        title="Закрыть">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modalBody">
                <div class="form" style="grid-template-columns:1fr;gap:12px">
                    <div class="field">
                        <label>Дата</label>
                        <div>@selectedLog.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</div>
                    </div>
                    <div class="field">
                        <label>Действие</label>
                        <div><span class="auditAction auditAction--@GetSeverityClass(selectedLog.ActionSeverity)">@selectedLog.ActionDisplay</span></div>
                    </div>
                    <div class="field">
                        <label>Сущность</label>
                        <div>@selectedLog.EntityTypeDisplay</div>
                    </div>
                    <div class="field">
                        <label>Объект</label>
                        <div>@selectedLog.EntityDisplayName</div>
                        <code style="font-size:11px;color:var(--muted)">@selectedLog.EntityId</code>
                    </div>
                    <div class="field">
                        <label>Детали</label>
                        <div style="white-space:pre-wrap;font-size:13px">@selectedLog.DetailsDisplay</div>
                    </div>
                    <div class="field">
                        <label>Пользователь</label>
                        <div>@selectedLog.ActorFullName</div>
                        @if (!string.IsNullOrWhiteSpace(selectedLog.ActorLogin))
                        {
                            <code style="font-size:11px;color:var(--muted)">@selectedLog.ActorLogin</code>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AuditLogDisplayDto> logs = new();
    private bool loading = true;
    private int totalCount = 0;
    private int currentPage = 1;
    private int totalPages = 1;
    private const int PageSize = 50;

    private string filterEntityType = "";
    private string filterAction = "";
    private string filterPeriod = "7";

    private bool showDetails = false;
    private AuditLogDisplayDto? selectedLog;

    protected override async Task OnInitializedAsync() => await LoadLogs();

    static string GetSeverityClass(AuditSeverity severity) => severity switch
    {
        AuditSeverity.Success => "success",
        AuditSeverity.Warning => "warning",
        AuditSeverity.Danger => "danger",
        _ => "neutral"
    };

    async Task LoadLogs()
    {
        loading = true;
        logs = await AuditService.GetLogsWithEntityNamesAsync(currentPage, PageSize, filterEntityType, filterAction, filterPeriod);
        totalCount = await AuditService.GetTotalCountAsync(filterEntityType, filterAction, filterPeriod);
        totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
        loading = false;
    }

    async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadLogs();
    }

    async Task PrevPage() { if (currentPage > 1) { currentPage--; await LoadLogs(); } }
    async Task NextPage() { if (currentPage < totalPages) { currentPage++; await LoadLogs(); } }

    void OpenDetails(AuditLogDisplayDto log)
    {
        selectedLog = log;
        showDetails = true;
    }

    void CloseDetails()
    {
        showDetails = false;
        selectedLog = null;
    }
}
