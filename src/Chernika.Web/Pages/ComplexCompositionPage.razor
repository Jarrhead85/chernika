@page "/состав-комплекса"
@attribute [Authorize(Policy = "ViewHK")]
@using Chernika.Domain
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Web.Components
@using Chernika.Web.Services
@inject EquipmentService EquipService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock
@implements IDisposable

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Конструктивный состав комплекса</h2>
            <div class="hint">Комплекс → модели техники → количество</div>
        </div>
        <div class="panelBody">
            <div class="form">
                <div class="field"><label>Комплекс</label>
                    <select value="@(selectedComplexId == Guid.Empty ? "" : selectedComplexId.ToString())"
                            @onchange="OnComplexChanged" class="field-select">
                        <option value="" disabled hidden>Выберите комплекс</option>
                        @foreach (var c in complexes)
                        {
                            <option value="@c.Id">@c.Code — @c.Name</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Комментарий</label><input @bind="comment" /></div>
                <div class="formActions">
                    @if (canCreate) { <button class="btn primary" disabled="@(selectedComplexId == Guid.Empty)" @onclick="CreateComposition">Создать черновик</button> }
                </div>
            </div>
        </div>
    </section>

    <div class="grid">
        <div class="stack">
            <section class="panel">
                <div class="panelHeader">
                    <h2>Реестр составов комплекса</h2>
                    <div class="hint">@compositions.Count записей</div>
                </div>
                <div class="panelBody">
                    @if (loading)
                    {
                        <div class="loading-state">Загрузка...</div>
                    }
                    else if (!compositions.Any())
                    {
                        <div class="empty-state">@EmptyStateText</div>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Версия</th>
                                    <th>Статус</th>
                                    <th>Дата создания</th>
                                    <th>Моделей</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var comp in compositions)
                                {
                                    <tr class="compositionRow--clickable" @onclick="() => SelectCompositionAsync(comp.Id)">
                                        <td class="mono">@comp.Version</td>
                                        <td><CompositionStatusBadge Status="@comp.Status" /></td>
                                        <td class="mono">@comp.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>@(comp.ItemCount ?? 0)</td>
                                        <td>
                                            <div class="rowActions">
                                                <button class="linkBtn" @onclick="() => SelectCompositionAsync(comp.Id)">Открыть</button>
                                                @if (CanEditComposition(comp.Status))
                                                {
                                                    <button class="linkBtn" @onclick="() => DeleteComposition(comp.Id)">Удалить</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            @if (selectedComposition != null)
            {
                <section class="panel compositionSelectedPanel">
                    <div class="panelHeader compositionHeader">
                        <div>
                            <div class="compositionType">Состав комплекса</div>
                            <h2>@selectedComposition.Complex?.Code · @selectedComposition.Complex?.Name</h2>
                            <div class="compositionVersionLine">
                                <span class="mono">Версия @selectedComposition.Version</span>
                                <CompositionStatusBadge Status="@selectedComposition.Status" />
                            </div>
                        </div>
                        <div class="compositionHeaderActions">
                            @if (CanEditSelectedDraft)
                            {
                                <button class="btn primary" @onclick="SaveCompositionDraft">Сохранить</button>
                            }
                            @if (selectedComposition.Status == ProductCompositionStatus.Draft)
                            {
                                @if (canSubmit)
                                {
                                    <button class="btn" @onclick="SubmitForReview">Отправить на согласование</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.OnReview)
                            {
                                @if (canApprove)
                                {
                                    <button class="btn primary" @onclick="ApproveComposition">Утвердить</button>
                                }
                                @if (canReturn)
                                {
                                    <button class="btn" @onclick="ReturnToDraft">Вернуть на доработку</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.Approved)
                            {
                                @if (canApprove)
                                {
                                    <button class="btn" @onclick="ArchiveComposition">Архивировать</button>
                                }
                                @if (canCreateVersion)
                                {
                                    <button class="btn primary" @onclick="CreateNewVersion">Создать новую версию</button>
                                }
                            }
                            else if (selectedComposition.Status == ProductCompositionStatus.Archived && canCreateVersion)
                            {
                                <button class="btn primary" @onclick="CreateNewVersion">Создать новую версию</button>
                            }
                            <a class="btn ghost" href="/составы/комплексы/@selectedComposition.ComplexId/версии/@selectedComposition.Id">Открыть версию</a>
                        </div>
                    </div>
                    <div class="panelBody">
                        <CompositionReadinessCard Level="HKObjectLevel.Complex" ObjectId="selectedComposition.ComplexId" />

                        @if (selectedComposition.Status != ProductCompositionStatus.Draft || !canEditDraft)
                        {
                            <div class="compositionReadOnlyBanner @ReadOnlyBannerClass">
                                @ReadOnlyBannerText
                            </div>
                        }
                        @if (selectedComposition.Status == ProductCompositionStatus.OnReview)
                        {
                            <div class="field compositionReviewComment">
                                <label>Комментарий к решению</label>
                                <input @bind="reviewComment" class="field-input" placeholder="Необязательно" />
                            </div>
                        }

                        @if (CanEditSelectedDraft)
                        {
                            <div class="icSectionPanel icCompositionRequisites">                                <h3 class="hkc-subtitle">Реквизиты состава</h3>
                                <div class="field field-full">
                                    <label>Комментарий</label>
                                    <input @bind="editComment" class="field-input" />
                                </div>
                                <div class="icDateGrid">
                                    <div class="field"><label>Дата начала действия</label><input type="date" @bind="editEffectiveDate" @bind:format="yyyy-MM-dd" class="field-input" /></div>
                                    <div class="field"><label>Дата окончания действия</label><input type="date" @bind="editExpirationDate" @bind:format="yyyy-MM-dd" class="field-input" /></div>
                                </div>
                            </div>

                            <div class="form compositionFormRow icAddRow">
                                <div class="field"><label>Модель техники</label>
                                    <select @bind="newModelId" class="field-select">
                                        <option value="" disabled hidden>Выберите изделие</option>
                                        @foreach (var m in models)
                                        {
                                            <option value="@m.Id">@m.Index — @m.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Количество</label><input type="number" @bind="newModelQty" min="1" class="field-input" /></div>
                                <div class="field compositionFormAction">
                                    <button class="btn primary" @onclick="AddItem">Добавить</button>
                                </div>
                            </div>
                        }

                        <div class="icSectionPanel">
                            <h3 class="hkc-subtitle">Состав комплекса · @selectedComposition.Items.Count моделей</h3>
                            <div class="field">
                                <input class="field-input" placeholder="Поиск по коду или наименованию…"
                                       value="@itemFilter" @oninput="OnItemFilterChanged" />
                            </div>

                        @if (!FilteredItems.Any())
                        {
                            <div class="empty-state">Нет моделей. Добавьте модель в состав комплекса.</div>
                        }
                        else
                        {
                            <div class="tableWrap">
                                <table class="hk-items-table">
                                    <thead>
                                        <tr><th>Код изделия</th><th>Наименование</th><th class="num">Количество</th><th>Примечание</th>@if (ShowRowActions) { <th>Действия</th> }</tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in FilteredItems)
                                        {
                                            <tr>
                                                <td class="mono">@item.EquipmentModel?.Index</td>
                                                <td>@item.EquipmentModel?.Name</td>
                                                <td class="num">
                                                    @if (editingItemId == item.Id && CanEditSelectedDraft)
                                                    {
                                                        <input type="number" @bind="editItemQty" class="field-input compositionQtyInput" min="1" />
                                                        <button class="linkBtn" @onclick="() => SaveItemQuantity(item.Id)">✓</button>
                                                        <button class="linkBtn" @onclick="() => CancelEditItem()">✕</button>
                                                    }
                                                    else
                                                    {
                                                        <span>@item.Quantity</span>
                                                    }
                                                </td>
                                                <td>@item.Notes</td>
                                                @if (ShowRowActions)
                                                {
                                                    <td>
                                                        <div class="rowActions">
                                                            <button class="linkBtn" @onclick="() => StartEditItemQty(item.Id, item.Quantity)">Изменить кол-во</button>
                                                            <button class="linkBtn" @onclick="() => RemoveItem(item.Id)">Удалить</button>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        </div>
                    </div>
                </section>
            }
        </div>

        <aside class="stack compositionSidebar">
            <section class="panel">
                <div class="panelHeader"><h2>Сводка</h2><div class="hint">Детали версии</div></div>
                <div class="panelBody">
                    @if (selectedComposition == null)
                    {
                        <div class="empty-state">—</div>
                    }
                    else
                    {
                        <div class="field"><label>Статус</label><CompositionStatusBadge Status="@selectedComposition.Status" /></div>
                        <div class="field"><label>Версия</label><div class="mono">@selectedComposition.Version</div></div>
                        <div class="field"><label>Автор</label><div>@(selectedComposition.AuthorName ?? "—")</div></div>
                        <div class="field"><label>Создан</label><div class="mono">@selectedComposition.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        <div class="field"><label>Обновлён</label><div class="mono">@selectedComposition.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</div></div>
                        @if (selectedComposition.ApprovedAt.HasValue)
                        {
                            <div class="field"><label>Утверждён</label><div class="mono">@selectedComposition.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</div></div>
                        }
                        @if (selectedComposition.EffectiveDate.HasValue)
                        {
                            <div class="field"><label>Действует с</label><div class="mono">@selectedComposition.EffectiveDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (selectedComposition.ExpirationDate.HasValue)
                        {
                            <div class="field"><label>Действует до</label><div class="mono">@selectedComposition.ExpirationDate.Value.ToString("dd.MM.yyyy")</div></div>
                        }
                        @if (!string.IsNullOrEmpty(selectedComposition.Comment))
                        {
                            <div class="field"><label>Комментарий</label><div>@selectedComposition.Comment</div></div>
                        }
                        <div class="compositionSidebarActions">
                            <a class="btn ghost" href="/журнал-аудита?entity=ComplexComposition&id=@(selectedComposition.Id)">Журнал аудита</a>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "complexId")] public Guid? ComplexIdQuery { get; set; }

    private List<Complex> complexes = new();
    private List<EquipmentModel> models = new();
    private List<CompositionVersionSummary> compositions = new();
    private ComplexCompositionReadModel? selectedComposition;
    private bool loading = true;
    private bool canCreate;
    private bool canEditDraft;
    private bool canSubmit;
    private bool canApprove;
    private bool canReturn;
    private bool canCreateVersion;
    private bool CanEditSelectedDraft => selectedComposition?.Status == ProductCompositionStatus.Draft && canEditDraft;
    private bool ShowRowActions => CanEditSelectedDraft;

    private string itemFilter = "";

    private void OnItemFilterChanged(ChangeEventArgs args) =>
        itemFilter = args.Value?.ToString() ?? string.Empty;

    private IEnumerable<ComplexCompositionItemReadModel> FilteredItems
    {
        get
        {
            var items = selectedComposition?.Items.OrderBy(i => i.SortOrder)
                ?? Enumerable.Empty<ComplexCompositionItemReadModel>();
            if (string.IsNullOrWhiteSpace(itemFilter))
                return items;
            var term = itemFilter.Trim();
            return items.Where(i =>
                (i.EquipmentModel?.Index ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (i.EquipmentModel?.Name ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }
    private CancellationTokenSource? _loadCts;

    private Guid selectedComplexId;
    private string comment = "";

    private Guid newModelId;
    private int newModelQty = 1;

    private string editComment = "";
    private DateTime? editEffectiveDate;
    private DateTime? editExpirationDate;
    private string reviewComment = "";

    private Guid? editingItemId;
    private int editItemQty;

    private bool HasEmptyState => selectedComplexId != Guid.Empty && !compositions.Any();

    [Inject] private TimeProvider TimeProvider { get; set; } = null!;
    private DateTime _now => TimeProvider.GetUtcNow().UtcDateTime;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canCreate = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexCreate);
        canEditDraft = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexEditDraft);
        canSubmit = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexSubmit);
        canApprove = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexApprove);
        canReturn = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexReturnForRevision);
        canCreateVersion = await Perms.HasPermissionAsync(userId!, PermissionCodes.CompositionComplexCreateVersion);
        _loadCts = new CancellationTokenSource();
        await LoadData();
        if (ComplexIdQuery.HasValue && ComplexIdQuery.Value != Guid.Empty)
        {
            selectedComplexId = ComplexIdQuery.Value;
            await LoadCompositions();
        }
    }

    private async Task LoadData()
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            loading = true;
            complexes = await EquipService.GetComplexesAsync();
            models = await EquipService.GetModelsAsync();
        }
        if (selectedComplexId != Guid.Empty)
            await LoadCompositions();
        else
            loading = false;
    }

    /// <summary>Выбор комплекса сразу загружает его составы (без кнопки обновления).</summary>
    private async Task OnComplexChanged(ChangeEventArgs args)
    {
        selectedComplexId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
        await LoadCompositions();
    }

    async Task LoadCompositions()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        loading = true;
        try
        {
            await using (await DbLock.WaitAsync(ct))
            {
                var result = selectedComplexId != Guid.Empty
                    ? (await EquipService.GetComplexCompositionSummariesAsync(selectedComplexId, ct)).ToList()
                    : new List<CompositionVersionSummary>();
                if (ct.IsCancellationRequested)
                    return;
                compositions = result;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            loading = false;
        }
    }

    async Task CreateComposition()
    {
        if (selectedComplexId == Guid.Empty) return;
        var comp = await EquipService.CreateComplexCompositionAsync(
            new CreateComplexCompositionRequest(selectedComplexId, string.IsNullOrWhiteSpace(comment) ? null : comment));
        await LoadCompositions();
        await SelectCompositionAsync(comp.Id);
    }

    async Task SelectCompositionAsync(Guid id)
    {
        var ct = _loadCts?.Token ?? default;
        await using (await DbLock.WaitAsync(ct))
        {
            selectedComposition = await EquipService.GetComplexCompositionDetailAsync(id, ct);
        }

        if (selectedComposition != null)
        {
            editComment = selectedComposition.Comment ?? "";
            editEffectiveDate = selectedComposition.EffectiveDate;
            editExpirationDate = selectedComposition.ExpirationDate;
        }
    }

    async Task SaveCompositionDraft()
    {
        if (!CanEditSelectedDraft) return;
        await EquipService.UpdateComplexCompositionDraftAsync(
            new UpdateComplexCompositionDraftRequest(selectedComposition!.Id,
                string.IsNullOrWhiteSpace(editComment) ? null : editComment,
                editEffectiveDate?.ToUniversalTime(),
                editExpirationDate?.ToUniversalTime()));
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task SubmitForReview()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.Draft || !canSubmit) return;
        await EquipService.SubmitComplexCompositionForReviewAsync(selectedComposition.Id);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task ApproveComposition()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.OnReview || !canApprove) return;
        await EquipService.ApproveComplexCompositionAsync(selectedComposition.Id,
            string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task ReturnToDraft()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.OnReview || !canReturn) return;
        await EquipService.ReturnComplexCompositionToDraftAsync(selectedComposition.Id,
            string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task ArchiveComposition()
    {
        if (selectedComposition == null || selectedComposition.Status != ProductCompositionStatus.Approved || !canApprove) return;
        await EquipService.ArchiveComplexCompositionAsync(selectedComposition.Id);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
    }

    async Task AddItem()
    {
        if (!CanEditSelectedDraft || newModelId == Guid.Empty) return;
        await EquipService.AddComplexCompositionItemAsync(
            new AddComplexCompositionItemRequest(selectedComposition!.Id, newModelId, newModelQty));
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition.Id);
        newModelId = Guid.Empty;
        newModelQty = 1;
    }

    void StartEditItemQty(Guid id, int qty)
    {
        editingItemId = id;
        editItemQty = qty;
    }

    void CancelEditItem()
    {
        editingItemId = null;
    }

    async Task SaveItemQuantity(Guid id)
    {
        if (!CanEditSelectedDraft) return;
        await EquipService.UpdateComplexCompositionItemAsync(
            new UpdateComplexCompositionItemRequest(id, editItemQty, 0, null));
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition!.Id);
        editingItemId = null;
    }

    async Task RemoveItem(Guid id)
    {
        if (!CanEditSelectedDraft) return;
        await EquipService.RemoveComplexCompositionItemAsync(id);
        await LoadCompositions();
        await SelectCompositionAsync(selectedComposition!.Id);
    }

    async Task DeleteComposition(Guid id)
    {
        var comp = compositions.FirstOrDefault(c => c.Id == id);
        if (comp == null || comp.Status != ProductCompositionStatus.Draft || !canEditDraft) return;
        await EquipService.DeleteComplexCompositionDraftAsync(id);
        compositions.RemoveAll(c => c.Id == id);
        if (selectedComposition?.Id == id) selectedComposition = null;
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    static string StatusLabel(ProductCompositionStatus status) => status switch
    {
        ProductCompositionStatus.Draft => "Черновик",
        ProductCompositionStatus.OnReview => "На проверке",
        ProductCompositionStatus.Approved => "Утверждён",
        ProductCompositionStatus.Archived => "Архивный",
        _ => status.ToString()
    };

    static string StatusTag(ProductCompositionStatus status) => status switch
    {
        ProductCompositionStatus.Draft => "warn",
        ProductCompositionStatus.OnReview => "warn",
        ProductCompositionStatus.Approved => "ok",
        ProductCompositionStatus.Archived => "",
        _ => ""
    };

    string ReadOnlyBannerClass => selectedComposition?.Status switch
    {
        ProductCompositionStatus.Draft => "compositionReadOnlyBanner--info",
        ProductCompositionStatus.OnReview => "compositionReadOnlyBanner--warn",
        ProductCompositionStatus.Archived => "compositionReadOnlyBanner--info",
        _ => "compositionReadOnlyBanner--info"
    };

    string ReadOnlyBannerText => selectedComposition?.Status switch
    {
        ProductCompositionStatus.Draft => "Черновик доступен только для просмотра. У вас нет права редактирования этого состава.",
        ProductCompositionStatus.OnReview => "На согласовании — состав заблокирован до решения согласующего.",
        ProductCompositionStatus.Approved => "Утверждён — для изменения создайте новую версию.",
        ProductCompositionStatus.Archived => "В архиве — историческая версия доступна только для просмотра.",
        _ => ""
    };

    async Task CreateNewVersion()
    {
        if (selectedComposition == null) return;
        var result = await EquipService.CreateComplexCompositionVersionAsync(selectedComposition.Id);
        if (result.Success && result.CompositionId.HasValue)
            Nav.NavigateTo($"/составы/комплексы/{selectedComposition.ComplexId}/версии/{result.CompositionId}", forceLoad: true);
    }

    bool CanEditComposition(ProductCompositionStatus status) =>
        canEditDraft && status == ProductCompositionStatus.Draft;

    private string EmptyStateText => HasEmptyState
        ? "Состав не создан"
        : "Нет составов. Выберите комплекс и нажмите «Создать черновик».";
}
