@page "/справочник-экземпляров"
@attribute [Authorize(Policy = "ViewReferences")]
@implements IDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Web.Services
@inject EquipmentService EquipService
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock

<div class="stack">
    <ReferenceBreadcrumb Group="Техника" Current="Экземпляры изделий" />
    @if (canEdit)
    {
        <section class="panel">
            <div class="panelHeader">
                <h2>@(editing ? "Редактирование экземпляра" : "Новый экземпляр изделия")</h2>
                <div class="hint">Конкретные единицы</div>
            </div>
            <div class="panelBody">
                <div class="form">
                    <div class="field"><label>Заводской номер</label><input @ref="_firstField" @bind="newInst.SerialNumber" /></div>
                    <div class="field"><label>Индекс</label><input @bind="newInst.Index" /></div>
                    <div class="field"><label>Наименование</label><input @bind="newInst.Name" /></div>
                    <div class="field">
                        <label>Вид техники</label>
                        <select value="@(_newInstTypeId?.ToString() ?? "")" @onchange="OnFormTypeChanged" class="field-select">
                            <option value="">Не указан</option>
                            @foreach (var t in _equipmentTypes)
                            {
                                <option value="@t.Id">@TypeDisplayName(t)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>Изделие</label>
                        <select value="@(newInst.EquipmentModelId == Guid.Empty ? "" : newInst.EquipmentModelId.ToString())"
                                @onchange="OnFormModelChanged" class="field-select">
                            <option value="" disabled hidden>Выберите изделие</option>
                            @foreach (var m in FormModelOptions)
                            {
                                <option value="@m.Id">@m.Index — @m.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>Марка</label><input @bind="newInst.Brand" /></div>
                    <div class="field"><label>Модификация</label><input @bind="newInst.Modification" /></div>
                    <div class="field"><label>Описание</label><input @bind="newInst.Description" /></div>
                    <div class="formActions">
                        <button class="btn ghost" @onclick="ResetForm">Очистить</button>
                        <button class="btn primary" @onclick="SaveInst">@(editing ? "Сохранить" : "Добавить")</button>
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mbError">@errorMessage</div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="panel">
        <div class="panelHeader">
            <h2>Список экземпляров</h2>
            <div class="hint">@totalCount записей</div>
        </div>
        <div class="panelBody">
            <div class="mbFilters">
                <input class="fieldInput mbSearch" @bind="search" @bind:event="oninput" @bind:after="OnFiltersChanged" placeholder="Поиск по зав. №, индексу, наименованию, марке, виду..." />
                <select class="field-select" @bind="typeFilter" @bind:after="OnFiltersChanged">
                    <option value="">Все виды техники</option>
                    @foreach (var t in _equipmentTypes)
                    {
                        <option value="@t.Id">@TypeDisplayName(t)</option>
                    }
                </select>
                <select class="field-select" @bind="modelFilter" @bind:after="OnFiltersChanged">
                    <option value="">Все изделия</option>
                    @foreach (var m in models)
                    {
                        <option value="@m.Id">@m.Index — @m.Name</option>
                    }
                </select>
                <select class="field-select" @bind="statusFilter" @bind:after="OnFiltersChanged">
                    <option value="0">Активные</option>
                    <option value="1">Удалённые</option>
                    <option value="2">Все</option>
                </select>
                <select class="field-select" @bind="sortBy" @bind:after="OnFiltersChanged">
                    <option value="SerialNumber">Сортировка: зав. №</option>
                    <option value="Name">Сортировка: наименование</option>
                    <option value="Index">Сортировка: индекс</option>
                    <option value="Brand">Сортировка: марка</option>
                </select>
                <button class="btn ghost" @onclick="ToggleSortDir">@(sortDesc ? "По убыванию" : "По возрастанию")</button>
                @if (HasActiveFilters)
                {
                    <button class="btn ghost" @onclick="ResetFilters">Сбросить</button>
                }
            </div>

            @if (loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (!instances.Any())
            {
                <div class="empty-state">Нет экземпляров изделий</div>
            }
            else
            {
                <div class="referenceTableWrap">
                    <table>
                        <thead>
                            <tr><th>Зав. №</th><th>Индекс</th><th>Наименование</th><th>Вид техники</th><th>Изделие</th><th>Марка</th><th>Модификация</th><th>Статус</th><th>Действия</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in instances)
                            {
                                var rowClickable = canEdit && !i.IsDeleted;
                                <tr class="@(rowClickable ? "clickableRow" : "")" tabindex="@(rowClickable ? "0" : "-1")" @ondblclick="() => OnRowDblClick(i)" @onkeydown="(ev) => OnRowKeyDown(ev, i)">
                                    <td class="mono">@i.SerialNumber</td>
                                    <td>@i.Index</td>
                                    <td>@i.Name</td>
                                    <td>@(i.EquipmentType is null ? "—" : TypeDisplayName(i.EquipmentType))</td>
                                    <td>@i.EquipmentModel?.Name</td>
                                    <td>@i.Brand</td>
                                    <td>@i.Modification</td>
                                    <td><span class="tag @(i.IsDeleted ? "bad" : "ok")">@(i.IsDeleted ? "Удалён" : "Активен")</span></td>
                                    <td @ondblclick:stopPropagation="true">
                                        <div class="rowActions">
                                            @if (i.IsDeleted)
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" style="color:var(--ok)" @onclick="() => RestoreInst(i.Id)">Восстановить</button>
                                                }
                                            }
                                            else
                                            {
                                                @if (canEdit)
                                                {
                                                    <button class="linkBtn" @onclick="() => EditInst(i)">Изменить</button>
                                                    <button class="linkBtn" style="color:var(--bad)" @onclick="() => DeleteInst(i.Id)">Удалить</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="footer">
                    <div>
                        <button class="linkBtn" @onclick="PrevPage" disabled="@(currentPage <= 1)">Назад</button>
                        <span style="margin:0 8px">Стр. @currentPage из @totalPages</span>
                        <button class="linkBtn" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Вперёд</button>
                    </div>
                    <div class="mono">Показано @instances.Count из @totalCount</div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<EquipmentInstance> instances = new();
    private List<EquipmentModel> models = new();
    private List<EquipmentType> _equipmentTypes = new();
    private EquipmentInstance newInst = new();
    private bool editing;
    private bool loading = true;
    private bool canEdit;
    private string? errorMessage;
    private string search = "";
    private string? typeFilter;
    private string? modelFilter;
    private int statusFilter;
    private string sortBy = "SerialNumber";
    private bool sortDesc;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount;
    private CancellationTokenSource? _cts;
    private ElementReference _firstField;
    private bool _focusForm;

    private Guid? _newInstTypeId => newInst.EquipmentTypeId;

    /// <summary>Изделия для формы: при выбранном виде — только изделия этого вида.</summary>
    private IEnumerable<EquipmentModel> FormModelOptions =>
        newInst.EquipmentTypeId is { } typeId
            ? models.Where(m => m.EquipmentTypeId == typeId)
            : models;

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(typeFilter) ||
        !string.IsNullOrEmpty(modelFilter) || statusFilter != 0;

    private static string TypeDisplayName(EquipmentType t) =>
        string.IsNullOrWhiteSpace(t.TypeGroup) ? t.Name : $"{t.TypeGroup} — {t.Name}";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        canEdit = userId != null && await Perms.HasPermissionAsync(userId, PermissionCodes.ReferenceEdit);
        try
        {
            await using (await DbLock.WaitAsync())
            {
                models = await EquipService.GetModelsAsync();
                _equipmentTypes = await EquipService.GetActiveEquipmentTypesAsync();
            }
        }
        catch { _equipmentTypes = new List<EquipmentType>(); }
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusForm) { _focusForm = false; await _firstField.FocusAsync(); }
    }

    private async Task OnFiltersChanged() { currentPage = 1; await ReloadAsync(); }

    /// <summary>Выбор вида техники фильтрует изделия и подтягивает вид у выбранного изделия.</summary>
    private Task OnFormTypeChanged(ChangeEventArgs args)
    {
        newInst.EquipmentTypeId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;

        // Если выбранное изделие не относится к выбранному виду — сбрасываем его.
        if (newInst.EquipmentModelId != Guid.Empty)
        {
            var model = models.FirstOrDefault(m => m.Id == newInst.EquipmentModelId);
            if (model is null || (newInst.EquipmentTypeId is { } t && model.EquipmentTypeId != t))
                newInst.EquipmentModelId = Guid.Empty;
        }
        return Task.CompletedTask;
    }

    private Task OnFormModelChanged(ChangeEventArgs args)
    {
        newInst.EquipmentModelId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
        if (newInst.EquipmentModelId != Guid.Empty)
        {
            var model = models.FirstOrDefault(m => m.Id == newInst.EquipmentModelId);
            if (model?.EquipmentTypeId is { } modelTypeId)
                newInst.EquipmentTypeId = modelTypeId;
        }
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel(); _cts?.Dispose(); _cts = new CancellationTokenSource(); var ct = _cts.Token;
        bool? showDeleted = statusFilter switch { 1 => true, 2 => null, _ => false };
        loading = true;
        try
        {
            await using (await DbLock.WaitAsync(ct))
            {
            var result = await EquipService.GetInstancesPagedAsync(new EquipmentInstanceQuery
            {
                Page = currentPage,
                Search = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
                EquipmentModelId = string.IsNullOrEmpty(modelFilter) ? null : Guid.Parse(modelFilter),
                EquipmentTypeId = string.IsNullOrEmpty(typeFilter) ? null : Guid.Parse(typeFilter),
                ShowDeleted = showDeleted,
                SortBy = sortBy,
                SortDescending = sortDesc,
            }, ct);
            if (ct.IsCancellationRequested) return;
            instances = result.Items.ToList(); totalCount = result.TotalCount; totalPages = result.TotalPages;
            if (currentPage > totalPages && totalPages > 0) { currentPage = totalPages; await ReloadAsync(); return; }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally { if (!ct.IsCancellationRequested) loading = false; }
    }

    async Task SaveInst()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(newInst.SerialNumber)) { errorMessage = "Укажите заводской номер."; return; }
        if (newInst.EquipmentModelId == Guid.Empty) { errorMessage = "Выберите изделие."; return; }
        try
        {
            if (editing) await EquipService.UpdateInstanceAsync(newInst); else await EquipService.CreateInstanceAsync(newInst);
            ResetForm(); await ReloadAsync();
        }
        catch (InvalidOperationException ex) { errorMessage = ex.Message; }
        catch (Exception)
        {
            errorMessage = editing
                ? "Не удалось изменить экземпляр. Обновите список и повторите попытку."
                : "Не удалось создать экземпляр. Обновите список и повторите попытку.";
        }
    }

    Task EditInst(EquipmentInstance i)
    {
        newInst = new EquipmentInstance
        {
            Id = i.Id, SerialNumber = i.SerialNumber, Index = i.Index, Name = i.Name,
            EquipmentModelId = i.EquipmentModelId, EquipmentTypeId = i.EquipmentTypeId,
            Brand = i.Brand, Modification = i.Modification, Description = i.Description
        };
        editing = true; _focusForm = true; return Task.CompletedTask;
    }

    async Task OnRowDblClick(EquipmentInstance i) { if (!canEdit || i.IsDeleted) return; await EditInst(i); }
    async Task OnRowKeyDown(KeyboardEventArgs ev, EquipmentInstance i) { if (!canEdit || i.IsDeleted || ev.Key != "Enter") return; await EditInst(i); }

    async Task DeleteInst(Guid id)
    {
        errorMessage = null;
        try { var ok = await EquipService.DeleteInstanceAsync(id); if (!ok) errorMessage = "Не удалось удалить запись."; await ReloadAsync(); }
        catch (InvalidOperationException ex) { errorMessage = ex.Message; }
    }

    async Task RestoreInst(Guid id)
    {
        errorMessage = null;
        try { var ok = await EquipService.RestoreInstanceAsync(id); if (!ok) errorMessage = "Не удалось восстановить запись."; await ReloadAsync(); }
        catch (InvalidOperationException ex) { errorMessage = ex.Message; }
    }

    void ResetForm() { newInst = new EquipmentInstance(); editing = false; errorMessage = null; }
    async Task ToggleSortDir() { sortDesc = !sortDesc; await ReloadAsync(); }

    async Task ResetFilters()
    {
        search = ""; typeFilter = null; modelFilter = null; statusFilter = 0; sortBy = "SerialNumber"; sortDesc = false; currentPage = 1;
        await ReloadAsync();
    }

    async Task PrevPage() { if (currentPage <= 1) return; currentPage--; await ReloadAsync(); }
    async Task NextPage() { if (currentPage >= totalPages) return; currentPage++; await ReloadAsync(); }

    public void Dispose() { _cts?.Cancel(); _cts?.Dispose(); }
}
