    /// <summary>Перенос под корень: раздел прежнего корня сохраняется, чтобы принадлежность ветки не потерялась молча.</summary>
    private void MoveUnderRoot(HKCardNode node)
    {
        if (!canEditComposition || node.ParentId is null)
            return;

        var nodesById = card.TreeNodes.ToDictionary(n => n.Id);
        var upper = node.ParentId.Value;
        Guid? inheritedSection = null;
        while (nodesById.TryGetValue(upper, out var current))
        {
            if (current.ParentId is null)
            {
                inheritedSection = current.SectionId;
                break;
            }
            upper = current.ParentId.Value;
        }

        node.ParentId = null;
        node.SectionId = inheritedSection;
        MarkStructureDirty();
        ResetChoiceIfNotApplicable();
        StateHasChanged();
    }

    private void ChangeTopNodeSection(HKCardNode node, string value)
    {
        // Наследование принадлежности вложенной позицией не редактируется:
        // раздел меняется только у верхней позиции всей ветки.
        if (!canEditComposition || node.ParentId is not null)
            return;
        node.SectionId = Guid.TryParse(value, out var id) ? id : null;
        MarkStructureDirty();
        StateHasChanged();
    }

