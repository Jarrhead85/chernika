    /// <summary>Выбор или замена файла: на сохранённой карте сразу загружаем, на новой — копим до сохранения.</summary>
    private async Task HandleAttachmentUpload(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        try
        {
            var maxBytes = FileOptions.Value.MaxPdfSizeBytes > 0
                ? FileOptions.Value.MaxPdfSizeBytes
                : 20L * 1024 * 1024;

            // Читаем файл сразу, пока InputFile ещё в DOM: после замены поля на чип
            // поток IBrowserFile прочитать уже нельзя.
            var file = e.File;
            using var buffer = new MemoryStream();
            await using (var source = file.OpenReadStream(maxAllowedSize: maxBytes))
            {
                await source.CopyToAsync(buffer);
            }
            _pendingFile = new PendingFile(buffer.ToArray(), file.Name, file.ContentType, file.Size);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось прочитать выбранный PDF-файл");
            _pendingFile = null;
            _fileInputKey++;
            _attachmentError = "Не удалось прочитать выбранный файл.";
            return;
        }

        if (!IsNew)
        {
            // Замена действующего основания при принятых реквизитах сбрасывает
            // их согласование: требуется подтверждение с объяснением.
            if (AttachmentChangeResetsApproval)
            {
                _attachmentConfirmAction = AttachmentConfirmation.Replace;
                StateHasChanged();
                return;
            }

            await UploadAttachment();

            // Не удалось загрузить — возвращаем поле в прежнее состояние с ошибкой.
            if (!string.IsNullOrEmpty(_attachmentError))
            {
                _pendingFile = null;
                _fileInputKey++;
            }
            return;
        }

        StateHasChanged();
    }

    /// <summary>Предпросмотр несохранённого файла в отдельной вкладке.</summary>
    private async Task OpenPendingPreviewAsync()
    {
        if (_pendingFile == null) return;
        try
        {
            var stream = new MemoryStream(_pendingFile.Content);
            await JS.InvokeVoidAsync("hkPdfPreview.openInNewTab", new DotNetStreamReference(stream));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось открыть предпросмотр PDF");
            _attachmentError = "Не удалось открыть предпросмотр PDF.";
        }
    }

    private void ClearPendingAttachment()
    {
        _pendingFile = null;
        _attachmentError = null;
        _fileInputKey++;
    }

    private Dictionary<string, object> ExpirationDateAttributes()
    {
        var attributes = new Dictionary<string, object> { ["class"] = "fieldInput" };
        if (card.EffectiveDate.HasValue)
            attributes["min"] = card.EffectiveDate.Value.ToString("yyyy-MM-dd");
        return attributes;
    }

    private async Task UploadAttachment()
    {
        if (card.Id == Guid.Empty) return;
        if (!canEditPdf) return;
        if (_pendingFile == null) return;

        _attachmentError = null;
        _attachmentNotice = null;
        _uploading = true;
        StateHasChanged();

        var pending = _pendingFile;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                using var stream = new MemoryStream(pending.Content);
                var result = await HKCardService.SaveAttachmentAsync(
                    card.Id, stream, pending.Name, pending.ContentType, pending.Size, loadedRowVersion);
                if (result.Attachment is not null)
                {
                    _attachment = new AttachmentInfo(result.Attachment.Id, result.Attachment.OriginalFileName,
                        result.Attachment.SizeBytes, result.Attachment.UploadedByUserName, result.Attachment.UploadedAt);
                }

                // После операции обновляются версия строки и состояния этапов
                // без перезагрузки всей формы: несохранённый ввод реквизитов и
                // структуры не теряется (PR № 10).
                await ApplyApprovalRefreshAsync(result);
            }

            _pendingFile = null;
            _fileInputKey++;
        }
        catch (UnauthorizedAccessException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось загрузить вложение ХК {CardId}", card.Id);
            _attachmentError = "Не удалось выполнить операцию с вложением.";
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAttachment()
    {
        if (_attachment == null) return;

        // Удаление при принятых реквизитах — то же изменение действующего
        // основания, что и замена: подтверждение с объяснением последствий.
        if (AttachmentChangeResetsApproval)
        {
            _attachmentConfirmAction = AttachmentConfirmation.Delete;
            StateHasChanged();
            return;
        }

        await ExecuteAttachmentDelete();
    }

    private async Task ExecuteAttachmentDelete()
    {
        if (_attachment == null) return;
        _attachmentError = null;
        _attachmentNotice = null;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                var result = await HKCardService.DeleteAttachmentAsync(card.Id, loadedRowVersion);

                // После удаления тоже обновляем версию строки и состояния этапов
                // без перезагрузки формы (PR № 10).
                await ApplyApprovalRefreshAsync(result);
            }
            _attachment = null;
            _fileInputKey++;
        }
        catch (UnauthorizedAccessException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось удалить вложение ХК {CardId}", card.Id);
            _attachmentError = "Не удалось выполнить операцию с вложением.";
        }
        StateHasChanged();
    }

    /// <summary>Подтверждённое изменение основания: выполняет отложенное действие.</summary>
    private async Task ConfirmAttachmentAction()
    {
        var action = _attachmentConfirmAction;
        _attachmentConfirmAction = AttachmentConfirmation.None;
        if (action == AttachmentConfirmation.Replace)
        {
            await UploadAttachment();
            if (!string.IsNullOrEmpty(_attachmentError))
            {
                _pendingFile = null;
                _fileInputKey++;
            }
        }
        else if (action == AttachmentConfirmation.Delete)
        {
            await ExecuteAttachmentDelete();
        }
    }

    /// <summary>Отказ от подтверждаемого изменения: поле возвращается как было.</summary>
    private void CancelAttachmentAction()
    {
        _attachmentConfirmAction = AttachmentConfirmation.None;
        if (_pendingFile is not null && _attachment is not null)
        {
            _pendingFile = null;
            _fileInputKey++;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Обновление отображаемого состояния после операции с вложением по её
    /// единому результату: статус, версия строки и возможности правки.
    /// </summary>
    private async Task ApplyApprovalRefreshAsync(HKCardAttachmentMutationResult result)
    {
        card.Status = result.CardStatus;
        statusStr = result.CardStatus.ToString();
        loadedRowVersion = result.CardRowVersion;

        if (result.ApprovalInvalidated)
        {
            _attachmentNotice = "Файл основания изменён: прежнее согласование сброшено. " +
                "Требуется повторное согласование реквизитов и состава.";
        }

        await RefreshStagesAsync();
    }

    /// <summary>Перечитывает возможности правки по состоянию этапов (без перезагрузки карты).</summary>
    private async Task RefreshStagesAsync()
    {
        try
        {
            var caps = await LoadApprovalStateCoreAsync(card.Id, card.Status, default);
            approvalStages = caps.Stages.ToList();
            canSubmit = caps.CanSubmit;
            canEditDetails = caps.CanEditDetails;
            canEditComposition = caps.CanEditComposition;
            canEditPdf = caps.CanEditPdf;
            canView = caps.CanView;
            canEdit = canEditDetails || canEditComposition;
            canQuickCreate = canEditComposition;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось перечитать этапы согласования после операции с вложением {CardId}", card.Id);
        }
    }

