    private async Task SaveQuickCreateAsync()
    {
        _quickCreateSaving = true;
        _quickCreateError = null;
        StateHasChanged();

        try
        {
            switch (_quickCreateKind)
            {
                case QuickCreateKind.Node:
                {
                    var created = await EquipmentService.CreateNodeAsync(new Node
                    {
                        Code = _qcCode.Trim(),
                        Name = _qcName.Trim(),
                        Description = string.IsNullOrWhiteSpace(_qcDescription) ? null : _qcDescription.Trim()
                    });
                    nodes = await EquipmentService.GetNodesAsync();
                    selectedNodeId = created.Id;
                    card.NodeId = created.Id;
                    if (IsNew)
                    {
                        card.Code = await HKCardService.GenerateCodeForNodeAsync(created.Id);
                        _existingActiveCard = await HKCardService.GetActiveCardForNodeAsync(created.Id);
                        _activeCardWarning = _existingActiveCard != null
                            ? $"Для узла уже есть активная ХК «{_existingActiveCard.Code}» в статусе «{TranslateStatus(_existingActiveCard.Status)}»."
                            : null;
                    }
                    break;
                }
                case QuickCreateKind.AssemblyUnit:
                {
                    var created = await EquipmentService.CreateAssemblyUnitAsync(new AssemblyUnit
                    {
                        Code = _qcCode.Trim(),
                        Name = _qcName.Trim(),
                        Description = string.IsNullOrWhiteSpace(_qcDescription) ? null : _qcDescription.Trim()
                    });
                    assemblyUnits = await EquipmentService.GetAssemblyUnitsAsync();
                    if (_quickCreateItemUiKey.HasValue)
                    {
                        var item = card.Items.FirstOrDefault(i => i.Id == _quickCreateItemUiKey.Value);
                        if (item != null) await SelectAu(item, created);
                    }
                    break;
                }
                case QuickCreateKind.GsmMaterial:
                {
                    var created = await EquipmentService.CreateGsmMaterialAsync(new GsmMaterial
                    {
                        Name = _qcName.Trim(),
                        Type = _qcType.Trim(),
                        Gost = string.IsNullOrWhiteSpace(_qcGost) ? null : _qcGost.Trim(),
                        Description = string.IsNullOrWhiteSpace(_qcDescription) ? null : _qcDescription.Trim()
                    });
                    gsmMaterials = await EquipmentService.GetGsmMaterialsAsync();
                    if (_quickCreateItemUiKey.HasValue && _quickCreateCategory.HasValue)
                    {
                        var item = card.Items.FirstOrDefault(i => i.Id == _quickCreateItemUiKey.Value);
                        if (item != null) await AddMaterial(item, _quickCreateCategory.Value, created.Id);
                    }
                    break;
                }
            }
            CloseQuickCreateModal();
        }
        catch (Exception ex)
        {
            _quickCreateError = ex.Message;
        }
        finally
        {
            _quickCreateSaving = false;
            StateHasChanged();
        }
    }
