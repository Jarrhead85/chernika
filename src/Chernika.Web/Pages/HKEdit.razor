@page "/хк/создать"
@page "/хк/{Id:guid}"
@attribute [Authorize(Policy = "ViewHK")]
@implements IAsyncDisposable
@using Chernika.Domain.Models
@using Chernika.Domain.Enums
@inject HKCardService HKCardService
@inject NavigationManager Nav
@inject EquipmentService EquipmentService
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>@(IsNew ? "Создание новой ХК" : "Редактирование ХК")</h2>
            <div class="hint">@card.Version</div>
        </div>
        <div class="panelBody">
            <EditForm Model="@card" OnValidSubmit="SaveCard">
                <DataAnnotationsValidator />
                <div class="form">
                    <div class="field"><label>Номер ХК</label><InputText @bind-Value="card.Code" readonly class="field" /></div>
                    <div class="field"><label>Уровень объекта</label>
                        <div class="level-selector" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
                            @foreach (var lvl in new[] { HKObjectLevel.Complex, HKObjectLevel.EquipmentModel, HKObjectLevel.Aggregate, HKObjectLevel.Node })
                            {
                                var active = selectedLevel == lvl;
                                <button type="button" class="btn @(active ? "primary" : "ghost")" @onclick="() => SelectLevel(lvl)" style="font-size:13px;padding:4px 12px">@LevelName(lvl)</button>
                            }
                        </div>
                    </div>
                    <div class="field"><label>@ObjectFieldLabel()</label>
                        @{
                            var objectEntity = GetSelectedObject();
                            var objDropId = "obj-drop";
                            var objBtnId = "obj-btn";
                        }
                        @if (canEdit)
                        {
                            <div id="@objBtnId" class="field-select" style="cursor:pointer;display:flex;align-items:center;justify-content:space-between" @onclick="() => ToggleObjectDropdown(objDropId, objBtnId)">
                                <span style="flex:1">@(objectEntity != null ? objectEntity : "Выбрать...")</span>
                                @if (objectEntity != null)
                                {
                                    <button type="button" style="background:none;border:none;cursor:pointer;color:var(--bad);font-size:16px;line-height:1;padding:0;flex-shrink:0" @onclick="ClearObject" @onclick:stopPropagation="true">×</button>
                                }
                            </div>
                            @if (_objectDropOpen)
                            {
                                <div id="@objDropId" class="gsm-dropdown">
                                    <input class="gsm-dropdown-search" @bind="_objectSearch" @oninput="() => { }" placeholder="Поиск..." />
                                    @foreach (var obj in GetFilteredObjects())
                                    {
                                        <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectObject(obj)">@obj</div>
                                    }
                                    @if (!GetFilteredObjects().Any())
                                    {
                                        <div class="hki-search-empty">Нет совпадений</div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="field-select" style="cursor:default;display:block;opacity:.7">@(objectEntity ?? "")</span>
                        }
                        @if (!string.IsNullOrEmpty(_activeCardWarning) && _existingActiveCard != null)
                        {
                            <div class="note" style="margin-top:6px;font-size:12px;color:var(--warn)">
                                ⚠ @_activeCardWarning
                                <button type="button" class="linkBtn" @onclick="GoToExistingCard" style="text-decoration:underline;margin-left:4px;font-size:12px">Перейти к существующей ХК</button>
                            </div>
                        }
                    </div>
                    <div class="field"><label>Статус</label>
                        <div style="display:flex;align-items:center;gap:10px;margin-top:6px">
                            <StatusBadge Status="@card.Status" />
                            @if (card.Status == HKCardStatus.Draft && canSendToApprove)
                            {
                                <button type="button" class="btn primary" @onclick="SendToApprove">Отправить на проверку</button>
                            }
                            @if (card.Status == HKCardStatus.RevisionRequired && canSendToApprove)
                            {
                                <button type="button" class="btn primary" @onclick="SendToApprove">Отправить на проверку</button>
                            }
                            @if (card.Status == HKCardStatus.OnReview && canApprove)
                            {
                                <button type="button" class="btn primary" @onclick="ApproveCard">✓ Утвердить</button>
                                <button type="button" class="btn ghost" @onclick="ReturnForRevision">↩ Вернуть на доработку</button>
                            }
                            @if (card.Status == HKCardStatus.Approved && canArchive)
                            {
                                <button type="button" class="btn ghost" @onclick="ArchiveCard">В архив</button>
                            }
                        </div>
                    </div>
                    <div class="field full-width"><label>Назначение ХК</label><InputTextArea @bind-Value="card.Purpose" /></div>
                    <div class="field full-width"><label>Основание для разработки</label><InputTextArea @bind-Value="card.NormativeBasis" /></div>
                    <div class="field full-width"><label>Примечание</label><InputTextArea @bind-Value="card.Notes" /></div>
                    <div class="field"><label>Дата начала действия</label><InputDate @bind-Value="card.EffectiveDate" /></div>
                    <div class="field"><label>Дата окончания действия</label><InputDate @bind-Value="card.ExpirationDate"
                        AdditionalAttributes="@(card.EffectiveDate.HasValue
                            ? new Dictionary<string, object> { ["min"] = card.EffectiveDate.Value.ToString("yyyy-MM-dd") }
                            : null)" /></div>

                    @if (selectedLevel == HKObjectLevel.Node)
                    {
                    <div class="full-width" style="margin-top:8px">
                        <h3 style="font-size:14px;font-weight:700;margin:0 0 10px">Строки ХК</h3>

                        <div class="hk-items-table-wrapper">
                        <table class="hk-items-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="col-num" style="width:40px">№</th>
                                    <th rowspan="2" style="width:160px">Сборочная единица</th>
                                    <th rowspan="2" style="width:55px" class="col-wrap">Кол-во изделий</th>
                                    <th colspan="4" style="width:600px">Наименование и обозначение марок ГСМ</th>
                                    <th rowspan="2" style="width:65px" class="col-wrap">Масса/Объём</th>
                                    <th rowspan="2" style="width:36px" class="col-wrap">Ед. изм.</th>
                                    <th rowspan="2" style="width:110px">Периодичность</th>
                                    <th rowspan="2" style="width:180px">Примечание</th>
                                    <th rowspan="2" class="col-actions" style="width:60px"></th>
                                </tr>
                                <tr>
                                    <th style="width:150px">Основные</th>
                                    <th style="width:150px">Дублирующие</th>
                                    <th style="width:150px">Резервные</th>
                                    <th style="width:150px">Зарубежные</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var idx = 0;
                                }
                                @foreach (var item in card.Items.OrderBy(i => i.SortOrder))
                                {
                                    idx++;
                                    <tr @key="item.Id" class="@(_focusItemId == item.Id ? "hki-focus" : "")">
                                        <td class="col-num">@idx</td>
                                        <td class="gsm-selector-cell">
                                            @if (canEdit)
                                            {
                                                var au = item.AssemblyUnitId != Guid.Empty ? assemblyUnits.FirstOrDefault(a => a.Id == item.AssemblyUnitId) : null;
                                                var auDropId = $"au-drop-{item.Id:N}";
                                                var auBtnId = $"au-btn-{item.Id:N}";
                                                var auKey = item.Id;
                                                @if (au != null)
                                                {
                                                    <div id="@auBtnId" class="hki-mat-tag" @onclick="() => ToggleAuDropdown(auKey, auDropId, auBtnId)" style="cursor:pointer">
                                                        <span>@au.Code — @au.Name</span>
                                                        <button type="button" class="hki-tag-remove" @onclick="() => ClearAssemblyUnit(item)" @onclick:stopPropagation="true">×</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" id="@auBtnId" class="btn ghost hki-add-mat" @onclick="() => ToggleAuDropdown(auKey, auDropId, auBtnId)">— не выбрано —</button>
                                                }
                                                @if (_auOpen.GetValueOrDefault(auKey))
                                                {
                                                    <div id="@auDropId" class="gsm-dropdown">
                                                        <input class="gsm-dropdown-search" @bind="_auSearch[auKey]" @oninput="() => { }" placeholder="Поиск..." />
                                                        @foreach (var a in FilteredAssemblyUnits(auKey))
                                                        {
                                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectAu(item, a)">@a.Code — @a.Name</div>
                                                        }
                                                        @if (!FilteredAssemblyUnits(auKey).Any())
                                                        {
                                                            <div class="hki-search-empty">Нет совпадений</div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                var au = assemblyUnits.FirstOrDefault(a => a.Id == item.AssemblyUnitId);
                                                <span>@(au != null ? $"{au.Code} — {au.Name}" : "")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <input type="number" @bind="item.Quantity" class="hki-td-input" />
                                            }
                                            else
                                            {
                                                <span>@item.Quantity</span>
                                            }
                                        </td>
                                        @foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
                                        {
                                            <td class="hki-mat-cell gsm-selector-cell">
                                                @{
                                                    var matsInCat = item.Materials.Where(m => m.Category == cat).ToList();
                                                }
                                                @foreach (var mat in matsInCat)
                                                {
                                                    var matName = gsmMaterials.FirstOrDefault(g => g.Id == mat.GsmMaterialId)?.Name ?? "—";
                                                    <div class="hki-mat-tag">
                                                        <span>@matName</span>
                                                        @if (canEdit)
                                                        {
                                                            <button type="button" class="hki-tag-remove" @onclick="() => RemoveMaterial(item, mat)">×</button>
                                                        }
                                                    </div>
                                                }
                                                @if (canEdit)
                                                {
                                                    var pickerKey = (item.Id, cat);
                                                    var dropId = $"gsm-drop-{item.Id:N}-{cat}";
                                                    var btnId = $"gsm-btn-{item.Id:N}-{cat}";
                                                    <div>
                                                        <button type="button" id="@btnId" class="btn ghost hki-add-mat" @onclick="() => ToggleMatDrop(pickerKey, dropId, btnId)">+ Добавить</button>
                                                        @if (_matOpen.GetValueOrDefault(pickerKey))
                                                        {
                                                            <div id="@dropId" class="gsm-dropdown">
                                                                <input class="gsm-dropdown-search" @bind="_matSearch[pickerKey]"
                                                                       @oninput="() => { }"
                                                                       placeholder="Поиск..." />
                                                                @foreach (var group in FilteredGsmMaterials(cat, item).GroupBy(m => m.Type))
                                                                {
                                                                    <div class="gsm-dropdown-group-label">@group.Key</div>
                                                                    @foreach (var mat in group)
                                                                    {
                                                                        <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => AddMaterial(item, cat, mat.Id)">@mat.Name</div>
                                                                    }
                                                                }
                                                                @if (!FilteredGsmMaterials(cat, item).Any())
                                                                {
                                                                    <div class="hki-search-empty">Нет совпадений</div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                        <td>
                                            @if (canEdit)
                                            {
                                                <input type="number" @bind="item.Volume" step="0.001" class="hki-td-input" />
                                            }
                                            else
                                            {
                                                <span>@item.Volume</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <input @bind="item.UnitOfMeasure" class="hki-td-input" />
                                            }
                                            else
                                            {
                                                <span>@item.UnitOfMeasure</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <textarea @bind="item.Periodicity" class="hki-td-input" rows="1" style="resize:vertical"></textarea>
                                            }
                                            else
                                            {
                                                <span>@item.Periodicity</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <textarea @bind="item.Notes" class="hki-td-input" rows="1" style="resize:vertical"></textarea>
                                            }
                                            else
                                            {
                                                <span>@item.Notes</span>
                                            }
                                        </td>
                                        <td class="hki-actions col-actions">
                                            @if (canEdit)
                                            {
                                                <button type="button" class="linkBtn" @onclick="() => MoveItem(item, -1)" disabled="@(idx <= 1)" title="Вверх">↑</button>
                                                <button type="button" class="linkBtn" @onclick="() => MoveItem(item, 1)" disabled="@(idx >= card.Items.Count)" title="Вниз">↓</button>
                                                <button type="button" class="linkBtn" @onclick="() => RemoveItem(item)" style="color:var(--bad)" title="Удалить">🗑</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>

                        @if (canEdit)
                        {
                            <button type="button" class="btn" @onclick="AddItem" style="margin-top:4px">+ Добавить строку</button>
                        }
                    </div>
                    }
                    @if (selectedLevel != HKObjectLevel.Node && !IsNew)
                    {
                    <div class="full-width" style="margin-top:8px">
                        <h3 style="font-size:14px;font-weight:700;margin:0 0 10px">Состав ХК</h3>

                        <div style="margin-bottom:12px">
                            <button type="button" class="btn" @onclick="ToggleAddChild">+ Добавить дочернюю ХК</button>
                        </div>

                        @if (_addChildOpen)
                        {
                            <div style="margin-bottom:12px;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--panel2)">
                                <div style="display:flex;gap:8px;align-items:center">
                                    <input @bind="_addChildSearch" placeholder="Поиск по коду или объекту..." style="flex:1;padding:6px 10px;border:1px solid var(--line);border-radius:6px;font-size:13px" />
                                    <button type="button" class="btn primary" @onclick="ConfirmAddChild" disabled="@(string.IsNullOrWhiteSpace(_addChildSearch))">Добавить</button>
                                    <button type="button" class="btn ghost" @onclick="ToggleAddChild">Отмена</button>
                                </div>
                                @if (_availableChildCards.Any())
                                {
                                    <div style="margin-top:8px;max-height:200px;overflow-y:auto">
                                        @foreach (var child in _availableChildCards)
                                        {
                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectAvailableChild(child)" style="padding:6px 10px">
                                                <span class="mono">@child.Code</span> — @child.ObjectName (@LevelName(child.ObjectLevel))
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_addChildSearch))
                                {
                                    <div class="note" style="margin-top:8px;font-size:12px">Нет доступных утверждённых ХК</div>
                                }
                            </div>
                        }

                        @if (_components.Count == 0)
                        {
                            <div class="note">Состав пуст. Добавьте утверждённые дочерние ХК.</div>
                        }
                        else
                        {
                            <table class="hk-items-table" style="margin-bottom:12px">
                                <thead>
                                    <tr>
                                        <th style="width:40px">№</th>
                                        <th>ХК-источник</th>
                                        <th>Версия</th>
                                        <th>Объект</th>
                                        <th>Утверждена</th>
                                        <th class="col-actions" style="width:60px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var compIdx = 0; }
                                    @foreach (var comp in _components.OrderBy(c => c.SortOrder))
                                    {
                                        compIdx++;
                                        <tr>
                                            <td>@compIdx</td>
                                            <td class="mono">@comp.ChildCode</td>
                                            <td>@comp.ChildVersion</td>
                                            <td>@comp.ChildObjectName</td>
                                            <td>@comp.ChildApprovedAt?.ToString("dd.MM.yyyy")</td>
                                            <td class="hki-actions col-actions">
                                                @if (canEdit)
                                                {
                                                    <button type="button" class="linkBtn" @onclick="() => RemoveComponent(comp.Id)" style="color:var(--bad)" title="Удалить">🗑</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <h4 style="font-size:13px;font-weight:600;margin:12px 0 8px">Агрегированные строки</h4>
                        @if (_aggregatedRows.Count == 0)
                        {
                            <div class="note">Нет данных</div>
                        }
                        else
                        {
                            <table class="hk-items-table">
                                <thead>
                                    <tr>
                                        <th>ХК-источник</th>
                                        <th>Сборочная единица</th>
                                        <th>Масса/объём</th>
                                        <th>Ед.изм.</th>
                                        <th>Марка ГСМ</th>
                                        <th>Категория</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _aggregatedRows)
                                    {
                                        <tr>
                                            <td class="mono">@row.SourceCardCode</td>
                                            <td>@row.AssemblyUnitName</td>
                                            <td>@row.Volume.ToString("F3")</td>
                                            <td>@(row.UnitOfMeasure ?? "кг")</td>
                                            <td>@row.GsmMaterialName</td>
                                            <td>@row.Category</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    }

                    <div class="formActions">
                        <button type="button" class="btn ghost" @onclick="GoBack">Отмена</button>
                        <button type="submit" class="btn primary" disabled="@(!canEdit && !IsNew)">@(IsNew ? "Создать ХК" : "Сохранить")</button>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error" style="margin-top:10px;color:var(--bad);font-size:13px">@errorMessage</div>
                    }
                    <ValidationSummary />
                </div>
            </EditForm>
        </div>
    </section>
</div>

@if (showReturnModal)
{
    <div class="modalOverlay" @onclick="() => showReturnModal = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Вернуть на доработку</h3>
                <button type="button" class="linkBtn" @onclick="() => showReturnModal = false">✕</button>
            </div>
            <div class="modalBody">
                <textarea @bind="returnComment"
                          placeholder="Укажите причину возврата для автора..."
                          rows="3"
                          style="width:100%;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:8px;font-family:inherit;font-size:14px"></textarea>
                @if (returnCommentError != null)
                {
                    <div style="color:var(--bad);font-size:13px;margin-top:6px">@returnCommentError</div>
                }
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="() => showReturnModal = false">Отмена</button>
                <button type="button" class="btn primary" @onclick="ConfirmReturn">Подтвердить</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "nodeId")] public Guid? NodeId { get; set; }

    private HKCard card = new()
    {
        Id = Guid.NewGuid(),
        Version = "v" + DateTime.UtcNow.ToString("MMyy"),
        Items = new List<HKCardItem>(),
        BranchId = Guid.Empty,
        CreatedAt = DateTime.UtcNow,
        UpdatedAt = DateTime.UtcNow,
    };

    private string statusStr = "Draft";
    private HKObjectLevel selectedLevel = HKObjectLevel.Node;
    private Guid selectedComplexId;
    private Guid selectedModelId;
    private Guid selectedAggregateId;
    private Guid selectedNodeId;
    private List<Complex> complexes = new();
    private List<EquipmentModel> models = new();
    private List<Aggregate> aggregates = new();
    private List<Node> nodes = new();
    private List<AssemblyUnit> assemblyUnits = new();
    private string? _activeCardWarning;
    private HKCard? _existingActiveCard;
    private bool IsNew => Id == null || Id == Guid.Empty;
    private bool canEdit;
    private bool canSendToApprove;
    private bool canApprove;
    private bool canReturn;
    private bool canArchive;
    private string currentUserId = "";
    private string? errorMessage;
    private bool showReturnModal;
    private string returnComment = string.Empty;
    private string? returnCommentError;

    private List<GsmMaterial> gsmMaterials = new();
    private Guid? _focusItemId;
    private Dictionary<Guid, string> _auSearch = new();
    private Dictionary<Guid, bool> _auOpen = new();
    private Dictionary<(Guid, GsmCategory), bool> _matOpen = new();
    private Dictionary<(Guid, GsmCategory), string> _matSearch = new();
    private string? _activeDropdownId;
    private bool _disposed;
    private DotNetObjectReference<HKEdit> _dotNetRef = null!;

    private bool _objectDropOpen;
    private string _objectSearch = "";
    private Guid? _loadedCardId;

    private List<HKCardComponentDto> _components = new();
    private List<AggregatedRowDto> _aggregatedRows = new();
    private bool _addChildOpen;
    private string _addChildSearch = "";
    private List<HKCardListItemDto> _availableChildCards = new();
    private Guid? _pendingChildId;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await JS.InvokeVoidAsync("dropdownPortal.cleanup");
        }
        catch { /* ignore — page is unloading */ }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        var isOperator = user.IsInRole("Operator");
        canSendToApprove = user.IsInRole("Operator");
        canApprove = user.IsInRole("NormAdmin");
        canReturn = user.IsInRole("NormAdmin");
        canArchive = user.IsInRole("NormAdmin");
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        complexes = await EquipmentService.GetComplexesAsync();
        models = await EquipmentService.GetModelsAsync();
        aggregates = await EquipmentService.GetAggregatesAsync();
        nodes = await EquipmentService.GetNodesAsync();
        assemblyUnits = await EquipmentService.GetAssemblyUnitsAsync();
        gsmMaterials = await EquipmentService.GetGsmMaterialsAsync();

        if (NodeId.HasValue && NodeId.Value != Guid.Empty)
        {
            selectedLevel = HKObjectLevel.Node;
            selectedNodeId = NodeId.Value;
        }
        else if (IsNew)
        {
            selectedLevel = HKObjectLevel.Node;
            selectedNodeId = Guid.Empty;
        }

        if (!IsNew && Id.HasValue)
        {
            await LoadCardAsync(Id.Value);
            _loadedCardId = Id;
        }
        else
        {
            canEdit = isOperator && (IsNew || card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired);

            if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
            {
                card.Items.Add(new HKCardItem
                {
                    Id = Guid.NewGuid(),
                    HKCardId = card.Id,
                    AssemblyUnitId = Guid.Empty,
                    Quantity = 1,
                    Volume = 1.000m,
                    UnitOfMeasure = "кг",
                    SortOrder = 1
                });
            }

            InitItemDicts();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNew && Id.HasValue && Id != _loadedCardId)
        {
            await LoadCardAsync(Id.Value);
            _loadedCardId = Id;
        }
    }

    private async Task LoadCardAsync(Guid cardId)
    {
        var existing = await HKCardService.GetByIdAsync(cardId);
        if (existing == null) return;

        card = existing;
        selectedLevel = card.ObjectLevel;
        selectedComplexId = card.ComplexId ?? Guid.Empty;
        selectedModelId = card.EquipmentModelId ?? Guid.Empty;
        selectedAggregateId = card.AggregateId ?? Guid.Empty;
        selectedNodeId = card.NodeId ?? Guid.Empty;
        statusStr = card.Status.ToString();

        var authState = await AuthState.GetAuthenticationStateAsync();
        var isOperator = authState.User.IsInRole("Operator");
        canEdit = isOperator && card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired;

        if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
        {
            card.Items.Add(new HKCardItem
            {
                Id = Guid.NewGuid(),
                HKCardId = card.Id,
                AssemblyUnitId = Guid.Empty,
                Quantity = 1,
                Volume = 1.000m,
                UnitOfMeasure = "кг",
                SortOrder = 1
            });
        }

        InitItemDicts();

        if (selectedLevel != HKObjectLevel.Node)
        {
            _components = await HKCardService.GetComponentsAsync(cardId);
            _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(cardId);
        }
    }

    private async Task CloseActiveDropdownAsync()
    {
        if (_activeDropdownId != null)
        {
            await JS.InvokeVoidAsync("dropdownPortal.detach", _activeDropdownId);
            _activeDropdownId = null;
        }
        _objectDropOpen = false;
        foreach (var key in _matOpen.Keys.ToList())
            _matOpen[key] = false;
        foreach (var key in _auOpen.Keys.ToList())
            _auOpen[key] = false;
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await CloseActiveDropdownAsync();
                StateHasChanged();
            }
            catch
            {
                // ignore — circuit may be shutting down
            }
        });
    }

    private void InitItemDicts()
    {
        _auSearch = card.Items.ToDictionary(i => i.Id, i => "");
        _auOpen = card.Items.ToDictionary(i => i.Id, _ => false);
        _matOpen = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => false);
        _matSearch = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => "");
    }

    private void AddItem()
    {
        var maxOrder = card.Items.Any() ? card.Items.Max(i => i.SortOrder) : 0;
        var item = new HKCardItem
        {
            Id = Guid.NewGuid(),
            HKCardId = card.Id,
            AssemblyUnitId = Guid.Empty,
            Quantity = 1,
            Volume = 1.000m,
            UnitOfMeasure = "кг",
            SortOrder = maxOrder + 1
        };
        card.Items.Add(item);
        _auSearch[item.Id] = "";
        _auOpen[item.Id] = false;
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen[(item.Id, cat)] = false;
            _matSearch[(item.Id, cat)] = "";
        }
        _focusItemId = item.Id;
    }

    private void MoveItem(HKCardItem item, int direction)
    {
        var sorted = card.Items.OrderBy(i => i.SortOrder).ToList();
        var idx = sorted.IndexOf(item);
        if (idx < 0) return;
        var target = idx + direction;
        if (target < 0 || target >= sorted.Count) return;
        (sorted[target].SortOrder, item.SortOrder) = (item.SortOrder, sorted[target].SortOrder);
    }

