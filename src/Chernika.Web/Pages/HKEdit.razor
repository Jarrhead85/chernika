    private async Task ConfirmAddChild()
    {
        if (_pendingChild is null || _pendingChild.Id == Guid.Empty) return;

        // На несохранённом черновике строки держим в памяти и записываем
        // одной операцией при сохранении карты.
        if (IsNew)
        {
            if (_pendingChildCards.All(c => c.Id != _pendingChild.Id))
                _pendingChildCards.Add(_pendingChild);
            _addChildOpen = false;
            _addChildSearch = "";
            _pendingChild = null;
            return;
        }

        try
        {
            await using (await DbLock.WaitAsync())
            {
                await HKCardService.AddComponentAsync(card.Id, _pendingChild.Id);
                _components = await HKCardService.GetComponentsAsync(card.Id);
                _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(card.Id);
            }
            _addChildOpen = false;
            _addChildSearch = "";
            _pendingChild = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

