    private async Task AddMaterial(HKCardItem item, GsmCategory cat, Guid materialId)
    {
        if (item.Materials.Any(m => m.GsmMaterialId == materialId && m.Category == cat)) return;
        item.Materials.Add(new HKCardItemMaterial
        {
            Id = Guid.NewGuid(),
            HKCardItemId = item.Id,
            GsmMaterialId = materialId,
            Category = cat
        });
        await CloseActiveDropdownAsync();
        StateHasChanged();
    }

    private void RemoveMaterial(HKCardItem item, HKCardItemMaterial mat)
    {
        item.Materials.Remove(mat);
    }

    private async Task ToggleModelDropdown(string dropId, string btnId)
    {
        if (_modelDropOpen)
        {
            await CloseActiveDropdownAsync();
            StateHasChanged();
        }
        else
        {
            await CloseActiveDropdownAsync();
            _modelDropOpen = true;
            _modelSearch = "";
            _activeDropdownId = dropId;
            StateHasChanged();
            await Task.Delay(50);
            if (_disposed) return;
            await JS.InvokeVoidAsync("dropdownPortal.attach", dropId, btnId);
