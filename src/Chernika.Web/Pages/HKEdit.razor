@page "/хк/создать"
@page "/хк/{Id:guid}"
@attribute [Authorize(Policy = "ViewHK")]
@implements IAsyncDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Domain.Enums
@inject HKCardService HKCardService
@inject NavigationManager Nav
@inject EquipmentService EquipmentService
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.Extensions.Options
@inject IPermissionService Perms
@inject IJSRuntime JS
@inject IOptions<FileStorageOptions> FileOptions

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>@(IsNew ? "Создание новой ХК" : "Редактирование ХК")</h2>
            <div class="hint">@card.Version</div>
        </div>
        <div class="panelBody">
            <EditForm Model="@card" OnValidSubmit="SaveCard">
                <DataAnnotationsValidator />
                <div class="form">
                    <div class="hk-form-row hk-form-row--request">
                        <div class="field">
                            <label for="hk-request-organization">Организация</label>
                            @if (canEdit)
                            {
                                <InputText id="hk-request-organization" @bind-Value="card.RequestOrganization" class="fieldInput" />
                            }
                            else
                            {
                                <span>@(card.RequestOrganization ?? "")</span>
                            }
                        </div>
                        <div class="field">
                            <label for="hk-request-sender">ФИО отправителя</label>
                            @if (canEdit)
                            {
                                <InputText id="hk-request-sender" @bind-Value="card.RequestSenderFullName" class="fieldInput" />
                            }
                            else
                            {
                                <span>@(card.RequestSenderFullName ?? "")</span>
                            }
                        </div>
                        <div class="field">
                            <label for="hk-request-date">Дата поступления</label>
                            @if (canEdit)
                            {
                                <InputDate id="hk-request-date" @bind-Value="card.RequestReceivedDate" class="fieldInput" />
                            }
                            else
                            {
                                <span>@card.RequestReceivedDate?.ToString("dd.MM.yyyy")</span>
                            }
                        </div>
                        <div class="field hk-letter-numbers-field">
                            <label>Номер письма</label>
                            <div class="hk-letter-numbers" role="group" aria-label="Номера входящего и исходящего писем">
                                <div class="hk-letter-number-part">
                                    <label class="sr-only" for="hk-incoming-letter">Входящий номер</label>
                                    @if (canEdit)
                                    {
                                        <InputText id="hk-incoming-letter" @bind-Value="card.IncomingLetterNumber" class="fieldInput" placeholder="Входящий" />
                                    }
                                    else
                                    {
                                        <span>@(card.IncomingLetterNumber ?? "")</span>
                                    }
                                </div>
                                <div class="hk-letter-number-part">
                                    <label class="sr-only" for="hk-outgoing-letter">Исходящий номер</label>
                                    @if (canEdit)
                                    {
                                        <InputText id="hk-outgoing-letter" @bind-Value="card.OutgoingLetterNumber" class="fieldInput" placeholder="Исходящий" />
                                    }
                                    else
                                    {
                                        <span>@(card.OutgoingLetterNumber ?? "")</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="field hk-mb-field">
                            <label>Род войск</label>
                            @if (selectedMilitaryBranchIds.Any())
                            {
                                <div class="hki-tags-row">
                                    @foreach (var mbId in selectedMilitaryBranchIds)
                                    {
                                        var mb = allMilitaryBranches.FirstOrDefault(b => b.Id == mbId);
                                        if (mb != null)
                                        {
                                            <span class="hki-mat-tag">
                                                <span>@mb.Code — @mb.Name</span>
                                                @if (canEdit)
                                                {
                                                    <button type="button" class="hki-tag-remove" @onclick="() => RemoveMilitaryBranch(mbId)">×</button>
                                                }
                                            </span>
                                        }
                                    }
                                </div>
                            }
                            @if (canEdit)
                            {
                                var mbDropId = "mb-drop";
                                var mbBtnId = "mb-btn";
                                <div id="@mbBtnId" class="field-select hki-mb-select" @onclick="() => ToggleMbDropdown(mbDropId, mbBtnId)">
                                    <span>Добавить род войск...</span>
                                </div>
                                @if (_mbDropOpen)
                                {
                                    <div id="@mbDropId" class="gsm-dropdown">
                                        <input class="gsm-dropdown-search" @bind="_mbSearch" @oninput="() => { }" placeholder="Поиск..." />
                                        @foreach (var mb in FilteredMilitaryBranches())
                                        {
                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => AddMilitaryBranch(mb.Id)">@mb.Code — @mb.Name</div>
                                        }
                                        @if (!FilteredMilitaryBranches().Any())
                                        {
                                            <div class="hki-search-empty">Нет совпадений</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        <div class="field hk-pdf-field">
                            <label>PDF-скан исходной ХК</label>
                            @if (_attachment == null)
                            {
                                @if (canEdit && CanSelectAttachment)
                                {
                                    <div class="hki-file-row">
                                        <label class="btn ghost hki-file-btn">
                                            Выбрать файл
                                            <InputFile @key="_fileInputKey" OnChange="HandleAttachmentUpload" accept="application/pdf,.pdf" class="hki-file-input" />
                                        </label>
                                        @if (!IsNew)
                                        {
                                            <button type="button" class="btn primary" disabled="@(_pendingFile == null || _uploading)" @onclick="() => UploadAttachment()">@(_uploading ? "Загрузка..." : "Загрузить")</button>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="hki-file-row">
                                    <span class="hki-file-name">📄 @_attachment.OriginalFileName <span class="hki-file-size">(@FormatSize(_attachment.SizeBytes))</span></span>
                                    <button type="button" class="btn" @onclick="OpenAttachmentPreview">Открыть</button>
                                    <button type="button" class="btn" @onclick="DownloadAttachment">Скачать</button>
                                    @if (canEdit && CanManageAttachment)
                                    {
                                        <label class="btn ghost hki-file-btn">
                                            Заменить
                                            <InputFile @key="_fileInputKey" OnChange="HandleAttachmentUpload" accept="application/pdf,.pdf" class="hki-file-input" />
                                        </label>
                                        <button type="button" class="btn primary" disabled="@(_pendingFile == null || _uploading)" @onclick="() => UploadAttachment()">@(_uploading ? "Загрузка..." : "Загрузить")</button>
                                        <button type="button" class="btn ghost hki-file-danger" @onclick="DeleteAttachment">Удалить</button>
                                    }
                                </div>
                                <div class="hki-file-meta">Загрузил: @(_attachment.UploadedByUserName ?? "—") · @(_attachment.UploadedAt.ToString("dd.MM.yyyy HH:mm"))</div>
                            }
                            @if (_pendingFile != null)
                            {
                                <div class="hki-file-row" style="margin-top:4px">
                                    <span class="hki-file-meta hki-file-pending">@(IsNew ? "Файл будет прикреплён при сохранении: " : "Выбрано: ")@_pendingFile.Name (@FormatSize(_pendingFile.Size))</span>
                                    @if (IsNew)
                                    {
                                        <button type="button" class="btn" @onclick="OpenPendingPreview">Предпросмотр</button>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_attachmentError))
                            {
                                <div class="hki-field-error">@_attachmentError</div>
                            }
                        </div>
                    </div>

                    <div class="hk-form-row hk-form-row--object">
                        <div class="field hk-request-details-field">
                            <label for="hk-request-details">Реквизиты</label>
                            @if (canEdit)
                            {
                                <InputTextArea id="hk-request-details" @bind-Value="card.RequestDetails" class="fieldInput" />
                            }
                            else
                            {
                                <p style="margin:4px 0 0">@card.RequestDetails</p>
                            }
                        </div>
                        <div class="field">
                            <label>Уровень объекта</label>
                            <div class="hk-level-segmented" role="tablist" aria-label="Уровень объекта">
                                @foreach (var lvl in LevelOrder)
                                {
                                    var active = selectedLevel == lvl;
                                    <button type="button"
                                            class="hk-level-segmented-item @(active ? "active" : "")"
                                            role="tab" aria-selected="@active.ToString().ToLower()"
                                            disabled="@(!canEdit)"
                                            @onclick="() => SelectLevel(lvl)">
                                        @LevelName(lvl)
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="field">
                            <label>@ObjectFieldLabel()</label>
                            @{
                                var objectEntity = GetSelectedObject();
                                var objDropId = "obj-drop";
                                var objBtnId = "obj-btn";
                            }
                            @if (canEdit)
                            {
                                <div id="@objBtnId" class="field-select" style="cursor:pointer;display:flex;align-items:center;justify-content:space-between" @onclick="() => ToggleObjectDropdown(objDropId, objBtnId)">
                                    <span style="flex:1">@(objectEntity != null ? objectEntity : "Выбрать...")</span>
                                    @if (objectEntity != null)
                                    {
                                        <button type="button" style="background:none;border:none;cursor:pointer;color:var(--bad);font-size:16px;line-height:1;padding:0;flex-shrink:0" @onclick="ClearObject" @onclick:stopPropagation="true">×</button>
                                    }
                                </div>
                            @if (_objectDropOpen)
                            {
                                <div id="@objDropId" class="gsm-dropdown">
                                    <input class="gsm-dropdown-search" @bind="_objectSearch" @oninput="() => { }" placeholder="Поиск..." />
                                    @if (canQuickCreate && selectedLevel == HKObjectLevel.Node)
                                    {
                                        <button type="button" class="gsm-dropdown-create" @onmousedown:preventDefault="true" @onclick="() => { CloseAllDropdownsSync(); OpenQuickCreateNode(); }">
                                            <span aria-hidden="true">+</span> @(string.IsNullOrWhiteSpace(_objectSearch) ? "Создать новый" : $"Создать «{_objectSearch}»")
                                        </button>
                                    }
                                    <div class="gsm-dropdown-divider" role="separator"></div>
                                    @foreach (var obj in GetFilteredObjects())
                                    {
                                        <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectObject(obj)">@obj</div>
                                    }
                                    @if (!GetFilteredObjects().Any())
                                    {
                                        <div class="hki-search-empty">Нет совпадений</div>
                                    }
                                </div>
                            }
                            }
                            else
                            {
                                <span class="field-select" style="cursor:default;display:block;opacity:.7">@(objectEntity ?? "")</span>
                            }
                            @if (!string.IsNullOrEmpty(_activeCardWarning) && _existingActiveCard != null)
                            {
                                <div class="note" style="margin-top:6px;font-size:12px;color:var(--warn)">
                                    ⚠ @_activeCardWarning
                                    <button type="button" class="linkBtn" @onclick="GoToExistingCard" style="text-decoration:underline;margin-left:4px;font-size:12px">Перейти к существующей ХК</button>
                                </div>
                            }
                        </div>
                        <div class="field">
                            <label>Номер ХК</label>
                            @if (canEdit && !IsNew)
                            {
                                <InputText @bind-Value="card.Code" readonly class="fieldInput" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrEmpty(card.Code) ? "—" : card.Code)</span>
                            }
                        </div>
                    </div>

                    <div class="hk-form-row hk-form-row--description">
                        <div class="field">
                            <label>Назначение ХК</label>
                            <InputTextArea @bind-Value="card.Purpose" class="fieldInput hk-resizable-textarea" />
                        </div>
                        <div class="field">
                            <label>Примечание</label>
                            <InputTextArea @bind-Value="card.Notes" class="fieldInput hk-resizable-textarea" />
                        </div>
                    </div>

                    <div class="hk-form-row hk-form-row--dates">
                        <div class="field">
                            <label>Дата начала действия</label>
                            <InputDate @bind-Value="card.EffectiveDate" class="fieldInput" />
                        </div>
                        <div class="field">
                            <label>Дата окончания действия</label>
                            <InputDate @bind-Value="card.ExpirationDate" AdditionalAttributes="@ExpirationDateAttributes()" />
                        </div>
                    </div>

                    @if (selectedLevel == HKObjectLevel.Node)
                    {
                    <div class="full-width" style="margin-top:8px">
                        <h3 style="font-size:14px;font-weight:700;margin:0 0 10px">Строки ХК</h3>

                        <div class="hk-items-table-wrapper">
                        <table class="hk-items-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="col-num" style="width:40px">№</th>
                                    <th rowspan="2" style="width:160px">Сборочная единица</th>
                                    <th rowspan="2" style="width:55px" class="col-wrap">Кол-во изделий</th>
                                    <th colspan="4" style="width:600px">Наименование и обозначение марок ГСМ</th>
                                    <th rowspan="2" style="width:65px" class="col-wrap">Масса/Объём</th>
                                    <th rowspan="2" style="width:36px" class="col-wrap">Ед. изм.</th>
                                    <th rowspan="2" style="width:110px">Периодичность</th>
                                    <th rowspan="2" style="width:180px">Примечание</th>
                                    <th rowspan="2" class="col-actions" style="width:60px"></th>
                                </tr>
                                <tr>
                                    <th style="width:150px">Основные</th>
                                    <th style="width:150px">Дублирующие</th>
                                    <th style="width:150px">Резервные</th>
                                    <th style="width:150px">Зарубежные</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var idx = 0;
                                }
                                @foreach (var item in card.Items.OrderBy(i => i.SortOrder))
                                {
                                    idx++;
                                    <tr @key="item.Id" class="@(_focusItemId == item.Id ? "hki-focus" : "")">
                                        <td class="col-num">@idx</td>
                                        <td class="gsm-selector-cell">
                                            @if (canEdit)
                                            {
                                                var au = item.AssemblyUnitId != Guid.Empty ? assemblyUnits.FirstOrDefault(a => a.Id == item.AssemblyUnitId) : null;
                                                var auDropId = $"au-drop-{item.Id:N}";
                                                var auBtnId = $"au-btn-{item.Id:N}";
                                                var auKey = item.Id;
                                                @if (au != null)
                                                {
                                                    <div id="@auBtnId" class="hki-mat-tag" @onclick="() => ToggleAuDropdown(auKey, auDropId, auBtnId)" style="cursor:pointer">
                                                        <span>@au.Code — @au.Name</span>
                                                        <button type="button" class="hki-tag-remove" @onclick="() => ClearAssemblyUnit(item)" @onclick:stopPropagation="true">×</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" id="@auBtnId" class="btn ghost hki-add-mat" @onclick="() => ToggleAuDropdown(auKey, auDropId, auBtnId)">— не выбрано —</button>
                                                }
                                                @if (_auOpen.GetValueOrDefault(auKey))
                                                {
                                                    <div id="@auDropId" class="gsm-dropdown">
                                                        <input class="gsm-dropdown-search" @bind="_auSearch[auKey]" @oninput="() => { }" placeholder="Поиск..." />
                                                        @if (canQuickCreate)
                                                        {
                                                            <button type="button" class="gsm-dropdown-create" @onmousedown:preventDefault="true" @onclick="() => { CloseAllDropdownsSync(); OpenQuickCreateAssemblyUnit(auKey); }">
                                                                <span aria-hidden="true">+</span> @(string.IsNullOrWhiteSpace(_auSearch.GetValueOrDefault(auKey)) ? "Создать новый" : $"Создать «{_auSearch[auKey]}»")
                                                            </button>
                                                        }
                                                        <div class="gsm-dropdown-divider" role="separator"></div>
                                                        @foreach (var a in FilteredAssemblyUnits(auKey))
                                                        {
                                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectAu(item, a)">@a.Code — @a.Name</div>
                                                        }
                                                        @if (!FilteredAssemblyUnits(auKey).Any())
                                                        {
                                                            <div class="hki-search-empty">Нет совпадений</div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                var au = assemblyUnits.FirstOrDefault(a => a.Id == item.AssemblyUnitId);
                                                <span>@(au != null ? $"{au.Code} — {au.Name}" : "")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <input type="number" @bind="item.Quantity" class="hki-td-input" />
                                            }
                                            else
                                            {
                                                <span>@item.Quantity</span>
                                            }
                                        </td>
                                        @foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
                                        {
                                            <td class="hki-mat-cell gsm-selector-cell">
                                                @{
                                                    var matsInCat = item.Materials.Where(m => m.Category == cat).ToList();
                                                }
                                                @foreach (var mat in matsInCat)
                                                {
                                                    var matName = gsmMaterials.FirstOrDefault(g => g.Id == mat.GsmMaterialId)?.Name ?? "—";
                                                    <div class="hki-mat-tag">
                                                        <span>@matName</span>
                                                        @if (canEdit)
                                                        {
                                                            <button type="button" class="hki-tag-remove" @onclick="() => RemoveMaterial(item, mat)">×</button>
                                                        }
                                                    </div>
                                                }
                                                @if (canEdit)
                                                {
                                                    var pickerKey = (item.Id, cat);
                                                    var dropId = $"gsm-drop-{item.Id:N}-{cat}";
                                                    var btnId = $"gsm-btn-{item.Id:N}-{cat}";
                                                    <div>
                                                        <button type="button" id="@btnId" class="btn ghost hki-add-mat" @onclick="() => ToggleMatDrop(pickerKey, dropId, btnId)">+ Добавить</button>
                                                        @if (_matOpen.GetValueOrDefault(pickerKey))
                                                        {
                                                            <div id="@dropId" class="gsm-dropdown">
                                                                <input class="gsm-dropdown-search" @bind="_matSearch[pickerKey]"
                                                                       @oninput="() => { }"
                                                                       placeholder="Поиск..." />
                                                                @if (canQuickCreate)
                                                                {
                                                                    <button type="button" class="gsm-dropdown-create" @onmousedown:preventDefault="true" @onclick="() => { CloseAllDropdownsSync(); OpenQuickCreateGsmMaterial(item.Id, cat); }">
                                                                        <span aria-hidden="true">+</span> @(string.IsNullOrWhiteSpace(_matSearch.GetValueOrDefault(pickerKey)) ? "Создать новый" : $"Создать «{_matSearch[pickerKey]}»")
                                                                    </button>
                                                                }
                                                                <div class="gsm-dropdown-divider" role="separator"></div>
                                                                @foreach (var group in FilteredGsmMaterials(cat, item).GroupBy(m => m.Type))
                                                                {
                                                                    <div class="gsm-dropdown-group-label">@group.Key</div>
                                                                    @foreach (var mat in group)
                                                                    {
                                                                        <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => AddMaterial(item, cat, mat.Id)">@mat.Name</div>
                                                                    }
                                                                }
                                                                @if (!FilteredGsmMaterials(cat, item).Any())
                                                                {
                                                                    <div class="hki-search-empty">Нет совпадений</div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                        <td>
                                            @if (canEdit)
                                            {
                                                <input type="number" @bind="item.Volume" step="0.001" class="hki-td-input" />
                                            }
                                            else
                                            {
                                                <span>@item.Volume</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <input @bind="item.UnitOfMeasure" class="hki-td-input" />
                                            }
                                            else
                                            {
                                                <span>@item.UnitOfMeasure</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <textarea @bind="item.Periodicity" class="hki-td-input" rows="1" style="resize:vertical"></textarea>
                                            }
                                            else
                                            {
                                                <span>@item.Periodicity</span>
                                            }
                                        </td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <textarea @bind="item.Notes" class="hki-td-input" rows="1" style="resize:vertical"></textarea>
                                            }
                                            else
                                            {
                                                <span>@item.Notes</span>
                                            }
                                        </td>
                                        <td class="hki-actions col-actions">
                                            @if (canEdit)
                                            {
                                                <button type="button" class="linkBtn" @onclick="() => MoveItem(item, -1)" disabled="@(idx <= 1)" title="Вверх">↑</button>
                                                <button type="button" class="linkBtn" @onclick="() => MoveItem(item, 1)" disabled="@(idx >= card.Items.Count)" title="Вниз">↓</button>
                                                <button type="button" class="linkBtn" @onclick="() => RemoveItem(item)" style="color:var(--bad)" title="Удалить">🗑</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>

                        @if (canEdit)
                        {
                            <button type="button" class="btn" @onclick="AddItem" style="margin-top:4px">+ Добавить строку</button>
                        }
                    </div>
                    }
                    @if (selectedLevel != HKObjectLevel.Node)
                    {
                    <div class="full-width" style="margin-top:8px">
                        <h3 style="font-size:14px;font-weight:700;margin:0 0 10px">Состав ХК</h3>

                        @if (canEdit)
                        {
                        <div style="margin-bottom:12px">
                            <button type="button" class="btn" @onclick="ToggleAddChild">+ Добавить дочернюю ХК</button>
                        </div>
                        }

                        @if (_addChildOpen)
                        {
                            <div style="margin-bottom:12px;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--panel2)">
                                <div style="display:flex;gap:8px;align-items:center">
                                    <input @bind="_addChildSearch" placeholder="Поиск по коду или объекту..." style="flex:1;padding:6px 10px;border:1px solid var(--line);border-radius:6px;font-size:13px" />
                                    <button type="button" class="btn primary" @onclick="ConfirmAddChild" disabled="@(string.IsNullOrWhiteSpace(_addChildSearch))">Добавить</button>
                                    <button type="button" class="btn ghost" @onclick="ToggleAddChild">Отмена</button>
                                </div>
                                @if (_availableChildCards.Any())
                                {
                                    <div style="margin-top:8px;max-height:200px;overflow-y:auto">
                                        @foreach (var child in _availableChildCards)
                                        {
                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectAvailableChild(child)" style="padding:6px 10px">
                                                <span class="mono">@child.Code</span> — @child.ObjectName (@LevelName(child.ObjectLevel))
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_addChildSearch))
                                {
                                    <div class="note" style="margin-top:8px;font-size:12px">Нет доступных утверждённых ХК</div>
                                }
                            </div>
                        }

                        @if (_components.Count == 0)
                        {
                            <div class="note">Состав пуст. Добавьте утверждённые дочерние ХК.</div>
                        }
                        else
                        {
                            <table class="hk-items-table" style="margin-bottom:12px">
                                <thead>
                                    <tr>
                                        <th style="width:40px">№</th>
                                        <th>ХК-источник</th>
                                        <th>Версия</th>
                                        <th>Объект</th>
                                        <th>Утверждена</th>
                                        <th class="col-actions" style="width:60px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var compIdx = 0; }
                                    @foreach (var comp in _components.OrderBy(c => c.SortOrder))
                                    {
                                        compIdx++;
                                        <tr>
                                            <td>@compIdx</td>
                                            <td class="mono">@comp.ChildCode</td>
                                            <td>@comp.ChildVersion</td>
                                            <td>@comp.ChildObjectName</td>
                                            <td>@comp.ChildApprovedAt?.ToString("dd.MM.yyyy")</td>
                                            <td class="hki-actions col-actions">
                                                @if (canEdit)
                                                {
                                                    <button type="button" class="linkBtn" @onclick="() => RemoveComponent(comp.Id)" style="color:var(--bad)" title="Удалить">🗑</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <h4 style="font-size:13px;font-weight:600;margin:12px 0 8px">Агрегированные строки</h4>
                        @if (_aggregatedRows.Count == 0)
                        {
                            <div class="note">Нет данных</div>
                        }
                        else
                        {
                            <table class="hk-items-table">
                                <thead>
                                    <tr>
                                        <th>ХК-источник</th>
                                        <th>Сборочная единица</th>
                                        <th>Масса/объём</th>
                                        <th>Ед.изм.</th>
                                        <th>Марка ГСМ</th>
                                        <th>Категория</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _aggregatedRows)
                                    {
                                        <tr>
                                            <td class="mono">@row.SourceCardCode</td>
                                            <td>@row.AssemblyUnitName</td>
                                            <td>@row.Volume.ToString("F3")</td>
                                            <td>@(row.UnitOfMeasure ?? "кг")</td>
                                            <td>@row.GsmMaterialName</td>
                                            <td>@row.Category</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    }

                    <div class="formActions hk-form-actions-with-status">
                        <div class="hk-status-inline">
                            <StatusBadge Status="@card.Status" />
                            @if (card.Status == HKCardStatus.Draft && canSendToApprove)
                            {
                                <button type="button" class="btn primary" @onclick="SendToApprove">Отправить на проверку</button>
                            }
                            @if (card.Status == HKCardStatus.RevisionRequired && canSendToApprove)
                            {
                                <button type="button" class="btn primary" @onclick="SendToApprove">Отправить на проверку</button>
                            }
                            @if (card.Status == HKCardStatus.OnReview && canApprove)
                            {
                                <button type="button" class="btn primary" @onclick="ApproveCard">✓ Утвердить</button>
                                <button type="button" class="btn ghost" @onclick="ReturnForRevision">↩ Вернуть на доработку</button>
                            }
                            @if (card.Status == HKCardStatus.Approved && canArchive)
                            {
                                <button type="button" class="btn ghost" @onclick="ArchiveCard">В архив</button>
                            }
                        </div>
                        <div class="hk-form-actions-buttons">
                            <button type="button" class="btn ghost" @onclick="GoBack">Отмена</button>
                            <button type="submit" class="btn primary" disabled="@(!canEdit && !IsNew)">@(IsNew ? "Сохранить черновик" : "Сохранить")</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error" style="margin-top:10px;color:var(--bad);font-size:13px">@errorMessage</div>
                    }
                    <ValidationSummary />
                </div>
            </EditForm>
        </div>
    </section>
</div>

@if (_quickCreateKind.HasValue)
{
    <div class="modalOverlay" @onclick="CloseQuickCreateModal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="qc-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="qc-title">@(QuickCreateTitle)</h3>
                <button type="button" class="linkBtn" @onclick="CloseQuickCreateModal">✕</button>
            </div>
            <div class="modalBody">
                @if (_quickCreateKind == QuickCreateKind.Node)
                {
                    <div class="field"><label>Код <span style="color:var(--bad)">*</span></label><input @bind="_qcCode" class="field" placeholder="Код узла" /></div>
                    <div class="field"><label>Наименование <span style="color:var(--bad)">*</span></label><input @bind="_qcName" class="field" placeholder="Наименование узла" /></div>
                    <div class="field"><label>Описание</label><textarea @bind="_qcDescription" rows="2" placeholder="Описание (необязательно)"></textarea></div>
                }
                else if (_quickCreateKind == QuickCreateKind.AssemblyUnit)
                {
                    <div class="field"><label>Код <span style="color:var(--bad)">*</span></label><input @bind="_qcCode" class="field" placeholder="Код сборочной единицы" /></div>
                    <div class="field"><label>Наименование <span style="color:var(--bad)">*</span></label><input @bind="_qcName" class="field" placeholder="Наименование сборочной единицы" /></div>
                    <div class="field"><label>Описание</label><textarea @bind="_qcDescription" rows="2" placeholder="Описание (необязательно)"></textarea></div>
                }
                else if (_quickCreateKind == QuickCreateKind.GsmMaterial)
                {
                    <div class="field"><label>Наименование <span style="color:var(--bad)">*</span></label><input @bind="_qcName" class="field" placeholder="Наименование марки ГСМ" /></div>
                    <div class="field"><label>Тип <span style="color:var(--bad)">*</span></label><input @bind="_qcType" class="field" placeholder="Тип (Основные, Дублирующие и т.д.)" /></div>
                    <div class="field"><label>ГОСТ / ТУ</label><input @bind="_qcGost" class="field" placeholder="ГОСТ (необязательно)" /></div>
                    <div class="field"><label>Описание</label><textarea @bind="_qcDescription" rows="2" placeholder="Описание (необязательно)"></textarea></div>
                }
                @if (_quickCreateError != null)
                {
                    <div style="color:var(--bad);font-size:13px;margin-top:6px">@_quickCreateError</div>
