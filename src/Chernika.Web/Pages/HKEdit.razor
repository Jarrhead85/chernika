    /// <summary>
    /// Названия марок для отображения: марки, доступные для нового выбора, плюс
    /// уже сохранённые в карточке (они могут быть исключены из выбора
    /// переходным фильтром, но в существующей строке ХК должны оставаться
    /// читаемыми). Старые документы из-за нового фильтра не скрываются.
    /// </summary>
    private Dictionary<Guid, string> MaterialNames =>
        _materialNames ??= gsmMaterials.ToDictionary(m => m.Id, m => m.Name);

    private Dictionary<Guid, string>? _materialNames;

    /// <summary>
    /// Набор названий заполняется при загрузке карточки, а не в пути отрисовки:
    /// отображение не должно ходить в БД. Недоступные для выбора марки дочитываются
    /// через сервис — справочный просмотр не зависит от переходного ограничения
    /// новых назначений.
    /// </summary>
    private async Task LoadMaterialNamesAsync(CancellationToken ct)
    {
        var names = gsmMaterials.ToDictionary(m => m.Id, m => m.Name);

        var missing = card.Items
            .SelectMany(i => i.Materials)
            .Select(m => m.GsmMaterialId)
            .Where(id => id != Guid.Empty && !names.ContainsKey(id))
            .Distinct()
            .ToList();

        if (missing.Count > 0)
        {
            foreach (var (id, name) in await GsmMaterialService.GetNamesAsync(missing, ct))
                names[id] = name;
        }

        _materialNames = names;
    }

    /// <summary>
    /// Марки для выпадающего списка строки ХК. Поиск идёт по названию, НД, индексу
    /// НАТО, группе и любой подгруппе — прежний <c>Type</c> больше не читается
    /// (PR-5). Уже добавленные в эту же категорию марки скрыты, как и раньше.
    /// </summary>
    private IEnumerable<GsmMaterial> FilteredGsmMaterials(GsmCategory cat, HKCardItem item)
    {
        var search = _matSearch.GetValueOrDefault((item.Id, cat), "")?.Trim().ToLower() ?? "";
        var existingIds = item.Materials.Where(m => m.Category == cat).Select(m => m.GsmMaterialId).ToHashSet();
        var available = gsmMaterials.Where(m => !existingIds.Contains(m.Id));
        if (string.IsNullOrEmpty(search)) return available;
        return available.Where(m =>
            (m.Name?.ToLower().Contains(search) ?? false)
            || (m.Nd?.ToLower().Contains(search) ?? false)
            || (m.NatoIndex?.ToLower().Contains(search) ?? false)
            || m.Classifications.Any(c =>
                (c.GroupName?.ToLower().Contains(search) ?? false)
                || (c.SubgroupName?.ToLower().Contains(search) ?? false)));
    }

    /// <summary>
    /// Заголовок группы марки: одна группа и её подгруппы. У классифицированной
    /// марки группа одна (инвариант B), поэтому берётся первая по алфавиту;
    /// неклассифицированная марка в новый список не попадает, но подпись
    /// определена на все случаи.
    /// </summary>
    private static string GsmGroupLabel(GsmMaterial m)
    {
        var own = m.Classifications
            .Where(c => !string.IsNullOrWhiteSpace(c.GroupName))
            .ToList();
        if (own.Count == 0) return "Без классификации";
        var group = own.Select(c => c.GroupName).Distinct(StringComparer.Ordinal)
            .OrderBy(g => g, StringComparer.Ordinal).First();
        var subgroups = own.Select(c => c.SubgroupName)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(s => s, StringComparer.Ordinal)
            .ToList();
        return subgroups.Count > 0 ? $"{group}: {string.Join(", ", subgroups)}" : group;
    }

    /// <summary>
    /// Заголовок блока «Связано с …»: имя исходной марки. Читается из уже
    /// загруженного набора имён, поэтому historical-строка с удалённой маркой
    /// показывает название, а не «—».
