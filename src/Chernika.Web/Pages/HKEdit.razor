    private async Task ToggleAddChild()
    {
        _addChildOpen = !_addChildOpen;
        if (_addChildOpen)
        {
            _addChildSearch = "";
            _availableChildCards = new();
            _pendingChild = null;
            List<HKCardListItemDto> allCards;
            await using (await DbLock.WaitAsync())
            {
                var paged = await HKCardService.GetFilteredAsync();
                allCards = paged.Items.ToList();
            }
            var existingChildIds = _components.Select(c => c.ChildHKCardId).ToHashSet();
            existingChildIds.UnionWith(_pendingChildCards.Select(c => c.Id));
            existingChildIds.Add(card.Id);
            var allowedChildLevel = AllowedChildLevel;
            _availableChildCards = allCards
                .Where(c => c.Status == HKCardStatus.Approved
                            && (allowedChildLevel is null || c.ObjectLevel == allowedChildLevel.Value)
                            && !existingChildIds.Contains(c.Id))
                .OrderBy(c => c.Code)
                .ToList();
        }
    }

