@if (_previewOpen && IsNew && _pendingFile != null)
{
    <div class="modalOverlay" @onclick="ClosePendingPreview">
        <div class="modal hk-preview-modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Предпросмотр PDF</h3>
                <button type="button" class="linkBtn" @onclick="ClosePendingPreview">✕</button>
