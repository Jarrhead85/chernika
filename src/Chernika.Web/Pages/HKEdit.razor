    {
        _archiveReplacementCardId = _versions
            .Where(v => v.Id != card.Id && v.Status == HKCardStatus.Approved)
            .Select(v => (Guid?)v.Id)
            .FirstOrDefault() ?? Guid.Empty;
        _archiveReason = string.Empty;
        _archiveError = null;
        _showArchiveModal = true;
    }

    private void CloseArchiveModal()
    {
        _showArchiveModal = false;
        _archiveReplacementCardId = Guid.Empty;
        _archiveReason = string.Empty;
        _archiveError = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        var reason = _archiveReason?.Trim() ?? string.Empty;
        if (!isSystemAdmin)
        {
            if (string.IsNullOrWhiteSpace(reason))
            {
                _archiveError = "Укажите причину архивирования.";
                return;
            }
            if (_archiveReplacementCardId == Guid.Empty)
            {
                _archiveError = "Выберите заменяющую утверждённую ХК.";
                return;
            }
        }

        bool archived;
        string? error;
        await using (await DbLock.WaitAsync())
        {
            (archived, error) = await HKCardService.ArchiveAsync(card.Id, _archiveReplacementCardId, reason);
        }
        if (!archived)
        {
            _archiveError = error ?? "Не удалось заархивировать ХК.";
            return;
        }

        CloseArchiveModal();
        await ReloadForRouteAsync();
    }

