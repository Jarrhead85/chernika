    private void OpenArchiveModal()
    {
        _archiveReplacementCardId = _versions
            .Where(v => v.Id != card.Id && v.Status == HKCardStatus.Approved)
            .Select(v => (Guid?)v.Id)
            .FirstOrDefault() ?? Guid.Empty;
        _archiveReason = string.Empty;
        _archiveError = null;
        _showArchiveModal = true;
    }

    private void CloseArchiveModal()
    {
        _showArchiveModal = false;
        _archiveReplacementCardId = Guid.Empty;
        _archiveReason = string.Empty;
        _archiveError = null;
    }

    private async Task ConfirmArchiveAsync()
    {
        var reason = _archiveReason?.Trim() ?? string.Empty;
        if (!isSystemAdmin)
        {
            if (string.IsNullOrWhiteSpace(reason))
            {
                _archiveError = "Укажите причину архивирования.";
                return;
            }
            if (_archiveReplacementCardId == Guid.Empty)
            {
                _archiveError = "Выберите заменяющую утверждённую ХК.";
                return;
            }
        }

        bool archived;
        string? error;
        await using (await DbLock.WaitAsync())
        {
            (archived, error) = await HKCardService.ArchiveAsync(card.Id, _archiveReplacementCardId, reason);
        }
        if (!archived)
        {
            _archiveError = error ?? "Не удалось заархивировать ХК.";
            return;
        }

        CloseArchiveModal();
        await ReloadForRouteAsync();
    }

    private async Task CreateNewVersion()
    {
        errorMessage = null;
        bool success;
        Guid? newCardId;
        string? error;
        await using (await DbLock.WaitAsync())
        {
            (success, newCardId, error) = await HKCardService.CreateNewVersionAsync(card.Id);
        }
        if (!success || !newCardId.HasValue)
        {
            errorMessage = error ?? "Не удалось создать новую версию ХК.";
            return;
        }
        Nav.NavigateTo($"/хк/{newCardId.Value}");
    }

    /// <summary>
    /// Загружает состояния этапов и пересчитывает права по частям.
    /// <para>
    /// Права редактирования берутся из состояния этапов, а не только из
    /// HK.Work: на рассмотрении реквизитов реквизиты закрыты, а структура
    /// остаётся доступной.
    /// </para>
    /// </summary>
    private async Task LoadApprovalStateAsync(CancellationToken ct = default)
    {
        if (IsNew) return;

        await using (await DbLock.WaitAsync())
        {
            // Чтение этапов не создаёт их. Отсутствие этапов у карты нового
            // процесса — допустимое состояние до первой команды согласования.
            approvalStages = (await Approvals.GetStagesAsync(card.Id, ct)).ToList();
            canSubmit = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKSubmit, ct);

            var hasWork = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKWork, ct);

            // Отсутствие этапов разбирается наравне с их наличием: архивной и
            // удалённой карте возвращать полную редактируемость нельзя.
            var caps = HKApprovalService.DeriveEditingCapabilities(approvalStages, card.Status, hasWork);

            canEditDetails = caps.CanEditDetails;
            canEditComposition = caps.CanEditComposition;
            canEditPdf = caps.CanEditPdf;

            // Сведения о принятой структуре читаются ЧЕРЕЗ СЕРВИС: он проверяет
            // HK.View, активность и филиал, и берёт редакцию по указателю карты,
            // а не по последней созданной записи.
            var accepted = await Revisions.GetAcceptedAsync(card.Id, ct);
            acceptedRevisionNumber = accepted?.RevisionNumber;
            acceptedAtUtc = accepted?.AcceptedAtUtc;
        }

        // Общий флаг оставлен только для полей, не разделённых по частям.
        canEdit = canEditDetails || canEditComposition;
        canQuickCreate = canEditComposition;
    }

    /// <summary>Отправляет этап на согласование.</summary>
    private async Task SubmitStageAsync(HKApprovalStage stage)
    {
        errorMessage = null;

        string? approverUserId = null;
        if (stage == HKApprovalStage.Details)
        {
            if (string.IsNullOrWhiteSpace(_approverUserId))
            {
                errorMessage = "Выберите согласующего перед отправкой реквизитов.";
                return;
            }
            approverUserId = _approverUserId;
        }

        try
        {
            await using (await DbLock.WaitAsync())
            {
                // Передаётся версия, прочитанная при ЗАГРУЗКЕ экрана.
                if (stage == HKApprovalStage.Details)
                    await Approvals.SubmitDetailsAsync(card.Id, approverUserId!, loadedRowVersion);
                else
                    await Approvals.SubmitCompositionAsync(card.Id, loadedRowVersion);
            }

            await ReloadAfterDecisionAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException
                                      or ArgumentException)
        {
            // При конфликте решение НЕ повторяется со свежей версией: иначе
            // действие со старого экрана прошло бы как новое. Сообщение
            // остаётся на экране вместе с несохранённым вводом.
            errorMessage = ex.Message;
        }
        catch (HKCardValidationException ex)
        {
            errorMessage = ex.ToUserMessage();
        }

        StateHasChanged();
    }

    /// <summary>Принимает или возвращает этап.</summary>
    private async Task DecideStageAsync(HKApprovalStage stage, bool approve)
    {
        errorMessage = null;

        try
        {
            await using (await DbLock.WaitAsync())
            {
                // Версия загрузки, а не свежая: см. SubmitStageAsync.
                var version = loadedRowVersion;
                if (stage == HKApprovalStage.Details)
                {
                    if (approve)
                        await Approvals.ApproveDetailsAsync(card.Id, null, version);
                    else
                        await Approvals.ReturnDetailsAsync(card.Id, null, version);
                }
                else
                {
                    if (approve)
                        await Approvals.ApproveCompositionAsync(card.Id, null, version);
                    else
                        await Approvals.ReturnCompositionAsync(card.Id, null, version);
                }
            }

            await ReloadAfterDecisionAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException
                                      or ArgumentException)
        {
            errorMessage = ex.Message;
        }

        StateHasChanged();
    }

    /// <summary>
    /// После успешной команды карта и этапы перечитываются, а сохранённая
    /// версия обновляется: следующая команда с этого экрана должна быть
    /// основана на новом состоянии.
    /// </summary>
    private async Task ReloadAfterDecisionAsync()
    {
        var cardId = card.Id;
        await LoadCardAsync(cardId, default);
        loadedRowVersion = card.RowVersion;
        await LoadApprovalStateAsync();
    }

    private string _approverUserId = "";
    private List<ApplicationUser> branchApprovers = new();

    private async Task<List<ApplicationUser>> GetBranchApproversAsync()
    {
        var users = await UserManager.Users
            .Where(u => u.IsActive && u.BranchId == card.BranchId)
            .OrderBy(u => u.FullName)
            .ToListAsync();

        return users;
    }

    private async Task SaveCard()
    {
        if (!canEdit) return;

        errorMessage = null;

        if (IsAutonomousMode)
        {
            // Структура сохраняется отдельной атомарной командой. Пока есть
            // несохранённые правки дерева,tracked граф нельзя записывать через
            // реквизитный путь: это обошло бы проверки структуры и разделов.
            if (_structureDirty)
            {
                errorMessage = StructureDirtyWarning;
                return;
            }
            // Автономная карта: справочный объект не нужен, номер формирует
            // сервер из названия.
            //
            // Уровень и режим присваиваются ТОЛЬКО при создании. Undefined —
            // начальное значение: выводом уровня по структуре он позже будет
            // заменён на реальный, и повторное присваивание при каждой правке
            // реквизитов затирало бы этот результат.
            card.IsAutonomous = true;
            if (IsNew)
            {
                card.ObjectLevel = HKObjectLevel.Undefined;
            }
            card.ComplexId = null;
            card.EquipmentModelId = null;
            card.AggregateId = null;
            card.NodeId = null;

            if (string.IsNullOrWhiteSpace(card.Name))
            {
                errorMessage = "Укажите название ХК.";
                return;
            }
        }
        else
        {
            card.IsAutonomous = false;
            card.ObjectLevel = selectedLevel;
            card.ComplexId = selectedLevel == HKObjectLevel.Complex ? selectedComplexId : null;
            card.EquipmentModelId = selectedLevel == HKObjectLevel.EquipmentModel ? selectedModelId : null;
            card.AggregateId = selectedLevel == HKObjectLevel.Aggregate ? selectedAggregateId : null;
            card.NodeId = selectedLevel == HKObjectLevel.Node ? selectedNodeId : null;

            var hasObject = selectedLevel switch
            {
                HKObjectLevel.Complex => selectedComplexId != Guid.Empty,
                HKObjectLevel.EquipmentModel => selectedModelId != Guid.Empty,
                HKObjectLevel.Aggregate => selectedAggregateId != Guid.Empty,
                HKObjectLevel.Node => selectedNodeId != Guid.Empty,
                _ => false
            };
            if (!hasObject)
            {
                errorMessage = "Необходимо выбрать объект нормирования.";
                return;
            }
        }

        card.Status = IsNew ? HKCardStatus.Draft : card.Status;

        if (string.IsNullOrWhiteSpace(card.Version))
        {
            errorMessage = "Поле «Версия» обязательно для заполнения.";
            return;
        }

        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (isSystemAdmin && IsNew)
        {
            if (!Guid.TryParse(_adminBranchId, out var adminBranchId) || adminBranchId == Guid.Empty)
            {
                errorMessage = "Укажите организацию для создания ХК.";
                return;
            }
            card.BranchId = adminBranchId;
        }
        else if (!string.IsNullOrEmpty(userId))
        {
            ApplicationUser? user;
            await using (await DbLock.WaitAsync())
            {
                user = await UserManager.FindByIdAsync(userId);
            }
            if (user?.BranchId != null)
                card.BranchId = user.BranchId.Value;
        }

        if (selectedLevel == HKObjectLevel.Node)
        {
            foreach (var item in card.Items)
            {
                if (string.IsNullOrEmpty(item.UnitOfMeasure)) item.UnitOfMeasure = "г";
            }

            var emptyAu = card.Items.FirstOrDefault(i => i.AssemblyUnitId == Guid.Empty);
            if (emptyAu != null)
            {
                errorMessage = "Укажите сборочную единицу во всех строках таблицы.";
                return;
            }

            var order = 1;
            foreach (var item in card.Items)
                item.SortOrder = order++;
        }

        if (card.EffectiveDate.HasValue && card.ExpirationDate.HasValue
            && card.ExpirationDate.Value < card.EffectiveDate.Value)
        {
            errorMessage = "Дата окончания действия не может быть раньше даты начала действия.";
            return;
        }

        try
        {
            await using (await DbLock.WaitAsync())
            {
                if (IsNew && _createdCardId is null)
                {
                    await HKCardService.CreateAsync(card);
                    _createdCardId = card.Id;
                }
                else
                {
                    await HKCardService.UpdateAsync(card);
                }
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (HKCardValidationException ex)
        {
            errorMessage = ex.ToUserMessage();
            return;
        }
        catch (DbUpdateException)
        {
            errorMessage = "Не удалось сохранить ХК. Проверьте заполнение " +
                "всех обязательных полей и повторите попытку.";
            return;
        }

        if (_createdCardId.HasValue && _pendingChildCards.Count > 0)
        {
            // Дочерние ХК, добавленные до сохранения, записываем сразу после создания карты.
            string? failedChild = null;
            await using (await DbLock.WaitAsync())
            {
                foreach (var child in _pendingChildCards.ToList())
                {
                    try
                    {
                        await HKCardService.AddComponentAsync(card.Id, child.Id);
                        _pendingChildCards.Remove(child);
                    }
                    catch (Exception ex)
                    {
                        failedChild = $"{child.Code} — {ex.Message}";
                        break;
                    }
                }

                if (_pendingChildCards.Count == 0)
                    _components = await HKCardService.GetComponentsAsync(card.Id);
            }

            if (failedChild is not null)
            {
                errorMessage = $"Черновик ХК сохранён, но дочернюю ХК не удалось добавить: {failedChild}";
                return;
            }
        }

        if (IsNew && selectedLevel == HKObjectLevel.EquipmentModel
            && selectedMilitaryBranchIds.Count > 0 && card.Id != Guid.Empty)
        {
            // CreateAsync не сохраняет военные ветки — фиксируем выбор после создания.
            try
            {
                await using (await DbLock.WaitAsync())
                {
                    await EquipmentService.SetHKCardMilitaryBranchesAsync(card.Id, selectedMilitaryBranchIds);
                }
            }
            catch (Exception ex)
            {
                errorMessage = "Черновик ХК сохранён, но род войск не удалось сохранить: " + ex.Message;
                return;
            }
        }

        if (IsNew && _pendingFile != null && card.Id != Guid.Empty)
        {
            await UploadAttachment();

            if (!string.IsNullOrEmpty(_attachmentError))
            {
                errorMessage = "Черновик ХК сохранён, но PDF-файл не удалось прикрепить. " +
                               "Исправьте ошибку и повторите загрузку.";
                return;
            }
        }

        // Автономная карта открывается сразу: её номер сформирован сервером при
        // создании, и пользователь должен увидеть настоящий номер и введённое
        // название, а не пустую форму.
        if (card.IsAutonomous && card.Id != Guid.Empty)
        {
            Nav.NavigateTo($"/хк/{card.Id}");
            return;
        }

        Nav.NavigateTo("/реестр-хк");
    }

