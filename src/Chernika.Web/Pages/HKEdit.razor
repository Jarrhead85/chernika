        if (days < 0)
            return $"Срок действия истёк {AppTime.Fmt(expiration, "dd.MM.yyyy")}";
        if (days == 0)
            return $"Срок действия истекает сегодня ({AppTime.Fmt(expiration, "dd.MM.yyyy")})";
