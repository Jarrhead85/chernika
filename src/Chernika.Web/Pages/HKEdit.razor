@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "nodeId")] public Guid? NodeId { get; set; }

    private HKCard card = new()
    {
        Id = Guid.NewGuid(),
        Version = "v" + DateTime.UtcNow.ToString("MMyy"),
        Items = new List<HKCardItem>(),
        BranchId = Guid.Empty,
        CreatedAt = DateTime.UtcNow,
        UpdatedAt = DateTime.UtcNow,
    };

    private string statusStr = "Draft";
    private HKObjectLevel selectedLevel = HKObjectLevel.Node;
    private Guid selectedComplexId;
    private Guid selectedModelId;
    private Guid selectedAggregateId;
    private Guid selectedNodeId;
    private List<Complex> complexes = new();
    private List<EquipmentModel> models = new();
    private List<Aggregate> aggregates = new();
    private List<Node> nodes = new();
    private List<AssemblyUnit> assemblyUnits = new();
    private string? _activeCardWarning;
    private HKCard? _existingActiveCard;
    private bool IsNew => Id == null || Id == Guid.Empty;
    private bool canEdit;
    private bool canSendToApprove;
    private bool canApprove;
    private bool canReturn;
    private bool canArchive;
    private string currentUserId = "";
    private string? errorMessage;
    private bool showReturnModal;
    private string returnComment = string.Empty;
    private string? returnCommentError;

    private List<GsmMaterial> gsmMaterials = new();
    private Guid? _focusItemId;
    private Dictionary<Guid, string> _auSearch = new();
    private Dictionary<Guid, bool> _auOpen = new();
    private Dictionary<(Guid, GsmCategory), bool> _matOpen = new();
    private Dictionary<(Guid, GsmCategory), string> _matSearch = new();
    private string? _activeDropdownId;
    private bool _disposed;
    private DotNetObjectReference<HKEdit> _dotNetRef = null!;

    private List<MilitaryBranch> allMilitaryBranches = new();
    private List<Guid> selectedMilitaryBranchIds = new();
    private bool _mbDropOpen;
    private string _mbSearch = "";

    private AttachmentInfo? _attachment;
    private bool _uploading;
    private string? _attachmentError;
    private IBrowserFile? _pendingFile;
    private int _fileInputKey;
    private bool _previewPending;
    private bool _previewOpen;

    private bool CanSelectAttachment => canEdit && (IsNew || card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired);
    private bool CanManageAttachment => !IsNew && canEdit && card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired;

    private record AttachmentInfo(Guid Id, string OriginalFileName, long SizeBytes, string? UploadedByUserName, DateTime UploadedAt);

    private bool _objectDropOpen;
    private string _objectSearch = "";
    private Guid? _loadedCardId;

    private List<HKCardComponentDto> _components = new();
    private List<AggregatedRowDto> _aggregatedRows = new();
    private bool _addChildOpen;
    private string _addChildSearch = "";
    private List<HKCardListItemDto> _availableChildCards = new();
    private Guid? _pendingChildId;

    private enum QuickCreateKind { Node, AssemblyUnit, GsmMaterial }
    private QuickCreateKind? _quickCreateKind;
    private bool _quickCreateSaving;
    private string? _quickCreateError;
    private string _qcCode = "";
    private string _qcName = "";
    private string _qcDescription = "";
    private string _qcGost = "";
    private string _qcType = "";
    private Guid? _quickCreateItemUiKey;
    private GsmCategory? _quickCreateCategory;
    private bool canQuickCreate;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await JS.InvokeVoidAsync("dropdownPortal.cleanup");
            await JS.InvokeVoidAsync("hkPdfPreview.clear", "hk-pdf-preview");
        }
        catch { /* ignore — page is unloading */ }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_previewPending && !_disposed && IsNew && _pendingFile != null)
        {
            _previewPending = false;
            try
            {
                var stream = _pendingFile.OpenReadStream(maxAllowedSize: FileOptions.Value.MaxPdfSizeBytes);
                await JS.InvokeVoidAsync("hkPdfPreview.load", new DotNetStreamReference(stream), "hk-pdf-preview");
            }
            catch { /* preview is best-effort */ }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        canSendToApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKNodeSubmit)
            || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKAggregateSubmit)
            || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKEquipmentSubmit)
            || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKComplexSubmit);
        canApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKApprove);
        canReturn = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKReview);
        canArchive = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKArchive);

        complexes = await EquipmentService.GetComplexesAsync();
        models = await EquipmentService.GetModelsAsync();
        aggregates = await EquipmentService.GetAggregatesAsync();
        nodes = await EquipmentService.GetNodesAsync();
        assemblyUnits = await EquipmentService.GetAssemblyUnitsAsync();
        gsmMaterials = await EquipmentService.GetGsmMaterialsAsync();
        allMilitaryBranches = await EquipmentService.GetMilitaryBranchesAsync();

        if (NodeId.HasValue && NodeId.Value != Guid.Empty)
        {
            selectedLevel = HKObjectLevel.Node;
            selectedNodeId = NodeId.Value;
        }
        else if (IsNew)
        {
            selectedLevel = HKObjectLevel.Node;
            selectedNodeId = Guid.Empty;
        }

        if (!IsNew && Id.HasValue)
        {
            await LoadCardAsync(Id.Value);
            _loadedCardId = Id;
        }
        else
        {
            canEdit = await Perms.HasPermissionAsync(currentUserId, selectedLevel == HKObjectLevel.Node ? PermissionCodes.HKNodeEditDraft :
                selectedLevel == HKObjectLevel.Aggregate ? PermissionCodes.HKAggregateEditDraft :
                selectedLevel == HKObjectLevel.EquipmentModel ? PermissionCodes.HKEquipmentEditDraft :
                PermissionCodes.HKComplexEditDraft);
            canQuickCreate = canEdit;

            if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
            {
                card.Items.Add(new HKCardItem
                {
                    Id = Guid.NewGuid(),
                    HKCardId = card.Id,
                    AssemblyUnitId = Guid.Empty,
                    Quantity = 1,
                    Volume = 1.000m,
                    UnitOfMeasure = "кг",
                    SortOrder = 1
                });
            }

            InitItemDicts();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNew && Id.HasValue && Id != _loadedCardId)
        {
            await LoadCardAsync(Id.Value);
            _loadedCardId = Id;
        }
    }

    private async Task LoadCardAsync(Guid cardId)
    {
        var existing = await HKCardService.GetByIdAsync(cardId);
        if (existing == null) return;

        card = existing;
        selectedLevel = card.ObjectLevel;
        selectedComplexId = card.ComplexId ?? Guid.Empty;
        selectedModelId = card.EquipmentModelId ?? Guid.Empty;
        selectedAggregateId = card.AggregateId ?? Guid.Empty;
        selectedNodeId = card.NodeId ?? Guid.Empty;
        statusStr = card.Status.ToString();

        var canEditLevel = await Perms.HasPermissionAsync(currentUserId,
            card.ObjectLevel == HKObjectLevel.Node ? PermissionCodes.HKNodeEditDraft :
            card.ObjectLevel == HKObjectLevel.Aggregate ? PermissionCodes.HKAggregateEditDraft :
            card.ObjectLevel == HKObjectLevel.EquipmentModel ? PermissionCodes.HKEquipmentEditDraft :
            PermissionCodes.HKComplexEditDraft);
        canEdit = canEditLevel && card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired;
        canQuickCreate = canEdit;

        if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
        {
            card.Items.Add(new HKCardItem
            {
                Id = Guid.NewGuid(),
                HKCardId = card.Id,
                AssemblyUnitId = Guid.Empty,
                Quantity = 1,
                Volume = 1.000m,
                UnitOfMeasure = "кг",
                SortOrder = 1
            });
        }

        InitItemDicts();

        if (selectedLevel != HKObjectLevel.Node)
        {
            _components = await HKCardService.GetComponentsAsync(cardId);
            _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(cardId);
        }

        if (selectedLevel == HKObjectLevel.EquipmentModel)
        {
            var cardBranches = await EquipmentService.GetHKCardMilitaryBranchesAsync(cardId);
            selectedMilitaryBranchIds = cardBranches.Select(b => b.Id).ToList();
        }

        await LoadAttachmentAsync(cardId);
    }

    private async Task LoadAttachmentAsync(Guid cardId)
    {
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var response = await http.GetAsync($"/api/HKCards/{cardId}/attachment");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadFromJsonAsync<AttachmentInfo>();
                _attachment = json;
            }
            else
            {
                _attachment = null;
            }
        }
        catch
        {
            _attachment = null;
        }
    }

    private async Task CloseActiveDropdownAsync()
    {
        if (_activeDropdownId != null)
        {
            await JS.InvokeVoidAsync("dropdownPortal.detach", _activeDropdownId);
            _activeDropdownId = null;
        }
        _objectDropOpen = false;
        _mbDropOpen = false;
        foreach (var key in _matOpen.Keys.ToList())
            _matOpen[key] = false;
        foreach (var key in _auOpen.Keys.ToList())
            _auOpen[key] = false;
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await CloseActiveDropdownAsync();
                StateHasChanged();
            }
            catch
            {
                // ignore — circuit may be shutting down
            }
        });
    }

    private void InitItemDicts()
    {
        _auSearch = card.Items.ToDictionary(i => i.Id, i => "");
        _auOpen = card.Items.ToDictionary(i => i.Id, _ => false);
        _matOpen = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => false);
        _matSearch = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => "");
    }

    private void AddItem()
    {
        var maxOrder = card.Items.Any() ? card.Items.Max(i => i.SortOrder) : 0;
        var item = new HKCardItem
        {
            Id = Guid.NewGuid(),
            HKCardId = card.Id,
            AssemblyUnitId = Guid.Empty,
            Quantity = 1,
            Volume = 1.000m,
            UnitOfMeasure = "кг",
            SortOrder = maxOrder + 1
        };
        card.Items.Add(item);
        _auSearch[item.Id] = "";
        _auOpen[item.Id] = false;
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen[(item.Id, cat)] = false;
            _matSearch[(item.Id, cat)] = "";
        }
        _focusItemId = item.Id;
    }

    private void MoveItem(HKCardItem item, int direction)
    {
        var sorted = card.Items.OrderBy(i => i.SortOrder).ToList();
        var idx = sorted.IndexOf(item);
        if (idx < 0) return;
        var target = idx + direction;
        if (target < 0 || target >= sorted.Count) return;
        (sorted[target].SortOrder, item.SortOrder) = (item.SortOrder, sorted[target].SortOrder);
    }

    private void GoBack() => Nav.NavigateTo("/реестр-хк");

    private async Task SendToApprove()
    {
        errorMessage = null;
        var (sent, error) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.OnReview, "Отправлена на проверку");
        if (sent)
        {
            card.Status = HKCardStatus.OnReview;
        }
        else if (!string.IsNullOrEmpty(error))
        {
            errorMessage = error;
        }
    }

    private async Task ApproveCard()
    {
        var (approved, _) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.Approved, "Утверждена");
        if (approved) card.Status = HKCardStatus.Approved;
    }

    private void ReturnForRevision()
    {
        returnComment = string.Empty;
        returnCommentError = null;
        showReturnModal = true;
    }

    private async Task ConfirmReturn()
    {
        if (string.IsNullOrWhiteSpace(returnComment))
        {
            returnCommentError = "Укажите причину возврата";
            return;
        }

        showReturnModal = false;

        var (returned, _) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.RevisionRequired, returnComment.Trim());
        if (returned)
        {
            card.Status = HKCardStatus.RevisionRequired;
            var existing = await HKCardService.GetByIdAsync(card.Id);
            if (existing != null)
            {
                card = existing;
                statusStr = card.Status.ToString();
            }
        }
    }

    private async Task ArchiveCard()
    {
        var (archived, _) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.Archived, "Переведена в архив");
        if (archived) card.Status = HKCardStatus.Archived;
    }

    private async Task SaveCard()
    {
        if (!canEdit) return;

        errorMessage = null;

        card.ObjectLevel = selectedLevel;
        card.ComplexId = selectedLevel == HKObjectLevel.Complex ? selectedComplexId : null;
        card.EquipmentModelId = selectedLevel == HKObjectLevel.EquipmentModel ? selectedModelId : null;
        card.AggregateId = selectedLevel == HKObjectLevel.Aggregate ? selectedAggregateId : null;
        card.NodeId = selectedLevel == HKObjectLevel.Node ? selectedNodeId : null;
        card.Status = IsNew ? HKCardStatus.Draft : card.Status;

        if (string.IsNullOrWhiteSpace(card.Code))
        {
            errorMessage = "Поле «Номер ХК» обязательно для заполнения.";
            return;
        }

        var hasObject = selectedLevel switch
        {
            HKObjectLevel.Complex => selectedComplexId != Guid.Empty,
            HKObjectLevel.EquipmentModel => selectedModelId != Guid.Empty,
            HKObjectLevel.Aggregate => selectedAggregateId != Guid.Empty,
            HKObjectLevel.Node => selectedNodeId != Guid.Empty,
            _ => false
        };
        if (!hasObject)
        {
            errorMessage = "Необходимо выбрать объект нормирования.";
            return;
        }
        if (string.IsNullOrWhiteSpace(card.Version))
        {
            errorMessage = "Поле «Версия» обязательно для заполнения.";
            return;
        }

        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user?.BranchId != null)
                card.BranchId = user.BranchId.Value;
        }

        if (card.BranchId == Guid.Empty)
        {
            var branches = await EquipmentService.GetBranchesAsync();
            var branch = branches.FirstOrDefault();
            card.BranchId = branch?.Id ?? Guid.Empty;
        }

        if (selectedLevel == HKObjectLevel.Node)
        {
            foreach (var item in card.Items)
            {
                if (string.IsNullOrEmpty(item.UnitOfMeasure)) item.UnitOfMeasure = "кг";
            }

            var emptyAu = card.Items.FirstOrDefault(i => i.AssemblyUnitId == Guid.Empty);
            if (emptyAu != null)
            {
                errorMessage = "Укажите сборочную единицу во всех строках таблицы.";
                return;
            }

            var order = 1;
            foreach (var item in card.Items)
                item.SortOrder = order++;
        }

        if (card.EffectiveDate.HasValue && card.ExpirationDate.HasValue
            && card.ExpirationDate.Value < card.EffectiveDate.Value)
        {
            errorMessage = "Дата окончания действия не может быть раньше даты начала действия.";
            return;
        }

        try
        {
            if (IsNew)
                await HKCardService.CreateAsync(card);
            else
                await HKCardService.UpdateAsync(card);
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (HKCardValidationException ex)
        {
            errorMessage = ex.ToUserMessage();
            return;
        }
        catch (DbUpdateException)
        {
            errorMessage = "Не удалось сохранить ХК. Проверьте заполнение " +
                "всех обязательных полей и повторите попытку.";
            return;
        }

        if (IsNew && _pendingFile != null && card.Id != Guid.Empty)
        {
            await UploadAttachment();

            if (!string.IsNullOrEmpty(_attachmentError))
            {
                errorMessage = "Черновик ХК сохранён, но PDF-файл не удалось прикрепить. " +
                               "Исправьте ошибку и повторите загрузку.";
                return;
            }
        }

        Nav.NavigateTo("/реестр-хк");
    }

