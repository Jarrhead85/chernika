    private async Task UploadAttachment()
    {
        if (card.Id == Guid.Empty) return;
        if (!canEdit) return;
        if (card.Status is not (HKCardStatus.Draft or HKCardStatus.RevisionRequired)) return;
        if (_pendingFile == null) return;

        _attachmentError = null;
        _uploading = true;
        StateHasChanged();

        var pending = _pendingFile;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                using var stream = new MemoryStream(pending.Content);
                var info = await HKCardService.SaveAttachmentAsync(
                    card.Id, stream, pending.Name, pending.ContentType, pending.Size);
                _attachment = new AttachmentInfo(info.Id, info.OriginalFileName, info.SizeBytes,
                    info.UploadedByUserName, info.UploadedAt);
            }

            _pendingFile = null;
            _fileInputKey++;
        }
        catch (UnauthorizedAccessException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось загрузить вложение ХК {CardId}", card.Id);
            _attachmentError = "Не удалось выполнить операцию с вложением.";
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAttachment()
    {
        if (_attachment == null) return;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                await HKCardService.DeleteAttachmentAsync(card.Id);
            }
            _attachment = null;
            _fileInputKey++;
        }
        catch (UnauthorizedAccessException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _attachmentError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Не удалось удалить вложение ХК {CardId}", card.Id);
            _attachmentError = "Не удалось выполнить операцию с вложением.";
        }
        StateHasChanged();
    }

