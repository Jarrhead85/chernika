    };

    private bool _qcFormValid => _quickCreateKind switch
    {
        QuickCreateKind.Node => !string.IsNullOrWhiteSpace(_qcCode) && !string.IsNullOrWhiteSpace(_qcName),
        QuickCreateKind.AssemblyUnit => !string.IsNullOrWhiteSpace(_qcCode) && !string.IsNullOrWhiteSpace(_qcName),
        QuickCreateKind.GsmMaterial => !string.IsNullOrWhiteSpace(_qcName)
            && !string.IsNullOrWhiteSpace(_qcGroup)
            && !string.IsNullOrWhiteSpace(_qcSubgroup),
