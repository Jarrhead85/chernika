    private async Task SaveQuickCreateAsync()
    {
        _quickCreateSaving = true;
        _quickCreateError = null;
        StateHasChanged();

        try
        {
            switch (_quickCreateKind)
            {
                case QuickCreateKind.Node:
                {
                    Node created;
                    await using (await DbLock.WaitAsync())
                    {
                        created = await EquipmentService.CreateNodeAsync(new Node
                        {
                            Code = _qcCode.Trim(),
                            Name = _qcName.Trim(),
                            Description = string.IsNullOrWhiteSpace(_qcDescription) ? null : _qcDescription.Trim()
                        });
                        nodes = await EquipmentService.GetNodesAsync();
                        if (IsNew)
                        {
                            card.Code = await HKCardService.GenerateCodeForNodeAsync(created.Id);
                            _existingActiveCard = await HKCardService.GetActiveCardForNodeAsync(created.Id);
                        }
                    }
                    selectedNodeId = created.Id;
                    card.NodeId = created.Id;
                    if (IsNew)
                    {
                        _activeCardWarning = _existingActiveCard != null
                            ? $"Для узла уже есть активная ХК «{_existingActiveCard.Code}» в статусе «{TranslateStatus(_existingActiveCard.Status)}»."
                            : null;
                    }
                    break;
                }
                case QuickCreateKind.AssemblyUnit:
                {
                    AssemblyUnit created;
                    await using (await DbLock.WaitAsync())
                    {
                        created = await EquipmentService.CreateAssemblyUnitAsync(new AssemblyUnit
                        {
                            Code = _qcCode.Trim(),
                            Name = _qcName.Trim(),
                            Description = string.IsNullOrWhiteSpace(_qcDescription) ? null : _qcDescription.Trim()
                        });
                        assemblyUnits = await EquipmentService.GetAssemblyUnitsAsync();
                    }
                    if (_quickCreateItemUiKey.HasValue)
                    {
                        var item = card.Items.FirstOrDefault(i => i.Id == _quickCreateItemUiKey.Value);
                        if (item != null) await SelectAu(item, created);
                    }
                    break;
                }
                case QuickCreateKind.GsmMaterial:
                {
                    Guid createdId;
                    await using (await DbLock.WaitAsync())
                    {
                        // Quick-create публикует марку сразу, поэтому классификация
                        // обязательна: сервис не примет запись без группы и подгруппы.
                        var created = await GsmMaterialService.CreateAsync(new GsmMaterialWriteRequest
                        {
                            Name = _qcName.Trim(),
                            Nd = string.IsNullOrWhiteSpace(_qcGost) ? null : _qcGost.Trim(),
                            IntendedUse = string.IsNullOrWhiteSpace(_qcDescription) ? null : _qcDescription.Trim(),
                            GroupName = _qcGroup.Trim(),
                            SubgroupNames = new List<string> { _qcSubgroup.Trim() }
                        });
                        createdId = created.Id;
                        gsmMaterials = await GsmMaterialService.GetActiveForSelectionAsync();
                        _materialNames = null;
                        await LoadMaterialNamesAsync(CancellationToken.None);
                    }
                    if (_quickCreateItemUiKey.HasValue && _quickCreateCategory.HasValue)
                    {
                        var item = card.Items.FirstOrDefault(i => i.Id == _quickCreateItemUiKey.Value);
                        if (item != null) await AddMaterial(item, _quickCreateCategory.Value, createdId);
                    }
                    break;
                }
            }
            CloseQuickCreateModal();
        }
        catch (Exception ex)
        {
            _quickCreateError = ex.Message;
        }
        finally
        {
            _quickCreateSaving = false;
            StateHasChanged();
        }
    }
