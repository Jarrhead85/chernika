    /// <summary>Выбор или замена файла: на сохранённой карте сразу загружаем, на новой — копим до сохранения.</summary>
    private async Task HandleAttachmentUpload(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        try
        {
            var maxBytes = FileOptions.Value.MaxPdfSizeBytes > 0
                ? FileOptions.Value.MaxPdfSizeBytes
                : 20L * 1024 * 1024;

            // Читаем файл сразу, пока InputFile ещё в DOM: после замены поля на чип
            // поток IBrowserFile прочитать уже нельзя.
            var file = e.File;
            using var buffer = new MemoryStream();
            await using (var source = file.OpenReadStream(maxAllowedSize: maxBytes))
            {
                await source.CopyToAsync(buffer);
            }
            _pendingFile = new PendingFile(buffer.ToArray(), file.Name, file.ContentType, file.Size);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось прочитать выбранный PDF-файл");
            _pendingFile = null;
            _fileInputKey++;
            _attachmentError = "Не удалось прочитать выбранный файл.";
            return;
        }

        if (!IsNew)
        {
            await UploadAttachment();

            // Не удалось загрузить — возвращаем поле в прежнее состояние с ошибкой.
            if (!string.IsNullOrEmpty(_attachmentError))
            {
                _pendingFile = null;
                _fileInputKey++;
            }
            return;
        }

        StateHasChanged();
    }

    /// <summary>Предпросмотр несохранённого файла в отдельной вкладке.</summary>
    private async Task OpenPendingPreviewAsync()
    {
        if (_pendingFile == null) return;
        try
        {
            var stream = new MemoryStream(_pendingFile.Content);
            await JS.InvokeVoidAsync("hkPdfPreview.openInNewTab", new DotNetStreamReference(stream));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось открыть предпросмотр PDF");
            _attachmentError = "Не удалось открыть предпросмотр PDF.";
        }
    }

