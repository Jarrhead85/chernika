    private IEnumerable<AssemblyUnit> FilteredAssemblyUnits(Guid itemId)
    {
        var search = _auSearch.GetValueOrDefault(itemId, "")?.Trim().ToLower() ?? "";
        if (string.IsNullOrEmpty(search)) return assemblyUnits;
