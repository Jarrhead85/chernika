    private async Task SelectObject(string display)
    {
        var objectId = Guid.Empty;
        switch (selectedLevel)
        {
            case HKObjectLevel.Complex:
                var c = complexes.FirstOrDefault(x => $"{x.Code} — {x.Name}" == display);
                if (c != null) { selectedComplexId = c.Id; card.ComplexId = c.Id; objectId = c.Id; }
                break;
            case HKObjectLevel.EquipmentModel:
                var m = models.FirstOrDefault(x => $"{x.Index} — {x.Name}" == display);
                if (m != null) { selectedModelId = m.Id; card.EquipmentModelId = m.Id; objectId = m.Id; }
                break;
            case HKObjectLevel.Aggregate:
                var a = aggregates.FirstOrDefault(x => $"{x.Code} — {x.Name}" == display);
                if (a != null) { selectedAggregateId = a.Id; card.AggregateId = a.Id; objectId = a.Id; }
                break;
            case HKObjectLevel.Node:
                var n = nodes.FirstOrDefault(x => $"{x.Code} — {x.Name}" == display);
                if (n != null) { selectedNodeId = n.Id; card.NodeId = n.Id; objectId = n.Id; }
                break;
        }
        _objectSearch = display;
        await CloseActiveDropdownAsync();
        if (IsNew && objectId != Guid.Empty)
        {
            await using (await DbLock.WaitAsync())
            {
                card.Code = await HKCardService.GenerateCodeForObjectAsync(selectedLevel, objectId);
                _existingActiveCard = await HKCardService.GetActiveCardForObjectAsync(selectedLevel, objectId);
            }
            _activeCardWarning = _existingActiveCard != null
                ? $"Для {LevelName(selectedLevel).ToLowerInvariant()} уже есть активная ХК «{_existingActiveCard.Code}» в статусе «{TranslateStatus(_existingActiveCard.Status)}»."
                : null;
        }
        StateHasChanged();
    }

