            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="CloseQuickCreateModal">Отмена</button>
                <button type="button" class="btn primary" @onclick="SaveQuickCreateAsync"
                        disabled="@(_quickCreateSaving || !_qcFormValid)">
                    @(_quickCreateSaving ? "Сохранение..." : "Создать")
                </button>
            </div>
        </div>
    </div>
}

@if (showReturnModal)
{
    <div class="modalOverlay" @onclick="() => showReturnModal = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Вернуть на доработку</h3>
