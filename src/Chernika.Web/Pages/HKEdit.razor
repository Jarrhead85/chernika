    private async Task SelectObject(string display)
    {
        switch (selectedLevel)
        {
            case HKObjectLevel.Complex:
                var c = complexes.FirstOrDefault(x => $"{x.Code} — {x.Name}" == display);
                if (c != null) { selectedComplexId = c.Id; card.ComplexId = c.Id; }
                break;
            case HKObjectLevel.EquipmentModel:
                var m = models.FirstOrDefault(x => $"{x.Index} — {x.Name}" == display);
                if (m != null) { selectedModelId = m.Id; card.EquipmentModelId = m.Id; }
                break;
            case HKObjectLevel.Aggregate:
                var a = aggregates.FirstOrDefault(x => $"{x.Code} — {x.Name}" == display);
                if (a != null) { selectedAggregateId = a.Id; card.AggregateId = a.Id; }
                break;
            case HKObjectLevel.Node:
                var n = nodes.FirstOrDefault(x => $"{x.Code} — {x.Name}" == display);
                if (n != null) { selectedNodeId = n.Id; card.NodeId = n.Id; }
                break;
        }
        _objectSearch = display;
        await CloseActiveDropdownAsync();
        if (IsNew && selectedLevel == HKObjectLevel.Node && selectedNodeId != Guid.Empty)
        {
            card.Code = await HKCardService.GenerateCodeForNodeAsync(selectedNodeId);
            _existingActiveCard = await HKCardService.GetActiveCardForNodeAsync(selectedNodeId);
            _activeCardWarning = _existingActiveCard != null
                ? $"Для узла уже есть активная ХК «{_existingActiveCard.Code}» в статусе «{TranslateStatus(_existingActiveCard.Status)}»."
                : null;
        }
        StateHasChanged();
    }

    private void ClearObject()
    {
        selectedComplexId = Guid.Empty;
        selectedModelId = Guid.Empty;
        selectedAggregateId = Guid.Empty;
        selectedNodeId = Guid.Empty;
        card.ComplexId = null;
        card.EquipmentModelId = null;
        card.AggregateId = null;
        card.NodeId = null;
        _objectSearch = "";
        _activeCardWarning = null;
        _existingActiveCard = null;
        _ = CloseActiveDropdownAsync();
        StateHasChanged();
    }

    private IEnumerable<string> GetFilteredObjects()
    {
        var search = _objectSearch?.Trim().ToLower() ?? "";
        IEnumerable<string> items = selectedLevel switch
        {
            HKObjectLevel.Complex => complexes.Select(x => $"{x.Code} — {x.Name}"),
            HKObjectLevel.EquipmentModel => models.Select(x => $"{x.Index} — {x.Name}"),
            HKObjectLevel.Aggregate => aggregates.Select(x => $"{x.Code} — {x.Name}"),
            HKObjectLevel.Node => nodes.Select(x => $"{x.Code} — {x.Name}"),
            _ => Enumerable.Empty<string>()
        };
        if (string.IsNullOrEmpty(search)) return items;
        return items.Where(x => x.ToLower().Contains(search));
    }

    private string? GetSelectedObject()
    {
        return selectedLevel switch
        {
            HKObjectLevel.Complex => complexes.FirstOrDefault(x => x.Id == selectedComplexId) is { } c ? $"{c.Code} — {c.Name}" : null,
            HKObjectLevel.EquipmentModel => models.FirstOrDefault(x => x.Id == selectedModelId) is { } m ? $"{m.Index} — {m.Name}" : null,
            HKObjectLevel.Aggregate => aggregates.FirstOrDefault(x => x.Id == selectedAggregateId) is { } a ? $"{a.Code} — {a.Name}" : null,
            HKObjectLevel.Node => nodes.FirstOrDefault(x => x.Id == selectedNodeId) is { } n ? $"{n.Code} — {n.Name}" : null,
            _ => null
        };
    }

    private void SelectLevel(HKObjectLevel level)
    {
        selectedLevel = level;
        ClearObject();
        if (IsNew)
        {
            card.ObjectLevel = level;
            card.Items.Clear();
            _focusItemId = null;
            if (level == HKObjectLevel.Node)
            {
                card.Items.Add(new HKCardItem
                {
                    Id = Guid.NewGuid(),
                    HKCardId = card.Id,
                    AssemblyUnitId = Guid.Empty,
                    Quantity = 1,
                    Volume = 1.000m,
                    UnitOfMeasure = "кг",
                    SortOrder = 1
                });
                InitItemDicts();
            }
        }
    }

