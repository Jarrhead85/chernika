    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("dropdownPortal.cleanup");
        }
        catch { /* ignore — page is unloading */ }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        isSystemAdmin = await Permissions.IsSystemAdminAsync();

        // Проверки прав и чтение организаций выполняются через общий scoped DbContext,
        // поэтому сериализуем их тем же CircuitDbLock, что и загрузку данных.
        await using (await DbLock.WaitAsync())
        {
            if (isSystemAdmin)
            {
                allBranches = await HKCardService.GetAllBranchesAsync();
            }
            canSendToApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKNodeSubmit)
                || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKAggregateSubmit)
                || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKEquipmentSubmit)
                || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKComplexSubmit);
            canApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKApprove);
            canReturn = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKReview);
            canArchive = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKArchive);

            // Создание и редактирование — единое право HK.Work: уровень карты
            // и её режим условием не являются. Отправка на согласование,
            // проверка, утверждение и архивирование остались на своих правах.
            canCreateNewVersion = canWork = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKWork);
            canCreateNode = canCreateAggregate = canCreateEquipmentModel = canCreateComplex = canWork;
        }

        await using (await DbLock.WaitAsync())
        {
            complexes = await EquipmentService.GetComplexesAsync();
            models = await EquipmentService.GetModelsAsync();
            aggregates = await EquipmentService.GetAggregatesAsync();
            nodes = await EquipmentService.GetNodesAsync();
            assemblyUnits = await EquipmentService.GetAssemblyUnitsAsync();
            gsmMaterials = await GsmMaterialService.GetActiveForSelectionAsync();
            _materialNames = null;
            await LoadMaterialNamesAsync(CancellationToken.None);
            // Предложения связанных ГСМ НЕ загружаются здесь: они появляются
            // сразу после явного выбора основной марки в строке. Предзагрузка по
            // сохранённым строкам была причиной дефекта — марка, выбранная позже,
            // не знала своих связей до перезагрузки страницы.
            _suggestions.Clear();
            _suggestionErrors.Clear();
            _suggestionOpen.Clear();
            _suggestionPicked.Clear();
            _suggestionLoading.Clear();
            DismissSuggestionAdded();
            allMilitaryBranches = await EquipmentService.GetMilitaryBranchesAsync();
        }

        if (!IsNew && Id.HasValue)
            await ReloadForRouteAsync();
        else
            await InitCreateModeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew || !Id.HasValue)
        {
            if (_loadedCardId != null)
                await InitCreateModeAsync();
            return;
        }

        if (Id != _loadedCardId)
            await ReloadForRouteAsync();
    }

    private async Task ReloadForRouteAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        var requestedId = Id!.Value;

        _loading = true;
        errorMessage = null;
        // Набор марок карточки сменился — кэш названий сбрасывается.
        _materialNames = null;

        Logger.LogInformation("HKEdit.LoadCardAsync начало: {Id}", requestedId);

        try
        {
            await LoadCardAsync(requestedId, ct);
            await LoadMaterialNamesAsync(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            Logger.LogInformation("HKEdit.LoadCardAsync отменена: {Id}", requestedId);
            return;
        }
        catch (Exception ex)
        {
            if (!ct.IsCancellationRequested && requestedId == Id)
            {
                Logger.LogWarning(ex, "HKEdit.LoadCardAsync ошибка: {Id}", requestedId);
                errorMessage = ex.Message;
                card = CreateEmptyCard();
                InitItemDicts();
                ResetEditingFlags();
                canQuickCreate = false;
            }
            return;
        }

        if (ct.IsCancellationRequested) return;

        _loadedCardId = requestedId;
        _loading = false;
        Logger.LogInformation("HKEdit.LoadCardAsync завершение: {Id}", requestedId);
    }

    private async Task InitCreateModeAsync()
    {
        _loading = true;
        errorMessage = null;
        card = CreateEmptyCard();
        statusStr = "Draft";
        _existingActiveCard = null;
        _activeCardWarning = null;
        _attachment = null;
        _components = new();
        _aggregatedRows = new();
        // Новая карта: разделов нет, редактор начинается с пустой структуры.
        InitStructureState();
        _availableChildCards = new();
        _pendingChild = null;
        _pendingChildCards.Clear();
        _createdCardId = null;
        _addChildOpen = false;
        _addChildSearch = "";
        selectedMilitaryBranchIds = new();
        _loadedCardId = null;

        // Уровень автономной карты не выбирается и не подставляется по умолчанию:
        // он определяется структурой, а структуры пока нет.
        selectedLevel = HKObjectLevel.Undefined;
        selectedComplexId = Guid.Empty;
        selectedModelId = Guid.Empty;
        selectedAggregateId = Guid.Empty;
        selectedNodeId = Guid.Empty;

        bool canWorkNew;
        await using (await DbLock.WaitAsync())
        {
            canWorkNew = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKWork);
        }

        // У новой карты этапов нет, и блокировать нечего: редактируемость всех
        // частей определяется правом HK.Work. Флаги задаются здесь явно —
        // оставленные по умолчаниюtrue сделали бы поля редактируемыми и без права.
        canEditDetails = canWorkNew;
        canEditComposition = canWorkNew;
        canEditPdf = canWorkNew;
        canEdit = canEditDetails || canEditComposition;
        canQuickCreate = canEditComposition;

        // Автономная карта сохраняется с пустой структурой, поэтому строка
        // состава заранее не создаётся: её добавит редактор дерева.
        if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
        {
            card.Items.Add(new HKCardItem
            {
                Id = Guid.NewGuid(),
                HKCardId = card.Id,
                AssemblyUnitId = Guid.Empty,
                Quantity = 0,
                Volume = 0m,
                UnitOfMeasure = "г",
                SortOrder = 1
            });
        }

        InitItemDicts();
        _loading = false;
    }

    private async Task LoadCardAsync(Guid cardId, CancellationToken ct)
    {
        try
        {
            await LoadCardCoreAsync(cardId, ct);
            await LoadAttachmentAsync(cardId, ct);
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
            ResetEditingFlags();
            canQuickCreate = false;
            _existingActiveCard = null;
            _activeCardWarning = null;
            _attachment = null;
            _components = new();
            _aggregatedRows = new();
            _loading = false;
        }
    }

    private async Task LoadCardCoreAsync(Guid cardId, CancellationToken ct)
    {
        await using (await DbLock.WaitAsync(ct))
        {
            var existing = await HKCardService.GetByIdAsync(cardId, ct);
            if (ct.IsCancellationRequested) return;

            if (existing == null)
            {
                Logger.LogWarning("HKEdit.LoadCardAsync: ХК не найдена или нет доступа: {Id}", cardId);
                errorMessage = "ХК не найдена или у вас нет доступа.";
                card = CreateEmptyCard();
                InitItemDicts();
                ResetEditingFlags();
                canQuickCreate = false;
                _existingActiveCard = null;
                _activeCardWarning = null;
                _attachment = null;
                _components = new();
                _aggregatedRows = new();
                _loading = false;
                return;
            }

            card = existing;
            loadedRowVersion = existing.RowVersion;
            _versions = await HKCardService.GetVersionsAsync(cardId, ct);
            selectedLevel = card.ObjectLevel;
            selectedComplexId = card.ComplexId ?? Guid.Empty;
            selectedModelId = card.EquipmentModelId ?? Guid.Empty;
            selectedAggregateId = card.AggregateId ?? Guid.Empty;
            selectedNodeId = card.NodeId ?? Guid.Empty;
            statusStr = card.Status.ToString();
            // Разделы и локальное состояние редактора структуры — вместе с картой.
            InitStructureState();

            await LoadApprovalStateAsync(ct);
            if (canSubmit)
            {
                await using var approverLock = await DbLock.WaitAsync();
                branchApprovers = await GetBranchApproversAsync();
            }

            // Общий флаг выводится из флагов частей, вычисленных этапами в
            // LoadApprovalStateAsync. Перезаписывать его здесь прежней проверкой
            // «карта в черновике или на доработке» нельзя: во время рассмотрения
            // реквизитов такая проверка запрещала бы автору работать с составом,
            // а во время рассмотрения состава — с реквизитами.
            if (ct.IsCancellationRequested) return;
            canEdit = canEditDetails || canEditComposition;
            canQuickCreate = canEditComposition;

            if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
            {
                card.Items.Add(new HKCardItem
                {
                    Id = Guid.NewGuid(),
                    HKCardId = card.Id,
                    AssemblyUnitId = Guid.Empty,
                    Quantity = 0,
                    Volume = 0m,
                    UnitOfMeasure = "г",
                    SortOrder = 1
                });
            }

            InitItemDicts();

            if (selectedLevel != HKObjectLevel.Node)
            {
                _components = await HKCardService.GetComponentsAsync(cardId, ct);
                _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(cardId, ct);
            }

            if (selectedLevel == HKObjectLevel.EquipmentModel)
            {
                var cardBranches = await EquipmentService.GetHKCardMilitaryBranchesAsync(cardId, ct);
                if (ct.IsCancellationRequested) return;
                selectedMilitaryBranchIds = cardBranches.Select(b => b.Id).ToList();
            }
        }
    }

    private async Task LoadAttachmentAsync(Guid cardId, CancellationToken ct)
    {
        try
        {
            AttachmentInfo? loaded = null;
            await using (await DbLock.WaitAsync(ct))
            {
                var info = await HKCardService.GetAttachmentInfoAsync(cardId, ct);
                loaded = info is null
                    ? null
                    : new AttachmentInfo(info.Id, info.OriginalFileName, info.SizeBytes,
                        info.UploadedByUserName, info.UploadedAt);
            }
            _attachment = loaded;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // маршрут уже изменился
        }
        catch (UnauthorizedAccessException)
        {
            _attachment = null;
        }
        catch (InvalidOperationException)
        {
            _attachment = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось загрузить вложение ХК {CardId}", cardId);
            _attachment = null;
        }
    }

    private async Task CloseActiveDropdownAsync()
    {
        if (_activeDropdownId != null)
        {
            try
            {
                await JS.InvokeVoidAsync("dropdownPortal.detach", _activeDropdownId);
            }
            catch (JSDisconnectedException)
            {
                // circuit завершается — просто сбрасываем состояние
            }
            catch (ObjectDisposedException)
            {
            }
            catch (JSException)
            {
                // JS-модуль уже недоступен, состояние всё равно сбрасываем
            }
            _activeDropdownId = null;
        }
        _objectDropOpen = false;
        _mbDropOpen = false;
        foreach (var key in _matOpen.Keys.ToList())
            _matOpen[key] = false;
        foreach (var key in _auOpen.Keys.ToList())
            _auOpen[key] = false;
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await CloseActiveDropdownAsync();
                StateHasChanged();
            }
            catch
            {
                // игнорируем — circuit может завершаться
            }
        });
    }

    private void InitItemDicts()
    {
        _auSearch = card.Items.ToDictionary(i => i.Id, i => "");
        _auOpen = card.Items.ToDictionary(i => i.Id, _ => false);
        _matOpen = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => false);
        _matSearch = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => "");
    }

    private void AddItem()
    {
        var maxOrder = card.Items.Any() ? card.Items.Max(i => i.SortOrder) : 0;
        var item = new HKCardItem
        {
            Id = Guid.NewGuid(),
            HKCardId = card.Id,
            AssemblyUnitId = Guid.Empty,
            Quantity = 0,
            Volume = 0m,
            UnitOfMeasure = "г",
            SortOrder = maxOrder + 1
        };
        card.Items.Add(item);
        _auSearch[item.Id] = "";
        _auOpen[item.Id] = false;
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen[(item.Id, cat)] = false;
            _matSearch[(item.Id, cat)] = "";
        }
        _focusItemId = item.Id;
    }

    private void MoveItem(HKCardItem item, int direction)
    {
        var sorted = card.Items.OrderBy(i => i.SortOrder).ToList();
        var idx = sorted.IndexOf(item);
        if (idx < 0) return;
        var target = idx + direction;
        if (target < 0 || target >= sorted.Count) return;
        (sorted[target].SortOrder, item.SortOrder) = (item.SortOrder, sorted[target].SortOrder);
    }

    // ── Редактор собственной структуры ─────────────────────────────
    // Локальное состояние редактора: изменения разделов, позиций и строк
    // остаются на экране до явного атомарного сохранения
    // (SaveHKCardStructureCommand), а не записываются цепочкой команд.

    /// <summary>Разделы карты в порядке их отображения.</summary>
    private List<HKCardSection> _sections = new();

    /// <summary>Активный выбор панели: тип раздела для НОВОЙ верхней ветки.</summary>
    private HKCardSectionType? _newBranchSection;

    /// <summary>Свернутые позиции: вложенность скрыта, номера остаются по полной структуре.</summary>
    private Dictionary<Guid, bool> _collapsed = new();

    /// <summary>Выбранный уровень следующей дочерней позиции.</summary>
    private Dictionary<Guid, HKObjectLevel> _childLevelChoice = new();

    /// <summary>Позиция, ожидающая подтверждения удаления.</summary>
    private Guid? _confirmDeletePositionId;

    /// <summary>Ошибка серверной проверки структуры, показанная над таблицей.</summary>
    private string? _structureError;

    /// <summary>В структуре есть несохранённые локальные изменения.</summary>
    private bool _structureDirty;

    /// <summary>Выбор уровня верхнего узла. Роковой выбор сбрасывается, когда он перестаёт быть применимым.</summary>
    private HKObjectLevel? _nodeRootChoice;

    /// <summary>Уровень следующей верхней позиции.</summary>
    private HKObjectLevel _topPositionLevel = HKObjectLevel.Aggregate;

    private void InitStructureState()
    {
        _sections = card.Sections.OrderBy(s => s.SortOrder).ToList();
        _structureDirty = false;
        _nodeRootChoice = card.NodeRootCardLevel;
        _collapsed.Clear();
        _childLevelChoice.Clear();
        _confirmDeletePositionId = null;
        _topPositionLevel = HKObjectLevel.Aggregate;
    }

    /// <summary>Строка редактора: номер из доменного механизма плюс ссылка на данные.</summary>
    private sealed record EditorRow(
        HKStructureRow Row, HKCardNode? Node, HKCardItem? Item, int Index, bool HasChildren);

    /// <summary>Входные данные доменного механизма: разделы, позиции, строки.</summary>
    private HKStructureInput BuildStructureInput() => new(
        _sections.Select(s => new HKStructureSectionInput(s.Id, s.SectionType, s.SortOrder)).ToList(),
        card.TreeNodes.Select(n => new HKStructureNodeInput(
            n.Id, n.ParentId, n.Level, n.Name, n.Quantity, n.SortOrder,
            // Раздел фиксируется только у верхней позиции: вложенная наследует.
            n.ParentId is null ? n.SectionId : null)).ToList(),
        card.Items.Select(i => new HKStructureItemInput(
            i.Id, i.HKCardNodeId, i.Quantity, i.Volume, i.UnitOfMeasure, i.SortOrder,
            i.HKCardNodeId is null ? i.SectionId : null)).ToList());

    /// <summary>
    /// Видимые строки редактора: иерархическое представление с учётом
    /// сворачивания. Номера остаются по полной структуре.
    /// </summary>
    private IReadOnlyList<EditorRow> EditorRows()
    {
        var rows = HKStructureNumbering.Build(BuildStructureInput());
        var nodesById = card.TreeNodes.ToDictionary(n => n.Id);
        var itemsById = card.Items.ToDictionary(i => i.Id);

        var result = new List<EditorRow>();
        var hiddenBelow = -1;

        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            if (hiddenBelow >= 0 && row.Depth > hiddenBelow)
                continue;
            hiddenBelow = -1;

            switch (row.Kind)
            {
                case HKStructureRowKind.Section:
                    result.Add(new EditorRow(row, null, null, i, false));
                    break;
                case HKStructureRowKind.Position:
                    var nodeId = row.NodeId!.Value;
                    result.Add(new EditorRow(row, nodesById[nodeId], null, i, CountChildRows(nodeId) > 0));
                    if (IsCollapsed(nodeId))
                        hiddenBelow = row.Depth;
                    break;
                default:
                    result.Add(new EditorRow(row, null, itemsById[row.ItemId!.Value], i, false));
                    break;
            }
        }

        return result;
    }

