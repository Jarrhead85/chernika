    private void ReturnForRevision()
    {
        returnComment = string.Empty;
        returnCommentError = null;
        showReturnModal = true;
    }

    private async Task ConfirmReturn()
    {
        showReturnModal = false;

        bool returned;
        await using (await DbLock.WaitAsync())
        {
            (returned, _) = await HKCardService.ChangeStatusAsync(
                card.Id, HKCardStatus.RevisionRequired, string.IsNullOrWhiteSpace(returnComment) ? null : returnComment.Trim());
        }
        if (returned)
        {
            card.Status = HKCardStatus.RevisionRequired;
            HKCard? existing;
            await using (await DbLock.WaitAsync())
            {
                existing = await HKCardService.GetByIdAsync(card.Id);
