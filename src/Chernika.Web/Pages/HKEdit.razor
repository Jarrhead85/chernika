@page "/хк/создать"
@page "/хк/{Id:guid}"
@attribute [Authorize(Policy = "ViewHK")]
@implements IAsyncDisposable
@using Chernika.Domain
@using Chernika.Domain.Models
@using Chernika.Domain.Structure
@using Chernika.Domain.Leveling
@using Chernika.Domain.Enums
@inject HKCardService HKCardService
@inject IPermissionService Permissions
@inject NavigationManager Nav
@inject EquipmentService EquipmentService
@inject GsmMaterialService GsmMaterialService
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.Extensions.Options
@using Chernika.Web.Services
@using Chernika.Web.Pages.Structure
@inject IPermissionService Perms
@inject IJSRuntime JS
@inject IOptions<FileStorageOptions> FileOptions
@inject ILogger<HKEdit> Logger
@inject CircuitDbLock DbLock
@inject HKApprovalService Approvals
@inject HKCardRevisionService Revisions
@inject TimeProvider TimeProvider

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>@PageTitleText()</h2>
            @if (!string.IsNullOrWhiteSpace(card.Name))
            {
                <div class="hint">@card.Name</div>
            }
            <div class="hint mono">@card.Code</div>
            <div class="hint">@card.Version</div>
            @if (!IsNew)
            {
                <StatusBadge Status="@card.Status" />
            }
        </div>
        <div class="panelBody">
            @if (_loadState == HkEditLoadState.Loading)
            {
                <div class="loading-state">Загрузка...</div>
            }
            else if (_loadState == HkEditLoadState.NotFound)
            {
                <div class="note" role="alert">
                    <b>ХК не найдена.</b>
                    Возможно, она удалена или ссылка устарела.
                    <div style="margin-top:8px;display:flex;gap:6px">
                        <button type="button" class="btn ghost" @onclick="RetryLoadAsync">Повторить загрузку</button>
                        <a class="btn ghost" href="/реестр-хк">В реестр ХК</a>
                    </div>
                </div>
            }
            else if (_loadState == HkEditLoadState.Forbidden)
            {
                <div class="note" role="alert">
                    <b>Нет доступа к этой ХК.</b>
                    @(_loadErrorText)
                    <div style="margin-top:8px;display:flex;gap:6px">
                        <a class="btn ghost" href="/реестр-хк">В реестр ХК</a>
                    </div>
                </div>
            }
            else if (_loadState == HkEditLoadState.Error)
            {
                <div class="error" role="alert">
                    <b>Не удалось загрузить карту.</b>
                    @(_loadErrorText)
                    <div style="margin-top:8px;display:flex;gap:6px">
                        <button type="button" class="btn ghost" @onclick="RetryLoadAsync">Повторить загрузку</button>
                        <a class="btn ghost" href="/реестр-хк">В реестр ХК</a>
                    </div>
                </div>
            }
            else
            {
            <EditForm Model="@card" OnValidSubmit="SaveCard">
                <DataAnnotationsValidator />
                <div class="form">
                    <div class="hk-form-row hk-form-row--request">
                        <div class="field">
                            <label for="hk-request-organization">Организация</label>
                            @if (canEditDetails)
                            {
                                <InputText id="hk-request-organization" @bind-Value="card.RequestOrganization" class="fieldInput" />
                            }
                            else
                            {
                                <div class="readonlyValue">@(card.RequestOrganization ?? "")</div>
                            }
                        </div>
                        <div class="field">
                            <label for="hk-request-sender">ФИО отправителя</label>
                            @if (canEditDetails)
                            {
                                <InputText id="hk-request-sender" @bind-Value="card.RequestSenderFullName" class="fieldInput" />
                            }
                            else
                            {
                                <div class="readonlyValue">@(card.RequestSenderFullName ?? "")</div>
                            }
                        </div>
                        <div class="field">
                            <label for="hk-request-date">Дата поступления</label>
                            @if (canEditDetails)
                            {
                                <InputDate id="hk-request-date" @bind-Value="card.RequestReceivedDate" class="fieldInput" />
                            }
                            else
                            {
                                <div class="readonlyValue">@(AppTime.FmtOr(card.RequestReceivedDate, "dd.MM.yyyy", ""))</div>
                            }
                        </div>
                        <div class="field hk-letter-numbers-field">
                            <label>Номер документа</label>
                            <div class="hk-letter-numbers @(canEditDetails ? "hk-letter-numbers--editable" : null)" role="group" aria-label="Номера входящего и исходящего документов">
                                <div class="hk-letter-number-part">
                                    <label class="sr-only" for="hk-incoming-letter">Входящий номер</label>
                                    @if (canEditDetails)
                                    {
                                        <InputText id="hk-incoming-letter" @bind-Value="card.IncomingLetterNumber" class="fieldInput" placeholder="Входящий" />
                                    }
                                    else
                                    {
                                        <div class="readonlyValue">@(card.IncomingLetterNumber ?? "")</div>
                                    }
                                </div>
                                <div class="hk-letter-number-part">
                                    <label class="sr-only" for="hk-outgoing-letter">Исходящий номер</label>
                                    @if (canEditDetails)
                                    {
                                        <InputText id="hk-outgoing-letter" @bind-Value="card.OutgoingLetterNumber" class="fieldInput" placeholder="Исходящий" />
                                    }
                                    else
                                    {
                                        <div class="readonlyValue">@(card.OutgoingLetterNumber ?? "")</div>
                                    }
                                </div>
                            </div>
                        </div>
                        @* Род войск виден у карты любого уровня и заполняется
                           по желанию: согласование его не требует. *@
                        @if (selectedLevel == HKObjectLevel.EquipmentModel || IsAutonomousMode)
                        {
                        <div class="field hk-mb-field">
                            <label>Род войск</label>
                            @if (selectedMilitaryBranchIds.Any())
                            {
                                <div class="hki-tags-row">
                                    @foreach (var mbId in selectedMilitaryBranchIds)
                                    {
                                        var mb = allMilitaryBranches.FirstOrDefault(b => b.Id == mbId);
                                        if (mb != null)
                                        {
                                            <span class="hki-mat-tag hki-mb-tag">
                                                <span>@mb.Name</span>
                                                @if (canEditDetails)
                                                {
                                                    <button type="button" class="hki-tag-remove" @onclick="() => RemoveMilitaryBranch(mbId)">×</button>
                                                }
                                            </span>
                                        }
                                    }
                                </div>
                            }
                            else if (!canEditDetails)
                            {
                                <div class="readonlyValue"></div>
                            }
                            @if (canEditDetails && !selectedMilitaryBranchIds.Any())
                            {
                                var mbDropId = "mb-drop";
                                var mbBtnId = "mb-btn";
                                <div id="@mbBtnId" class="field-select hki-mb-select" @onclick="() => ToggleMbDropdown(mbDropId, mbBtnId)">
                                    <span>Добавить род войск...</span>
                                </div>
                                @if (_mbDropOpen)
                                {
                                    <div id="@mbDropId" class="gsm-dropdown">
                                        <input class="gsm-dropdown-search" @bind="_mbSearch" @oninput="() => { }" placeholder="Поиск..." />
                                        @foreach (var mb in FilteredMilitaryBranches())
                                        {
                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => AddMilitaryBranch(mb.Id)">@mb.ArmedForcesType — @mb.Name</div>
                                        }
                                        @if (!FilteredMilitaryBranches().Any())
                                        {
                                            <div class="hki-search-empty">Нет совпадений</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        }
                        <div class="field hk-pdf-field">
                            <label>PDF-скан исходной ХК</label>
                            @{ var pdfError = !string.IsNullOrEmpty(_attachmentError); }
                            @if (_attachment != null)
                            {
                                <div class="fieldInput hki-pdf-chip @(pdfError ? "hki-pdf-chip--error" : null)"
                                     title="@AttachmentChipTitle">
                                    <button type="button" class="hki-pdf-name" title="@_attachment.OriginalFileName" @onclick="OpenAttachmentPreview">📄 @_attachment.OriginalFileName</button>
                                    <span class="hki-pdf-size">@FormatSize(_attachment.SizeBytes)</span>
                                    @if (_uploading)
                                    {
                                        <span class="hki-pdf-size">Загрузка…</span>
                                    }
                                    <button type="button" class="hki-pdf-icon" title="Скачать" @onclick="DownloadAttachment">⤓</button>
                                    @if (canEditPdf && CanManageAttachment)
                                    {
                                        <label class="hki-pdf-icon" title="Заменить">
                                            <InputFile @key="_fileInputKey" OnChange="HandleAttachmentUpload" accept="application/pdf,.pdf" class="hki-file-input" />
                                        </label>
                                        <button type="button" class="hki-pdf-icon hki-pdf-icon--danger" title="Удалить" @onclick="DeleteAttachment">🗑</button>
                                    }
                                    @if (pdfError)
                                    {
                                        <span class="hki-pdf-icon hki-pdf-icon--danger" title="@_attachmentError">⚠</span>
                                    }
                                </div>
                            }
                            else if (_pendingFile != null)
                            {
                                <div class="fieldInput hki-pdf-chip hki-pdf-chip--pending @(pdfError ? "hki-pdf-chip--error" : null)"
                                     title="@PendingChipTitle">
                                    <button type="button" class="hki-pdf-name" title="@_pendingFile.Name" @onclick="OpenPendingPreviewAsync">📄 @_pendingFile.Name</button>
                                    <span class="hki-pdf-size">@FormatSize(_pendingFile.Size)</span>
                                    @if (_uploading)
                                    {
                                        <span class="hki-pdf-size">Загрузка…</span>
                                    }
                                    <button type="button" class="hki-pdf-icon" title="Убрать" @onclick="ClearPendingAttachment">×</button>
                                    @if (pdfError)
                                    {
                                        <span class="hki-pdf-icon hki-pdf-icon--danger" title="@_attachmentError">⚠</span>
                                    }
                                </div>
                            }
                            else if (canEditPdf && CanSelectAttachment)
                            {
                                <label class="fieldInput hki-pdf-empty @(pdfError ? "hki-pdf-chip--error" : null)"
                                       title="@_attachmentError">
                                    <span>📄 Выбрать файл</span>
                                    @if (pdfError)
                                    {
                                        <span class="hki-pdf-icon hki-pdf-icon--danger" title="@_attachmentError">⚠</span>
                                    }
                                    <InputFile @key="_fileInputKey" OnChange="HandleAttachmentUpload" accept="application/pdf,.pdf" class="hki-file-input" />
                                </label>
                            }
                            else
                            {
                                <div class="fieldInput hki-pdf-chip hki-pdf-chip--empty">
                                    <span class="hki-pdf-size">Файл не прикреплён</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_attachmentError))
                            {
                                <div class="hk-attachment-message hk-attachment-message--error" role="alert">@_attachmentError</div>
                            }
                            else if (!string.IsNullOrEmpty(_attachmentNotice))
                            {
                                <div class="hk-attachment-message" role="status">@_attachmentNotice</div>
                            }
                            @if (_attachmentConfirmAction != AttachmentConfirmation.None)
                            {
                                <div class="hk-delete-confirm" role="dialog" aria-label="Подтверждение изменения основания">
                                    <span>
                                        @(_attachmentConfirmAction == AttachmentConfirmation.Replace
                                            ? "Заменить PDF-основание? Изменение сбросит согласование по прежнему файлу."
                                            : "Удалить PDF-основание? Изменение сбросит согласование по прежнему файлу.")
                                        <b>Потребуется повторное согласование реквизитов и состава.</b>
                                    </span>
                                    <div class="hk-delete-confirm-actions">
                                        <button type="button" class="btn hki-danger" @onclick="ConfirmAttachmentAction">Подтвердить</button>
                                        <button type="button" class="btn" @onclick="CancelAttachmentAction">Отмена</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="hk-form-row hk-form-row--object">
                        <div class="field hk-request-details-field">
                            <label for="hk-request-details">Реквизиты</label>
                            @if (canEditDetails)
                            {
                                <InputTextArea id="hk-request-details" @bind-Value="card.RequestDetails" class="fieldInput" />
                            }
                            else
                            {
                                <div class="readonlyValue readonlyValueMultiline">@(card.RequestDetails ?? "")</div>
                            }
                        </div>
                        @if (!IsAutonomousMode)
                        {
                        <div class="field">
                            <label>Уровень объекта</label>
                            <div class="hk-level-segmented" role="tablist" aria-label="Уровень объекта">
                                @foreach (var lvl in GetVisibleLevels())
                                {
                                    var active = selectedLevel == lvl;
                                    <button type="button"
                                            class="hk-level-segmented-item @(active ? "active" : "")"
                                            role="tab" aria-selected="@active.ToString().ToLower()"
                                            disabled="@(!IsNew || !canEditDetails)"
                                            @onclick="() => SelectLevel(lvl)">
                                        @LevelName(lvl)
                                    </button>
                                }
                                @if (!GetVisibleLevels().Any())
                                {
                                    <div class="note">Нет прав для создания ХК ни на одном уровне.</div>
                                }
                            </div>
                        </div>
                        <div class="field">
                            <label>@ObjectFieldLabel()</label>
                            @{
                                var objectEntity = GetSelectedObject();
                                var objDropId = "obj-drop";
                                var objBtnId = "obj-btn";
                            }
                            @if (canEditDetails)
                            {
                                <div id="@objBtnId" class="field-select" style="cursor:pointer;display:flex;align-items:center;justify-content:space-between" @onclick="() => ToggleObjectDropdown(objDropId, objBtnId)">
                                    <span style="flex:1">@(objectEntity != null ? objectEntity : "Выбрать...")</span>
                                    @if (objectEntity != null)
                                    {
                                        <button type="button" style="background:none;border:none;cursor:pointer;color:var(--bad);font-size:16px;line-height:1;padding:0;flex-shrink:0" @onclick="ClearObject" @onclick:stopPropagation="true">×</button>
                                    }
                                </div>
                            @if (_objectDropOpen)
                            {
                                <div id="@objDropId" class="gsm-dropdown">
                                    <input class="gsm-dropdown-search" @bind="_objectSearch" @oninput="() => { }" placeholder="Поиск..." />
                                    @if (canQuickCreate && selectedLevel == HKObjectLevel.Node)
                                    {
                                        <button type="button" class="gsm-dropdown-create" @onmousedown:preventDefault="true" @onclick="() => { CloseAllDropdownsSync(); OpenQuickCreateNode(); }">
                                            <span aria-hidden="true">+</span> @(string.IsNullOrWhiteSpace(_objectSearch) ? "Создать новый" : $"Создать «{_objectSearch}»")
                                        </button>
                                    }
                                    <div class="gsm-dropdown-divider" role="separator"></div>
                                    @foreach (var obj in GetFilteredObjects())
                                    {
                                        <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectObject(obj)">@obj</div>
                                    }
                                    @if (!GetFilteredObjects().Any())
                                    {
                                        <div class="hki-search-empty">Нет совпадений</div>
                                    }
                                </div>
                            }
                            }
                            else
                            {
                                <div class="readonlyValue">@(objectEntity ?? "")</div>
                            }
                            @if (!string.IsNullOrEmpty(_activeCardWarning) && _existingActiveCard != null)
                            {
                                <div class="note" style="margin-top:6px;font-size:12px;color:var(--warn)">
                                    @_activeCardWarning
                                    <button type="button" class="linkBtn" @onclick="GoToExistingCard" style="text-decoration:underline;margin-left:4px;font-size:12px">Перейти к существующей ХК</button>
                                </div>
                            }
                        </div>
                        }
                        else
                        {
                        <div class="field">
                            <label for="hk-card-name">Название ХК</label>
                            @if (canEditDetails)
                            {
                                <InputText id="hk-card-name" @bind-Value="card.Name" class="fieldInput"
                                           placeholder="Например: Насосный агрегат" />
                            }
                            else
                            {
                                <div class="readonlyValue">@(card.Name ?? "")</div>
                            }
                        </div>
                        }
                        <div class="field">
                            <label>Номер ХК</label>
                            @if (IsNew)
                            {
                                <div class="readonlyValue">формируется при сохранении</div>
                            }
                            else
                            {
                                <div class="readonlyValue">@(card.Code ?? "")</div>
                            }
                        </div>
                    </div>

                    <div class="hk-form-row hk-form-row--description">
                        <div class="field">
                            <label>Назначение ХК</label>
                            @if (canEditDetails)
                            {
                                <InputTextArea @bind-Value="card.Purpose" class="fieldInput hk-resizable-textarea" />
                            }
                            else
                            {
                                <div class="readonlyValue readonlyValueMultiline">@(card.Purpose ?? "")</div>
                            }
                        </div>
                        <div class="field">
                            <label>Примечание</label>
                            @if (canEditDetails)
                            {
                                <InputTextArea @bind-Value="card.Notes" class="fieldInput hk-resizable-textarea" />
                            }
                            else
                            {
                                <div class="readonlyValue readonlyValueMultiline">@(card.Notes ?? "")</div>
                            }
                        </div>
                    </div>

                    <div class="hk-form-row hk-form-row--dates">
                        <div class="field">
                            <label>Дата начала действия</label>
                            @if (canEditDetails)
                            {
                                <InputDate @bind-Value="card.EffectiveDate" class="fieldInput" />
                            }
                            else
                            {
                                <div class="readonlyValue">@(AppTime.FmtOr(card.EffectiveDate, "dd.MM.yyyy", ""))</div>
                            }
                        </div>
                        <div class="field">
                            <label>Дата окончания действия</label>
                            @if (canEditDetails)
                            {
                                <InputDate @bind-Value="card.ExpirationDate" AdditionalAttributes="@ExpirationDateAttributes()" />
                            }
                            else
                            {
                                <div class="readonlyValue">@(AppTime.FmtOr(card.ExpirationDate, "dd.MM.yyyy", ""))</div>
                            }
                        </div>
                    </div>

                    @* Этап реквизитов — над разделительной чертой двух частей,
                       под полями дат действия. *@
                    @if (!IsNew)
                    {
                        <div class="hk-editor-part-head hk-editor-part-head--requisites">
                            <span class="hk-stage-label">@StagePartTitle(HKApprovalStage.Details)</span>
                            <span class="tag @StageStateBadgeClass(StageState(HKApprovalStage.Details))">@StageStateBadge(StageState(HKApprovalStage.Details))</span>
                            @if (StageApprovedAt(HKApprovalStage.Details) is { } detailsApprovedAt)
                            {
                                <span class="hint">Реквизиты приняты: @AppTime.Fmt(detailsApprovedAt, "dd.MM.yyyy")</span>
                            }
                            <span class="hint">@ExpirationHint()</span>
                            @StageButtons(HKApprovalStage.Details)
                        </div>
                    }

                    @if (!IsAutonomousMode && selectedLevel != HKObjectLevel.Node)
                    {
                    <div class="full-width" style="margin-top:8px">
                        <h3 style="font-size:14px;font-weight:700;margin:0 0 10px">Состав ХК</h3>

                        @if (canEditComposition)
                        {
                        <div style="margin-bottom:12px">
                            <button type="button" class="btn" @onclick="ToggleAddChild">+ Добавить дочернюю ХК</button>
                        </div>
                        }

                        @if (_addChildOpen)
                        {
                            <div style="margin-bottom:12px;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--panel2)">
                                <div style="display:flex;gap:8px;align-items:center">
                                    <input @bind="_addChildSearch" placeholder="Поиск по коду или объекту..." style="flex:1;padding:6px 10px;border:1px solid var(--line);border-radius:6px;font-size:13px" />
                                    <button type="button" class="btn primary" @onclick="ConfirmAddChild" disabled="@(_pendingChild is null)">Добавить</button>
                                    <button type="button" class="btn ghost" @onclick="ToggleAddChild">Отмена</button>
                                </div>
                                @if (_availableChildCards.Any())
                                {
                                    <div style="margin-top:8px;max-height:200px;overflow-y:auto">
                                        @foreach (var child in _availableChildCards)
                                        {
                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectAvailableChild(child)" style="padding:6px 10px">
                                                <span class="mono">@child.Code</span> — @child.ObjectName (@LevelName(child.ObjectLevel))
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_addChildSearch))
                                {
                                    <div class="note" style="margin-top:8px;font-size:12px">Нет доступных утверждённых ХК</div>
                                }
                            </div>
                        }

                        @if (_components.Count == 0 && _pendingChildCards.Count == 0)
                        {
                            <div class="note">Состав пуст. Добавьте утверждённые дочерние ХК.</div>
                        }
                        else
                        {
                            <table class="hk-items-table" style="margin-bottom:12px">
                                <thead>
                                    <tr>
                                        <th style="width:40px">№</th>
                                        <th>ХК-источник</th>
                                        <th>Версия</th>
                                        <th>Объект</th>
                                        <th>Утверждена</th>
                                        <th class="col-actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var compIdx = 0; }
                                    @foreach (var comp in _components.OrderBy(c => c.SortOrder))
                                    {
                                        compIdx++;
                                        <tr>
                                            <td>@compIdx</td>
                                            <td class="mono">@comp.ChildCode</td>
                                            <td>@comp.ChildVersion</td>
                                            <td>@comp.ChildObjectName</td>
                                            <td>@AppTime.Fmt(comp.ChildApprovedAt, "dd.MM.yyyy")</td>
                                            <td class="hki-actions col-actions">
                                                @if (canEditComposition)
                                                {
                                                    <button type="button" class="linkBtn" @onclick="() => RemoveComponent(comp.Id)" style="color:var(--bad)" title="Удалить">🗑</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var child in _pendingChildCards)
                                    {
                                        compIdx++;
                                        <tr>
                                            <td>@compIdx</td>
                                            <td class="mono">@child.Code</td>
                                            <td>@child.Version</td>
                                            <td>@child.ObjectName</td>
                                            <td>@AppTime.Fmt(child.ApprovedDate, "dd.MM.yyyy")</td>
                                            <td class="hki-actions col-actions">
                                                @if (canEditComposition)
                                                {
                                                    <button type="button" class="linkBtn" @onclick="() => RemovePendingChild(child)" style="color:var(--bad)" title="Удалить">🗑</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <h4 style="font-size:13px;font-weight:600;margin:12px 0 8px">Агрегированные строки</h4>
                        @if (_aggregatedRows.Count == 0)
                        {
                            <div class="note">
                                @(IsNew && _pendingChildCards.Count > 0
                                    ? "Будут рассчитаны после сохранения черновика"
                                    : "Нет данных")
                            </div>
                        }
                        else
                        {
                            <table class="hk-items-table">
                                <thead>
                                    <tr>
                                        <th>ХК-источник</th>
                                        <th>Сборочная единица</th>
                                        <th>Масса/объём</th>
                                        <th>Ед.изм.</th>
                                        <th>Марка ГСМ</th>
                                        <th>Категория</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _aggregatedRows)
                                    {
                                        <tr>
                                            <td class="mono">@row.SourceCardCode</td>
                                            <td>@row.AssemblyUnitName</td>
                                            <td>@row.Volume.ToString("F0")</td>
                                            <td>@(row.UnitOfMeasure ?? "кг")</td>
                                            <td>@row.GsmMaterialName</td>
                                            <td>@row.Category</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    }

                    <div class="formActions hk-form-actions-with-status">
                        <div class="hk-status-inline">
                            @* Этап состава — сразу под разделительной чертой двух
                               частей формы: в строке с кнопками формы. *@
                            @if (IsAutonomousMode && !IsNew)
                            {
                                <span class="hk-stage-label">@StagePartTitle(HKApprovalStage.Composition)</span>
                                <span class="tag @StageStateBadgeClass(StageState(HKApprovalStage.Composition))">@StageStateBadge(StageState(HKApprovalStage.Composition))</span>
                                @if (StageApprovedAt(HKApprovalStage.Composition) is { } compositionApprovedAt)
                                {
                                    <span class="hint">Состав принят: @AppTime.Fmt(compositionApprovedAt, "dd.MM.yyyy")</span>
                                }
                                @StageButtons(HKApprovalStage.Composition)
                            }
                            @if (!IsNew && acceptedRevisionNumber is { } acceptedNumber)
                            {
                                var acceptedCaption = "ХК принята. Принятая структура: редакция №" + acceptedNumber;
                                if (acceptedAtUtc is { } acceptedAt)
                                    acceptedCaption += ", дата решения " + AppTime.Fmt(acceptedAt, "dd.MM.yyyy");
                                <div class="hint">@acceptedCaption</div>
                                @* Переход открывает ПРИНЯТУЮ редакцию, а не текущий
                                   несохранённый или сохранённый черновик. *@
                                <a class="btn ghost btn-sm" href="@($"/составы-хк?карта={card.Id}")">Открыть состав ХК</a>
                            }
                            @if (!hasApprovalStages)
                            {
                                @if (!IsNew
                                    && _loadState == HkEditLoadState.Ready
                                    && card.Status is HKCardStatus.Draft or HKCardStatus.RevisionRequired
                                    && canSendToApprove)
                                {
                                    <button type="button" class="btn primary" @onclick="SendToApprove">
                                        Отправить на согласование
                                    </button>
                                }
                                @if (card.Status == HKCardStatus.OnReview && canApprove)
                                {
                                    <button type="button" class="btn primary" @onclick="ApproveCard">✓ Утвердить</button>
                                    <button type="button" class="btn ghost" @onclick="ReturnForRevision">↩ Вернуть на доработку</button>
                                }
                            }
                            @if (card.Status == HKCardStatus.Approved && canCreateNewVersion)
                            {
                                <button type="button" class="btn" @onclick="CreateNewVersion">Создать новую версию</button>
                            }
                            @if (card.Status == HKCardStatus.Approved && canArchive)
                            {
                                <button type="button" class="btn ghost" @onclick="OpenArchiveModal">В архив</button>
                            }
                        </div>
                        <div class="hk-form-actions-buttons">
                            @if (isSystemAdmin && IsNew)
                            {
                                <select class="fieldInput hk-admin-branch-select" @bind="_adminBranchId" aria-label="Отдел">
                                    <option value="">Отдел: выберите…</option>
                                    @foreach (var b in allBranches)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                </select>
                            }
                            @if (canEdit || IsNew)
                            {
                                <button type="button" class="btn ghost" @onclick="GoBack">Назад</button>
                                <button type="submit" class="btn primary" disabled="@(!canEdit && !IsNew)">@(IsNew ? "Сохранить черновик" : "Сохранить реквизиты")</button>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="error" style="margin-top:10px;color:var(--bad);font-size:13px">@errorMessage</div>
                    }
                    <ValidationSummary />
                </div>
            </EditForm>

                        @if (IsAutonomousMode || selectedLevel == HKObjectLevel.Node)
                        {
                        <div class="full-width" style="margin-top:8px">
                            <h3 class="hk-editor-strong">Строки ХК</h3>

                            @* Автономная карта хранит собственную структуру, а не дочерние
                               ХК. Разделы — необязательная группировка над деревом: они
                               не являются уровнями техники, не умножают потребность и
                               не влияют на определение уровня карты. Панель применяется
                               к НОВОЙ верхней ветке и не меняет раздел уже выбранной. *@
                            @if (IsAutonomousMode && IsNew)
                            {
                                <div class="note hk-editor-note">
                                    <b>Структура появится после сохранения черновика.</b>
                                    <div style="margin-top:4px">
                                        1. Сохраните черновик кнопкой «Сохранить черновик» под формой —
                                        номер ХК сформирует сервер, а карта получит свой номер.
                                    </div>
                                    <div>
                                        2. После сохранения здесь появятся разделы, позиции и конечные строки;
                                        они сохраняются отдельной командой «Сохранить структуру».
                                    </div>
                                    <div>
                                        3. Отправка на согласование — следующий шаг, отдельной командой.
                                    </div>
                                </div>
                            }

                            @if (IsAutonomousMode && !IsNew)
                            {
                                <div class="hk-editor-panel">
                                    <div class="hk-editor-panel-row">
                                        <span class="hki-muted-sm">Раздел новой ветки:</span>
                                        <button type="button"
                                                class="@(SelectedSectionType is null ? "btn primary" : "btn ghost") hk-editor-chip"
                                                aria-pressed="@(SelectedSectionType is null ? "true" : "false")"
                                                disabled="@(!canEditStructure)"
                                                @onclick="() => SelectNewBranchSection(null)">
                                            Без раздела
                                        </button>
                                        @foreach (var panelType in new[] { HKCardSectionType.Oils, HKCardSectionType.Greases, HKCardSectionType.Fuels })
                                        {
                                            // Подсветка — по ВИДУ раздела: сам раздел
                                            // создаётся при добавлении первой ветки.
                                            var panelSelected = SelectedSectionType == panelType;
                                            <button type="button"
                                                    class="@(panelSelected ? "btn primary" : "btn ghost") hk-editor-chip"
                                                    aria-pressed="@(panelSelected ? "true" : "false")"
                                                    disabled="@(!canEditStructure)"
                                                    @onclick="() => SelectNewBranchSection(panelType)">
                                                @HKSectionNames.NameOf(panelType)
                                            </button>
                                        }
                                    </div>

                                    @if (canEditComposition)
                                    {
                                        <div class="hk-editor-panel-row">
                                            <span class="hki-muted-sm">Верхняя позиция:</span>
                                            <select @bind="_topPositionLevel" class="hki-td-input hk-editor-select hk-editor-select--narrow">
                                                <option value="@HKObjectLevel.EquipmentModel">Изделие</option>
                                                <option value="@HKObjectLevel.Aggregate">Агрегат</option>
                                                <option value="@HKObjectLevel.Node">Узел</option>
                                            </select>
                                            <button type="button" class="btn ghost hk-editor-chip"
                                                    @onclick="AddTopPosition">+ Добавить позицию</button>
                                            <button type="button" class="btn ghost hk-editor-chip"
                                                    @onclick="() => AddRowUnder(null)">+ Добавить строку</button>
                                        </div>
                                    }

                                    @if (NeedsNodeRootChoice)
                                    {
                                        <div class="hk-editor-toolbar hki-muted-sm">
                                            <span class="hki-muted">ХК уровня:</span>
                                            <select value="@(NodeRootChoiceKey)"
                                                    @onchange="e => SetNodeRootChoice((string)e.Value!)"
                                                    class="hki-td-input hk-editor-select">
                                                <option value="">— выберите —</option>
                                                <option value="Aggregate">ХК агрегата</option>
                                                <option value="EquipmentModel">ХК изделия</option>
                                            </select>
                                            <span class="hki-muted">(старшая верхняя позиция — узел)</span>
                                        </div>
                                    }
                                </div>
                                }

                                @if (_structureError is { } structureErrorText)
                                {
                                    <div class="note hk-editor-note" role="alert">
                                        @structureErrorText
                                    </div>
                                }

                        @if (!IsAutonomousMode || !IsNew)
                        {
                        @if (!EditorRows().Any(r => r.Node is not null || r.Item is not null))
                        {
                            <div class="note" style="margin-bottom:8px">Строк пока нет.</div>
                        }
                        else
                        {
                        <div class="hk-items-table-wrapper">
                        <table class="hk-items-table hk-rows-table @(canEditComposition ? "hk-rows-editable" : null)">
                                <thead>
                                    <tr>
                                        <th rowspan="2" class="col-num hki-th-num">№</th>
                                        <th rowspan="2" class="col-wrap">Сборочная единица</th>
                                        <th rowspan="2" class="col-wrap hki-th-qty" title="Количество сборных единиц">
                                            <span class="th-wide">Кол-во СЕ</span><span class="th-narrow">СЕ</span>
                                        </th>
                                        <th colspan="4" class="col-wrap">Наименование и обозначение марок ГСМ</th>
                                        <th rowspan="2" class="col-wrap hki-th-mass" title="Масса/Объём">
                                            <span class="th-wide">Масса/Объём</span><span class="th-narrow">Масса</span>
                                        </th>
                                        <th rowspan="2" class="col-wrap hki-th-unit" title="Единицы измерения">
                                            <span class="th-wide">Ед. изм.</span><span class="th-narrow">Ед.</span>
                                        </th>
                                        <th rowspan="2">Периодичность</th>
                                        <th rowspan="2" class="col-wrap">Примечание</th>
                                        <th rowspan="2" class="col-actions"></th>
                                    </tr>
                                    <tr>
                                        <th>Основные</th>
                                        <th>Дублирующие</th>
                                        <th>Резервные</th>
                                        <th>Зарубежные</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var idx = 0;
                                    }
                                    @foreach (var er in EditorRows())
                                    {
                                        idx = er.Index + 1;
                                        @if (er.Row.Kind == HKStructureRowKind.Section)
                                        {
                                            @* Раздел — визуальная группа: без количества
                                               и собственных норм, только номер и название. *@
                                            <tr @key="@(er.Row.SectionId is null ? "nosec" + er.Index : "sec" + er.Row.SectionId)"
                                                class="@(er.Row.SectionId is null ? "hki-nosection-row" : "hki-section-row")">
                                                <td colspan="11" class="hk-editor-strong">
                                                    @if (er.Row.SectionId is not null)
                                                    {
                                                        @er.Row.Number @er.Row.Name
                                                    }
                                                    else
                                                    {
                                                        @er.Row.Name
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        else if (er.Row.Kind == HKStructureRowKind.Position)
                                        {
                                            var node = er.Node!;
                                            var nodeExpanded = !IsCollapsed(node.Id);
                                            var nodeChildCount = CountChildRows(node.Id);
                                            var nodeAllowedLvls = AllowedChildLevels(node);
                                            <tr @key="@($"node{node.Id}")" class="hki-position-row">
                                                <td class="col-num">@er.Row.Number</td>
                                                <td colspan="10" class="hk-editor-cell" style="--indent:@(er.Row.Depth * 14)px">
                                                    <div class="hk-editor-row">
                                                        <div class="hk-editor-fields">
                                                        <span class="hk-editor-collapse">
                                                            @if (canEditComposition && nodeChildCount > 0)
                                                            {
                                                                <button type="button" class="hki-collapse-btn"
                                                                        @onclick="() => ToggleCollapse(node.Id)"
                                                                        aria-expanded="@(nodeExpanded ? "true" : "false")"
                                                                        aria-label="@(nodeExpanded ? "Свернуть ветку" : "Раскрыть ветку")"
                                                                        title="@(nodeExpanded ? "Свернуть" : "Раскрыть")">@(nodeExpanded ? "▾" : "▸")</button>
                                                            }
                                                        </span>
                                                        <span class="tag hki-muted-xs">@LevelTitle(node.Level)</span>
                                                        @if (canEditComposition)
                                                        {
                                                            <input id="@PositionNameId(node.Id)" @bind="node.Name" class="hki-td-input hk-editor-name"
                                                                   placeholder="Название позиции" />
                                                            <span class="hki-muted-xs"> Кол-во:</span>
                                                            <input type="number"
                                                                   @bind:get="node.Quantity == 0 ? null : (int?)node.Quantity"
                                                                   @bind:set="@(v => node.Quantity = v ?? 0)"
                                                                   class="hki-td-input hk-editor-num" />
                                                        }
                                                        else
                                                        {
                                                            <b>@node.Name</b>
                                                            <span class="hki-muted-sm">× @node.Quantity</span>
                                                        }
                                                        </div>

                                                        <div class="hki-actions-row">
                                                        @if (canEditComposition)
                                                        {
                                                            @if (node.ParentId is null)
                                                            {
                                                                <select value="@(SectionKey(node.SectionId))"
                                                                        @onchange="ev => ChangeTopNodeSection(node, (string)ev.Value!)"
                                                                        class="hki-td-input hk-editor-select" title="Раздел ветки">
                                                                    <option value="">Без раздела</option>
                                                                    @foreach (var sec in EditorSections)
                                                                    {
                                                                        <option value="@sec.Id">@HKSectionNames.NameOf(sec.SectionType)</option>
                                                                    }
                                                                </select>
                                                            }
                                                            @if (nodeAllowedLvls.Count > 0)
                                                            {
                                                                                                                <span class="hki-muted-xs">Дочерняя позиция:</span>
                                                                <select value="@(ChildLevelKey(node.Id, nodeAllowedLvls))"
                                                                        @onchange="ev => SetChildLevelChoice(node, (string)ev.Value!)"
                                                                        class="hki-td-input hk-editor-select hk-editor-select--narrow" title="Уровень новой дочерней позиции">
                                                                    @foreach (var lv in nodeAllowedLvls)
                                                                    {
                                                                        <option value="@lv">@LevelTitle(lv)</option>
                                                                    }
                                                                </select>
                                                                <button type="button" class="linkBtn hki-link-xs"
                                                                        @onclick="() => AddChildPosition(node)" title="Добавить дочернюю позицию">+ Позиция</button>
                                                            }
                                                            <button type="button" class="linkBtn hki-link-xs"
                                                                    @onclick="() => AddRowUnder(node)" title="Добавить конечную строку под позицией">+ СЕ</button>
                                                            <button type="button" class="linkBtn" @onclick="() => MoveTreeRow(node, null, -1)"
                                                                    disabled="@(!CanMove(node, null, -1))" title="Вверх">↑</button>
                                                            <button type="button" class="linkBtn" @onclick="() => MoveTreeRow(node, null, 1)"
                                                                    disabled="@(!CanMove(node, null, 1))" title="Вниз">↓</button>
                                                            @if (node.ParentId is not null)
                                                            {
                                                                <button type="button" class="linkBtn hki-link-xs"
                                                                        @onclick="() => MoveUnderRoot(node)" title="Перенести под корень">↥ корень</button>
                                                            }
                                                            <button type="button" class="linkBtn hki-danger" @onclick="() => AskDeletePosition(node)"
                                                                    title="Удалить позицию">🗑</button>
                                                        }
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            var item = er.Item;
                                            <tr @key="item.Id" class="@(_focusItemId == item.Id ? "hki-focus" : "")">
                                            <td class="col-num">@er.Row.Number</td>
                                            <td class="gsm-selector-cell">
                                                @if (canEditComposition)
                                                {
                                                    var au = item.AssemblyUnitId != Guid.Empty ? assemblyUnits.FirstOrDefault(a => a.Id == item.AssemblyUnitId) : null;
                                                    var auDropId = $"au-drop-{item.Id:N}";
                                                    var auBtnId = $"au-btn-{item.Id:N}";
                                                    var auKey = item.Id;
                                                    @if (au != null)
                                                    {
                                                        <div id="@auBtnId" class="hki-mat-tag hki-mat-tag--clickable" @onclick="() => ToggleAuDropdown(auKey, auDropId, auBtnId)">
                                                            <span>@au.Code — @au.Name</span>
                                                            <button type="button" class="hki-tag-remove" @onclick="() => ClearAssemblyUnit(item)" @onclick:stopPropagation="true">×</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" id="@auBtnId" class="btn ghost hki-add-mat" @onclick="() => ToggleAuDropdown(auKey, auDropId, auBtnId)">— не выбрано —</button>
                                                    }
                                                    @if (_auOpen.GetValueOrDefault(auKey))
                                                    {
                                                        <div id="@auDropId" class="gsm-dropdown">
                                                            <input class="gsm-dropdown-search" @bind="_auSearch[auKey]" @oninput="() => { }" placeholder="Поиск..." />
                                                            @if (canQuickCreate)
                                                            {
                                                                <button type="button" class="gsm-dropdown-create" @onmousedown:preventDefault="true" @onclick="() => { CloseAllDropdownsSync(); OpenQuickCreateAssemblyUnit(auKey); }">
                                                                    <span aria-hidden="true">+</span> @(string.IsNullOrWhiteSpace(_auSearch.GetValueOrDefault(auKey)) ? "Создать новый" : $"Создать «{_auSearch[auKey]}»")
                                                                </button>
                                                            }
                                                            <div class="gsm-dropdown-divider" role="separator"></div>
                                                            @foreach (var a in FilteredAssemblyUnits(auKey))
                                                            {
                                                                <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => SelectAu(item, a)">@a.Code — @a.Name</div>
                                                            }
                                                            @if (!FilteredAssemblyUnits(auKey).Any())
                                                            {
                                                                <div class="hki-search-empty">Нет совпадений</div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    var au = assemblyUnits.FirstOrDefault(a => a.Id == item.AssemblyUnitId);
                                                    <span>@(au != null ? $"{au.Code} — {au.Name}" : "")</span>
                                                }
                                            </td>
                                            <td>
                                                @if (canEditComposition)
                                                {
                                                    <input type="number" @bind:get="item.Quantity == 0 ? null : (int?)item.Quantity"
                                                           @bind:set="@(v => item.Quantity = v ?? 0)" class="hki-td-input" />
                                                }
                                                else
                                                {
                                                    <span>@item.Quantity</span>
                                                }
                                            </td>
                                            @foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
                                            {
                                                <td class="hki-mat-cell gsm-selector-cell">
                                                    @{
                                                        var matsInCat = item.Materials.Where(m => m.Category == cat).ToList();
                                                    }
                                                    @foreach (var mat in matsInCat)
                                                    {
                                                        // Название берётся из объединённого набора (выбор +
                                                        // уже сохранённые марки карточки): марка, ставшая
                                                        // недоступной для нового выбора, не должна выглядеть
                                                        // как «—» в существующей строке ХК.
                                                        var matName = MaterialNames.TryGetValue(mat.GsmMaterialId, out var nm)
                                                            ? nm
                                                            : "—";
                                                        <div class="hki-mat-tag">
                                                            <span>@matName</span>
                                                            @if (canEditComposition)
                                                            {
                                                                <button type="button" class="hki-tag-remove" @onclick="() => RemoveMaterialFromRow(item, mat.RowId, mat.GsmMaterialId, mat.Category)">×</button>
                                                            }
                                                        </div>
                                                    }
                                                    @if (canEditComposition)
                                                    {
                                                        var pickerKey = (item.Id, cat);
                                                        var dropId = $"gsm-drop-{item.Id:N}-{cat}";
                                                        var btnId = $"gsm-btn-{item.Id:N}-{cat}";
                                                        <div>
                                                            <button type="button" id="@btnId" class="btn ghost hki-add-mat" @onclick="() => ToggleMatDrop(pickerKey, dropId, btnId)">+ Добавить</button>
                                                            @if (_matOpen.GetValueOrDefault(pickerKey))
                                                            {
                                                                <div id="@dropId" class="gsm-dropdown">
                                                                    <input class="gsm-dropdown-search" @bind="_matSearch[pickerKey]"
                                                                           @oninput="() => { }"
                                                                           placeholder="Поиск..." />
                                                                    @if (canQuickCreate)
                                                                    {
                                                                        <button type="button" class="gsm-dropdown-create" @onmousedown:preventDefault="true" @onclick="() => { CloseAllDropdownsSync(); OpenQuickCreateGsmMaterial(item.Id, cat); }">
                                                                            <span aria-hidden="true">+</span> @(string.IsNullOrWhiteSpace(_matSearch.GetValueOrDefault(pickerKey)) ? "Создать новый" : $"Создать «{_matSearch[pickerKey]}»")
                                                                        </button>
                                                                    }
                                                                    <div class="gsm-dropdown-divider" role="separator"></div>
                                                                    @* Группировка — по классификации марки (одна группа,
                                                                       перечень подгрупп), а не по прежнему Type. *@
                                                                    @foreach (var group in FilteredGsmMaterials(cat, item)
                                                                               .GroupBy(m => GsmGroupLabel(m)))
                                                                    {
                                                                        <div class="gsm-dropdown-group-label">@group.Key</div>
                                                                        @foreach (var mat in group)
                                                                        {
                                                                            @* Связи здесь не подсказываются: предложение
                                                                                   связанных ГСМ живёт отдельным блоком
                                                                                   строки и появляется сразу после
                                                                                   явного выбора основной марки. Прежняя
                                                                                   подсказка в списке category читала
                                                                                   связи, загруженные при инициализации,
                                                                                   и для марки, выбранной позже, её
                                                                                   не знала. *@
                                                                            <div class="gsm-dropdown-item" @onmousedown:preventDefault="true" @onmousedown="() => AddMaterial(item, cat, mat.Id)">
                                                                                <span>@mat.Name</span>
                                                                            </div>
                                                                        }
                                                                    }
                                                                    @if (!FilteredGsmMaterials(cat, item).Any())
                                                                    {
                                                                        <div class="hki-search-empty">Нет совпадений</div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </td>
                                            }
                                            <td>
                                                @if (canEditComposition)
                                                {
                                                    <input type="number" @bind:get="item.Volume == 0m ? null : (decimal?)item.Volume"
                                                           @bind:set="@(v => item.Volume = v ?? 0m)" step="0.001" class="hki-td-input" />
                                                }
                                                else
                                                {
                                                    <span>@item.Volume.ToString("F0")</span>
                                                }
                                            </td>
                                            <td>
                                                @if (canEditComposition)
                                                {
                                                    <input @bind="item.UnitOfMeasure" class="hki-td-input" />
                                                }
                                                else
                                                {
                                                    <span>@item.UnitOfMeasure</span>
                                                }
                                            </td>
                                            <td>
                                                @if (canEditComposition)
                                                {
                                                    <textarea @bind="item.Periodicity" class="hki-td-input" rows="1"></textarea>
                                                }
                                                else
                                                {
                                                    <span>@item.Periodicity</span>
                                                }
                                            </td>
                                            <td>
                                                @if (canEditComposition)
                                                {
                                                    <textarea @bind="item.Notes" class="hki-td-input" rows="1"></textarea>
                                                }
                                                else
                                                {
                                                    <span>@item.Notes</span>
                                                }
                                            </td>
                                            <td class="hki-actions col-actions">
                                                @if (canEditComposition)
                                                {
                                                    <button type="button" class="linkBtn" @onclick="() => MoveTreeRow(null, item, -1)" disabled="@(!CanMove(null, item, -1))" title="Вверх">↑</button>
                                                    <button type="button" class="linkBtn" @onclick="() => MoveTreeRow(null, item, 1)" disabled="@(!CanMove(null, item, 1))" title="Вниз">↓</button>
                                                    <button type="button" class="linkBtn hki-danger" @onclick="() => RemoveItem(item)" title="Удалить">🗑</button>
                                                }
                                            </td>
                                        </tr>
                                        @* ── Предложение связанных ГСМ по строке ──────────────
                                           Показывается сразу после явного выбора основной
                                           марки, без перезагрузки страницы. Уже сохранённая
                                           строка получает ту же возможность по видимой
                                           команде «Проверить связи» — удалять и заново
                                           выбирать основную марку ради просмотра связей
                                           не требуется. Ни выбор основной марки, ни
                                           открытие блока ничего не добавляют в card.Items:
                                           только «Добавить выбранные» после видимого
                                           списка. *@
                                        @if (canEditComposition && item.Tracked is not null && (
                                            _suggestionLoading.Contains(item.Id)
                                            || (_suggestionErrors.TryGetValue(item.Id, out var sErr) && !string.IsNullOrEmpty(sErr))
                                            || HasVisibleSuggestion(item.Tracked!)
                                            || (suggestionAddedCount > 0 && _suggestionAddedFor == item.Id)
                                            || (suggestionSkippedCount > 0 && _suggestionSkippedFor == item.Id)
                                            || HasPrimaryMaterial(item.Tracked!)))
                                        {
                                            <tr class="hki-suggestion-row">
                                                <td colspan="11">
                                                    <div class="hki-suggestion">
                                                        @if (_suggestionLoading.Contains(item.Id))
                                                        {
                                                            <div class="hki-suggestionLine">Проверяем связанные ГСМ…</div>
                                                        }
                                                        else if (_suggestionErrors.TryGetValue(item.Id, out var loadError) && !string.IsNullOrEmpty(loadError))
                                                        {
                                                            @* Ошибка чтения НЕ выдаётся за «связей нет»:
                                                               иначе пользователь решил бы, что
                                                               рекомендаций не существует. *@
                                                            <div class="hki-suggestionLine hki-suggestionError" role="alert">
                                                                <span>@loadError</span>
                                                                <button type="button" class="linkBtn" @onclick="() => ReloadSuggestionsAsync(item.Tracked!)">Повторить</button>
                                                            </div>
                                                        }
                                                        else if (HasVisibleSuggestion(item.Tracked!))
                                                        {
                                                            <div class="hki-suggestionLine">
                                                                <span>
                                                                    Связанные ГСМ по основным маркам строки:
                                                                    @foreach (var src in SuggestionsFor(item.Tracked!).Where(s => s.Suggestions.Count > 0))
                                                                    {
                                                                        <span class="hki-suggestionSource">
                                                                            «@src.PrimaryName» — @src.Suggestions.Count(x => x.IsAddable) из @src.Suggestions.Count
                                                                        </span>
                                                                    }
                                                                    <span class="hki-suggestionSource">(@SuggestionSummary(item.Tracked!))</span>
                                                                </span>
                                                                <button type="button" class="linkBtn"
                                                                        @onclick="() => ToggleSuggestionOpen(item.Tracked!)">
                                                                    @(_suggestionOpen.Contains(item.Id) ? "Скрыть варианты" : "Посмотреть варианты")
                                                                </button>
                                                            </div>

                                                            @if (!HasAddableSuggestion(item.Tracked!))
                                                            {
                                                                @* Все аналоги недоступны: список показан, чтобы
                                                                   сами связи были видны, но подтверждать
                                                                   нечего. *@
                                                                <div class="hki-suggestionLine hki-suggestionDone">
                                                                    Все связанные марки недоступны для строки ХК — причина указана у каждой позиции.
                                                                </div>
                                                            }

                                                            @if (_suggestionOpen.Contains(item.Id))
                                                            {
                                                                <div class="hki-suggestionPanel">
                                                                    @foreach (var src in SuggestionsFor(item.Tracked!))
                                                                    {
                                                                        @* Категории без вариантов не показываются: пустая группа —
                                                                           шум. Порядок фиксирован, а не «как сложилось». *@
                                                                        var groups = new[] { GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }
                                                                            .Select(c => (
                                                                                Category: c,
                                                                                Options: src.Suggestions
                                                                                    .Where(x => x.Categories.Contains(c))
                                                                                    .ToList()))
                                                                            .Where(t => t.Options.Count > 0)
                                                                            .ToList();
                                                                        <div class="hki-suggestionGroup">
                                                                            <div class="hki-suggestionGroupTitle">Связано с «@src.PrimaryName»</div>
                                                                            @foreach (var (category, options) in groups)
                                                                            {
                                                                                <div class="hki-suggestionCategory">
                                                                                    <div class="hki-suggestionCategoryTitle">
                                                                                        @GsmRelationSuggestion.CategoryLabel(category)
                                                                                    </div>
                                                                                    @foreach (var o in options)
                                                                                    {
                                                                                        var already = SuggestionAlreadyInRow(item.Tracked!, o.MaterialId, category);
                                                                                        <label class="hki-suggestionOption @(already ? "hki-suggestionOptionAlready" : "") @(o.IsAddable ? "" : "hki-suggestionOptionBlocked")">
                                                                                            <input type="checkbox"
                                                                                                   checked="@IsPicked(item.Id, o.MaterialId, category)"
                                                                                                   disabled="@(already || !o.IsAddable)"
                                                                                                   @onchange="() => ToggleSuggestionPick(item.Tracked!, o.MaterialId, category)" />
                                                                                            <span class="hki-suggestionName">@o.Name</span>
                                                                                            @if (!string.IsNullOrWhiteSpace(o.Nd))
                                                                                            {
                                                                                                <span class="hki-suggestionNd mono">НД: @o.Nd</span>
                                                                                            }
                                                                                            @if (!string.IsNullOrWhiteSpace(o.Note))
                                                                                            {
                                                                                                <span class="hki-suggestionNote">Примечание связи: @o.Note</span>
                                                                                            }
                                                                                            @if (already)
                                                                                            {
                                                                                                <span class="tag">Уже в строке</span>
                                                                                            }
                                                                                            else if (!o.IsAddable)
                                                                                            {
                                                                                                <span class="tag warn">@o.UnavailableReason</span>
                                                                                            }
                                                                                        </label>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        </div>
                                                                    }

                                                                    <div class="hki-suggestionActions">
                                                                        @* Кнопка активна, только если есть отмеченные варианты,
                                                                           которые всё ещё предлагаются И доступны. Устаревшая
                                                                           отметка не должна превращаться в строку ХК. *@
                                                                        <button type="button" class="btn primary"
                                                                                disabled="@(PickedAddableCount(item.Tracked!) == 0)"
                                                                                @onclick="() => ConfirmSuggestions(item.Tracked!)">
                                                                            Добавить выбранные
                                                                        </button>
                                                                        <button type="button" class="btn ghost" @onclick="() => CancelSuggestions(item.Tracked!)">Отмена</button>
                                                                        <span class="hki-suggestionHint">
                                                                            По умолчанию ничего не отмечено. Добавленные варианты становятся обычными строками: удалить их можно только отдельным действием.
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        else if (HasPrimaryMaterial(item.Tracked!))
                                                        {
                                                            @* Предложения ещё не запрашивались. У сохранённой ХК это
                                                               единственный способ увидеть связи своей основной
                                                               марки, не удаляя и не выбирая её заново. *@
                                                            <div class="hki-suggestionLine">
                                                                <span class="hki-suggestionHint">
                                                                    Связи основных марок строки не загружены.
                                                                </span>
                                                                <button type="button" class="btn ghost" @onclick="() => CheckRelationsCommandAsync(item.Tracked!)">
                                                                    Проверить связи
                                                                </button>
                                                            </div>
                                                        }

                                                        @* Подтверждение подключено отдельным блоком, а не как
                                                           «иначе» в цепочке выше: после добавления связи в
                                                           справочнике никуда не делись, поэтому список
                                                           вариантов остаётся видимым и показывает их как
                                                           «Уже в строке». Ветка-«иначе» в этом случае
                                                           не выполнялась бы, и подтверждение не появлялось
                                                           бы вовсе. *@
                                                        @if (_suggestionAddedFor == item.Id && suggestionAddedCount > 0)
                                                        {
                                                            <div class="hki-suggestionLine hki-suggestionDone">
                                                                <span>
                                                                    Добавлено вариантов: @suggestionAddedCount. Это обычные строки ХК — их можно удалить как любую другую строку.
                                                                </span>
                                                                <button type="button" class="linkBtn" @onclick="DismissSuggestionAdded">Скрыть</button>
                                                            </div>
                                                        }

                                                        @if (_suggestionSkippedFor == item.Id && suggestionSkippedCount > 0)
                                                        {
                                                            <div class="hki-suggestionLine hki-suggestionError" role="alert">
                                                                <span>
                                                                    Не добавлено: @suggestionSkippedCount. Связь была изменена или удалена либо марка стала недоступна — нажмите «Проверить связи» и выберите заново.
                                                                </span>
                                                                <button type="button" class="linkBtn" @onclick="DismissSuggestionAdded">Скрыть</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @* Строка под корнем автономной карты может иметь
                                           собственный раздел: селект только для такой строки. *@
                                        @if (IsAutonomousMode && canEditStructure && item.IsLocal && item.NodeId is null)
                                        {
                                            <tr @key="@($"seci{item.Id}")" class="hki-note-row">
                                                <td></td>
                                                <td colspan="10" class="hk-editor-cell hki-muted-xs" style="--indent:@(er.Row.Depth * 14)px">
                                                    Раздел строки:
                                                    <select value="@(SectionKey(item.SectionId))"
                                                            @onchange="ev => ChangeRootItemSection(item, (string)ev.Value!)"
                                                            class="hki-td-input hk-editor-select hk-editor-select--tiny">
                                                        <option value="">Без раздела</option>
                                                        @foreach (var sec in EditorSections)
                                                        {
                                                            <option value="@sec.Id">@HKSectionNames.NameOf(sec.SectionType)</option>
                                                        }
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        }

                        @if (canEditStructure)
                        {
                                @* Кнопка сохранения атомарно переносит в базу разделы,
                                   позиции, строки и материалы одной транзакцией. Конфликт
                                   версий не повторяется автоматом и не уничтожает
                                   локальный ввод. *@
                                <button type="button" class="btn primary hk-editor-gap"
                                        disabled="@(IsNew || _savingStructure)"
                                        title="@(IsNew ? "Сначала сохраните черновик ХК" : "Сохранить структуру целиком")"
                                        @onclick="SaveStructureAsync">
                                    @(_savingStructure ? "Сохраняю…" : "Сохранить структуру")
                                </button>

                                @if (structureDirty && !_loading)
                                {
                                    <span class="hki-muted-xs hk-editor-gap--sm">
                                        в структуре есть несохранённые изменения
                                    </span>
                                }
                            }

                            @if (IsAutonomousMode && !IsNew)
                            {
                                var summary = BuildSummary();
                                <div class="hk-totals">
                                    <div class="hk-totals-title">
                                        Итоги ХК
                                        <span class="hk-totals-note">
                                            (предварительный расчёт редактора; не является итогом принятой карты)
                                        </span>
                                    </div>
                                    @foreach (var sectionTotal in summary.Totals.Sections)
                                    {
                                        var sectionName = SectionNameById(sectionTotal.SectionId, summary.Sections);
                                        <div>@sectionName: @FormatTotals(sectionTotal.Totals)</div>
                                    }
                                    @if (summary.Totals.WithoutSection is { } withoutSection && withoutSection.Totals.Count > 0)
                                    {
                                        <div>Без раздела: @FormatTotals(withoutSection.Totals)</div>
                                    }
                                    @if (summary.Totals.Overall.Count > 0)
                                    {
                                        <div class="hk-totals-total">Вся ХК: @FormatTotals(summary.Totals.Overall)</div>
                                    }
                                </div>

                                @if (_confirmItemId is { } confirmLineId)
                                {
                                    var confirmRow = EditorRows().FirstOrDefault(r => r.Item?.Id == confirmLineId);
                                    if (confirmRow?.Item is not null)
                                    {
                                        <div class="hk-delete-confirm">
                                            <b>Удалить строку?</b>
                                            <span>@_confirmImpactText</span>
                                            <div class="hk-editor-actions">
                                                <button type="button" class="btn hki-danger" @onclick="ConfirmDeleteItem">Удалить</button>
                                                <button type="button" class="btn ghost" @onclick="CancelDeleteItem">Отмена</button>
                                            </div>
                                        </div>
                                    }
                                }

                                @if (_confirmDeletePositionId is { } confirmId)
                                {
                                    var confirmNode = _structure?.NodeById(confirmId);
                                    if (confirmNode is not null)
                                    {
                                        <div class="hk-delete-confirm">
                                            <b>Удалить «@confirmNode.Name»?</b>
                                            <span>@DeleteImpactText(confirmId)</span>
                                            <div class="hk-editor-actions">
                                                <button type="button" class="btn hki-danger" @onclick="ConfirmDeletePosition">Удалить</button>
                                                <button type="button" class="btn ghost" @onclick="CancelDeletePosition">Отмена</button>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        }
                        </div>
                        }
            }
        </div>
    </section>
</div>

<section class="panel">
    <div class="panelHeader">
        <h2>Версии ХК</h2>
        <div class="hint">История версий по объекту</div>
    </div>
    <div class="panelBody">
        @if (_versions.Any())
        {
            <table class="hk-items-table">
                <thead>
                    <tr>
                        <th>Версия</th>
                        <th>Статус</th>
                        <th>Утверждена</th>
                        <th>Создана</th>
                        <th>Примечание</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _versions.OrderByDescending(v => v.CreatedAt))
                    {
                        <tr>
                            <td class="mono">@v.Version</td>
                            <td><StatusBadge Status="@v.Status" /></td>
                            <td>@(AppTime.FmtOr(v.ApprovedDate, "dd.MM.yyyy", "—"))</td>
                            <td>@AppTime.Fmt(v.CreatedAt, "dd.MM.yyyy")</td>
                            <td>
                                @if (v.IsCurrent)
                                {
                                    <span class="tag ok">текущая</span>
                                }
                                @if (v.SupersedesHKCardId == card.Id)
                                {
                                    <span class="tag warn">заменяет текущую</span>
                                }
                                else if (card.SupersedesHKCardId == v.Id)
                                {
                                    <span class="tag warn">предшественник</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="note">Других версий нет</div>
        }
    </div>
</section>

@if (_quickCreateKind.HasValue)
{
    <div class="modalOverlay" @onclick="CloseQuickCreateModal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="qc-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="qc-title">@(QuickCreateTitle)</h3>
                <button type="button" class="linkBtn" @onclick="CloseQuickCreateModal">✕</button>
            </div>
            <div class="modalBody">
                @if (_quickCreateKind == QuickCreateKind.Node)
                {
                    <div class="field"><label>Код <span style="color:var(--bad)">*</span></label><input @bind="_qcCode" class="field" placeholder="Код узла" /></div>
                    <div class="field"><label>Наименование <span style="color:var(--bad)">*</span></label><input @bind="_qcName" class="field" placeholder="Наименование узла" /></div>
                    <div class="field"><label>Описание</label><textarea @bind="_qcDescription" rows="2" placeholder="Описание (необязательно)"></textarea></div>
                }
                else if (_quickCreateKind == QuickCreateKind.AssemblyUnit)
                {
                    <div class="field"><label>Код <span style="color:var(--bad)">*</span></label><input @bind="_qcCode" class="field" placeholder="Код сборочной единицы" /></div>
                    <div class="field"><label>Наименование <span style="color:var(--bad)">*</span></label><input @bind="_qcName" class="field" placeholder="Наименование сборочной единицы" /></div>
                    <div class="field"><label>Описание</label><textarea @bind="_qcDescription" rows="2" placeholder="Описание (необязательно)"></textarea></div>
                }
                else if (_quickCreateKind == QuickCreateKind.GsmMaterial)
                {
                    <div class="field"><label>Наименование <span style="color:var(--bad)">*</span></label><input @bind="_qcName" class="field" placeholder="Наименование марки ГСМ" /></div>
                    <div class="field"><label>Группа ГСМ <span style="color:var(--bad)">*</span></label><input @bind="_qcGroup" class="field" placeholder="Например: Смазочные материалы" /></div>
                    <div class="field"><label>Подгруппа ГСМ <span style="color:var(--bad)">*</span></label><input @bind="_qcSubgroup" class="field" placeholder="Например: Для смазки" /></div>
                    <div class="field"><label>НД</label><input @bind="_qcGost" class="field" placeholder="НД (необязательно)" /></div>
                    <div class="field"><label>Назначение и условия применения</label><textarea @bind="_qcDescription" rows="2" placeholder="Назначение (необязательно)"></textarea></div>
                }
                @if (_quickCreateError != null)
                {
                    <div style="color:var(--bad);font-size:13px;margin-top:6px">@_quickCreateError</div>
                }
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="CloseQuickCreateModal">Отмена</button>
                <button type="button" class="btn primary" @onclick="SaveQuickCreateAsync"
                        disabled="@(_quickCreateSaving || !_qcFormValid)">
                    @(_quickCreateSaving ? "Сохранение..." : "Создать")
                </button>
            </div>
        </div>
    </div>
}

@if (showLeaveModal)
{
    <div class="modalOverlay" @onclick="() => showLeaveModal = false">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="leave-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="leave-title">Несохранённые реквизиты</h3>
                <button type="button" class="linkBtn" @onclick="() => showLeaveModal = false">✕</button>
            </div>
            <div class="modalBody">
                <p>Реквизиты изменены, но не сохранены. При уходе изменения будут потеряны.</p>
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="() => showLeaveModal = false">Остаться</button>
                <button type="button" class="btn primary" @onclick="LeaveWithoutSaving">Уйти без сохранения</button>
            </div>
        </div>
    </div>
}

@if (showReturnModal)
{
    <div class="modalOverlay" @onclick="() => showReturnModal = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3>Вернуть на доработку</h3>
                <button type="button" class="linkBtn" @onclick="() => showReturnModal = false">✕</button>
            </div>
            <div class="modalBody">
                <textarea @bind="returnComment"
                          placeholder="Причина возврата (необязательно)..."
                          rows="3"
                          style="width:100%;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:8px;font-family:inherit;font-size:14px"></textarea>
                @if (returnCommentError != null)
                {
                    <div style="color:var(--bad);font-size:13px;margin-top:6px">@returnCommentError</div>
                }
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="() => showReturnModal = false">Отмена</button>
                <button type="button" class="btn primary" @onclick="ConfirmReturn">Подтвердить</button>
            </div>
        </div>
    </div>
}

@if (_showArchiveModal)
{
    <div class="modalOverlay" @onclick="CloseArchiveModal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="archive-title" @onclick:stopPropagation>
            <div class="modalHeader">
                <h3 id="archive-title">Архивирование ХК</h3>
                <button type="button" class="linkBtn" @onclick="CloseArchiveModal">✕</button>
            </div>
            <div class="modalBody">
                <p>ХК «@card.Code», версия @card.Version, будет переведена в статус «Архивная».</p>
                <div class="field">
                    <label>Заменяющая утверждённая ХК <span style="color:var(--bad)">*</span></label>
                    <select class="field-select" @bind="_archiveReplacementCardId" style="width:100%">
                        <option value="@Guid.Empty">— выберите —</option>
                        @foreach (var v in _versions.Where(v => v.Id != card.Id && v.Status == HKCardStatus.Approved).OrderBy(v => v.Version))
                        {
                            <option value="@v.Id">@v.Version (@v.Status)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Причина архивирования <span style="color:var(--bad)">*</span></label>
                    <textarea @bind="_archiveReason" rows="3" style="width:100%;resize:vertical;padding:8px;border:1px solid var(--line);border-radius:8px;font-family:inherit;font-size:14px" placeholder="Укажите причину…"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_archiveError))
                {
                    <div style="color:var(--bad);font-size:13px;margin-top:6px">@_archiveError</div>
                }
            </div>
            <div class="modalFooter">
                <button type="button" class="btn ghost" @onclick="CloseArchiveModal">Отмена</button>
                <button type="button" class="btn primary" @onclick="ConfirmArchiveAsync" disabled="@(!isSystemAdmin && (string.IsNullOrWhiteSpace(_archiveReason) || _archiveReplacementCardId == Guid.Empty))">Архивировать</button>
            </div>
        </div>
    </div>
}

