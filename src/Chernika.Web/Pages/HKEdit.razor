    private void MoveTreeRow(HKCardNode? node, HKCardItem? item, int direction)
    {
        if (!canEditComposition)
            return;
        MoveSiblingUnder(node?.ParentId, item?.HKCardNodeId, node, item, direction);
    }

    /// <summary>
    /// Перемещение среди соседей ОДНОГО родителя: позиции и конечные строки
    /// делят одну последовательность. Доменный порядок: SortOrder, потом
    /// позиции, затем идентификаторы.
    /// </summary>
    private void MoveSiblingUnder(Guid? nodeParent, Guid? itemParent, HKCardNode? node, HKCardItem? item, int direction)
    {
        var siblings = new List<(HKCardNode? N, HKCardItem? I)>();
        siblings.AddRange(card.TreeNodes
            .Where(n => n.ParentId == nodeParent)
            .Select(n => ((HKCardNode?)n, (HKCardItem?)null)));
        siblings.AddRange(card.Items
            .Where(i => i.HKCardNodeId == itemParent)
            .Select(i => ((HKCardNode?)null, (HKCardItem?)i)));

        siblings = siblings
            .OrderBy(s => SortOrderOf(s.N, s.I))
            .ThenBy(s => s.N is not null ? 0 : 1)
            .ThenBy(s => s.N?.Id ?? s.I!.Id)
            .ToList();

        var index = siblings.FindIndex(s =>
            s.N?.Id == node?.Id && s.I?.Id == item?.Id);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= siblings.Count)
            return;

        var moving = siblings[index];
        siblings.RemoveAt(index);
        siblings.Insert(target, moving);
        ReindexSiblings(siblings);
        MarkStructureDirty();
        StateHasChanged();
    }

    private static int SortOrderOf(HKCardNode? node, HKCardItem? item) =>
        node?.SortOrder ?? item?.SortOrder ?? 0;

    private void ReindexSiblings(List<(HKCardNode? N, HKCardItem? I)> siblings)
    {
        for (var i = 0; i < siblings.Count; i++)
        {
            if (siblings[i].N is { } node)
                node.SortOrder = i + 1;
            if (siblings[i].I is { } item)
                item.SortOrder = i + 1;
        }
    }

    /// <summary>
    /// Доступность кнопок перемещения: в автономном режиме — сосед в
    /// отображаемом порядке той же группы; перепрыгнуть раздел нельзя;
    /// в старом плоском режиме — прежние правила.
    /// </summary>
    private bool CanMove(HKCardNode? node, HKCardItem? item, int direction)
    {
        if (!IsAutonomousMode)
        {
            var flat = card.Items.OrderBy(i => i.SortOrder).ToList();
            var current = flat.IndexOf(item!);
            var at = current + direction;
            return current >= 0 && at >= 0 && at < flat.Count;
        }

        var parentId = node?.ParentId ?? item?.HKCardNodeId;
        var rows = EditorRows();
        var current2 = -1;
        for (var i = 0; i < rows.Count && current2 < 0; i++)
        {
            if (rows[i].Node?.Id == node?.Id && rows[i].Item?.Id == item?.Id)
                current2 = i;
        }
        var target2 = current2 + direction;
        if (target2 < 0 || target2 >= rows.Count)
            return false;

        var neighbor = rows[target2];
        // Сосед — заголовок раздела? Иначе порядок подразделов сложно сделать
        // однозначным: перенос не перескакивает заголовок.
        if (neighbor.Row.Kind == HKStructureRowKind.Section)
            return false;

        var neighborParent = neighbor.Node?.ParentId ?? neighbor.Item?.HKCardNodeId;
        return neighborParent == parentId;
    }

    private void AskDeletePosition(HKCardNode node)
    {
        if (!canEditComposition)
            return;
        _confirmDeletePositionId = node.Id;
        StateHasChanged();
    }

    private void CancelDeletePosition()
    {
        _confirmDeletePositionId = null;
        StateHasChanged();
    }

    private IEnumerable<HKCardNode> Subtree(HKCardNode root)
    {
        var result = new List<HKCardNode> { root };
        var nodeStack = new Stack<HKCardNode>();
        nodeStack.Push(root);
        while (nodeStack.Count > 0)
        {
            var current = nodeStack.Pop();
            foreach (var child in card.TreeNodes.Where(n => n.ParentId == current.Id))
            {
                result.Add(child);
                nodeStack.Push(child);
            }
        }
        return result;
    }

    /// <summary>Полное описание затрагиваемого содержимого перед удалением ветки.</summary>
    private string DeleteImpactText(HKCardNode node)
    {
        var removed = Subtree(node).ToList();
        var removedIds = removed.Select(n => n.Id).ToHashSet();
        var affectedItems = card.Items
            .Where(i => i.HKCardNodeId is { } pid && removedIds.Contains(pid))
            .ToList();
        var materials = affectedItems.SelectMany(i => i.Materials).Count();
        return $"Затронуто: позиций — {removed.Count}, конечных строк — {affectedItems.Count}, назначений марок — {materials}.";
    }

    private void ConfirmDeletePosition()
    {
        var node = card.TreeNodes.FirstOrDefault(n => n.Id == _confirmDeletePositionId);
        if (node is null)
            return;

        var removedNodes = Subtree(node).ToList();
        var removedIds = removedNodes.Select(n => n.Id).ToHashSet();

        foreach (var removed in removedNodes)
        {
            card.TreeNodes.Remove(removed);
        }

        var doomedItems = card.Items
            .Where(i => i.HKCardNodeId is { } pid && removedIds.Contains(pid))
            .ToList();
        foreach (var doomed in doomedItems)
        {
            card.Items.Remove(doomed);
            CleanupItemDicts(doomed.Id);
        }

        MarkStructureDirty();
        ResetChoiceIfNotApplicable();
        _confirmDeletePositionId = null;
        StateHasChanged();
    }

    private void CleanupItemDicts(Guid itemId)
    {
        _auSearch.Remove(itemId);
        _auOpen.Remove(itemId);
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen.Remove((itemId, cat));
            _matSearch.Remove((itemId, cat));
        }
    }

    private void MarkStructureDirty() => _structureDirty = true;

    /// <summary>Выбор верхнего узла сохраняется только пока он применим.</summary>
    private void ResetChoiceIfNotApplicable()
    {
        var shape = new HKTreeShape(
            card.TreeNodes.Select(n => new HKTreePosition(n.Id, n.ParentId, n.Level)).ToList(),
            card.Items.Count(i => i.HKCardNodeId is null));
        if (HKCardLevelRule.SeniorTopLevel(shape) != HKObjectLevel.Node)
            _nodeRootChoice = null;
    }

    /// <summary>Атомарное сохранение разделов, позиций, строк и материалов.</summary>
    private async Task SaveStructureAsync()
    {
        if (!canEditComposition || IsNew)
            return;

        errorMessage = null;
        _structureError = null;

        try
        {
            var command = BuildStructureCommand(loadedRowVersion);
            await using (await DbLock.WaitAsync())
            {
                await HKCardService.SaveStructureAsync(command);
            }
            // Перезагрузка: сохранение обновило версию строки и уровень карты.
            _loadCts?.Cancel();
            _loadCts?.Dispose();
            _loadCts = new CancellationTokenSource();
            await LoadCardAsync(card.Id, _loadCts.Token);
            await LoadMaterialNamesAsync(_loadCts.Token);
        }
        catch (HkCardVersionConflictException ex)
        {
            // Конфликт версий не повторяется автоматически и не уничтожает
            // локальный ввод: правки структуры остаются на экране.
            errorMessage = ex.Message + " Локальные правки структуры сохранены на экране.";
        }
        catch (InvalidOperationException ex)
        {
            _structureError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _structureError = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (DbUpdateException)
        {
            _structureError = "Не удалось сохранить структуру. Проверьте заполнение позиций и строк и повторите попытку.";
        }
    }

    /// <summary>Команда из текущего состояния редактора: итоговые разделы, позиции, строки и материалы.</summary>
    private SaveHKCardStructureCommand BuildStructureCommand(uint expectedRowVersion)
    {
        var rows = HKStructureNumbering.Build(BuildStructureInput());

        // Порядок нормализуется при сохранении по отображаемому представлению:
        // разделы и самостоятельные ветки делят общий верхний порядок,
        // потомки одного родителя — один совместный список.
        var counters = new Dictionary<Guid, int>();
        var sectionsOrder = new Dictionary<Guid, int>();
        var topCounter = 0;

        foreach (var row in rows)
        {
            switch (row.Kind)
            {
                case HKStructureRowKind.Section:
                    topCounter++;
                    sectionsOrder[row.SectionId!.Value] = topCounter;
                    break;
                case HKStructureRowKind.Position:
                    var node = card.TreeNodes.First(n => n.Id == row.NodeId!.Value);
                    if (node.ParentId is null)
                    {
                        topCounter++;
                        node.SortOrder = topCounter;
                    }
                    else
                    {
                        counters[node.ParentId.Value] = counters.TryGetValue(node.ParentId.Value, out var v) ? v + 1 : 1;
                        node.SortOrder = counters[node.ParentId.Value];
                    }
                    break;
                default:
                    var item = card.Items.First(i => i.Id == row.ItemId!.Value);
                    if (item.HKCardNodeId is null)
                    {
                        topCounter++;
                        item.SortOrder = topCounter;
                    }
                    else
                    {
                        counters[item.HKCardNodeId.Value] = counters.TryGetValue(item.HKCardNodeId.Value, out var v2) ? v2 + 1 : 1;
                        item.SortOrder = counters[item.HKCardNodeId.Value];
                    }
                    break;
            }
        }

        foreach (var section in _sections)
        {
            if (sectionsOrder.TryGetValue(section.Id, out var order))
                section.SortOrder = order;
        }

        var positions = card.TreeNodes
            .Select(n => new HKCardStructureNodeWrite(
                n.Id, n.ParentId, n.Level, n.Name, n.Quantity, n.SortOrder,
                n.ParentId is null ? n.SectionId : null))
            .ToList();

        var items = card.Items
            .Select(i => new HKCardStructureItemWrite(
                i.Id, i.HKCardNodeId, i.AssemblyUnitId,
                i.Quantity, i.Volume, i.UnitOfMeasure, i.Periodicity, i.Notes, i.SortOrder,
                i.HKCardNodeId is null ? i.SectionId : null,
                i.Materials
                    .Select(m => new HKCardMaterialWrite(m.Id, m.GsmMaterialId, m.Category))
                    .ToList()))
            .ToList();

        var input = BuildStructureInput();
        var shape = new HKTreeShape(
            input.Nodes.Select(n => new HKTreePosition(n.Id, n.ParentId, n.Level)).ToList(),
            input.Items.Count(i => i.NodeId is null));
        var senior = HKCardLevelRule.SeniorTopLevel(shape);
        var nodeRootChoice = senior == HKObjectLevel.Node ? _nodeRootChoice : null;

        return new SaveHKCardStructureCommand(
            card.Id,
            _sections.OrderBy(s => s.SortOrder)
                .Select(s => new HKCardSectionWrite(s.Id, s.SectionType, s.SortOrder))
                .ToList(),
            positions,
            items,
            nodeRootChoice,
            expectedRowVersion);
    }

