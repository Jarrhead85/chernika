    private async Task AddMaterial(HKCardItem item, GsmCategory cat, Guid materialId)
    {
        // Выбор основной марки — единственное место, где предложение связанных
        // марок запрашивается само. Ни выбор, ни открытие блока ничего не пишут
        // в card.Items: только явное подтверждение пользователя.
        var isPrimary = cat == GsmCategory.Primary;

        if (item.Materials.Any(m => m.GsmMaterialId == materialId && m.Category == cat)) return;
        item.Materials.Add(new HKCardItemMaterial
        {
            Id = Guid.NewGuid(),
            HKCardItemId = item.Id,
            GsmMaterialId = materialId,
            Category = cat
        });
        await CloseActiveDropdownAsync();

        if (isPrimary)
            await LoadSuggestionsForItemAsync(item, materialId);

        StateHasChanged();
    }

    /// <summary>
    /// Загрузка предложений для строки по её основным маркам. Вызывается сразу
    /// после явного выбора основной марки, поэтому актуальные связи читаются без
    /// перезагрузки страницы; при открытии уже сохранённой ХК — по видимой
    /// команде «Проверить связи» (см. <see cref="CheckRelationsCommandAsync"/>).
    /// <para>
    /// Ошибка чтения НЕ подменяется сообщением «связей нет»: она попадает в
    /// состояние строки и показывается как неблокирующее предупреждение с
    /// повтором. Иначе пользователь решил бы, что рекомендаций нет.
    /// </para>
    /// <para>
    /// Перехватываются ЛЮБЫЕ сбои чтения — DbUpdateException, NpgsqlException,
    /// TimeoutException, InvalidOperationException, UnauthorizedAccessException, —
    /// потому что блок подсказок необязателен и не должен ломать правку ХК.
    /// Отмена (OperationCanceledException) исключена намеренно: это не сбой
    /// загрузки, а уход со страницы, и превращать её в предупреждение значило бы
    /// показывать пользователю ошибку там, где он ничего не делал.
    /// </para>
    /// </summary>
    private async Task LoadSuggestionsForItemAsync(HKCardItem item, Guid justPickedPrimaryId)
    {
        if (_suggestionLoading.Contains(item.Id)) return;

        _suggestionLoading.Add(item.Id);
        _suggestionErrors.Remove(item.Id);
        StateHasChanged();
        try
        {
            var primaryIds = item.Materials
                .Where(m => m.Category == GsmCategory.Primary && m.GsmMaterialId != Guid.Empty)
                .Select(m => m.GsmMaterialId)
                .Distinct()
                .ToList();

            var sources = primaryIds.Count == 0
                ? new List<GsmRelationSuggestionSource>()
                : await GsmMaterialService.GetRelatedSuggestionsAsync(primaryIds);

            // Отметки, более не относящиеся к текущему набору связанных марок,
            // снимаются: иначе «Добавить выбранные» добавила бы то, чего
            // пользователь уже не видит.
            _suggestions[item.Id] = sources;
            _suggestionPicked.RemoveWhere(p => p.ItemId == item.Id && !IsPickStillValid(sources, p));
            _suggestionErrors[item.Id] = null;

            if (sources.Count > 0 && justPickedPrimaryId != Guid.Empty)
                _suggestionOpen.Add(item.Id);
        }
        catch (OperationCanceledException)
        {
            // Уход со страницы, а не сбой: состояние не трогаем, ошибку не
            // показываем. Иначе на размонтированной цепи осталось бы
            // предупреждение о несуществующей ошибке.
        }
        catch (Exception ex)
        {
            // Список убираем: показывать устаревшие варианты после сбоя опаснее,
            // чем не показать ничего. Причина остаётся видимой с повтором.
            _suggestions.Remove(item.Id);
            _suggestionErrors[item.Id] =
                "Не удалось загрузить связанные ГСМ (" + ex.GetType().Name + "). Повторите попытку.";
        }
        finally
        {
            _suggestionLoading.Remove(item.Id);
        }
    }

    /// <summary>
    /// Видимая команда «Проверить связи» для уже сохранённой ХК: позволяет
    /// увидеть предложения по существующим основным маркам, не удаляя и не
    /// выбирая их заново.
    /// </summary>
    private async Task CheckRelationsCommandAsync(HKCardItem item)
    {
        await LoadSuggestionsForItemAsync(item, Guid.Empty);
        if (SuggestionsFor(item).Any())
            _suggestionOpen.Add(item.Id);
        StateHasChanged();
    }

    /// <summary>
    /// Отметка действительна, только если вариант всё ещё предлагается из
    /// текущего источника, в нужной категории и доступен для добавления.
    /// Проверяется и при пересчёте набора, и в момент подтверждения — иначе
    /// между открытием блока и нажатием кнопки связь могла быть удалена, а
    /// марка — оказаться недоступной.
    /// </summary>
    private static bool IsPickStillValid(
        IReadOnlyList<GsmRelationSuggestionSource> sources,
        (Guid ItemId, Guid MaterialId, GsmCategory Category) pick) =>
        sources.Any(s => s.Suggestions.Any(x =>
            x.MaterialId == pick.MaterialId
            && x.IsAddable
            && x.Categories.Contains(pick.Category)));

    private IEnumerable<GsmRelationSuggestionSource> SuggestionsFor(HKCardItem item) =>
        _suggestions.TryGetValue(item.Id, out var sources) ? sources : Enumerable.Empty<GsmRelationSuggestionSource>();

    /// <summary>
    /// Есть ли что показать. Учитываются <b>все</b> активные связи, включая
    /// недоступные: если у основной марки есть только удалённые или
    /// неклассифицированные аналоги, блок обязан появиться и объяснить причину.
    /// Молча исчезнувший блок выглядел бы как «связей нет» — это ложь.
    /// </summary>
    private bool HasVisibleSuggestion(HKCardItem item) =>
        SuggestionsFor(item).Any(s => s.Suggestions.Count > 0);

    /// <summary>
    /// Есть ли в строке основная марка. Нужна для показа видимой команды
    /// «Проверить связи» у сохранённой ХК: без основной марки предлагать нечего.
    /// </summary>
    private static bool HasPrimaryMaterial(HKCardItem item) =>
        item.Materials.Any(m => m.Category == GsmCategory.Primary && m.GsmMaterialId != Guid.Empty);

    /// <summary>Есть ли среди предложений хоть одна доступная позиция.</summary>
    private bool HasAddableSuggestion(HKCardItem item) =>
        SuggestionsFor(item).Any(s => s.Suggestions.Any(x => x.IsAddable));

    /// <summary>
    /// Число доступных вариантов, действительно отмеченных пользователем.
    /// Кнопка подтверждения активна только при положительном значении: если все
    /// отметки снялись или устарели, добавлять нечего.
    /// </summary>
    private int PickedAddableCount(HKCardItem item) =>
        _suggestionPicked.Count(p => p.ItemId == item.Id && IsPickStillValid(SuggestionsFor(item).ToList(), p));

    /// <summary>
    /// Заголовок блока: число доступных к добавлению вариантов и общее число
    /// связей, чтобы случай «показаны только недоступные» читался явно.
    /// </summary>
    private string SuggestionSummary(HKCardItem item)
    {
        var total = SuggestionsFor(item).Sum(s => s.Suggestions.Count);
        var addable = SuggestionsFor(item).Sum(s => s.Suggestions.Count(x => x.IsAddable));
        return addable == total
            ? $"{total} шт."
            : $"{addable} из {total} доступно";
    }

    private static bool SuggestionAlreadyInRow(HKCardItem item, Guid materialId, GsmCategory category) =>
        item.Materials.Any(m => m.GsmMaterialId == materialId && m.Category == category);

    private bool IsPicked(Guid itemId, Guid materialId, GsmCategory category) =>
        _suggestionPicked.Contains((itemId, materialId, category));

    private void ToggleSuggestionPick(HKCardItem item, Guid materialId, GsmCategory category)
    {
        var key = (item.Id, materialId, category);
        if (!_suggestionPicked.Add(key))
            _suggestionPicked.Remove(key);
    }

    private void ToggleSuggestionOpen(HKCardItem item)
    {
        if (!_suggestionOpen.Add(item.Id))
            _suggestionOpen.Remove(item.Id);
    }

    /// <summary>
    /// Подтверждение выбранных вариантов. Единственное место, где предложение
    /// превращается в строки ХК — и только в редактируемую модель карточки;
    /// запись происходит при сохранении через HKCardService.
    /// <para>
    /// Идемпотентность — по (строка, марка, категория): уже имеющаяся в этой
    /// категории строка не добавляется второй раз.
    /// </para>
    /// <para>
    /// Каждая отметка перепроверяется по <b>текущему</b> набору предложений
    /// (источник, категория, IsAddable). Между открытием блока и нажатием кнопки
    /// пользователь мог нажать «Проверить связи» или изменить основные марки:
    /// такой отметке нельзя превращаться в строку ХК.
    /// </para>
    /// </summary>
    private void ConfirmSuggestions(HKCardItem item)
    {
        var current = SuggestionsFor(item).ToList();
        var added = 0;
        var skipped = 0;

        foreach (var (itemId, materialId, category) in _suggestionPicked.ToList())
        {
            if (itemId != item.Id) continue;

            if (!IsPickStillValid(current, (itemId, materialId, category)))
            {
                // Вариант больше не предлагается или стал недоступен. Молча
                // выбросить его нельзя — пользователь ждал его добавления.
                skipped++;
                continue;
            }

            if (SuggestionAlreadyInRow(item, materialId, category)) continue;
            item.Materials.Add(new HKCardItemMaterial
            {
                Id = Guid.NewGuid(),
                HKCardItemId = item.Id,
                GsmMaterialId = materialId,
                Category = category,
            });
            added++;
        }

        _suggestionPicked.RemoveWhere(p => p.ItemId == item.Id);
        _suggestionOpen.Remove(item.Id);

        if (added > 0)
        {
            suggestionAddedCount = added;
            _suggestionAddedFor = item.Id;
        }

        if (skipped > 0)
        {
            suggestionSkippedCount = skipped;
            _suggestionSkippedFor = item.Id;
        }
    }

    /// <summary>
    /// Отмена. Закрывает блок и снимает ВРЕМЕННЫЙ выбор (флажки), но не трогает
    /// уже сохранённые материалы строки: отмена предложения не должна менять
    /// документ. Отмена вызывается явно, поэтому её последствия заметны.
    /// </summary>
    private void CancelSuggestions(HKCardItem item)
    {
        _suggestionPicked.RemoveWhere(p => p.ItemId == item.Id);
        _suggestionOpen.Remove(item.Id);
    }

    private void DismissSuggestionAdded()
    {
        suggestionAddedCount = 0;
        _suggestionAddedFor = Guid.Empty;
        suggestionSkippedCount = 0;
        _suggestionSkippedFor = Guid.Empty;
    }

    /// <summary>
    /// Повторная загрузка предложений после ошибки чтения, по команде
    /// «Проверить связи» или после того, как пользователь снял/заменил основную
    /// марку.
    /// </summary>
    private async Task ReloadSuggestionsAsync(HKCardItem item)
    {
        // Предупреждение о снятых отметках относилось к прошлому набору; после
        // перечитывания оно неактуально и снимается.
        suggestionSkippedCount = 0;
        _suggestionSkippedFor = Guid.Empty;
        await LoadSuggestionsForItemAsync(item, Guid.Empty);
    }

    private async Task RemoveMaterial(HKCardItem item, HKCardItemMaterial mat)
    {
        var wasPrimary = mat.Category == GsmCategory.Primary;
        item.Materials.Remove(mat);

        // Снятие или замена основной марки пересчитывает предложения: показывать
        // рекомендации удалённой марки было бы ложью. Уже подтверждённые
        // материалы при этом НЕ удаляются — они становятся обычными ручными
        // строками, и удалить их можно только отдельным действием.
        _suggestionPicked.RemoveWhere(p =>
            p.ItemId == item.Id && p.MaterialId == mat.GsmMaterialId);

        if (wasPrimary)
            await LoadSuggestionsForItemAsync(item, Guid.Empty);

        StateHasChanged();
    }

