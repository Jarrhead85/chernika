        sectionId?.ToString() ?? "";

    private static string LevelTitle(HKObjectLevel level) => level switch
    {
        HKObjectLevel.EquipmentModel => "Изделие",
        HKObjectLevel.Aggregate => "Агрегат",
        HKObjectLevel.Node => "Узел",
        _ => level.ToString()
    };

    private string NodeRootChoiceKey =>
        _nodeRootChoice?.ToString() ?? "";

    /// <summary>Выбор уровня верхнего узла показывается, пока старшая верхняя позиция — узел.</summary>
    private bool NeedsNodeRootChoice =>
        HKCardLevelRule.SeniorTopLevel(new HKTreeShape(
            BuildStructureInput().Nodes
                .Select(n => new HKTreePosition(n.Id, n.ParentId, n.Level)).ToList(),
            card.Items.Count(i => i.HKCardNodeId is null))) == HKObjectLevel.Node;

    private void SetNodeRootChoice(string value) =>
        _nodeRootChoice = value switch
        {
            nameof(HKObjectLevel.Aggregate) => HKObjectLevel.Aggregate,
            nameof(HKObjectLevel.EquipmentModel) => HKObjectLevel.EquipmentModel,
            _ => null
        };

    /// <summary>
    /// Выбор вида раздела для новой самостоятельной ветки.
    /// <para>
    /// Источник выбора один — <see cref="HKStructureEditorState.NewBranchSectionType"/>:
    /// отдельная копия выбора в компоненте расходилась с моделью, из-за чего
    /// подсветка зависела от идентификатора ещё не созданного раздела.
    /// </para>
    /// </summary>
    private void SelectNewBranchSection(HKCardSectionType? type)
    {
        // Выбор только запоминает вид раздела: сам раздел создаётся при
        // добавлении первой ветки, а не при переключении кнопки.
        if (_structure is not null)
            _structure.NewBranchSectionType = type;

        StateHasChanged();
    }

    /// <summary>Выбранный вид раздела новой ветки.</summary>
    private HKCardSectionType? SelectedSectionType => _structure?.NewBranchSectionType;

    /// <summary>
    /// Раздел для новой самостоятельной ветки. Раздел создаётся первым
    /// выбором панели и появляется в базе только при сохранении структуры.
    /// </summary>
    private Guid? SectionIdForNewBranch()
    {
        if (_structure is null)
            return null;

        var chosen = _structure?.NewBranchSectionType;
        if (chosen is null)
            return null;

        return _structure.AddSection(chosen.Value).Id;
    }

    /// <summary>Тип раздела, выбранный на панели для НОВОЙ самостоятельной ветки.</summary>

    /// <summary>Устойчивый Id выбранного на панели раздела новой ветки.</summary>

    /// <summary>
    /// Разрешённые уровни дочерней позиции — единое правило проекта, а не
    /// отдельная таблица в разметке.
    /// </summary>
    private static IReadOnlyList<HKObjectLevel> AllowedChildLevels(EditorNode parent) =>
        HKStructureEditorState.AllowedChildLevels(parent.Level);

    private string ChildLevelKey(Guid nodeId, IReadOnlyList<HKObjectLevel> allowed)
    {
        var chosen = _childLevelChoice.TryGetValue(nodeId, out var value) && allowed.Contains(value)
            ? value
            : allowed[0];
        return chosen.ToString();
    }

    private void SetChildLevelChoice(EditorNode parent, string value)
    {
        if (!Enum.TryParse<HKObjectLevel>(value, out var level))
            return;
        if (!AllowedChildLevels(parent).Contains(level))
            return;
        _childLevelChoice[parent.Id] = level;
    }

    /// <summary>Количество потомков позиции: вложенные позиции и конечные строки.</summary>
    private int CountChildRows(Guid nodeId) =>
        (_structure?.Nodes.Count(n => n.ParentId == nodeId) ?? 0)
        + (_structure?.Items.Count(i => i.NodeId == nodeId) ?? 0);

    private bool IsCollapsed(Guid nodeId) => _structure?.IsCollapsed(nodeId) ?? false;

    /// <summary>
    /// Свёрнутое или развёрнутое — это просмотр: доступно и в read-only режиме
    /// и не меняет порядок, номера и итоги.
    /// </summary>
    private void ToggleCollapse(Guid nodeId)
    {
        _structure?.ToggleCollapse(nodeId);
        StateHasChanged();
    }

    /// <summary>
    /// Перенос под корень: раздел прежнего корня сохраняется, чтобы
    /// принадлежность ветки не потерялась молча.
    /// </summary>
    private void MoveUnderRoot(EditorNode node)
    {
        if (!canEditStructure || _structure is null || node.ParentId is null)
            return;

        var nodesById = _structure.Nodes.ToDictionary(x => x.Id);
        var upper = node.ParentId.Value;
        Guid? inheritedSection = null;
        while (nodesById.TryGetValue(upper, out var current))
        {
            if (current.ParentId is null)
            {
                inheritedSection = current.SectionId;
                break;
            }
            upper = current.ParentId.Value;
        }

        if (!_structure.TryMovePosition(node.Id, null, out var error))
        {
            _structureError = error;
            return;
        }

        node.SectionId = inheritedSection;
        ResetChoiceIfNotApplicable();
        StateHasChanged();
    }

    private void ChangeTopNodeSection(EditorNode node, string value)
    {
        // Раздел меняется только у верхней позиции всей ветки: вложенная
        // наследует раздел корня и собственного не имеет.
        if (!canEditStructure || _structure is null || node.ParentId is not null)
            return;

        var sectionId = Guid.TryParse(value, out var id) ? id : (Guid?)null;
        if (!_structure.TrySetTopSection(node.Id, sectionId, out var error))
        {
            _structureError = error;
            return;
        }

        StateHasChanged();
    }

    private void ChangeRootItemSection(RowItem item, string value)
    {
        if (!canEditStructure || _structure is null || !item.IsLocal || item.NodeId is not null)
            return;

        var sectionId = Guid.TryParse(value, out var id) ? id : (Guid?)null;
        if (!_structure.TrySetRootItemSection(item.Id, sectionId, out var error))
        {
            _structureError = error;
            return;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Фокус в название новой позиции ставится после отрисовки: пока
    /// элемента нет в DOM, сфокусироваться на нём нельзя.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNodeId is not { } nodeId)
            return;

        _focusNodeId = null;

        try
        {
            // Фокус ставится после отрисовки: до этого элемента нет в DOM.
            await JS.InvokeVoidAsync("popoverPositioning.focusById", PositionNameId(nodeId));
        }
        catch (JSException)
        {
            // Фокус не критичен: работа редактора от него не зависит.
        }
        catch (InvalidOperationException)
        {
            // Предварительный рендер или отключённый JS.
        }
    }

    /// <summary>Устойчивый идентификатор поля названия позиции.</summary>
    private static string PositionNameId(Guid nodeId) => $"hk-position-name-{nodeId:N}";

    private void AddTopPosition()
    {
        if (!canEditStructure || _structure is null)
            return;

        // Раздел выбранного вида создаётся вместе с веткой — в модели.
        var node = _structure.AddTopPosition(_topPositionLevel);
        _focusNodeId = node.Id;
        ResetChoiceIfNotApplicable();
        StateHasChanged();
    }

    private void AddChildPosition(EditorNode parent)
    {
        if (!canEditStructure || _structure is null)
            return;

        var allowed = AllowedChildLevels(parent);
        if (allowed.Count == 0)
            return;

        var level = _childLevelChoice.TryGetValue(parent.Id, out var chosen) && allowed.Contains(chosen)
            ? chosen
            : allowed[0];

        var node = _structure.AddChildPosition(parent.Id, level);
        _focusNodeId = node.Id;
        StateHasChanged();
    }

    /// <summary>
    /// Новая конечная строка: под позицией наследует раздел ветки, под корнем
    /// несёт раздел самостоятельно.
    /// </summary>
    private void AddRowUnder(EditorNode? parent)
    {
        if (!canEditStructure || _structure is null)
            return;

        var item = _structure.AddItem(parent?.Id, Guid.Empty);
        item.UnitOfMeasure = "г";
        item.Quantity = 1;

        if (parent is null)
            item.SectionId = SectionIdForNewBranch();

        _auSearch[item.Id] = "";
        _auOpen[item.Id] = false;
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen[(item.Id, cat)] = false;
            _matSearch[(item.Id, cat)] = "";
        }

        _focusItemId = item.Id;
        StateHasChanged();
    }

    /// <summary>
    /// Перемещение среди соседей своего контейнера: корень ХК, конкретный
    /// раздел или конкретная позиция. Соседи берутся доменной механикой,
    /// плоский видимый порядок не используется.
    /// </summary>
    private void MoveTreeRow(EditorNode? node, RowItem? item, int direction)
    {
        if (!canEditStructure || _structure is null)
            return;

        var moved = node is not null
            ? _structure.MovePosition(node.Id, direction)
            : item is not null && item.IsLocal && _structure.MoveItem(item.Id, direction);

        if (!moved)
            return;

        StateHasChanged();
    }

    /// <summary>
    /// Перемещение среди соседей ОДНОГО родителя: позиции и конечные строки
    /// делят одну последовательность. Доменный порядок: SortOrder, потом
    /// позиции, затем идентификаторы.
    /// </summary>
    /// <summary>
    /// Доступность перемещения: сосед берётся из контейнера записи, поэтому
    /// сворачивание соседней ветки на возможность перемещения не влияет.
    /// </summary>
    private bool CanMove(EditorNode? node, RowItem? item, int direction)
    {
        if (_structure is null)
            return false;

        if (!IsAutonomousMode)
        {
            var flat = card.Items.OrderBy(i => i.SortOrder).ToList();
            var current = flat.FindIndex(i => item is not null && i.Id == item.Id);
            var at = current + direction;
            return current >= 0 && at >= 0 && at < flat.Count;
        }

        return node is not null
            ? _structure.CanMovePosition(node.Id, direction)
            : item is not null && item.IsLocal && _structure.CanMoveItem(item.Id, direction);
    }

    private void AskDeletePosition(EditorNode node)
    {
        if (!canEditComposition)
            return;
        _confirmDeletePositionId = node.Id;
        _confirmImpactText = _structure?.PositionImpactText(node.Id);
        StateHasChanged();
    }

    private void CancelDeletePosition()
    {
        _confirmDeletePositionId = null;
        StateHasChanged();
    }

    /// <summary>Описание затрагиваемого содержимого перед удалением ветки.</summary>
    private string DeleteImpactText(Guid nodeId) =>
        _structure?.PositionImpactText(nodeId) ?? "";

    /// <summary>
    /// Удаление подтверждённой ветки. Доступность действия перепроверяется в
    /// обработчике подтверждения: показ диалога и его нажатие — разные моменты.
    /// </summary>
    private void ConfirmDeletePosition()
    {
        if (!canEditStructure || _structure is null || _confirmDeletePositionId is not { } nodeId)
        {
            _confirmDeletePositionId = null;
            return;
        }

        var doomedItems = _structure.Items
            .Where(i => i.NodeId is { } pid
                && _structure.Nodes.Any(n => n.Id == pid
                    && (n.Id == nodeId || n.ParentId == nodeId)))
            .Select(i => i.Id)
            .ToList();

        _structure.RemovePosition(nodeId);

        foreach (var itemId in doomedItems)
            CleanupItemDicts(itemId);

        _confirmDeletePositionId = null;
        _confirmImpactText = null;
        ResetChoiceIfNotApplicable();
        StateHasChanged();
    }

    private void CleanupItemDicts(Guid itemId)
    {
        _auSearch.Remove(itemId);
        _auOpen.Remove(itemId);
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen.Remove((itemId, cat));
            _matSearch.Remove((itemId, cat));
        }
    }

    /// <summary>Выбор верхнего узла сохраняется только пока он применим.</summary>
    private void ResetChoiceIfNotApplicable()
    {
        var shape = new HKTreeShape(
            card.TreeNodes.Select(n => new HKTreePosition(n.Id, n.ParentId, n.Level)).ToList(),
            card.Items.Count(i => i.HKCardNodeId is null));
        if (HKCardLevelRule.SeniorTopLevel(shape) != HKObjectLevel.Node)
            _nodeRootChoice = null;
    }

    /// <summary>Атомарное сохранение разделов, позиций, строк и материалов.</summary>
    private async Task SaveStructureAsync()
    {
        if (!canEditStructure || _structure is null || IsNew)
            return;

        // Повторное нажатие не создаёт второй запрос: команда уже выполняется.
        if (_savingStructure)
            return;

        _savingStructure = true;
        errorMessage = null;
        _structureError = null;

        try
        {
            // Команда строится ИЗ ЛОКАЛЬНОЙ МОДЕЛИ редактора: прежний
            // построитель читал card.TreeNodes и card.Items, то есть прежний
            // EF-граф, в котором правок редактора не было.
            _structure.UpdateVersion(loadedRowVersion);
            var command = _structure.BuildCommand();

            await using (await DbLock.WaitAsync("HKEdit: сохранение структуры"))
            {
                await HKCardService.SaveStructureAsync(command);
                // Карта возвращается в редактирование: служебные поля — из
                // базы, несохранённые реквизиты остаются введёнными и не были
                // записаны структурной командой.
                await HKCardService.AttachCardForEditingAsync(card, card.Id);
            }

            // Подтверждённая версия принимается, изменения снимаются. Граф НЕ
            // перечитывается: правки, сделанные во время запроса, остаются в
            // модели и не теряются.
            loadedRowVersion = card.RowVersion;
            _structure.UpdateVersion(loadedRowVersion);
            _structure.MarkClean();
        }
        catch (HkCardVersionConflictException ex)
        {
            // Конфликт версий не повторяется автоматически и не уничтожает
            // локальный ввод: правки структуры остаются на экране.
            errorMessage = ex.Message + " Локальные правки структуры сохранены на экране.";
        }
        catch (InvalidOperationException ex)
        {
            _structureError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _structureError = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (DbUpdateException)
        {
            _structureError = "Не удалось сохранить структуру. Проверьте заполнение позиций и строк и повторите попытку.";
        }
        finally
        {
            // Состояние сохранения снимается при любом исходе: иначе после
            // первого сохранения кнопка осталась бы в состоянии «Сохраняю…»
            // и повторное сохранение стало бы невозможным.
            _savingStructure = false;
        }
    }


    /// <summary>Идёт сохранение структуры: повторное нажатие не создаёт второй запрос.</summary>
    private bool _savingStructure;

    /// <summary>В структуре есть несохранённые изменения (по локальной модели).</summary>

    /// <summary>Черновик ещё не создан: структурные изменения блокируют обычное сохранение requisites.</summary>
    private string? StructureDirtyWarning =>
        structureDirty && IsAutonomousMode && !IsNew
            ? "В структуре есть несохранённые изменения — сначала нажмите «Сохранить структуру» либо сбросьте правки обновлением страницы."
            : null;

