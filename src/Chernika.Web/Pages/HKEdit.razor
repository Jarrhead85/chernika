    private async Task UploadAttachment()
    {
        if (card.Id == Guid.Empty) return;
        if (!canEdit) return;
        if (card.Status is not (HKCardStatus.Draft or HKCardStatus.RevisionRequired)) return;
        if (_pendingFile == null) return;

        _attachmentError = null;
        _uploading = true;
        StateHasChanged();

        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            using var content = new MultipartFormDataContent();
            var stream = _pendingFile.OpenReadStream(maxAllowedSize: FileOptions.Value.MaxPdfSizeBytes);
            content.Add(new StreamContent(stream), "file", _pendingFile.Name);
            var response = await http.PostAsync($"/api/HKCards/{card.Id}/attachment", content);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                _attachmentError = error;
            }
            else
            {
                _pendingFile = null;
                _fileInputKey++;
                _previewPending = false;
                _previewOpen = false;
                await JS.InvokeVoidAsync("hkPdfPreview.clear", "hk-pdf-preview");
                await LoadAttachmentAsync(card.Id);
            }
        }
        catch (Exception ex)
        {
            _attachmentError = ex.Message;
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAttachment()
    {
        if (_attachment == null) return;
        try
        {
            using var http = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
            var response = await http.DeleteAsync($"/api/HKCards/{card.Id}/attachment");
            if (response.IsSuccessStatusCode)
            {
                _attachment = null;
                _fileInputKey++;
            }
        }
        catch { }
        StateHasChanged();
    }

