    }

    private async Task ToggleAuDropdown(Guid itemId, string dropId, string btnId)
    {
        if (_auOpen.GetValueOrDefault(itemId))
        {
            await CloseActiveDropdownAsync();
            StateHasChanged();
        }
        else
        {
            await CloseActiveDropdownAsync();
            _auOpen[itemId] = true;
            _auSearch[itemId] = "";
            _activeDropdownId = dropId;
            StateHasChanged();
            await Task.Delay(50);
            if (_disposed) return;
            await JS.InvokeVoidAsync("dropdownPortal.attach", dropId, btnId);
            await JS.InvokeVoidAsync("dropdownPortal.onClickOutside", dropId, _dotNetRef);
        }
    }

