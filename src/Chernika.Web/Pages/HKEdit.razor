    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("dropdownPortal.cleanup");
        }
        catch { /* ignore — page is unloading */ }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await InitializeAsync();
        }
        catch (OperationCanceledException)
        {
            // Отмена устаревшей операции не меняет текущую форму.
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "HKEdit: первоначальная инициализация не удалась, этап {Stage}", _loadStage);
            _loadErrorText = "Не удалось подготовить страницу. Повторите загрузку или обратитесь в службу поддержки.";
            _loadState = HkEditLoadState.Error;
            ResetEditingFlags();
            canQuickCreate = false;
        }
    }

    private async Task InitializeAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _loadStage = "инициализация";

        // Проверки прав и чтение организаций выполняются через общий scoped DbContext,
        // поэтому сериализуем их тем же CircuitDbLock, что и загрузку данных.
        await using (await DbLock.WaitAsync("HKEdit.OnInitialized: права"))
        {
            // Признак системного администратора определяется до чтения списка
            // отделов: без него администратор не видел бы поле выбора отдела
            // и не смог бы создать карту.
            isSystemAdmin = await Permissions.IsSystemAdminAsync();

            if (isSystemAdmin)
            {
                allBranches = await HKCardService.GetAllBranchesAsync();
            }
            canSendToApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKNodeSubmit)
                || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKAggregateSubmit)
                || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKEquipmentSubmit)
                || await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKComplexSubmit);
            canApprove = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKApprove);
            canReturn = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKReview);
            canArchive = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKArchive);

            // Создание и редактирование — единое право HK.Work: уровень карты
            // и её режим условием не являются. Отправка на согласование,
            // проверка, утверждение и архивирование остались на своих правах.
            canCreateNewVersion = canWork = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKWork);
            canCreateNode = canCreateAggregate = canCreateEquipmentModel = canCreateComplex = canWork;

        }

        // Названия марок читаются отдельной операцией: внутри блока справочников
        // они брали бы ту же блокировку повторно, а семафор нереентерабельный —
        // ожидание тогда ждало бы само себя.
        await LoadMaterialNamesAsync(CancellationToken.None);

        await using (await DbLock.WaitAsync("HKEdit.OnInitialized: справочники"))
        {
            complexes = await EquipmentService.GetComplexesAsync();
            models = await EquipmentService.GetModelsAsync();
            aggregates = await EquipmentService.GetAggregatesAsync();
            nodes = await EquipmentService.GetNodesAsync();
            assemblyUnits = await EquipmentService.GetAssemblyUnitsAsync();
            gsmMaterials = await GsmMaterialService.GetActiveForSelectionAsync();
            _materialNames = null;
            // Предложения связанных ГСМ НЕ загружаются здесь: они появляются
            // сразу после явного выбора основной марки в строке. Предзагрузка по
            // сохранённым строкам была причиной дефекта — марка, выбранная позже,
            // не знала своих связей до перезагрузки страницы.
            _suggestions.Clear();
            _suggestionErrors.Clear();
            _suggestionOpen.Clear();
            _suggestionPicked.Clear();
            _suggestionLoading.Clear();
            DismissSuggestionAdded();
            allMilitaryBranches = await EquipmentService.GetMilitaryBranchesAsync();
        }

        if (!IsNew && Id.HasValue)
            await ReloadForRouteAsync();
        else
            await InitCreateModeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew || !Id.HasValue)
        {
            if (_loadedCardId != null)
                await InitCreateModeAsync();
            return;
        }

        if (Id != _loadedCardId)
            await ReloadForRouteAsync();
    }

    /// <summary>
    /// Загрузка карты по маршруту.
    /// <para>
    /// Каждая загрузка получает номер поколения и собственную отмену:
    /// предыдущий запрос отменяется, а его результат, даже если он завершится
    /// позже, не публикуется — он не должен заменить текущую карту, сбросить
    /// её права или вывести свою ошибку.
    /// </para>
    /// </summary>
    private async Task ReloadForRouteAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;
        var requestedId = Id!.Value;
        var generation = ++_loadGeneration;

        _loadState = HkEditLoadState.Loading;
        _loadErrorText = null;
        _versionsError = null;
        errorMessage = null;
        // Набор марок карточки сменился — кэш названий сбрасывается.
        _materialNames = null;

        Logger.LogDebug("HKEdit: загрузка карты {CardId}, поколение {Generation}", requestedId, generation);

        LoadOutcome outcome;
        try
        {
            outcome = await LoadCardAsync(requestedId, ct, generation);

            // Названия марок — некритичный блок: их ошибка не должна
            // уничтожать загруженную карту.
            if (outcome == LoadOutcome.Ready)
            {
                try
                {
                    await LoadMaterialNamesAsync(ct);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogWarning(ex, "HKEdit: названия марок не прочитаны {CardId}", requestedId);
                    _versionsError = "Названия марок недоступны.";
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            Logger.LogDebug("HKEdit: загрузка отменена {CardId}", requestedId);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "HKEdit: загрузка карты {CardId} не удалась, этап {Stage}", requestedId, _loadStage);
            if (generation != _loadGeneration || requestedId != Id)
                return;

            _loadErrorText = "Не удалось загрузить карту. Повторите загрузку или обратитесь в службу поддержки.";
            _loadState = HkEditLoadState.Error;
            ResetEditingFlags();
            canQuickCreate = false;
            return;
        }

        if (ct.IsCancellationRequested || generation != _loadGeneration)
            return;

        // Ready выставляется только после успешной обязательной загрузки:
        // отказ, отсутствие карты и запрет доступа остаются тем, чем были.
        if (outcome != LoadOutcome.Ready)
        {
            Logger.LogDebug("HKEdit: загрузка не дала документа {CardId}: {Outcome}", requestedId, outcome);
            return;
        }

        _loadStage = null;
        _loadedCardId = requestedId;
        _loadState = HkEditLoadState.Ready;
        Logger.LogDebug("HKEdit: загрузка завершена {CardId}", requestedId);
    }

    /// <summary>Повторная загрузка текущей карты после ошибки.</summary>
    private async Task RetryLoadAsync()
    {
        if (Id is { } id && id != Guid.Empty)
        {
            _loadedCardId = null;
            await ReloadForRouteAsync();
            return;
        }

        await InitCreateModeAsync();
    }

    private async Task InitCreateModeAsync()
    {
        _loadState = HkEditLoadState.Loading;
        errorMessage = null;
        card = CreateEmptyCard();
        statusStr = "Draft";
        _existingActiveCard = null;
        _activeCardWarning = null;
        _attachment = null;
        _components = new();
        _aggregatedRows = new();
        // Новая карта: разделов нет, редактор начинается с пустой структуры.
        await InitStructureStateAsync(_loadCts?.Token ?? CancellationToken.None);
        _availableChildCards = new();
        _pendingChild = null;
        _pendingChildCards.Clear();
        _createdCardId = null;
        _addChildOpen = false;
        _addChildSearch = "";
        selectedMilitaryBranchIds = new();
        _loadedCardId = null;

        // Уровень автономной карты не выбирается и не подставляется по умолчанию:
        // он определяется структурой, а структуры пока нет.
        selectedLevel = HKObjectLevel.Undefined;
        selectedComplexId = Guid.Empty;
        selectedModelId = Guid.Empty;
        selectedAggregateId = Guid.Empty;
        selectedNodeId = Guid.Empty;

        bool canWorkNew;
        await using (await DbLock.WaitAsync())
        {
            canWorkNew = await Perms.HasPermissionAsync(currentUserId, PermissionCodes.HKWork);
        }

        // У новой карты этапов нет, и блокировать нечего: редактируемость всех
        // частей определяется правом HK.Work. Флаги задаются здесь явно —
        // оставленные по умолчаниюtrue сделали бы поля редактируемыми и без права.
        canEditDetails = canWorkNew;
        canEditComposition = canWorkNew;
        canEditPdf = canWorkNew;
        canEdit = canEditDetails || canEditComposition;
        canQuickCreate = canEditComposition;

        // Автономная карта сохраняется с пустой структурой, поэтому строка
        // состава заранее не создаётся: её добавит редактор дерева.
        if (selectedLevel == HKObjectLevel.Node && !card.Items.Any())
        {
            card.Items.Add(new HKCardItem
            {
                Id = Guid.NewGuid(),
                HKCardId = card.Id,
                AssemblyUnitId = Guid.Empty,
                Quantity = 0,
                Volume = 0m,
                UnitOfMeasure = "г",
                SortOrder = 1
            });
        }

        InitItemDicts();
        _loadState = HkEditLoadState.Ready;
    }

    /// <summary>
    /// Итог обязательной загрузки карты.
    /// <para>
    /// Вызывающий метод решает по результату, можно ли показывать документ:
    /// состояние Ready выставляется только при успехе, а отказ, отсутствие и
    /// отмена остаются тем, чем были.
    /// </para>
    /// </summary>
    private enum LoadOutcome
    {
        /// <summary>Карта загружена и опубликована.</summary>
        Ready,

        /// <summary>Карты нет.</summary>
        NotFound,

        /// <summary>Доступа к карте нет.</summary>
        Forbidden,

        /// <summary>Техническая ошибка загрузки.</summary>
        Error,

        /// <summary>Загрузка отменена.</summary>
        Cancelled,

        /// <summary>Загрузка устарела: маршрут уже сменился.</summary>
        Stale
    }



    private async Task<LoadOutcome> LoadCardAsync(Guid cardId, CancellationToken ct, int generation)
    {
        try
        {
            var core = await LoadCardCoreAsync(cardId, ct, generation);
            if (core != LoadOutcome.Ready)
                return core;

            // Наличие файла — часть готовой модели: «файл не прикреплён» не
            // показывается, пока неизвестно, прикреплён ли он.
            await LoadAttachmentAsync(cardId, ct);
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "HKEdit: нет доступа к карте {CardId}", cardId);
            if (generation != _loadGeneration || cardId != Id)
                return LoadOutcome.Stale;

            _loadErrorText = ex.Message;
            _loadState = HkEditLoadState.Forbidden;
            ResetEditingFlags();
            canQuickCreate = false;
            return LoadOutcome.Forbidden;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Отменённая загрузка ничего не публикует: состояние текущей
            // карты остаётся прежним.
            return LoadOutcome.Cancelled;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "HKEdit: техническая ошибка загрузки карты {CardId}, этап {Stage}",
                cardId, _loadStage);
            if (generation != _loadGeneration || cardId != Id)
                return LoadOutcome.Stale;

            _loadErrorText = "Не удалось загрузить карту. Повторите загрузку или обратитесь в службу поддержки.";
            _loadState = HkEditLoadState.Error;
            ResetEditingFlags();
            canQuickCreate = false;
            return LoadOutcome.Error;
        }

        return LoadOutcome.Ready;
    }

    /// <summary>
    /// Обязательная загрузка карты: реквизиты, граф структуры, состояния
    /// этапов и возможности пользователя.
    /// <para>
    /// Данные собираются во временные переменные и публикуются в поля
    /// компонента только целиком и только если загрузка ещё актуальна:
    /// завершившийся позже старый запрос не должен заменить текущую карту,
    /// сбросить её права или вывести свою ошибку.
    /// </para>
    /// </summary>
    private async Task<LoadOutcome> LoadCardCoreAsync(Guid cardId, CancellationToken ct, int generation)
    {
        _loadStage = "реквизиты";

        await using (await DbLock.WaitAsync(ct))
        {
            var existing = await HKCardService.GetByIdAsync(cardId, ct);
            if (ct.IsCancellationRequested)
                return LoadOutcome.Cancelled;
            if (generation != _loadGeneration)
                return LoadOutcome.Stale;

            if (existing == null)
            {
                Logger.LogWarning("HKEdit: карта не найдена {CardId}", cardId);
                _loadErrorText = "ХК не найдена.";
                _loadState = HkEditLoadState.NotFound;
                ResetEditingFlags();
                canQuickCreate = false;
                return LoadOutcome.NotFound;
            }

            _loadStage = "структура";
            var structure = await HKCardService.GetStructureGraphAsync(cardId, ct);
            if (ct.IsCancellationRequested)
                return LoadOutcome.Cancelled;
            if (generation != _loadGeneration)
                return LoadOutcome.Stale;

            _loadStage = "этапы согласования";
            var capabilities = await LoadApprovalStateAsync(
                cardId, existing.Status, ct, lockHeld: true);
            if (ct.IsCancellationRequested)
                return LoadOutcome.Cancelled;
            if (generation != _loadGeneration)
                return LoadOutcome.Stale;

            // Кандидаты в согласующие — для филиала ЗАГРУЖАЕМОЙ карты.
            _loadStage = "согласующие";
            branchApprovers = new List<HKApproverCandidate>();
            _approversError = null;
            try
            {
                branchApprovers = await GetBranchApproversAsync(existing.BranchId, ct);
                _approversLoaded = true;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogWarning(ex, "HKEdit: кандидаты в согласующие не получены {CardId}", cardId);
                _approversLoaded = false;
                _approversError = "Не удалось получить список согласующих.";
            }

            if (ct.IsCancellationRequested)
                return LoadOutcome.Cancelled;
            if (generation != _loadGeneration)
                return LoadOutcome.Stale;

            // История версий — некритичный блок: её ошибка не должна
            // уничтожать уже загруженную карту.
            IReadOnlyList<HKCardVersionDto> versions = Array.Empty<HKCardVersionDto>();
            string? versionsError = null;
            try
            {
                versions = await HKCardService.GetVersionsAsync(cardId, ct);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogWarning(ex, "HKEdit: история версий не прочитана {CardId}", cardId);
                versionsError = "История версий недоступна.";
            }

            var level = existing.ObjectLevel;

            // Публикация: с этого момента страница показывает целую карту.
            card = existing;
            CaptureLoadedRequisites();
            loadedRowVersion = existing.RowVersion;
            _versions = versions.ToList();
            _versionsError = versionsError;
            selectedLevel = level;
            selectedComplexId = existing.ComplexId ?? Guid.Empty;
            selectedModelId = existing.EquipmentModelId ?? Guid.Empty;
            selectedAggregateId = existing.AggregateId ?? Guid.Empty;
            selectedNodeId = existing.NodeId ?? Guid.Empty;
            statusStr = existing.Status.ToString();

            approvalStages = capabilities.Stages.ToList();
            canSubmit = capabilities.CanSubmit;
            canEditDetails = capabilities.CanEditDetails;
            canEditComposition = capabilities.CanEditComposition;
            canEditPdf = capabilities.CanEditPdf;
            canView = capabilities.CanView;

            // Общий флаг оставлен только для полей, не разделённых по частям.
            canEdit = canEditDetails || canEditComposition;
            canQuickCreate = canEditComposition;

            // Локальное состояние структуры — из той же проекции графа.
            _structure = structure is null
                ? null
                : HKStructureEditorState.FromGraph(structure);

            if (level == HKObjectLevel.Node && !existing.Items.Any())
            {
                existing.Items.Add(new HKCardItem
                {
                    Id = Guid.NewGuid(),
                    HKCardId = existing.Id,
                    AssemblyUnitId = Guid.Empty,
                    Quantity = 0,
                    Volume = 0m,
                    UnitOfMeasure = "г",
                    SortOrder = 1
                });
            }

            InitItemDicts();

            if (level != HKObjectLevel.Node)
            {
                _components = await HKCardService.GetComponentsAsync(cardId, ct);
                _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(cardId, ct);
            }

            if (level == HKObjectLevel.EquipmentModel)
            {
                var cardBranches = await EquipmentService.GetHKCardMilitaryBranchesAsync(cardId, ct);
                if (ct.IsCancellationRequested)
                    return LoadOutcome.Cancelled;
                if (generation != _loadGeneration)
                    return LoadOutcome.Stale;
                selectedMilitaryBranchIds = cardBranches.Select(b => b.Id).ToList();
            }
        }

        if (ct.IsCancellationRequested)
            return LoadOutcome.Cancelled;
        if (generation != _loadGeneration)
            return LoadOutcome.Stale;

        _loadStage = null;
        _loadedCardId = cardId;
        _loadState = HkEditLoadState.Ready;
        Logger.LogDebug("HKEdit: карта загружена {CardId}", cardId);
        return LoadOutcome.Ready;
    }

    private async Task LoadAttachmentAsync(Guid cardId, CancellationToken ct)
    {
        try
        {
            AttachmentInfo? loaded = null;
            await using (await DbLock.WaitAsync(ct))
            {
                var info = await HKCardService.GetAttachmentInfoAsync(cardId, ct);
                loaded = info is null
                    ? null
                    : new AttachmentInfo(info.Id, info.OriginalFileName, info.SizeBytes,
                        info.UploadedByUserName, info.UploadedAt);
            }
            _attachment = loaded;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // маршрут уже изменился
        }
        catch (UnauthorizedAccessException)
        {
            _attachment = null;
        }
        catch (InvalidOperationException)
        {
            _attachment = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось загрузить вложение ХК {CardId}", cardId);
            _attachment = null;
        }
    }

    private async Task CloseActiveDropdownAsync()
    {
        if (_activeDropdownId != null)
        {
            try
            {
                await JS.InvokeVoidAsync("dropdownPortal.detach", _activeDropdownId);
            }
            catch (JSDisconnectedException)
            {
                // circuit завершается — просто сбрасываем состояние
            }
            catch (ObjectDisposedException)
            {
            }
            catch (JSException)
            {
                // JS-модуль уже недоступен, состояние всё равно сбрасываем
            }
            _activeDropdownId = null;
        }
        _objectDropOpen = false;
        _mbDropOpen = false;
        foreach (var key in _matOpen.Keys.ToList())
            _matOpen[key] = false;
        foreach (var key in _auOpen.Keys.ToList())
            _auOpen[key] = false;
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await CloseActiveDropdownAsync();
                StateHasChanged();
            }
            catch
            {
                // игнорируем — circuit может завершаться
            }
        });
    }

    private void InitItemDicts()
    {
        _auSearch = card.Items.ToDictionary(i => i.Id, i => "");
        _auOpen = card.Items.ToDictionary(i => i.Id, _ => false);
        _matOpen = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => false);
        _matSearch = card.Items.SelectMany(i => new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign }.Select(c => (i.Id, c))).ToDictionary(k => k, _ => "");
    }

    private void AddItem()
    {
        var maxOrder = card.Items.Any() ? card.Items.Max(i => i.SortOrder) : 0;
        var item = new HKCardItem
        {
            Id = Guid.NewGuid(),
            HKCardId = card.Id,
            AssemblyUnitId = Guid.Empty,
            Quantity = 0,
            Volume = 0m,
            UnitOfMeasure = "г",
            SortOrder = maxOrder + 1
        };
        card.Items.Add(item);
        _auSearch[item.Id] = "";
        _auOpen[item.Id] = false;
        foreach (var cat in new[] { GsmCategory.Primary, GsmCategory.Duplicate, GsmCategory.Reserve, GsmCategory.Foreign })
        {
            _matOpen[(item.Id, cat)] = false;
            _matSearch[(item.Id, cat)] = "";
        }
        _focusItemId = item.Id;
    }

    private void MoveItem(HKCardItem item, int direction)
    {
        var sorted = card.Items.OrderBy(i => i.SortOrder).ToList();
        var idx = sorted.IndexOf(item);
        if (idx < 0) return;
        var target = idx + direction;
        if (target < 0 || target >= sorted.Count) return;
        (sorted[target].SortOrder, item.SortOrder) = (item.SortOrder, sorted[target].SortOrder);
    }

    // ── Редактор собственной структуры ─────────────────────────────
    // Локальное состояние редактора: изменения разделов, позиций и строк
    // остаются на экране до явного атомарного сохранения
    // (SaveHKCardStructureCommand), а не записываются цепочкой команд.

    /// <summary>Разделы карты в порядке их отображения.</summary>
    /// <summary>
    /// Независимое состояние редактора: глубокая копия read-only проекции
    /// графа. Правки до сохранения не затрагивают загруженные сущности.
    /// </summary>
    private HKStructureEditorState? _structure;

    /// <summary>
    /// Собственная структура редактируется у сохранённой карты: у нового
    /// черновика она ещё не существует в базе, поэтому недоступна до
    /// первого сохранения реквизитов.
    /// </summary>
    private bool canEditStructure => canEditComposition && !IsNew && _structure is not null;

    private List<EditorSection> EditorSections =>
        _structure?.Sections.OrderBy(s => s.SortOrder).ToList() ?? new List<EditorSection>();

    /// <summary>Активный выбор панели: тип раздела для НОВОЙ верхней ветки.</summary>

    /// <summary>Свернутые позиции: вложенность скрыта, номера остаются по полной структуре.</summary>
    private Dictionary<Guid, bool> _collapsed = new();

    /// <summary>Выбранный уровень следующей дочерней позиции.</summary>
    private Dictionary<Guid, HKObjectLevel> _childLevelChoice = new();

    /// <summary>Позиция, ожидающая подтверждения удаления.</summary>
    private Guid? _confirmDeletePositionId;

    /// <summary>Ошибка серверной проверки структуры, показанная над таблицей.</summary>
    private string? _structureError;

    /// <summary>Выбранная позиция по устойчивому Id — для подсветки и итогов.</summary>
    /// <summary>
    /// Позиция, в название которой после отрисовки ставится фокус.
    /// <para>
    /// До отрисовки элемента в DOM нет, поэтому фокус ставится в
    /// <see cref="OnAfterRenderAsync"/>: это безопасный механизм без
    /// обращения к JS и без таймеров.
    /// </para>
    /// </summary>
    private Guid? _focusNodeId;


    /// <summary>Описание содержимого, удаляемого подтверждаемым действием.</summary>
    private string? _confirmImpactText;

    /// <summary>В структуре есть несохранённые локальные изменения.</summary>

    /// <summary>Выбор уровня верхнего узла. Роковой выбор сбрасывается, когда он перестаёт быть применимым.</summary>
    private HKObjectLevel? _nodeRootChoice;

    /// <summary>Уровень следующей верхней позиции.</summary>
    private HKObjectLevel _topPositionLevel = HKObjectLevel.Aggregate;

    /// <summary>
    /// Строит состояние редактора из полного рабочего графа. Чтение идёт
    /// отдельной read-only проекцией: загруженные сущности не редактируются.
    /// </summary>
    private async Task InitStructureStateAsync(CancellationToken ct)
    {
        _childLevelChoice.Clear();
        _confirmDeletePositionId = null;
        _topPositionLevel = HKObjectLevel.Aggregate;

        var graph = await HKCardService.GetStructureGraphAsync(card.Id, ct);
        if (graph is null)
        {
            _structure = null;
            return;
        }

        _structure = HKStructureEditorState.FromGraph(graph);
        _nodeRootChoice = _structure.NodeRootChoice;
    }

    /// <summary>В структуре есть несохранённые изменения.</summary>
    private bool structureDirty => _structure?.IsDirty ?? false;

    /// <summary>Строка редактора: номер из доменного механизма плюс ссылка на данные.</summary>
    private sealed record EditorRow(
        HKStructureRow Row, EditorNode? Node, RowItem? Item, int Index, bool HasChildren);

    /// <summary>
    /// Строка таблицы редактора: единый вид для собственной структуры
    /// автономной карты и для обычных строк ХК.
    /// <para>
    /// Автономная карта работает с независимым состоянием редактора, обычная —
    /// с сохранёнными строками карты. Разметка при этом одна: источник выбирается
    /// один раз, а свойства читают и пишут в тот источник, из которого строка
    /// создана.
    /// </para>
    /// </summary>
    private sealed class RowItem
    {
        private readonly EditorItem? _local;
        private readonly HKCardItem? _tracked;
        private readonly HKStructureEditorState? _state;
        private readonly Func<Guid, string?> _assemblyUnitName;

        private RowItem(
            EditorItem local, HKStructureEditorState? state, Func<Guid, string?> assemblyUnitName)
        {
            _local = local;
            _state = state;
            _assemblyUnitName = assemblyUnitName;
        }

        private RowItem(HKCardItem tracked, Func<Guid, string?> assemblyUnitName)
        {
            _tracked = tracked;
            _assemblyUnitName = assemblyUnitName;
        }

        public static RowItem ForLocal(
            EditorItem item, HKStructureEditorState? state, Func<Guid, string?> assemblyUnitName) =>
            new(item, state, assemblyUnitName);

        public static RowItem ForTracked(HKCardItem item, Func<Guid, string?> assemblyUnitName) =>
            new(item, assemblyUnitName);

        /// <summary>Строка принадлежит локальному состоянию редактора.</summary>
        public bool IsLocal => _local is not null;

        /// <summary>
        /// Отслеживаемая строка обычной карты. У собственной структуры её нет:
        /// механизмы, работающие с сохранённой строкой, к такой строке не
        /// применяются.
        /// </summary>
        public HKCardItem? Tracked => _tracked;

        /// <summary>
        /// Сборочная единица строки: имя для показа берётся у источника.
        /// <para>
        /// У локальной строки название обновляется при выборе и снятии
        /// сборочной единицы — строка не показывает прежнее название.
        /// </para>
        /// </summary>
        public string? AssemblyUnitName
        {
            get => _local?.AssemblyUnitName ?? _assemblyUnitName(AssemblyUnitId);
            set
            {
                if (_local is not null)
                    _local.AssemblyUnitName = value;
            }
        }

        public Guid Id => _local is not null ? _local.Id : _tracked!.Id;

        // Источник значения выбирается по НАЛИЧИЮ локальной записи, а не по
        // значению поля: у локальной строки поле может быть пустым
        // (например, не задан узел), и обращение к отслеживаемой строке
        // при этом обращало бы к null.
        public Guid? NodeId
        {
            get => _local is not null ? _local.NodeId : _tracked!.HKCardNodeId;
            set { if (_local is not null) _local.NodeId = value; else _tracked!.HKCardNodeId = value; }
        }

        public Guid AssemblyUnitId
        {
            get => _local is not null ? _local.AssemblyUnitId : _tracked!.AssemblyUnitId;
            set { if (_local is not null) _local.AssemblyUnitId = value; else _tracked!.AssemblyUnitId = value; }
        }

        public int Quantity
        {
            get => _local is not null ? _local.Quantity : _tracked!.Quantity;
            set { if (_local is not null) _local.Quantity = value; else _tracked!.Quantity = value; }
        }

        public decimal Volume
        {
            get => _local is not null ? _local.Volume : _tracked!.Volume;
            set { if (_local is not null) _local.Volume = value; else _tracked!.Volume = value; }
        }

        public string? UnitOfMeasure
        {
            get => _local is not null ? _local.UnitOfMeasure : _tracked!.UnitOfMeasure;
            set { if (_local is not null) _local.UnitOfMeasure = value; else _tracked!.UnitOfMeasure = value; }
        }

        public string? Periodicity
        {
            get => _local is not null ? _local.Periodicity : _tracked!.Periodicity;
            set { if (_local is not null) _local.Periodicity = value; else _tracked!.Periodicity = value; }
        }

        public string? Notes
        {
            get => _local is not null ? _local.Notes : _tracked!.Notes;
            set { if (_local is not null) _local.Notes = value; else _tracked!.Notes = value; }
        }

        public Guid? SectionId
        {
            get => _local is not null ? _local.SectionId : _tracked!.SectionId;
            set { if (_local is not null) _local.SectionId = value; else _tracked!.SectionId = value; }
        }

        /// <summary>
        /// Марки строки: стабильный Id строки назначения, марка и категория.
        /// Идентификатор строки назначения — ключ удаления, а не позиция в
        /// списке.
        /// </summary>
        public List<(Guid RowId, Guid GsmMaterialId, GsmCategory Category)> Materials =>
            _local is not null
                ? _local.Materials
                    .Select(m => (m.Id, m.GsmMaterialId, m.Category))
                    .ToList()
                : _tracked!.Materials
                    .Select(m => (m.Id, m.GsmMaterialId, m.Category))
                    .ToList();

        public void AddMaterial(Guid gsmMaterialId, GsmCategory category)
        {
            if (_local is not null)
            {
                _state?.AddMaterial(_local.Id, gsmMaterialId, category);
                return;
            }

            _tracked!.Materials.Add(new HKCardItemMaterial
            {
                Id = Guid.NewGuid(),
                HKCardItemId = _tracked.Id,
                GsmMaterialId = gsmMaterialId,
                Category = category
            });
        }

        /// <summary>Удаляет назначение по стабильному Id строки материала.</summary>
        public void RemoveMaterial(Guid materialRowId)
        {
            if (_local is not null)
            {
                _state?.RemoveMaterial(_local.Id, materialRowId);
                return;
            }

            var row = _tracked!.Materials.FirstOrDefault(m => m.Id == materialRowId);
            if (row is not null)
                _tracked.Materials.Remove(row);
        }
    }

    /// <summary>Входные данные доменного механизма: разделы, позиции, строки.</summary>
    private HKStructureInput BuildStructureInput() =>
        _structure?.BuildInput() ?? new HKStructureInput(
            new List<HKStructureSectionInput>(),
            new List<HKStructureNodeInput>(),
            new List<HKStructureItemInput>());

    /// <summary>
    /// Видимые строки редактора: иерархическое представление с учётом
    /// сворачивания. Номера остаются по полной структуре.
    /// </summary>
    private IReadOnlyList<EditorRow> EditorRows()
    {
        // Обычная карта: структура не собственная, строки хранятся у карты и
        // сохраняются реквизитным путём.
        if (!IsAutonomousMode)
        {
            var flat = card.Items.OrderBy(i => i.SortOrder).ToList();
            return flat.Select((item, i) => new EditorRow(
                new HKStructureRow(
                    (i + 1).ToString(), 0, HKStructureRowKind.TerminalRow,
                    null, item.Id, null, null, "", item.Quantity),
                null,
                RowItem.ForTracked(item, AssemblyUnitNameOf),
                i,
                false)).ToList();
        }

        if (_structure is null)
            return Array.Empty<EditorRow>();

        var rows = HKStructureNumbering.Build(BuildStructureInput());
        var nodesById = _structure.Nodes.ToDictionary(n => n.Id);
        var itemsById = _structure.Items.ToDictionary(i => i.Id);

        var result = new List<EditorRow>();
        var hiddenBelow = -1;

        for (var i = 0; i < rows.Count; i++)
        {
            var row = rows[i];
            if (hiddenBelow >= 0 && row.Depth > hiddenBelow)
                continue;
            hiddenBelow = -1;

            switch (row.Kind)
            {
                case HKStructureRowKind.Section:
                    result.Add(new EditorRow(row, null, null, i, false));
                    break;
                case HKStructureRowKind.Position:
                    var nodeId = row.NodeId!.Value;
                    var position = nodesById[nodeId];

                    // Самостоятельная ветка без раздела: перед ней видна группа
                    // «Без раздела». Это только группировка показа — она не
                    // создаёт записи в БД, своего номера и не влияет на
                    // расчёты.
                    if (position.ParentId is null && position.SectionId is null)
                        AddWithoutSectionHeader(result);

                    result.Add(new EditorRow(row, position, null, i, CountChildRows(nodeId) > 0));
                    if (IsCollapsed(nodeId))
                        hiddenBelow = row.Depth;
                    break;
                default:
                    var item = itemsById[row.ItemId!.Value];

                    // Корневая строка без раздела — тоже часть группы
                    // «Без раздела».
                    if (item.NodeId is null && item.SectionId is null)
                        AddWithoutSectionHeader(result);

                    result.Add(new EditorRow(
                        row, null, RowItem.ForLocal(item, _structure, AssemblyUnitNameOf),
                        i, false));
                    break;
            }
        }

        return result;
    }

    /// <summary>
    /// Добавляет заголовок группы «Без раздела», если предыдущая строка не
    /// была частью этой группы: несмежные блоки получают свой заголовок.
    /// <para>
    /// Группа — только показ: в содержимом карты такой раздел не появляется.
    /// </para>
    /// </summary>
    private static void AddWithoutSectionHeader(List<EditorRow> result)
    {
        if (result.Count > 0
            && result[^1].Row.Kind == HKStructureRowKind.Section
            && result[^1].Row.SectionId is null)
        {
            return;
        }

        // Номер группы — по порядковому номеру заголовка в выборке: он
        // устойчив между отрисовками и различает несмежные блоки.
        var groupNumber = result.Count(
            x => x.Row.Kind == HKStructureRowKind.Section && x.Row.SectionId is null) + 1;

        result.Add(new EditorRow(
            new HKStructureRow(
                string.Empty, 0, HKStructureRowKind.Section,
                null, null, null, null, "Без раздела", 0),
            null, null, -groupNumber, false));
    }

    /// <summary>Агрегат для панели итогов.</summary>
    private sealed record StructureSummaryData(
        IReadOnlyList<EditorSection> Sections, HKCardTotals Totals);

    private StructureSummaryData BuildSummary()
    {
        var totals = _structure?.Totals()
            ?? HKStructureTotals.Calculate(BuildStructureInput());
        return new StructureSummaryData(EditorSections, totals);
    }

    private static string FormatTotals(IEnumerable<HKMeasuredTotal> totals) =>
        string.Join("; ", totals.Select(HKTotalFormatter.Format));

    private string SectionNameById(Guid sectionId, IReadOnlyList<EditorSection> sections)
    {
        var section = sections.FirstOrDefault(s => s.Id == sectionId);
        return section is null ? "Раздел" : HKSectionNames.NameOf(section.SectionType);
    }

    /// <summary>Наименование сборочной единицы для показа в строке таблицы.</summary>
    private string? AssemblyUnitNameOf(Guid id) =>
        assemblyUnits.FirstOrDefault(a => a.Id == id)?.Name;

    private string SectionNameOf(Guid? sectionId)
    {
        var section = _structure?.SectionById(sectionId);
        return section is null ? "" : HKSectionNames.NameOf(section.SectionType);
    }

