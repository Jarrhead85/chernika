    private void ReturnForRevision()
    {
        returnComment = string.Empty;
        returnCommentError = null;
        showReturnModal = true;
    }

    private async Task ConfirmReturn()
    {
        if (string.IsNullOrWhiteSpace(returnComment))
        {
            returnCommentError = "Укажите причину возврата";
            return;
        }

        showReturnModal = false;

        var (returned, _) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.RevisionRequired, returnComment.Trim());
        if (returned)
        {
            card.Status = HKCardStatus.RevisionRequired;
            var existing = await HKCardService.GetByIdAsync(card.Id);
            if (existing != null)
            {
                card = existing;
                statusStr = card.Status.ToString();
            }
        }
    }

    private async Task ArchiveCard()
    {
        var (archived, _) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.Archived, "Переведена в архив");
        if (archived) card.Status = HKCardStatus.Archived;
    }

    private async Task SaveCard()
    {
        if (!canEdit) return;

        errorMessage = null;

        card.ObjectLevel = selectedLevel;
        card.ComplexId = selectedLevel == HKObjectLevel.Complex ? selectedComplexId : null;
        card.EquipmentModelId = selectedLevel == HKObjectLevel.EquipmentModel ? selectedModelId : null;
        card.AggregateId = selectedLevel == HKObjectLevel.Aggregate ? selectedAggregateId : null;
        card.NodeId = selectedLevel == HKObjectLevel.Node ? selectedNodeId : null;
        card.Status = IsNew ? HKCardStatus.Draft : card.Status;

        if (string.IsNullOrWhiteSpace(card.Code))
        {
            errorMessage = "Поле «Номер ХК» обязательно для заполнения.";
            return;
        }

        var hasObject = selectedLevel switch
        {
            HKObjectLevel.Complex => selectedComplexId != Guid.Empty,
            HKObjectLevel.EquipmentModel => selectedModelId != Guid.Empty,
            HKObjectLevel.Aggregate => selectedAggregateId != Guid.Empty,
            HKObjectLevel.Node => selectedNodeId != Guid.Empty,
            _ => false
        };
        if (!hasObject)
        {
            errorMessage = "Необходимо выбрать объект нормирования.";
            return;
        }
        if (string.IsNullOrWhiteSpace(card.Version))
        {
            errorMessage = "Поле «Версия» обязательно для заполнения.";
            return;
        }

        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user?.BranchId != null)
                card.BranchId = user.BranchId.Value;
        }

        if (card.BranchId == Guid.Empty)
        {
            var branches = await EquipmentService.GetBranchesAsync();
            var branch = branches.FirstOrDefault();
            card.BranchId = branch?.Id ?? Guid.Empty;
        }

        if (selectedLevel == HKObjectLevel.Node)
        {
            foreach (var item in card.Items)
            {
                if (string.IsNullOrEmpty(item.UnitOfMeasure)) item.UnitOfMeasure = "кг";
            }

            var emptyAu = card.Items.FirstOrDefault(i => i.AssemblyUnitId == Guid.Empty);
            if (emptyAu != null)
            {
                errorMessage = "Укажите сборочную единицу во всех строках таблицы.";
                return;
            }

            var order = 1;
            foreach (var item in card.Items)
                item.SortOrder = order++;
        }

        if (card.EffectiveDate.HasValue && card.ExpirationDate.HasValue
            && card.ExpirationDate.Value < card.EffectiveDate.Value)
        {
            errorMessage = "Дата окончания действия не может быть раньше даты начала действия.";
            return;
        }

        try
        {
            if (IsNew)
                await HKCardService.CreateAsync(card);
            else
                await HKCardService.UpdateAsync(card);
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
            return;
        }
        catch (DbUpdateException)
        {
            errorMessage = "Не удалось сохранить ХК. Проверьте заполнение " +
                "всех обязательных полей и повторите попытку.";
            return;
        }

        Nav.NavigateTo("/реестр-хк");
    }

