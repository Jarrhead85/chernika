    private async Task ToggleAddChild()
    {
        _addChildOpen = !_addChildOpen;
        if (_addChildOpen)
        {
            _addChildSearch = "";
            _availableChildCards = new();
            _pendingChildId = null;
            var paged = await HKCardService.GetFilteredAsync();
            var allCards = paged.Items;
            var existingChildIds = _components.Select(c => c.ChildHKCardId).ToHashSet();
            existingChildIds.Add(card.Id);
            _availableChildCards = allCards
                .Where(c => c.Status == HKCardStatus.Approved && !existingChildIds.Contains(c.Id))
                .OrderBy(c => c.Code)
                .ToList();
        }
    }

    private async Task SelectAvailableChild(HKCardListItemDto child)
    {
        _addChildSearch = $"{child.Code} — {child.ObjectName}";
        _pendingChildId = child.Id;
        await CloseActiveDropdownAsync();
    }

    private async Task ConfirmAddChild()
    {
        if (_pendingChildId == null || _pendingChildId.Value == Guid.Empty) return;
        try
        {
            await HKCardService.AddComponentAsync(card.Id, _pendingChildId.Value);
            _components = await HKCardService.GetComponentsAsync(card.Id);
            _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(card.Id);
            _addChildOpen = false;
            _addChildSearch = "";
            _pendingChildId = null;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task RemoveComponent(Guid componentId)
    {
        try
        {
            await HKCardService.RemoveComponentAsync(componentId);
            _components = await HKCardService.GetComponentsAsync(card.Id);
            _aggregatedRows = await HKCardService.GetAggregatedRowsAsync(card.Id);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private IEnumerable<GsmMaterial> FilteredGsmMaterials(GsmCategory cat, HKCardItem item)
    {
        var search = _matSearch.GetValueOrDefault((item.Id, cat), "")?.Trim().ToLower() ?? "";
        var existingIds = item.Materials.Where(m => m.Category == cat).Select(m => m.GsmMaterialId).ToHashSet();
        var available = gsmMaterials.Where(m => !existingIds.Contains(m.Id));
        if (string.IsNullOrEmpty(search)) return available;
        return available.Where(m => (m.Name?.ToLower().Contains(search) ?? false) || (m.Type?.ToLower().Contains(search) ?? false));
    }

