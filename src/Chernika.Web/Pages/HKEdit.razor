    /// <summary>Изменены реквизиты: изменения ещё не записаны в базу.</summary>
    private bool _requisitesDirty;

    // Снимок реквизитов при загрузке: по нему определяется, остались ли
    // несохранённые правки. Событие изменения поля не годится: оно
    // приходит только от полей формы, а правится карта и через другие
    // пути (например, выбором срока действия).
    private string _loadedOrganization = string.Empty;
    private string _loadedSender = string.Empty;
    private string _loadedIncoming = string.Empty;
    private string _loadedOutgoing = string.Empty;
    private string _loadedDetails = string.Empty;
    private string _loadedName = string.Empty;
    private string _loadedPurpose = string.Empty;
    private string _loadedNotes = string.Empty;
    private DateTime? _loadedReceived;
    private DateTime? _loadedEffective;
    private DateTime? _loadedExpiration;

    /// <summary>Запоминает текущие реквизиты как сохранённые.</summary>
    private void CaptureLoadedRequisites()
    {
        _loadedOrganization = card.RequestOrganization ?? string.Empty;
        _loadedSender = card.RequestSenderFullName ?? string.Empty;
        _loadedIncoming = card.IncomingLetterNumber ?? string.Empty;
        _loadedOutgoing = card.OutgoingLetterNumber ?? string.Empty;
        _loadedDetails = card.RequestDetails ?? string.Empty;
        _loadedName = card.Name ?? string.Empty;
        _loadedPurpose = card.Purpose ?? string.Empty;
        _loadedNotes = card.Notes ?? string.Empty;
        _loadedReceived = card.RequestReceivedDate;
        _loadedEffective = card.EffectiveDate;
        _loadedExpiration = card.ExpirationDate;
        _requisitesDirty = false;
    }

    /// <summary>Реквизиты отличаются от загруженных — правки не сохранены.</summary>
    private bool HasUnsavedRequisites() =>
        !string.Equals(card.RequestOrganization ?? string.Empty, _loadedOrganization, StringComparison.Ordinal)
        || !string.Equals(card.RequestSenderFullName ?? string.Empty, _loadedSender, StringComparison.Ordinal)
        || !string.Equals(card.IncomingLetterNumber ?? string.Empty, _loadedIncoming, StringComparison.Ordinal)
        || !string.Equals(card.OutgoingLetterNumber ?? string.Empty, _loadedOutgoing, StringComparison.Ordinal)
        || !string.Equals(card.RequestDetails ?? string.Empty, _loadedDetails, StringComparison.Ordinal)
        || !string.Equals(card.Name ?? string.Empty, _loadedName, StringComparison.Ordinal)
        || !string.Equals(card.Purpose ?? string.Empty, _loadedPurpose, StringComparison.Ordinal)
        || !string.Equals(card.Notes ?? string.Empty, _loadedNotes, StringComparison.Ordinal)
        || card.RequestReceivedDate != _loadedReceived
        || card.EffectiveDate != _loadedEffective
        || card.ExpirationDate != _loadedExpiration;

    /// <summary>Диалог ухода при несохранённых реквизитах.</summary>
    private bool showLeaveModal;


    private async Task SendToApprove()
    {
        errorMessage = null;
        if (IsNew)
        {
            errorMessage = "Сначала сохраните черновик ХК.";
            return;
        }
        bool sent;
        string? error;
        await using (await DbLock.WaitAsync())
        {
            (sent, error) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.OnReview, "Отправлена на проверку");
        }
        if (sent)
        {
            card.Status = HKCardStatus.OnReview;
        }
        else if (!string.IsNullOrEmpty(error))
        {
            errorMessage = error;
        }
    }

    private async Task ApproveCard()
    {
        bool approved;
        await using (await DbLock.WaitAsync())
        {
            (approved, _) = await HKCardService.ChangeStatusAsync(card.Id, HKCardStatus.Approved, "Утверждена");
        }
        if (approved) card.Status = HKCardStatus.Approved;
    }

