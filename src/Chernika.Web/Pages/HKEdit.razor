    private async Task SelectNode(Node node)
    {
        selectedNodeId = node.Id;
        card.NodeId = node.Id;
        _modelSearch = $"{node.Code} — {node.Name}";
        await CloseActiveDropdownAsync();
        if (IsNew)
        {
            card.Code = await HKCardService.GenerateCodeAsync(node.Id);
            _existingActiveCard = await HKCardService.GetActiveCardForNodeAsync(node.Id);
            _activeCardWarning = _existingActiveCard != null
                ? $"Для изделия «{node.Code}» уже есть активная ХК «{_existingActiveCard.Code}» в статусе «{TranslateStatus(_existingActiveCard.Status)}»."
                : null;
        }
        StateHasChanged();
    }

    private void ClearNode()
    {
        selectedNodeId = Guid.Empty;
        card.NodeId = Guid.Empty;
        _modelSearch = "";
        _activeCardWarning = null;
        _existingActiveCard = null;
        _ = CloseActiveDropdownAsync();
        StateHasChanged();
    }

    private IEnumerable<Node> FilteredModels()
    {
        var search = _modelSearch?.Trim().ToLower() ?? "";
        if (string.IsNullOrEmpty(search)) return nodes;
        return nodes.Where(n => (n.Code?.ToLower().Contains(search) ?? false) || (n.Name?.ToLower().Contains(search) ?? false));
    }

    private IEnumerable<GsmMaterial> FilteredGsmMaterials(GsmCategory cat, HKCardItem item)
    {
        var search = _matSearch.GetValueOrDefault((item.Id, cat), "")?.Trim().ToLower() ?? "";
        var existingIds = item.Materials.Where(m => m.Category == cat).Select(m => m.GsmMaterialId).ToHashSet();
        var available = gsmMaterials.Where(m => !existingIds.Contains(m.Id));
        if (string.IsNullOrEmpty(search)) return available;
        return available.Where(m => (m.Name?.ToLower().Contains(search) ?? false) || (m.Type?.ToLower().Contains(search) ?? false));
    }

    private void RemoveItem(HKCardItem item) => card.Items.Remove(item);

    private static string TranslateStatus(HKCardStatus status) => status switch
    {
        HKCardStatus.Draft => "Черновик",
        HKCardStatus.OnReview => "На проверке",
        HKCardStatus.RevisionRequired => "На доработке",
        HKCardStatus.Approved => "Утверждена",
        HKCardStatus.Archived => "Архивная",
        HKCardStatus.Deleted => "Удалена",
        _ => status.ToString()
    };

    private async Task GoToExistingCard()
    {
        await CloseActiveDropdownAsync();
        if (!_disposed)
        {
            try { await JS.InvokeVoidAsync("dropdownPortal.cleanup"); } catch { }
        }
        Nav.NavigateTo($"/хк/{_existingActiveCard!.Id}", forceLoad: true);
    }
