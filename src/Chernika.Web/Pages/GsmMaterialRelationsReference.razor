@page "/справочник-гсм-связи"
@attribute [Authorize(Policy = "ViewReferences")]
@using Chernika.Domain
@using Chernika.Web.Services
@inject AuthenticationStateProvider AuthState
@inject IPermissionService Perms
@inject CircuitDbLock DbLock

@* Тонкая оболочка страницы: маршрут, хлебные крошки и авторизация. Сам реестр
   связей и форма живут в GsmRelationsRegistry, чтобы возможное будущее
   объединение двух справочников ГСМ на одной странице не потребовало переноса
   логики. *@

<ReferenceBreadcrumb Group="Материалы" Current="Связи марок" />

<GsmRelationsRegistry CanEdit="@canEdit" />

@code {
    private bool canEdit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        // Право только прячет команды записи; сервер проверяет его самостоятельно.
        canEdit = userId != null
            && await DbLock.LockedAsync(
                () => Perms.HasPermissionAsync(userId!, PermissionCodes.ReferenceEdit));
    }
}
