@page "/инд-карты/создать"
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using Chernika.Web.Services
@using Chernika.Web.Shared
@inject IndividualCardService IndCardService
@inject EquipmentService EquipService
@inject IPermissionService Perms
@inject AuthenticationStateProvider AuthState
@inject CircuitDbLock DbLock
@inject NavigationManager Nav

<div class="stack wiz-wrap">
    <section class="panel">
        <div class="panelHeader">
            <h2>Создание черновика ИК</h2>
            <div class="hint">Шаг @Step из 3 — @StepTitle</div>
        </div>
        <div class="panelBody">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="hkc-error">@_error</div>
            }

            @if (!_canCreateDraft)
            {
                <div class="note">Недостаточно прав: требуется разрешение на создание черновиков ИК.</div>
            }
            else if (Step == 1)
            {
                <div class="wiz-field">
                    <span class="wiz-fieldLabel">Цель ИК</span>
                    <div class="wiz-levels" role="radiogroup" aria-label="Цель ИК">
                        @foreach (var (level, label) in LevelOptions)
                        {
                            <label class="wiz-levelCard @(_level == level ? "selected" : "")">
                                <input type="radio" name="ik-level" checked="@(_level == level)"
                                       @onchange="() => SelectLevel(level)" />
                                <span>@label</span>
                            </label>
                        }
                    </div>
                </div>

                @if (_level is not null)
                {
                    <div class="field">
                        <label>Объект</label>
                        <div class="wiz-objectRow">
                            <SearchablePopoverSelect TItem="ObjectOption"
                                                     Items="_objects"
                                                     Selected="_selectedObject"
                                                     DisplayTextSelector="@(o => o.DisplayName)"
                                                     SearchPredicate="ObjectMatchesSearch"
                                                     Placeholder="Поиск по коду или наименованию…"
                                                     EmptyText="Ничего не найдено"
                                                     OnSearchInput="OnObjectSearchInputAsync"
                                                     OnSelected="SelectObject">
                                <ItemTemplate Context="obj">@obj.DisplayName</ItemTemplate>
                            </SearchablePopoverSelect>
                            @if (_selectedObject is not null)
                            {
                                <button type="button" class="wiz-clearBtn" aria-label="Очистить выбор объекта"
                                        title="Очистить" @onclick="ClearObject">×</button>
                            }
                        </div>
                    </div>
                }

                <div class="formActions">
                    <button type="button" class="btn primary" disabled="@(_level is null || _objectId == Guid.Empty)"
                            @onclick="GoToPreflight">Далее</button>
                </div>
            }
            else if (Step == 2)
            {
                @if (_preflight is null)
                {
                    <div class="loading-state">Нормативный анализ…</div>
                }
                else
                {
                    <div class="hkv-row"><span class="hkv-label">Цель:</span> @LevelName(_level) — @(_objectCode) @(_objectName)</div>

                    @if (_preflight.RootState == IndividualCardPreflightRootState.SelectionRequired)
                    {
                        <div class="wiz-field">
                            <span class="wiz-fieldLabel">Выберите ХК верхнего уровня</span>
                            @foreach (var candidate in _preflight.RootCandidates)
                            {
                                <label class="wiz-levelCard @(_rootHKCardId == candidate.HKCardId ? "selected" : "")">
                                    <input type="radio" name="ik-root" checked="@(_rootHKCardId == candidate.HKCardId)"
                                           @onchange="() => SelectRoot(candidate)" />
                                    <span>@candidate.Code @candidate.Version — @candidate.ObjectName</span>
                                </label>
                            }
                        </div>
                    }
                    else if (_preflight.SelectedRoot is not null)
                    {
                        <div class="hkv-row"><span class="hkv-label">ХК верхнего уровня:</span>
                            @_preflight.SelectedRoot.Code @_preflight.SelectedRoot.Version — @_preflight.SelectedRoot.ObjectName
                            <span class="hkv-muted">ХК выбрана автоматически</span>
                        </div>
                    }

                    <h4 class="hkc-subtitle">Нормативные источники</h4>
                    <div class="hkv-muted">
                        <div>Строк состава: @_preflight.Compositions.Count</div>
                        <div>Источников ХК: @_preflight.HKSources.Count</div>
                    </div>

                    <h4 class="hkc-subtitle">Нормативные пробелы</h4>
                    @if (_preflight.NormativeGaps.Count == 0)
                    {
                        <div class="note">Нормативные пробелы не обнаружены.</div>
                    }
                    else
                    {
                        @foreach (var gap in _preflight.NormativeGaps)
                        {
                            <div class="note">⚠ @gap.Message</div>
                        }
                        <div class="hkv-row"><span class="hkv-label">@GapLabel</span></div>
                    }

                    <div class="formActions">
                        <button type="button" class="btn ghost" @onclick="() => Step = 1">Назад</button>
                        <button type="button" class="btn primary"
                                disabled="@(_preflight.SelectedRoot is null && _rootHKCardId == Guid.Empty)"
                                @onclick="() => Step = 3">Далее</button>
                    </div>
                }
            }
            else
            {
                <div class="hkv-row"><span class="hkv-label">Цель:</span> @LevelName(_level) — @(_objectCode) @(_objectName)</div>
                <div class="hkv-row"><span class="hkv-label">ХК верхнего уровня:</span>
                    @(_preflight?.SelectedRoot?.Code) @(_preflight?.SelectedRoot?.Version)
                </div>
                <div class="hkv-row"><span class="hkv-label">@GapLabel</span></div>

                <div class="formActions">
                    <button type="button" class="btn ghost" @onclick="() => Step = 2">Назад</button>
                    <button type="button" class="btn primary" disabled="@_creating" @onclick="Create">
                        @(_creating ? "Создание…" : "Создать черновик ИК")
                    </button>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private int Step = 1;
    private string StepTitle => Step switch { 1 => "Цель", 2 => "Нормативные источники", _ => "Подтверждение" };

    private string? _error;
    private bool _canCreateDraft;

    private IndividualCardObjectLevel? _level;
    private Guid _objectId;
    private string _objectCode = string.Empty;
    private string _objectName = string.Empty;

    private List<ObjectOption> _objects = new();
    private ObjectOption? _selectedObject;
    private CancellationTokenSource? _searchCts;

    private IndividualCardPreflightResult? _preflight;
    private Guid _rootHKCardId;
    private bool _creating;

    private sealed record ObjectOption(Guid Id, string Code, string Name)
    {
        public string DisplayName => Code == Name ? Code : $"{Code} — {Name}";
    }

    private static readonly List<(IndividualCardObjectLevel Level, string Label)> LevelOptions = new()
    {
        (IndividualCardObjectLevel.Complex, "Комплекс"),
        (IndividualCardObjectLevel.EquipmentModel, "Изделие"),
        (IndividualCardObjectLevel.Aggregate, "Агрегат"),
        (IndividualCardObjectLevel.Node, "Узел"),
        (IndividualCardObjectLevel.EquipmentInstance, "Экземпляр техники"),
    };

    private static string LevelName(IndividualCardObjectLevel? level) => LevelOptions
        .FirstOrDefault(o => o.Level == level).Label ?? string.Empty;

    private string GapLabel => _preflight is { NormativeGaps.Count: > 0 }
        ? $"Найдены нормативные пробелы: {_preflight.NormativeGaps.Count}"
        : "Нормативная готовность";

    private static bool ObjectMatchesSearch(ObjectOption obj, string search) =>
        obj.Code.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        obj.Name.Contains(search, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _canCreateDraft = await Perms.HasPermissionAsync(userId, PermissionCodes.IndividualCardCreateDraft);
    }

    private async Task SelectLevel(IndividualCardObjectLevel level)
    {
        _level = level;
        _objectId = Guid.Empty;
        _objectCode = _objectName = string.Empty;
        _selectedObject = null;
        _preflight = null;
        await ReloadObjectsAsync(null);
    }

    private async Task OnObjectSearchInputAsync(string? search)
    {
        _searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _searchCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await ReloadObjectsAsync(string.IsNullOrWhiteSpace(search) ? null : search.Trim());
    }

    private async Task ReloadObjectsAsync(string? search)
    {
        switch (_level)
        {
            case IndividualCardObjectLevel.Complex:
            {
                var page = await EquipService.GetComplexesPagedAsync(new ComplexQuery { Page = 1, PageSize = 30, Search = search });
                _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Code, o.Name)).ToList();
                break;
            }
            case IndividualCardObjectLevel.EquipmentModel:
            {
                var page = await EquipService.GetModelsPagedAsync(new EquipmentModelQuery { Page = 1, PageSize = 30, Search = search });
                _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Index, o.Name)).ToList();
                break;
            }
            case IndividualCardObjectLevel.Aggregate:
            {
                var page = await EquipService.GetAggregatesPagedAsync(new AggregateQuery { Page = 1, PageSize = 30, Search = search });
                _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Code, o.Name)).ToList();
                break;
            }
            case IndividualCardObjectLevel.Node:
            {
                var page = await EquipService.GetNodesPagedAsync(new NodeQuery { Page = 1, PageSize = 30, Search = search });
                _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Code, o.Name)).ToList();
                break;
            }
            case IndividualCardObjectLevel.EquipmentInstance:
            {
                var page = await EquipService.GetInstancesPagedAsync(new EquipmentInstanceQuery { Page = 1, PageSize = 30, Search = search });
                _objects = page.Items.Select(o => new ObjectOption(o.Id, o.SerialNumber, o.Name)).ToList();
                break;
            }
            default:
                _objects = new List<ObjectOption>();
                break;
        }
    }

    private void SelectObject(ObjectOption obj)
    {
        _objectId = obj.Id;
        _objectCode = obj.Code;
        _objectName = obj.Name;
        _selectedObject = obj;
    }

    private void ClearObject()
    {
        _objectId = Guid.Empty;
        _objectCode = _objectName = string.Empty;
        _selectedObject = null;
    }

    private async Task GoToPreflight()
    {
        _error = null;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _preflight = await IndCardService.BuildPreflightAsync(
                    new IndividualCardPreflightRequest(_level!.Value, _objectId));
            }
            _rootHKCardId = Guid.Empty;
            Step = 2;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
    }

    private async Task SelectRoot(IndividualCardHKCandidateDto candidate)
    {
        _rootHKCardId = candidate.HKCardId;
        _error = null;
        try
        {
            await using (await DbLock.WaitAsync())
            {
                _preflight = await IndCardService.BuildPreflightAsync(
                    new IndividualCardPreflightRequest(_level!.Value, _objectId, _rootHKCardId));
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
    }

    private async Task Create()
    {
        _error = null;
        _creating = true;
        try
        {
            Guid newId;
            var rootHKCardId = _rootHKCardId == Guid.Empty
                ? (Guid?)null
                : _rootHKCardId;
            await using (await DbLock.WaitAsync())
            {
                var created = await IndCardService.CreateDraftAsync(new CreateIndividualCardDraftRequest(
                    _level!.Value, _objectId, rootHKCardId));
                newId = created.Id;
            }
            Nav.NavigateTo($"/инд-карты/{newId}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _creating = false;
        }
    }
}
