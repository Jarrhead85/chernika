@page "/инд-карты/создать"
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using Chernika.Web.Services
@inject IndividualCardService IndCardService
@inject EquipmentService EquipService
@inject IPermissionService Perms
@inject AuthenticationStateProvider AuthState
@inject CircuitDbLock DbLock
@inject NavigationManager Nav

<div class="stack">
    <section class="panel">
        <div class="panelHeader">
            <h2>Создать ИК</h2>
        </div>
        <div class="panelBody">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="hkc-error">@_error</div>
            }

            @if (!_canCreateDraft)
            {
                <div class="note">Недостаточно прав: требуется разрешение на создание черновиков ИК.</div>
            }
            else
            {
                <div class="btnRow ikTargetSegmented" role="group" aria-label="Цель ИК">
                    @foreach (var (level, label) in LevelOptions)
                    {
                        <button type="button" aria-pressed="@(_level == level)"
                                class="btn @(_level == level ? "primary" : "ghost")"
                                @onclick="() => SelectLevel(level)">@label</button>
                    }
                </div>

                @if (_level is not null)
                {
                    <div class="field ikObjectSearch">
                        <label>Объект</label>
                        <input placeholder="Поиск по коду или наименованию…"
                               value="@_objectSearch" @oninput="OnObjectSearchChanged" />
                    </div>

                    @if (_loadingObjects)
                    {
                        <div class="loading-state">Загрузка…</div>
                    }
                    else if (_objects.Count == 0)
                    {
                        <div class="empty-state">Ничего не найдено.</div>
                    }
                    else
                    {
                        <div class="tableWrap" data-scroll="contained">
                            <table>
                                <thead>
                                    <tr>
                                        <th>@CodeColumnHeader</th>
                                        <th>Наименование</th>
                                        @if (_level == IndividualCardObjectLevel.EquipmentInstance)
                                        {
                                            <th>Изделие</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var obj in _objects)
                                    {
                                        var isSelected = _objectId == obj.Id;
                                        <tr tabindex="0" role="button" aria-pressed="@isSelected"
                                            class="ikObjectRow @(isSelected ? "selected" : null)"
                                            @onclick="() => SelectObjectAsync(obj)"
                                            @onkeydown="e => OnObjectRowKeyDown(e, obj)">
                                            <td class="mono">@obj.Code</td>
                                            <td>@obj.Name</td>
                                            @if (_level == IndividualCardObjectLevel.EquipmentInstance)
                                            {
                                                <td>@obj.ModelDisplay</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (_totalObjects > ObjectPageSize)
                        {
                            <div class="pager">
                                <button class="btn ghost" disabled="@(_objectPage <= 1)" @onclick="PrevObjectPage">← Назад</button>
                                <span class="hint">Страница @_objectPage из @((int)Math.Ceiling(_totalObjects / (double)ObjectPageSize))</span>
                                <button class="btn ghost" disabled="@(_objectPage * ObjectPageSize >= _totalObjects)" @onclick="NextObjectPage">Вперёд →</button>
                            </div>
                        }
                    }

                    @if (_objectId != Guid.Empty)
                    {
                        <div class="ikReadyBlock">
                            <div class="ikReadyTitle">Выбранный объект</div>
                            <div class="ikReadyValue">@LevelName(_level) — @(_objectCode) @(_objectName)</div>

                            <div class="ikReadyHeader">
                                <div class="ikReadyTitle">Нормативная готовность</div>
                                @if (!_preflightLoading && _preflight is not null)
                                {
                                    <span class="tag @(_preflight.NormativeGaps.Count > 0 ? "ikTagBad" : "ikTagOk")">
                                        @(_preflight.NormativeGaps.Count > 0 ? "Есть проблемы" : "Готова")
                                    </span>
                                }
                            </div>

                            @if (_preflightLoading)
                            {
                                <div class="loading-state">Нормативный анализ…</div>
                            }
                            else if (_preflight is not null)
                            {
                                @if (_preflight.RootState == IndividualCardPreflightRootState.SelectionRequired)
                                {
                                    <div class="wiz-field">
                                        <span class="wiz-fieldLabel">Выберите ХК верхнего уровня</span>
                                        @foreach (var candidate in _preflight.RootCandidates)
                                        {
                                            <label class="wiz-levelCard @(_rootHKCardId == candidate.HKCardId ? "selected" : "")">
                                                <input type="radio" name="ik-root" checked="@(_rootHKCardId == candidate.HKCardId)"
                                                       @onchange="() => SelectRootAsync(candidate)" />
                                                <span>@candidate.Code v@(candidate.Version) — @candidate.ObjectName</span>
                                            </label>
                                        }
                                    </div>
                                }
                                else if (_preflight.SelectedRoot is not null)
                                {
                                    <div class="hkv-row"><span class="hkv-label">ХК верхнего уровня:</span>
                                        @_preflight.SelectedRoot.Code v@(_preflight.SelectedRoot.Version) — @_preflight.SelectedRoot.ObjectName
                                        <span class="hkv-muted">ХК выбрана автоматически</span>
                                    </div>
                                }

                                <div class="hkv-row"><span class="hkv-label">Версия состава:</span> @CompositionVersionDisplay</div>
                                <div class="hkv-row"><span class="hkv-label">Источники ХК:</span> @_preflight.HKSources.Count</div>

                                @if (_preflight.NormativeGaps.Count > 0)
                                {
                                    <div class="hkv-row"><span class="hkv-label">Найдены проблемы: @_preflight.NormativeGaps.Count</span></div>
                                    <div class="ikGapList">
                                        @foreach (var gap in _preflight.NormativeGaps)
                                        {
                                            <div class="ikGapItem">@gap.Message</div>
                                        }
                                    </div>
                                }
                            }

                            <div class="formActions">
                                <button type="button" class="btn primary"
                                        disabled="@(_preflightLoading || _preflight is null || (_preflight.SelectedRoot is null && _rootHKCardId == Guid.Empty))"
                                        @onclick="Create">
                                    @(_creating ? "Создание…" : "Создать ИК")
                                </button>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </section>
</div>

@code {
    private string? _error;
    private bool _canCreateDraft;

    private IndividualCardObjectLevel? _level;
    private Guid _objectId;
    private string _objectCode = string.Empty;
    private string _objectName = string.Empty;

    private const int ObjectPageSize = 50;
    private string _objectSearch = string.Empty;
    private int _objectPage = 1;
    private int _totalObjects;
    private bool _loadingObjects;
    private List<ObjectOption> _objects = new();
    private CancellationTokenSource? _searchCts;

    private IndividualCardPreflightResult? _preflight;
    private bool _preflightLoading;
    private Guid _rootHKCardId;
    private bool _creating;

    private sealed record ObjectOption(Guid Id, string Code, string Name, string ModelDisplay);

    private static readonly List<(IndividualCardObjectLevel Level, string Label)> LevelOptions = new()
    {
        (IndividualCardObjectLevel.Complex, "Комплекс"),
        (IndividualCardObjectLevel.EquipmentModel, "Изделие"),
        (IndividualCardObjectLevel.Aggregate, "Агрегат"),
        (IndividualCardObjectLevel.Node, "Узел"),
        (IndividualCardObjectLevel.EquipmentInstance, "Экземпляр техники"),
    };

    private static string LevelName(IndividualCardObjectLevel? level) => LevelOptions
        .FirstOrDefault(o => o.Level == level).Label ?? string.Empty;

    private string CodeColumnHeader => _level switch
    {
        IndividualCardObjectLevel.EquipmentModel => "Индекс",
        IndividualCardObjectLevel.EquipmentInstance => "Серийный номер",
        _ => "Код",
    };

    private string CompositionVersionDisplay
    {
        get
        {
            if (_preflight is null || _preflight.Compositions.Count == 0)
                return "—";
            var versions = _preflight.Compositions
                .Select(c => c.CompositionVersion)
                .Where(v => !string.IsNullOrWhiteSpace(v))
                .Distinct()
                .Select(v => $"v{v}")
                .ToList();
            return versions.Count == 0 ? "—" : string.Join(", ", versions);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        _canCreateDraft = await Perms.HasPermissionAsync(userId, PermissionCodes.IndividualCardCreateDraft);
    }

    private async Task SelectLevel(IndividualCardObjectLevel level)
    {
        _level = level;
        _objectId = Guid.Empty;
        _objectCode = _objectName = string.Empty;
        _objectSearch = string.Empty;
        _objectPage = 1;
        _totalObjects = 0;
        _objects = new List<ObjectOption>();
        _preflight = null;
        _rootHKCardId = Guid.Empty;
        await ReloadObjectsAsync(null);
    }

    private async Task OnObjectSearchChanged(ChangeEventArgs args)
    {
        _objectSearch = args.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _searchCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _objectPage = 1;
        await ReloadObjectsAsync(string.IsNullOrWhiteSpace(_objectSearch) ? null : _objectSearch.Trim());
    }

    private async Task PrevObjectPage()
    {
        if (_objectPage > 1)
        {
            _objectPage--;
            await ReloadObjectsAsync(string.IsNullOrWhiteSpace(_objectSearch) ? null : _objectSearch.Trim());
        }
    }

    private async Task NextObjectPage()
    {
        if (_objectPage * ObjectPageSize < _totalObjects)
        {
            _objectPage++;
            await ReloadObjectsAsync(string.IsNullOrWhiteSpace(_objectSearch) ? null : _objectSearch.Trim());
        }
    }

    private async Task ReloadObjectsAsync(string? search)
    {
        _loadingObjects = true;
        try
        {
            switch (_level)
            {
                case IndividualCardObjectLevel.Complex:
                {
                    var page = await EquipService.GetComplexesPagedAsync(new ComplexQuery { Page = _objectPage, PageSize = ObjectPageSize, Search = search });
                    _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Code, o.Name, string.Empty)).ToList();
                    _totalObjects = page.TotalCount;
                    break;
                }
                case IndividualCardObjectLevel.EquipmentModel:
                {
                    var page = await EquipService.GetModelsPagedAsync(new EquipmentModelQuery { Page = _objectPage, PageSize = ObjectPageSize, Search = search });
                    _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Index, o.Name, string.Empty)).ToList();
                    _totalObjects = page.TotalCount;
                    break;
                }
                case IndividualCardObjectLevel.Aggregate:
                {
                    var page = await EquipService.GetAggregatesPagedAsync(new AggregateQuery { Page = _objectPage, PageSize = ObjectPageSize, Search = search });
                    _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Code, o.Name, string.Empty)).ToList();
                    _totalObjects = page.TotalCount;
                    break;
                }
                case IndividualCardObjectLevel.Node:
                {
                    var page = await EquipService.GetNodesPagedAsync(new NodeQuery { Page = _objectPage, PageSize = ObjectPageSize, Search = search });
                    _objects = page.Items.Select(o => new ObjectOption(o.Id, o.Code, o.Name, string.Empty)).ToList();
                    _totalObjects = page.TotalCount;
                    break;
                }
                case IndividualCardObjectLevel.EquipmentInstance:
                {
                    var page = await EquipService.GetInstancesPagedAsync(new EquipmentInstanceQuery { Page = _objectPage, PageSize = ObjectPageSize, Search = search });
                    _objects = page.Items.Select(o => new ObjectOption(
                        o.Id, o.SerialNumber, o.Name,
                        o.EquipmentModel is null ? string.Empty : $"{o.EquipmentModel.Index} — {o.EquipmentModel.Name}")).ToList();
                    _totalObjects = page.TotalCount;
                    break;
                }
                default:
                    _objects = new List<ObjectOption>();
                    _totalObjects = 0;
                    break;
            }
        }
        finally
        {
            _loadingObjects = false;
        }
    }

    private async Task OnObjectRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, ObjectOption obj)
    {
        if (e.Key is "Enter" or " ")
        {
            await SelectObjectAsync(obj);
        }
    }

    private async Task SelectObjectAsync(ObjectOption obj)
    {
        _objectId = obj.Id;
        _objectCode = obj.Code;
        _objectName = obj.Name;
        _rootHKCardId = Guid.Empty;
        _preflight = null;
        _error = null;
        _preflightLoading = true;
        try
        {
            IndividualCardPreflightResult? result = null;
            await using (await DbLock.WaitAsync())
            {
                result = await IndCardService.BuildPreflightAsync(
                    new IndividualCardPreflightRequest(_level!.Value, obj.Id));
            }
            if (_objectId == obj.Id)
                _preflight = result;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (_objectId == obj.Id)
                _error = ex.Message;
        }
        finally
        {
            _preflightLoading = false;
        }
    }

    private async Task SelectRootAsync(IndividualCardHKCandidateDto candidate)
    {
        _rootHKCardId = candidate.HKCardId;
        _error = null;
        _preflightLoading = true;
        try
        {
            IndividualCardPreflightResult? result = null;
            await using (await DbLock.WaitAsync())
            {
                result = await IndCardService.BuildPreflightAsync(
                    new IndividualCardPreflightRequest(_level!.Value, _objectId, _rootHKCardId));
            }
            if (_objectId == result.ObjectId)
                _preflight = result;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _preflightLoading = false;
        }
    }

    private async Task Create()
    {
        _error = null;
        _creating = true;
        try
        {
            Guid newId;
            var rootHKCardId = _rootHKCardId == Guid.Empty
                ? (Guid?)null
                : _rootHKCardId;
            await using (await DbLock.WaitAsync())
            {
                var created = await IndCardService.CreateDraftAsync(new CreateIndividualCardDraftRequest(
                    _level!.Value, _objectId, rootHKCardId));
                newId = created.Id;
            }
            Nav.NavigateTo($"/инд-карты/{newId}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            _error = ex.Message;
        }
        finally
        {
            _creating = false;
        }
    }
}
