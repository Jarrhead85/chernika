@inject EquipmentService EquipService

<div class="modalOverlay" style="z-index:10000" @onclick="Cancel" @onkeydown="OnKeyDown">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="branch-quick-create-title"
         @onclick:stopPropagation="true" style="max-width:420px">
        <div class="modalHeader">
            <h3 id="branch-quick-create-title">Новый филиал</h3>
            <button type="button" class="linkBtn" @onclick="Cancel" aria-label="Закрыть">✕</button>
        </div>
        <div class="modalBody">
            <div class="form">
                <div class="field">
                    <label for="branch-quick-create-name">Наименование *</label>
                    <input id="branch-quick-create-name" @ref="_nameRef" type="text" @bind="_name" @bind:event="oninput"
                           class="fieldInput" autocomplete="off" maxlength="256" placeholder="Наименование филиала" />
                </div>
                <div class="field">
                    <label for="branch-quick-create-desc">Описание</label>
                    <textarea id="branch-quick-create-desc" @bind="_description" @bind:event="oninput"
                              class="fieldInput" maxlength="2000" rows="3" placeholder="Описание"></textarea>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="loginError" style="margin-top:12px">@_error</div>
            }
        </div>
        <div class="modalFooter">
            <button type="button" class="btn" @onclick="Cancel" disabled="@_creating">Отмена</button>
            <button type="button" class="btn primary" @onclick="CreateAsync" disabled="@_creating">
                @(_creating ? "Создание..." : "Создать и выбрать")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<Branch> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _name = "";
    private string _description = "";
    private string? _error;
    private bool _creating;
    private ElementReference _nameRef;
    private bool _focused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focused)
        {
            _focused = true;
            await _nameRef.FocusAsync();
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_creating)
            Cancel();
    }

    private void Cancel()
    {
        if (_creating) return;
        _ = OnCancelled.InvokeAsync();
    }

    private async Task CreateAsync()
    {
        if (_creating) return;
        _error = null;
        var name = _name.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            _error = "Укажите наименование.";
            return;
        }
        _creating = true;
        try
        {
            var branch = await EquipService.CreateBranchAsync(new Branch
            {
                Name = name,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim()
            });
            await OnCreated.InvokeAsync(branch);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Не удалось создать филиал. Обновите список и повторите попытку.";
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }
}
