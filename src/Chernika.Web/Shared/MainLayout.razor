@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject SearchService SearchSvc
@inject IPermissionService PermSvc
@inject TaskService TaskSvc
@inject ILogger<MainLayout> Logger
@using Chernika.Domain
@using Chernika.Domain.Entities
@using Chernika.Domain.Enums
@using Chernika.Domain.Models
@using Chernika.Infrastructure.Services
@using Chernika.Web.Services
@using Microsoft.AspNetCore.Identity
@inherits LayoutComponentBase
@implements IDisposable

<div class="bgParallax" aria-hidden="true"></div>
<div class="app">
    <aside class="sidebar" aria-label="Навигация">
        <div class="sideHeader">
            <div class="title">Навигация</div>
        </div>
        <nav class="nav">
            <a class="@GetActive("реестр-хк")" href="реестр-хк">
                <span>Реестр ХК</span>
                @*<span class="badge">Ctrl+1</span>*@
            </a>
            <a class="@GetActive("состав-изделия")" href="состав-изделия">
                <span>Состав изделия</span>
                @*<span class="badge">Ctrl+2</span>*@
            </a>
            <a class="@GetActive("состав-агрегата")" href="состав-агрегата">
                <span>Состав агрегата</span>
            </a>
            <a class="@GetActive("состав-комплекса")" href="состав-комплекса">
                <span>Состав комплекса</span>
            </a>
            <a class="@GetActive("инд-карты")" href="инд-карты">
                <span>Индивидуальная карта</span>
                @*<span class="badge">Ctrl+3</span>*@
            </a>
            <div style="border-top:1px dashed var(--line);margin:6px 0"></div>
            <a class="@GetReferencesActive()" href="справочники">
                <span>Справочники</span>
            </a>
            <div style="border-top:1px dashed var(--line);margin:6px 0"></div>
            <a class="@GetActive("задачи")" href="задачи">
                <span> Задачи</span>
                @if (openTaskCount > 0)
                {
                    <span class="badge">@openTaskCount</span>
                }
            </a>
            @if (canViewAudit)
            {
                <a class="@GetActive("журнал-аудита")" href="журнал-аудита">
                    <span>Журнал аудита</span>
                </a>
            }
@if (canManageUsers)
{
    <div style="border-top:1px dashed var(--line);margin:6px 0"></div>
    <a class="@GetActive("пользователи")" href="пользователи">
        <span>Пользователи</span>
    </a>
}
@if (canSystemConfig)
{
    <a class="@GetActive("диагностика")" href="диагностика">
        <span>Диагностика</span>
    </a>
}
        </nav>
        <section class="sideCard" aria-label="Статус">
            @*<h3>Контур и безопасность</h3>*@
            <p>АИС «ИСБ ГСМ» — ведение химмотологических карт, нормирование ГСМ и индивидуальные нормы.</p>
            <div class="mini">
                @*<span class="pill" id="themeLabel">Тёмная</span>*@
                @*<span class="pill">Panel-based</span>*@
                <span class="pill">Версия интерфейса: 1.0.0 2026.05</span>
            </div>
        </section>
    </aside>

    <header class="topbar">
        <div class="brand">
            <div class="logo">ИС</div>
            <div>
                <h1>АИС «ИСБ ГСМ»</h1>
                <div class="sub">Реестр ХК • Состав изделия • Индивидуальная карта</div>
            </div>
        </div>
        <div class="actions">
            <div class="env" title="Окружение и состояние">
                <span class="dot" aria-hidden="true"></span>Контур: Тестовый • БД: OK
            </div>
            <div class="searchTop" role="search">
                <div class="searchTopInner">
                    <input placeholder="Поиск: ВВСТ, марка ГСМ, номер ХК…"
                           value="@searchQuery"
                           @oninput="OnSearchInput"
                           @onfocus="OnSearchFocus"
                           @onblur="OnSearchBlur"
                           id="globalSearchInput" />
                    <button @onclick="DoSearch">Поиск</button>
                </div>
                @if (showSearchDropdown)
                {
                    <div class="searchDropdown" @onmouseenter="() => searchHover = true" @onmouseleave="() => searchHover = false">
                        @foreach (var r in searchResults.Take(4))
                        {
                            <a href="@r.Url" class="searchDropdownItem">
                                <div class="sdiTop">
                                    <span class="sdiType">@r.EntityTypeDisplay</span>
                                </div>
                                <div class="sdiTitle">@r.Title</div>
                                @if (!string.IsNullOrEmpty(r.Subtitle))
                                {
                                    <div class="sdiSub">@r.Subtitle</div>
                                }
                                @if (!string.IsNullOrEmpty(r.ContextInfo))
                                {
                                    <div class="sdiCtx">@r.ContextInfo</div>
                                }
                            </a>
                        }
                        @if (searchTotalCount > 4)
                        {
                            <a href="/поиск?q=@Uri.EscapeDataString(searchQuery)" class="searchDropdownAll">
                                Показать все результаты (@searchTotalCount) →
                            </a>
                        }
                    </div>
                }
            </div>
            <div class="bellWrap">
                <button class="iconBtn" id="notificationBellButton" @ref="_bellButtonRef" title="Уведомления"
                        aria-label="Уведомления"
                        aria-expanded="@(showBellDropdown ? "true" : "false")"
                        aria-controls="notificationBellDropdown"
                        @onclick="ToggleBell">🔔
                    @if (unreadCount > 0)
                    {
                        <span class="bellBadge">@UnreadLabel</span>
                    }
                </button>
                @if (showBellDropdown)
                {
                    <div class="popover bellPopover" id="notificationBellDropdown" @ref="_bellPopoverRef"
                         role="dialog" aria-label="Последние уведомления"
                         data-placement="@_bellPlacement" @onclick:stopPropagation>
                        <div class="popoverHeader">
                            <span>Уведомления</span>
                            @if (unreadCount > 0)
                            {
                                <span class="bellHeaderActions">
                                    <span class="tag warn">@UnreadLabel новых</span>
                                    <button class="linkBtn" @onclick="MarkAllRead">Прочитать все</button>
                                </span>
                            }
                        </div>
                        <div class="popoverList">
                            @if (recentNotifications.Count == 0)
                            {
                                <div class="bellEmpty">Уведомлений нет</div>
                            }
                            else
                            {
                                @foreach (var n in recentNotifications)
                                {
                                    <button class="bellItem @(n.IsRead ? "read" : "unread")" @onclick="() => OpenNotification(n)">
                                        <div class="bellItemTitle">@n.Title</div>
                                        @if (!string.IsNullOrEmpty(n.Message))
                                        {
                                            <div class="bellItemMsg">@n.Message</div>
                                        }
                                        <div class="bellItemMeta">@NotificationTypeLabel(n.Type) • @RelativeTime(n.CreatedAtUtc)</div>
                                    </button>
                                }
                            }
                        </div>
                        <div class="popoverFooter">
                            <a href="/уведомления" class="linkBtn" @onclick="CloseBell">Все уведомления →</a>
                        </div>
                    </div>
                }
            </div>
            <button class="modeBtn" @onclick="ToggleTheme" id="themeToggle">☀</button>
            <div class="user" title="Профиль пользователя">
                <div class="avatar">@userInitial</div>
                <div class="meta">
                    <div class="name">@userName</div>
                    <div class="role">@userRole</div>
                </div>
                <a href="/выход" class="linkBtn" style="margin-left:8px" title="Выйти">→</a>
            </div>
        </div>
    </header>

    <main class="main">
        <div class="stack">
            @Body
            <div class="footer" style="padding:10px 2px 0">
                <div>Версия интерфейса: <span class="mono">1.0.0</span> • <span class="mono">2026.05</span></div>
                <div>© АИС «ИСБ ГСМ»</div>
            </div>
        </div>
    </main>
</div>

@code {
    string searchQuery = "";
    string userName = "Гость";
    string userRole = "";
    string userInitial = "?";
    bool canViewAudit;
    bool canManageUsers;
    bool canSystemConfig;
    bool _isDark = true;

    List<SearchResultItem> searchResults = [];
    int searchTotalCount = 0;
    bool searchFocused = false;
    bool searchHover = false;
    bool showSearchDropdown => searchFocused && searchResults.Count > 0;
    CancellationTokenSource? searchCts;
    int openTaskCount;
    int unreadCount;
    bool showBellDropdown;
    IReadOnlyList<NotificationDto> recentNotifications = [];
    DotNetObjectReference<MainLayout>? _bellRef;
    bool _bellPositioned;
    string _bellPlacement = "bottom";
    ElementReference _bellButtonRef;
    ElementReference _bellPopoverRef;
    bool _authChecked;
    bool _disposed;
    readonly SemaphoreSlim _layoutRefreshGate = new(1, 1);
    CancellationTokenSource? _layoutRefreshCts;

    [Inject] NavigationManager Nav { get; set; } = null!;
    [Inject] NotificationService NotifSvc { get; set; } = null!;
    [Inject] NotificationRefreshService NotifRefresh { get; set; } = null!;

    string UnreadLabel => unreadCount >= 100 ? "99+" : unreadCount.ToString();

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        NotifRefresh.Changed += OnNotifRefresh;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (_disposed) return;

        Logger.LogInformation("Навигация layout: {From} → {To}", Nav.Uri, args.Location);

        if (showBellDropdown)
            CloseBell();

        _ = InvokeAsync(RefreshLayoutIndicatorsAsync);
    }

    private async Task OnNotifRefresh()
    {
        await RefreshBellAsync();
        if (!_disposed)
            StateHasChanged();
    }

    private async Task RefreshLayoutIndicatorsAsync()
    {
        if (!_authChecked || _disposed)
            return;

        _layoutRefreshCts?.Cancel();
        _layoutRefreshCts?.Dispose();
        _layoutRefreshCts = new CancellationTokenSource();
        var ct = _layoutRefreshCts.Token;

        try
        {
            await _layoutRefreshGate.WaitAsync(ct);
            try
            {
                if (ct.IsCancellationRequested || _disposed)
                    return;

                openTaskCount = await TaskSvc.GetOpenTaskCountAsync(ct);

                if (ct.IsCancellationRequested || _disposed)
                    return;

                unreadCount = await NotifSvc.GetUnreadCountAsync(ct);

                if (showBellDropdown && !ct.IsCancellationRequested && !_disposed)
                    recentNotifications = (await NotifSvc.GetMyNotificationsAsync(new NotificationQuery { PageSize = 5 }, ct)).Items;
            }
            finally
            {
                _layoutRefreshGate.Release();
            }

            if (!ct.IsCancellationRequested && !_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // новый маршрут отменил устаревшее обновление
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка обновления индикаторов layout после навигации");
        }
    }

    private async Task RefreshBellAsync(CancellationToken ct = default)
    {
        if (!_authChecked) return;
        try
        {
            unreadCount = await NotifSvc.GetUnreadCountAsync(ct);
            if (showBellDropdown)
                recentNotifications = (await NotifSvc.GetMyNotificationsAsync(new NotificationQuery { PageSize = 5 }, ct)).Items;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Не удалось обновить счётчик уведомлений");
        }
    }

    private async Task ToggleBell()
    {
        if (showBellDropdown)
        {
            CloseBell();
            return;
        }
        showBellDropdown = true;
        await RefreshBellAsync();
        _bellPositioned = false;
        StateHasChanged();
    }

    private void CloseBell()
    {
        showBellDropdown = false;
        try { _ = JS.InvokeVoidAsync("popoverPositioning.removeOutsideClickListener"); } catch { }
        try { _ = JS.InvokeVoidAsync("popoverPositioning.removeEscapeListener"); } catch { }
        StateHasChanged();
    }

    [JSInvokable]
    public void CloseDropdown() => CloseBell();

    private async Task OpenNotification(NotificationDto n)
    {
        if (!n.IsRead)
        {
            try
            {
                await NotifSvc.MarkAsReadAsync(n.Id);
            }
            catch
            {
                // не критично: уведомление всё равно можно открыть
            }
        }
        showBellDropdown = false;
        await RefreshBellAsync();
        await NotifRefresh.NotifyChangedAsync();
        Nav.NavigateTo(NotificationRouteGuard.Normalize(n.NavigationUrl) ?? "/уведомления");
    }

    private async Task MarkAllRead()
    {
        try
        {
            await NotifSvc.MarkAllAsReadAsync();
        }
        catch
        {
            // ignore
        }
        await RefreshBellAsync();
        if (!_disposed)
            StateHasChanged();
        await NotifRefresh.NotifyChangedAsync();
    }

    private static string NotificationTypeLabel(NotificationType type) => type switch
    {
        NotificationType.TaskAssigned => "Задача",
        NotificationType.TaskCompleted => "Задача выполнена",
        NotificationType.HKSubmittedForReview => "ХК на проверке",
        NotificationType.HKReturnedForRevision => "ХК на доработке",
        NotificationType.HKApproved => "ХК утверждена",
        NotificationType.HKExpiring => "Срок действия ХК",
        NotificationType.HKExpired => "ХК просрочена",
        NotificationType.ReferenceProposalPending => "Предложение справочника",
        NotificationType.Information => "Информация",
        NotificationType.System => "Система",
        _ => type.ToString(),
    };

    private static string RelativeTime(DateTime utc)
    {
        var localNow = DateTime.Now;
        var local = utc.ToLocalTime();
        var diff = localNow - local;
        if (diff.TotalSeconds < 60) return "только что";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} мин назад";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} ч назад";
        if (diff.TotalDays < 2) return "вчера";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} дн назад";
        return local.ToString("dd.MM.yyyy");
    }

    public void Dispose()
    {
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        NotifRefresh.Changed -= OnNotifRefresh;
        _layoutRefreshCts?.Cancel();
        _layoutRefreshCts?.Dispose();
        _layoutRefreshGate.Dispose();
        try { _ = JS.InvokeVoidAsync("popoverPositioning.removeOutsideClickListener"); } catch { }
        try { _ = JS.InvokeVoidAsync("popoverPositioning.removeEscapeListener"); } catch { }
        _bellRef?.Dispose();
    }

    private string GetActive(string path)
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        var target = path.TrimStart('/');
        return relative.Equals(target, StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

    private string GetReferencesActive()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        return relative.Equals("справочники", StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith("справочники/", StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith("справочник-", StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

    async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;
        try
        {
            await Task.Delay(300, token);
            if (!token.IsCancellationRequested)
                await PerformSearch();
        }
        catch (TaskCanceledException) { }
    }

    async Task PerformSearch()
    {
        if (searchQuery.Length < 2)
        {
            searchResults = [];
            searchTotalCount = 0;
            return;
        }
        searchResults = await SearchSvc.SearchAsync(searchQuery, 20);
        searchTotalCount = searchResults.Count;
    }

    void OnSearchFocus() { searchFocused = true; }
    async Task OnSearchBlur()
    {
        await Task.Delay(200);
        if (!searchHover)
        {
            searchFocused = false;
            StateHasChanged();
        }
    }
    void GoToSearchPage() => Nav.NavigateTo($"/поиск?q={Uri.EscapeDataString(searchQuery)}");
    void DoSearch() { if (!string.IsNullOrWhiteSpace(searchQuery)) GoToSearchPage(); }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            var stored = await JS.InvokeAsync<string>("getTheme");
            _isDark = stored != "light";
            await JS.InvokeVoidAsync("applyTheme", _isDark);
            await LoadUserInfo();
            StateHasChanged();
        }

        if (showBellDropdown && !_bellPositioned)
        {
            _bellPositioned = true;
            _bellRef ??= DotNetObjectReference.Create(this);
            try
            {
                _bellPlacement = await JS.InvokeAsync<string>("popoverPositioning.getPlacement", _bellButtonRef, 430);
                await JS.InvokeVoidAsync("popoverPositioning.addOutsideClickListener", _bellButtonRef, _bellPopoverRef, _bellRef, nameof(CloseDropdown));
                await JS.InvokeVoidAsync("popoverPositioning.addEscapeListener", _bellRef, nameof(CloseDropdown));
                StateHasChanged();
            }
            catch (JSDisconnectedException) { }
        }
    }

    async Task LoadUserInfo()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _authChecked = true;
            userName = user.FindFirst("FullName")?.Value ?? user.Identity.Name ?? "Пользователь";
            userRole = user.FindFirst("Position")?.Value ?? "";
            userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId != null)
            {
                canViewAudit = await PermSvc.HasPermissionAsync(userId, PermissionCodes.AuditView);
                canManageUsers = await PermSvc.HasPermissionAsync(userId, PermissionCodes.UsersManage);
                canSystemConfig = await PermSvc.HasPermissionAsync(userId, PermissionCodes.SystemConfig);
            }
            await RefreshLayoutIndicatorsAsync();
        }
    }

    async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("applyTheme", _isDark);
    }
}
